<% content_for(:page_title) { "Edit quiz question ##{@question.id}" } %>

<div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
  <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">Quiz question #<%= @question.id %> · <%= @question.kind.to_s.humanize %></p>
      <h2 class="mt-1 text-2xl font-bold text-gray-900">Fix the question</h2>
      <p class="mt-1 text-sm text-gray-600">Reported: <%= @report.reason %></p>
    </div>
    <%= link_to "Back to report", admin_report_path(@report), class: "btn btn-secondary" %>
  </div>

  <% if @question.errors.any? %>
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert">
      <ul class="list-disc pl-5">
        <% @question.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @question, url: update_question_admin_report_path(@report), method: :patch, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :prompt, class: "block text-sm font-bold text-gray-700" %>
      <%= f.text_area :prompt, rows: 3, class: "mt-1 w-full rounded-md border border-gray-300 p-2" %>
    </div>
    <fieldset>
      <legend class="text-sm font-bold text-gray-700">Choices (pick the correct one)</legend>
      <div class="mt-1 grid gap-2">
        <% 4.times do |i| %>
          <div class="flex items-center gap-2">
            <%= f.radio_button :correct_index, i, id: "correct_#{i}", "aria-label": "Choice #{("A".ord + i).chr} is correct" %>
            <%= text_field_tag "bible_quiz_question[choices][]", @question.choices[i], id: "choice_#{i}",
                               class: "w-full rounded-md border border-gray-300 p-2", "aria-label": "Choice #{("A".ord + i).chr}" %>
          </div>
        <% end %>
      </div>
    </fieldset>
    <div>
      <%= f.label :reference, class: "block text-sm font-bold text-gray-700" %>
      <%= f.text_field :reference, class: "mt-1 w-full rounded-md border border-gray-300 p-2" %>
    </div>
    <div>
      <%= f.label :explanation, class: "block text-sm font-bold text-gray-700" %>
      <%= f.text_area :explanation, rows: 3, class: "mt-1 w-full rounded-md border border-gray-300 p-2" %>
    </div>
    <div>
      <%= label_tag :notes, "Resolution note (optional)", class: "block text-sm font-bold text-gray-700" %>
      <%= text_field_tag :notes, params[:notes], class: "mt-1 w-full rounded-md border border-gray-300 p-2" %>
    </div>
    <p class="text-sm text-gray-600">Saving puts the question back in the quiz and resolves its pending reports.</p>
    <%= f.submit "Save and resolve", class: "btn btn-primary" %>
  <% end %>
</div>
