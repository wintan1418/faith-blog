<% content_for(:page_title) { @user.username } %>
<% tz = AdminDashboardStats::TZ %>
<% when_ = ->(t) { t ? "#{t.in_time_zone(tz).strftime('%-d %b %Y, %H:%M')} (#{time_ago_in_words(t)} ago)" : "—" } %>

<div class="mb-4"><%= link_to "← All members", admin_users_path, class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %></div>

<div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-4">
      <%= avatar_for(@user, size: :xlarge) if @profile %>
      <div>
        <h1 class="text-2xl font-extrabold text-gray-900"><%= @user.username %></h1>
        <p class="text-sm text-gray-600 break-all"><%= @user.email %></p>
        <% if @profile&.headline.present? %><p class="mt-1 text-sm text-gray-800"><%= @profile.headline %></p><% end %>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="badge badge-secondary"><%= @user.role.humanize %></span>
          <span class="badge <%= @user.active? ? 'badge-success' : 'badge-primary' %>"><%= @user.active? ? "Active" : "Suspended" %></span>
          <span class="badge badge-secondary"><%= @user.email_verified? ? "Email verified" : "Email not verified" %></span>
          <% if @user.two_factor_enabled? %><span class="badge badge-success">2FA on</span><% end %>
          <span class="badge badge-secondary"><%= @profile.nil? || @profile.public_profile? ? "Public profile" : "Private profile" %></span>
        </div>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Public profile", user_path(@user.username), class: "btn btn-secondary btn-sm", target: "_blank", rel: "noopener" %>
      <%= link_to "Security", security_admin_user_path(@user), class: "btn btn-secondary btn-sm" %>
      <%= link_to "Actions", admin_users_path(q: @user.username), class: "btn btn-secondary btn-sm" %>
    </div>
  </div>
</div>

<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% @stats.each do |label, value| %>
    <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
      <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500"><%= label %></dt>
      <dd class="mt-1 text-2xl font-bold text-gray-900"><%= number_with_delimiter(value) %></dd>
    </div>
  <% end %>
</dl>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Account</h2>
    <dl class="mt-3 divide-y divide-gray-100 text-sm">
      <% [["Joined", when_.call(@user.created_at)],
          ["Last seen", when_.call(@user.last_seen_at)],
          ["Last sign-in", when_.call(@user.last_sign_in_at)],
          ["Sign-ins", @user.sign_in_count.to_i],
          ["App", @user.android_app_version ? "Android #{@user.android_app_version}" : "Web or iPhone"],
          ["Signed up with", @user.provider.presence&.titleize || "Email"],
          ["Invited by", @user.invited_by&.username || "—"],
          ["Breath streak", "#{@user.current_breath_streak.to_i} days (best #{@user.longest_breath_streak.to_i})"]].each do |k, v| %>
        <div class="flex justify-between gap-4 py-2"><dt class="text-gray-500"><%= k %></dt><dd class="text-right font-medium text-gray-900"><%= v %></dd></div>
      <% end %>
    </dl>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Profile</h2>
    <% if @profile %>
      <% if @profile.bio.present? %><p class="mt-3 whitespace-pre-line text-sm text-gray-800"><%= @profile.bio %></p><% end %>
      <dl class="mt-3 divide-y divide-gray-100 text-sm">
        <% [["Location", @profile.location],
            ["Industry", @profile.industry],
            ["Assembly", @profile.assembly],
            ["Faith background", @profile.faith_background],
            ["Open to", Array(@profile.open_to).compact_blank.join(", ")],
            ["Skills", Array(@profile.skills).compact_blank.join(", ")],
            ["Website", @profile.website],
            ["Birthday", [@profile.birth_day, (Date::MONTHNAMES[@profile.birth_month.to_i] if @profile.birth_month.present?)].compact.join(" ")]].each do |k, v| %>
          <% next if v.blank? %>
          <div class="flex justify-between gap-4 py-2"><dt class="text-gray-500"><%= k %></dt><dd class="text-right font-medium text-gray-900 break-words"><%= v %></dd></div>
        <% end %>
      </dl>
    <% else %>
      <p class="mt-3 text-sm text-gray-500">No profile filled in yet.</p>
    <% end %>
  </div>
</div>

<div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-gray-900">Recent breaths</h2>
  <% if @recent_posts.any? %>
    <ul class="mt-3 divide-y divide-gray-100">
      <% @recent_posts.each do |post| %>
        <li class="flex flex-wrap items-baseline justify-between gap-3 py-3 text-sm">
          <span class="min-w-0 flex-1 text-gray-800"><%= truncate(post.title.presence || post.content&.to_plain_text.to_s.squish, length: 140).presence || "(no text)" %></span>
          <span class="whitespace-nowrap text-xs text-gray-500"><%= time_ago_in_words(post.created_at) %> ago · <%= post.status %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">No breaths yet.</p>
  <% end %>
</div>
