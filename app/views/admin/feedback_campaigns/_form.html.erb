<%= form_with model: [ :admin, campaign ], local: true, class: "fc-admin-form" do |f| %>
  <% if campaign.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-800 mb-4">
      <%= campaign.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="fc-admin-field">
    <%= f.label :title, "Question", class: "fc-admin-label" %>
    <%= f.text_field :title, class: "fc-admin-input", maxlength: 160, required: true, placeholder: "How is Brethreign working for you?" %>
    <p class="fc-admin-hint">The headline of the survey. Members see it in the alert and on the feed pop-up.</p>
  </div>

  <fieldset class="fc-admin-field">
    <legend class="fc-admin-label">Rating</legend>
    <label class="afb-radio"><%= f.radio_button :rating_kind, "stars" %> <span><strong>1–5 stars</strong> — quick satisfaction</span></label>
    <label class="afb-radio"><%= f.radio_button :rating_kind, "nps" %> <span><strong>0–10</strong> — “How likely are you to recommend Brethreign?” (gives an NPS score)</span></label>
  </fieldset>

  <div class="fc-admin-field">
    <%= f.label :follow_up_prompt, "Follow-up question for a text box (optional)", class: "fc-admin-label" %>
    <%= f.text_field :follow_up_prompt, class: "fc-admin-input", maxlength: 200, placeholder: "What should we improve?" %>
    <p class="fc-admin-hint">Leave empty for no text box.</p>
  </div>

  <div class="fc-admin-field">
    <%= f.label :choice_question, "Extra multiple-choice question (optional)", class: "fc-admin-label" %>
    <%= f.text_field :choice_question, class: "fc-admin-input", maxlength: 200, placeholder: "What do you use most?" %>
    <%= f.label :choice_options_text, "Answers, one per line (2–#{FeedbackCampaign::MAX_CHOICES})", class: "fc-admin-label" %>
    <%= f.text_area :choice_options_text, class: "fc-admin-input", rows: 4, placeholder: "The feed\nRooms\nThe Bible\nMessages" %>
  </div>

  <details class="fc-admin-field afb-long" <%= "open" if campaign.long_form? || campaign.errors[:questions].any? %>>
    <summary class="fc-admin-label">Longer survey: your own list of questions (optional)</summary>
    <%= f.text_area :questions_text, class: "fc-admin-input afb-mono", rows: 16,
          placeholder: "# one: Where do you live?\nNigeria\nGhana\nUnited Kingdom\n\n# many 3: What should we build next?\n> Pick up to 3.\nJob board\nVoice & video calls\nLive streams\n\n# text: What do you love most?\n\n# rating: How likely are you to recommend Brethreign to a friend?" %>
    <p class="fc-admin-hint">
      Start each question with <code># one:</code> (pick one), <code># many:</code> (pick several; <code># many 3:</code> allows up to 3),
      <code># text:</code> (a text box) or <code># rating:</code> (where the rating above goes). Answers go one per line under it;
      a line starting with <code>&gt;</code> is a hint. Add <code>optional</code> (e.g. <code># one optional:</code>) to let members skip it.
      With a list here, the survey opens as its own page, the follow-up question above becomes the intro line, and the multiple-choice question above is not used.
    </p>
  </details>

  <div class="fc-admin-field">
    <%= f.label :audience, "Who is it for?", class: "fc-admin-label" %>
    <%= f.select :audience, FeedbackCampaign.audience_options, {}, class: "fc-admin-input" %>
    <p class="fc-admin-hint">Platform audiences are members who used that platform in the last <%= FeedbackCampaign::PLATFORM_WINDOW.inspect %>. Members who turned surveys off in Settings are never asked.</p>
  </div>

  <div class="afb-two">
    <div class="fc-admin-field">
      <%= f.label :starts_at, "Start (empty = when you press Launch)", class: "fc-admin-label" %>
      <%= f.datetime_local_field :starts_at, class: "fc-admin-input" %>
    </div>
    <div class="fc-admin-field">
      <%= f.label :ends_at, "End", class: "fc-admin-label" %>
      <%= f.datetime_local_field :ends_at, class: "fc-admin-input" %>
    </div>
  </div>
  <p class="fc-admin-hint">Times are in <%= Time.zone.name %>.</p>

  <label class="afb-radio">
    <%= f.check_box :also_push %>
    <span><strong>Also send a push notification</strong> — off by default. Everyone targeted gets an in-app alert either way; pushes go out in small batches.</span>
  </label>

  <label class="afb-radio">
    <%= f.check_box :also_email %>
    <span><strong>Also send an email</strong> — to members who have email notifications on, with a button straight to the survey.</span>
  </label>

  <div class="fc-admin-form-actions">
    <%= f.submit (campaign.persisted? ? "Save changes" : "Save as draft"), class: "fc-btn fc-btn-primary" %>
    <%= link_to "Cancel", campaign.persisted? ? admin_feedback_campaign_path(campaign) : admin_feedback_campaigns_path, class: "fc-btn" %>
  </div>
<% end %>
