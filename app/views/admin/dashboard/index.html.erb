<% content_for(:page_title) { "Dashboard" } %>

<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
  <%= link_to admin_users_path, class: "fc-card block p-5" do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-[var(--fc-muted)]">Total Users</p>
        <p class="mt-4 text-4xl font-extrabold text-[var(--fc-ink)]"><%= @total_users %></p>
        <p class="mt-1 text-sm font-semibold text-[var(--fc-muted)]">+<%= @new_users_today %> today</p>
      </div>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-[var(--fc-surface-2)] text-[var(--fc-accent)]">
        <%= render_icon("users", classes: "h-5 w-5") %>
      </span>
    </div>
  <% end %>

  <%= link_to admin_posts_path, class: "fc-card block p-5" do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-[var(--fc-muted)]">Total Posts</p>
        <p class="mt-4 text-4xl font-extrabold text-[var(--fc-ink)]"><%= @total_posts %></p>
        <p class="mt-1 text-sm font-semibold text-[var(--fc-muted)]">+<%= @posts_today %> today</p>
      </div>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-[var(--fc-surface-2)] text-[var(--fc-accent)]">
        <%= render_icon("filetext", classes: "h-5 w-5") %>
      </span>
    </div>
  <% end %>

  <%= link_to admin_reports_path, class: "fc-card block p-5" do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-[var(--fc-muted)]">Pending Reports</p>
        <p class="mt-4 text-4xl font-extrabold text-[var(--fc-ink)]"><%= @pending_reports %></p>
        <p class="mt-1 text-sm font-semibold <%= @pending_reports.positive? ? 'text-red-600' : 'text-[var(--fc-muted)]' %>">
          <%= @pending_reports.positive? ? "Needs review" : "All clear" %>
        </p>
      </div>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-red-50 text-red-600">
        <%= render_icon("shield", classes: "h-5 w-5") %>
      </span>
    </div>
  <% end %>

  <%= link_to admin_resources_path, class: "fc-card block p-5" do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-[var(--fc-muted)]">Pending Resources</p>
        <p class="mt-4 text-4xl font-extrabold text-[var(--fc-ink)]"><%= @pending_resources %></p>
        <p class="mt-1 text-sm font-semibold <%= @pending_resources.positive? ? 'text-[var(--fc-accent)]' : 'text-[var(--fc-muted)]' %>">
          <%= @pending_resources.positive? ? "Needs review" : "All clear" %>
        </p>
      </div>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-[var(--fc-surface-2)] text-[var(--fc-accent)]">
        <%= render_icon("bookopen", classes: "h-5 w-5") %>
      </span>
    </div>
  <% end %>
</div>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <section class="fc-card overflow-hidden">
    <header class="fc-card-header-strip flex items-center justify-between">
      <h2 class="text-sm font-extrabold text-[var(--fc-ink)]">Recent Posts</h2>
      <%= link_to "View all", admin_posts_path, class: "text-sm font-bold text-[var(--fc-accent)] hover:text-[var(--fc-ink)]" %>
    </header>
    <div class="divide-y divide-[var(--fc-line)]">
      <% if @recent_posts.any? %>
        <% @recent_posts.each do |post| %>
          <%= link_to post_path(post), class: "flex items-start justify-between gap-4 px-5 py-4 hover:bg-[var(--fc-surface-2)]" do %>
            <span class="min-w-0">
              <span class="block truncate text-sm font-extrabold text-[var(--fc-ink)]"><%= post.title %></span>
              <span class="mt-1 block truncate text-xs font-semibold text-[var(--fc-muted)]">
                <%= post.user.username %><%= " in #{post.room.name}" if post.room %>
              </span>
            </span>
            <span class="shrink-0 text-xs font-semibold text-[var(--fc-muted)]"><%= time_ago_short(post.created_at) %></span>
          <% end %>
        <% end %>
      <% else %>
        <div class="px-5 py-8 text-center">
          <p class="text-sm font-semibold text-[var(--fc-muted)]">No posts yet.</p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="fc-card overflow-hidden">
    <header class="fc-card-header-strip flex items-center justify-between">
      <h2 class="text-sm font-extrabold text-[var(--fc-ink)]">New Users</h2>
      <%= link_to "View all", admin_users_path, class: "text-sm font-bold text-[var(--fc-accent)] hover:text-[var(--fc-ink)]" %>
    </header>
    <div class="divide-y divide-[var(--fc-line)]">
      <% @recent_users.each do |user| %>
        <%= link_to admin_user_path(user), class: "flex items-center gap-3 px-5 py-4 hover:bg-[var(--fc-surface-2)]" do %>
          <% if user.profile.avatar.attached? %>
            <%= image_tag user.profile.avatar, class: "fc-avatar object-cover" %>
          <% else %>
            <span class="fc-avatar"><%= user.username.first.upcase %></span>
          <% end %>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-extrabold text-[var(--fc-ink)]"><%= user.username %></span>
            <span class="block truncate text-xs font-semibold text-[var(--fc-muted)]"><%= user.email %></span>
          </span>
          <span class="text-xs font-semibold text-[var(--fc-muted)]"><%= time_ago_short(user.created_at) %></span>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
