<% content_for(:page_title) { "Review ##{@review.id}" } %>

<% reviewable = @review.reviewable %>

<div class="mb-4">
  <%= link_to "← Back to queue", admin_moderation_reviews_path, class: "text-sm font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="lg:col-span-2 space-y-4">
    <div class="rounded-xl border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] p-6">
      <p class="text-xs font-bold uppercase tracking-wider text-[var(--fc-muted)]"><%= reviewable.class.name %> #<%= reviewable.id %></p>
      <% if reviewable.is_a?(Post) %>
        <h2 class="mt-1 text-xl font-extrabold text-[var(--fc-ink)]"><%= reviewable.title %></h2>
        <div class="prose prose-sm mt-3 max-w-none text-[var(--fc-soft)]"><%= reviewable.content %></div>
      <% elsif reviewable.is_a?(Comment) %>
        <h2 class="mt-1 text-base font-bold text-[var(--fc-ink)]">Comment on post #<%= reviewable.post_id %></h2>
        <div class="prose prose-sm mt-3 max-w-none text-[var(--fc-soft)]"><%= reviewable.content %></div>
      <% else %>
        <pre class="mt-3 whitespace-pre-wrap text-sm text-[var(--fc-soft)]"><%= reviewable.try(:body) || reviewable.inspect %></pre>
      <% end %>
    </div>

    <div class="rounded-xl border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] p-6">
      <h3 class="text-sm font-extrabold uppercase tracking-wider text-[var(--fc-muted)]">AI Assessment</h3>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--fc-muted)]">Severity</p>
          <p class="text-base font-extrabold text-[var(--fc-ink)]"><%= @review.severity %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--fc-muted)]">Score</p>
          <p class="text-base font-extrabold text-[var(--fc-ink)]"><%= @review.score.round(3) %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--fc-muted)]">Recommended</p>
          <p class="text-base font-extrabold text-[var(--fc-ink)]"><%= @review.recommended_action.humanize %></p>
        </div>
      </div>
      <% if @review.summary.present? %>
        <p class="mt-4 rounded-lg bg-[var(--fc-surface-2)] p-3 text-sm text-[var(--fc-soft)]">"<%= @review.summary %>"</p>
      <% end %>
      <div class="mt-4 flex flex-wrap gap-1">
        <% @review.categories.each do |cat| %>
          <span class="rounded bg-[var(--fc-surface-3)] px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-[var(--fc-soft)]"><%= cat.tr("_", " ") %></span>
        <% end %>
      </div>
      <details class="mt-4">
        <summary class="cursor-pointer text-xs font-bold uppercase tracking-wider text-[var(--fc-muted)]">Raw response</summary>
        <pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-[var(--fc-bg)] p-3 text-xs text-[var(--fc-soft)]"><%= JSON.pretty_generate(@review.raw_response) rescue @review.raw_response.to_s %></pre>
      </details>
    </div>

    <%= form_with url: decide_admin_moderation_review_path(@review), method: :post, local: true, class: "rounded-xl border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] p-6" do |f| %>
      <h3 class="text-sm font-extrabold uppercase tracking-wider text-[var(--fc-muted)]">Decide</h3>
      <%= f.text_area :notes, rows: 3, placeholder: "Optional notes (visible to other moderators).", class: "mt-3 w-full rounded-lg border border-[var(--fc-line-strong)] bg-[var(--fc-bg)] px-3 py-2 text-sm text-[var(--fc-ink)]" %>
      <div class="mt-4 flex flex-wrap gap-2">
        <%= f.submit "Approve", name: "decision", value: "approve", class: "btn btn-secondary btn-sm" %>
        <%= f.submit "Dismiss flag", name: "decision", value: "dismiss", class: "btn btn-secondary btn-sm" %>
        <%= f.submit "Hide content", name: "decision", value: "hide", class: "btn btn-secondary btn-sm" %>
        <%= f.submit "Warn user", name: "decision", value: "warn", class: "btn btn-secondary btn-sm" %>
        <%= f.submit "Restrict user", name: "decision", value: "restrict", class: "btn btn-secondary btn-sm" %>
        <%= f.submit "Suspend user", name: "decision", value: "suspend", class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </section>

  <aside class="space-y-4">
    <div class="rounded-xl border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] p-5">
      <h3 class="text-sm font-extrabold uppercase tracking-wider text-[var(--fc-muted)]">Author</h3>
      <% if @review.user %>
        <p class="mt-2 text-base font-extrabold text-[var(--fc-ink)]"><%= @review.user.username %></p>
        <p class="text-xs text-[var(--fc-muted)]"><%= @review.user.email %></p>
        <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
          <div>
            <p class="font-bold uppercase tracking-wider text-[var(--fc-muted)]">Risk</p>
            <p class="font-extrabold text-[var(--fc-ink)]"><%= @review.user.risk_profile&.risk_level || "clear" %></p>
          </div>
          <div>
            <p class="font-bold uppercase tracking-wider text-[var(--fc-muted)]">Flagged</p>
            <p class="font-extrabold text-[var(--fc-ink)]"><%= @review.user.risk_profile&.flagged_reviews_count || 0 %></p>
          </div>
        </div>
      <% else %>
        <p class="mt-2 text-sm text-[var(--fc-muted)]">No user attached.</p>
      <% end %>
    </div>

    <% if @recent_logs&.any? %>
      <div class="rounded-xl border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] p-5">
        <h3 class="text-sm font-extrabold uppercase tracking-wider text-[var(--fc-muted)]">Recent moderation history</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <% @recent_logs.each do |log| %>
            <li>
              <p class="font-bold text-[var(--fc-ink)]"><%= log.action.humanize %></p>
              <p class="text-xs text-[var(--fc-muted)]"><%= time_ago_in_words(log.created_at) %> ago by <%= log.moderator&.username || "system" %></p>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </aside>
</div>
