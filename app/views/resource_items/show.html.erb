<% content_for(:title) { "#{@resource.title} - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-4xl">
    <article class="mystic-panel-strong overflow-hidden">
      <header class="border-b border-faith-green/10 p-6 sm:p-8">
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <%= link_to "Resources", resources_root_path, class: "mystic-badge px-3 py-1" %>
          <%= link_to @resource.resource_category.name, resource_category_path(@resource.resource_category), class: "mystic-badge px-3 py-1" %>
          <span class="mystic-badge px-3 py-1"><%= @resource.resource_type.titleize %></span>
        </div>

        <div class="flex items-start gap-4">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-lg bg-white/75 text-faith-green">
            <%= render_icon(@resource.type_icon, classes: "w-7 h-7") %>
          </span>
          <div class="min-w-0">
            <h1 class="mystic-title text-4xl sm:text-5xl"><%= @resource.title %></h1>
            <p class="mystic-copy mt-3 max-w-3xl text-base"><%= @resource.description %></p>
          </div>
        </div>
      </header>

      <div class="grid gap-6 p-6 sm:p-8 md:grid-cols-[1fr_240px]">
        <main>
          <div class="prose-faith">
            <p>
              This resource was shared by <strong><%= @resource.user&.username || "Faith Community" %></strong>
              to help the community study, reflect, and grow.
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <% if @resource.url.present? %>
              <%= link_to "Open Resource", @resource.url, target: "_blank", rel: "noopener", class: "btn btn-primary" %>
            <% end %>
            <% if @resource.file.attached? %>
              <%= link_to "Download File", rails_blob_path(@resource.file, disposition: "attachment"), class: "btn btn-primary" %>
            <% end %>
            <%= link_to "Back to Library", resources_root_path, class: "btn btn-secondary" %>
          </div>
        </main>

        <aside class="space-y-3">
          <div class="rounded-lg bg-white/60 p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-faith-muted">Category</p>
            <p class="mt-1 font-bold text-faith-dark"><%= @resource.resource_category.name %></p>
          </div>
          <div class="rounded-lg bg-white/60 p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-faith-muted">Stats</p>
            <p class="mt-1 text-sm font-semibold text-faith-muted"><%= pluralize(@resource.views_count, "view") %></p>
            <p class="text-sm font-semibold text-faith-muted"><%= pluralize(@resource.downloads_count, "download") %></p>
          </div>
          <% if user_signed_in? && (@resource.user == current_user || current_user.admin_or_moderator?) %>
            <div class="rounded-lg bg-white/60 p-4">
              <%= link_to "Edit Resource", edit_resources_item_path(@resource), class: "btn btn-secondary w-full" %>
            </div>
          <% end %>
        </aside>
      </div>
    </article>
  </div>
</div>
