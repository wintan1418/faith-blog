<% content_for(:title) { "Submit Resource - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-8">
      <span class="mystic-kicker">Library</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Submit Resource</h1>
      <p class="mystic-copy mt-2">Share something useful with the community. It will be reviewed before publishing.</p>
    </div>

    <div class="mystic-panel-strong p-6">
      <%= render "form", resource: @resource, categories: @categories %>
    </div>
  </div>
</div>
