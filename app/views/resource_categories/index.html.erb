<% content_for(:title) { "Resource Categories - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container py-8 sm:py-10">
      <span class="mystic-kicker">Library</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Resource Categories</h1>
      <p class="mystic-copy mt-2 max-w-2xl">Browse resources by topic.</p>
    </div>
  </section>

  <div class="mystic-container py-8">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @categories.each do |category| %>
        <%= link_to resource_category_path(category), class: "mystic-card-link mystic-panel p-5" do %>
          <h2 class="text-xl font-bold text-faith-dark"><%= category.name %></h2>
          <% if category.description.present? %>
            <p class="mystic-copy mt-2 line-clamp-3 text-sm"><%= category.description %></p>
          <% end %>
          <p class="mt-4 text-sm font-semibold text-faith-muted"><%= pluralize(category.resources.approved.count, "resource") %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
