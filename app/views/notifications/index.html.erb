<% content_for(:title) { "Notifications - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="mystic-kicker">Notifications</span>
        <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Updates</h1>
      </div>
      <% if @notifications.any? { |n| n.unread? } %>
        <%= button_to "Mark all as read", mark_all_read_notifications_path, class: "btn btn-secondary" %>
      <% end %>
    </div>

    <% if @notifications.any? %>
      <div class="mystic-panel overflow-hidden">
        <div class="divide-y divide-faith-green/10">
          <% @notifications.each do |notification| %>
            <div class="flex items-start gap-4 p-5 <%= notification.unread? ? 'bg-white/45' : '' %>">
              <% if notification.actor %>
                <% if notification.actor.profile.avatar.attached? %>
                  <%= image_tag notification.actor.profile.avatar, class: "mystic-avatar h-10 w-10 shrink-0 object-cover" %>
                <% else %>
                  <span class="mystic-avatar mystic-avatar-fallback grid h-10 w-10 shrink-0 place-items-center text-sm font-bold">
                    <%= notification.actor.username.first.upcase %>
                  </span>
                <% end %>
              <% else %>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/75 text-faith-green">
                  <%= render_icon("sparkles", classes: "w-5 h-5") %>
                </span>
              <% end %>

              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold leading-6 text-faith-dark"><%= notification.message %></p>
                <p class="mt-1 text-xs font-semibold text-faith-muted"><%= time_ago_in_words(notification.created_at) %> ago</p>
              </div>

              <% if notification.unread? %>
                <%= button_to mark_read_notification_path(notification), class: "mt-1 rounded-full p-2 text-faith-green hover:bg-white/75", data: { turbo_frame: "_top" }, title: "Mark as read" do %>
                  <span class="block h-2.5 w-2.5 rounded-full bg-faith-green"></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-8">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="mystic-panel p-12 text-center">
        <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-white/75 text-faith-green">
          <%= render_icon("sparkles", classes: "w-8 h-8") %>
        </div>
        <h2 class="text-xl font-bold text-faith-dark">No notifications</h2>
        <p class="mystic-copy mt-2">You are all caught up.</p>
      </div>
    <% end %>
  </div>
</div>
