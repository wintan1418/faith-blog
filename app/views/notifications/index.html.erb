<% content_for(:title) { "Notifications · Brethreign" } %>

<%
  # One emoji per notification type — a fast visual scent for each row.
  type_badge = ->(n) {
    case n.notification_type.to_sym
    when :new_comment              then "💬"
    when :comment_reply            then "↩️"
    when :post_liked, :comment_liked then "❤️"
    when :new_follower             then "👤"
    when :direct_message           then "✉️"
    when :prayer_joined            then "🙏"
    when :prayer_answered          then "🌟"
    when :mentioned, :everyone_mention then "📣"
    when :post_reshared            then "🔁"
    when :post_featured            then "⭐"
    when :breath_from_followee     then "🌿"
    when :connection_request, :connection_accepted then "🤝"
    when :post_moderation_approved then "✅"
    when :post_held_for_review, :post_blocked then "🛡️"
    when :resource_approved, :resource_rejected then "📚"
    else "✦"
    end
  }

  groups = @notifications.group_by do |n|
    if n.created_at >= Time.current.beginning_of_day       then "Today"
    elsif n.created_at >= 1.day.ago.beginning_of_day       then "Yesterday"
    elsif n.created_at >= 7.days.ago.beginning_of_day      then "This week"
    else "Earlier"
    end
  end
  unread_count = @notifications.count(&:unread?)
%>

<div class="fc-page">
  <div class="fc-notifpage">
    <header class="fc-notifpage-head">
      <div>
        <span class="fc-page-kicker">✦ Notifications</span>
        <h1 class="fc-notifpage-title">Updates</h1>
        <% if unread_count.positive? %>
          <p class="fc-notifpage-sub"><%= pluralize(unread_count, "new update") %> waiting for you.</p>
        <% else %>
          <p class="fc-notifpage-sub">You're all caught up. 🕊️</p>
        <% end %>
      </div>
      <% if unread_count.positive? %>
        <%= button_to "Mark all read", mark_all_read_notifications_path, class: "fc-btn" %>
      <% end %>
    </header>

    <% if @notifications.any? %>
      <% ["Today", "Yesterday", "This week", "Earlier"].each do |label| %>
        <% rows = groups[label] %>
        <% next unless rows %>
        <section class="fc-notifpage-group">
          <h2 class="fc-notifpage-daylabel"><%= label %></h2>
          <div class="fc-notifpage-card">
            <% rows.each do |notification| %>
              <%= link_to visit_notification_path(notification),
                          class: "fc-notifrow#{' is-unread' if notification.unread?}" do %>
                <span class="fc-notifrow-avatar">
                  <% if notification.actor %>
                    <% if notification.actor.profile&.avatar&.attached? %>
                      <%= image_tag notification.actor.profile.avatar, class: "fc-avatar object-cover", alt: notification.actor.username %>
                    <% else %>
                      <span class="fc-avatar" style="<%= avatar_tint_style(notification.actor.username) %>"><%= notification.actor.username.first.upcase %></span>
                    <% end %>
                  <% else %>
                    <span class="fc-avatar"><%= render_icon("sparkles", classes: "h-4 w-4") %></span>
                  <% end %>
                  <span class="fc-notifrow-badge"><%= type_badge.call(notification) %></span>
                </span>

                <span class="fc-notifrow-body">
                  <span class="fc-notifrow-text"><%= notification.message %></span>
                  <span class="fc-notifrow-time"><%= time_ago_in_words(notification.created_at) %> ago</span>
                </span>

                <% if notification.unread? %>
                  <span class="fc-notifrow-dot" aria-label="Unread"></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="mt-8">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="fc-empty">
        <div class="fc-empty-mark" aria-hidden="true">
          <%= render_icon("sparkles", classes: "h-7 w-7") %>
        </div>
        <h2 class="fc-empty-title">Nothing here yet.</h2>
        <p class="fc-empty-text">When someone reacts, comments, follows, or prays with you, it lands here.</p>
      </div>
    <% end %>
  </div>
</div>
