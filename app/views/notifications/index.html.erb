<% content_for(:title) { "Notifications · Brethreign" } %>
<%# Never show a saved copy: going back after opening an alert must show it read. %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>

<%
  groups = @notifications.group_by do |n|
    if n.created_at >= Time.current.beginning_of_day       then "Today"
    elsif n.created_at >= 1.day.ago.beginning_of_day       then "Yesterday"
    elsif n.created_at >= 7.days.ago.beginning_of_day      then "This week"
    else "Earlier"
    end
  end
  unread_count = @notifications.count(&:unread?)
%>

<div class="fc-page">
  <div class="fc-notifpage" data-controller="notifications-page">
    <header class="fc-notifpage-head">
      <div>
        <span class="fc-page-kicker"><%= render_icon("bell", classes: "h-4 w-4") %> Notifications</span>
        <h1 class="fc-notifpage-title">Alerts</h1>
        <% if unread_count.positive? %>
          <p class="fc-notifpage-sub" data-notifications-page-target="sub"><%= pluralize(unread_count, "new update") %> waiting for you.</p>
        <% else %>
          <p class="fc-notifpage-sub" data-notifications-page-target="sub">You're all caught up.</p>
        <% end %>
      </div>
      <% if unread_count.positive? %>
        <%= button_to mark_all_read_notifications_path, class: "fc-notifpage-markall", form_class: "fc-notifpage-markall-form",
                      form: { data: { notifications_page_target: "markAll", action: "submit->notifications-page#markAll" } } do %>
          <%= render_icon("check", classes: "h-4 w-4") %><span>Mark all read</span>
        <% end %>
      <% end %>
    </header>

    <% if @notifications.any? %>
      <% ["Today", "Yesterday", "This week", "Earlier"].each do |label| %>
        <% rows = groups[label] %>
        <% next unless rows %>
        <section class="fc-notifpage-group">
          <h2 class="fc-notifpage-daylabel"><%= label %></h2>
          <div class="fc-notifpage-card">
            <% rows.each do |notification| %>
              <%= link_to visit_notification_path(notification),
                          class: "fc-notifrow#{' is-unread' if notification.unread?}",
                          data: { notifications_page_target: "row", action: "notifications-page#open" } do %>
                <span class="fc-notifrow-avatar">
                  <% if notification.actor %>
                    <% if notification.actor.profile&.avatar&.attached? %>
                      <%= image_tag avatar_src(notification.actor.profile), class: "fc-avatar object-cover", alt: notification.actor.username %>
                    <% else %>
                      <span class="fc-avatar" style="<%= avatar_tint_style(notification.actor.username) %>"><%= notification.actor.username.first.upcase %></span>
                    <% end %>
                  <% else %>
                    <span class="fc-avatar"><%= render_icon("sparkles", classes: "h-4 w-4") %></span>
                  <% end %>
                  <span class="fc-notifrow-badge is-<%= notification.web_icon %>"><%= render_icon(notification.web_icon, classes: "h-3 w-3") %></span>
                </span>

                <span class="fc-notifrow-body">
                  <span class="fc-notifrow-text"><%= notification.web_message %></span>
                  <span class="fc-notifrow-time"><%= time_ago_in_words(notification.created_at) %> ago</span>
                </span>

                <% if notification.unread? %>
                  <span class="fc-notifrow-dot" aria-label="Unread"></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="mt-8">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="fc-empty">
        <div class="fc-empty-mark" aria-hidden="true">
          <%= render_icon("bell", classes: "h-7 w-7") %>
        </div>
        <h2 class="fc-empty-title">Nothing here yet.</h2>
        <p class="fc-empty-text">When someone reacts, comments, follows, or prays with you, it lands here.</p>
      </div>
    <% end %>
  </div>
</div>
