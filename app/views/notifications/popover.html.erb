<%= turbo_frame_tag "notifications_panel" do %>
  <div class="fc-notif-popover">
    <header class="fc-notif-head">
      <h2>Notifications</h2>
      <% if @notifications.any? { |n| n.unread? } %>
        <%= button_to "Mark all read", mark_all_read_notifications_path,
            method: :post,
            form_class: "inline",
            class: "fc-notif-mark-all",
            data: { turbo_frame: "notifications_panel" } %>
      <% end %>
    </header>
    <%= render "notifications/list", notifications: @notifications %>
    <footer class="fc-notif-foot">
      <%= link_to "Open notifications page", notifications_path, class: "fc-notif-foot-link" %>
    </footer>
  </div>
<% end %>
