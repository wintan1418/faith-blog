<%# The "Share what I read" form (DailyBibleController#new_share): what
    stood out, a key verse, today's prayer burden and my notes (each only if
    chosen), then "Post to feed" or a status image. Locals: chapter, prayer
    (ChapterPrayer::Shown), passage, note (ChapterNote or nil), habit. %>
<% suggested, all_verses = daily_bible_share_verses(chapter, prayer, passage) %>
<% first = suggested.first || all_verses.first %>
<turbo-frame id="reading_share_form_<%= chapter.slug %>">
  <%= form_with url: daily_bible_share_path, method: :post, class: "db-share-form",
        data: { turbo_frame: "_top", reading_share_target: "form",
                chapter: chapter.to_s, link: scripture_page_url(chapter.slug),
                link_label: "#{request.host.delete_prefix('www.')}/scripture/#{chapter.slug}",
                streak: habit.streak, name: current_user.display_name } do %>
    <%= hidden_field_tag :chapter, chapter.slug %>

    <label class="db-field">
      <span class="db-label">What stood out to me</span>
      <%= text_area_tag :note, nil, rows: 3, maxlength: ReadingShare::NOTE_MAX, class: "db-textarea",
            placeholder: "A line that stayed with you, a question, a word for someone…",
            data: { reading_share_target: "note" } %>
    </label>

    <% if all_verses.any? %>
      <label class="db-field">
        <span class="db-label">Key verse</span>
        <select name="verse" class="db-select" data-reading-share-target="verse" data-action="reading-share#pickVerse">
          <option value="" data-text="">No verse</option>
          <% if suggested.any? %>
            <optgroup label="Suggested">
              <% suggested.each do |label, slug, text| %>
                <option value="<%= slug %>" data-text="<%= text %>" data-label="<%= label %>" <%= "selected" if slug == first[1] %>><%= label %> · <%= truncate(text, length: 48, separator: " ") %></option>
              <% end %>
            </optgroup>
          <% end %>
          <optgroup label="Every verse">
            <% all_verses.each do |number, slug, text| %>
              <option value="<%= slug %>" data-text="<%= text %>" data-label="<%= chapter.book.ref_name %> <%= chapter.chapter %>:<%= number %>" <%= "selected" if suggested.empty? && slug == first[1] %>><%= number %> · <%= truncate(text, length: 52, separator: " ") %></option>
            <% end %>
          </optgroup>
        </select>
        <span class="db-verse-preview" data-reading-share-target="versePreview">“<%= first[2] %>”</span>
      </label>
    <% end %>

    <% if prayer.burden.present? && prayer.current? %>
      <label class="db-check">
        <%= check_box_tag :include_burden, "1", true, data: { reading_share_target: "burden", text: prayer.burden } %>
        <span><strong>Include today's prayer burden</strong><small><%= prayer.burden %></small></span>
      </label>
    <% end %>

    <% if note %>
      <label class="db-check">
        <%= check_box_tag :include_notes, "1", false, data: { reading_share_target: "notes", text: note.body.truncate(ReadingShare::NOTES_MAX, separator: " ") } %>
        <span><strong>Include my notes</strong><small><%= note.body.truncate(160, separator: " ") %></small></span>
      </label>
    <% else %>
      <p class="db-share-hint">Your notes on <%= chapter %> stay private. Write some under “My notes” on the chapter page and you can choose to include them here.</p>
    <% end %>

    <div class="db-actions">
      <button type="button" class="db-btn db-btn-quiet" data-action="reading-share#image" data-testid="reading-status-image">
        <%= render_icon("image", classes: "db-i16") %> Status image
      </button>
      <%= button_tag type: "submit", class: "db-btn db-btn-primary", data: { testid: "reading-share-post" } do %>
        <%= render_icon("send", classes: "db-i16") %> Post to feed
      <% end %>
    </div>
  <% end %>
</turbo-frame>
