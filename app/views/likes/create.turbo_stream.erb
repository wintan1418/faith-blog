<% if @likeable.is_a?(Post) %>
  <%= turbo_stream.replace dom_id(@likeable, :reactions) do %>
    <%= render "posts/reactions", post: @likeable %>
  <% end %>
  <%= turbo_stream.replace dom_id(@likeable, :reaction_summary) do %>
    <%= render "posts/reaction_summary", post: @likeable %>
  <% end %>
<% elsif @likeable.is_a?(Comment) %>
  <%= turbo_stream.replace dom_id(@likeable, :reactions) do %>
    <%= render "comments/reaction", comment: @likeable %>
  <% end %>
<% elsif @likeable.is_a?(Message) %>
  <%= turbo_stream.replace dom_id(@likeable) do %>
    <%= render "conversations/message", message: @likeable, viewer_id: current_user.id %>
  <% end %>
<% end %>
