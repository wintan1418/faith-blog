<div style="display: none; visibility: hidden; opacity: 0; color: transparent; height: 0; width: 0; max-height: 0; max-width: 0; overflow: hidden;"><%= WelcomeNote.preheader %></div>

<div style="font-family: Inter, Arial, sans-serif; color: #17251d; line-height: 1.65; max-width: 600px; margin: 0 auto; padding: 12px; font-size: 15.5px;">
  <p style="margin: 0 0 6px; color: #6c7c72; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 800;">Brethreign</p>
  <h1 style="font-family: 'Fraunces', Georgia, serif; font-size: 28px; line-height: 1.2; margin: 0 0 18px; color: #17251d;">Welcome home, <%= @user.username %></h1>

  <p style="margin: 0 0 14px;">Dear <%= @user.username %>,</p>
  <p style="margin: 0 0 14px;"><%= WelcomeNote.opening(existing: @existing) %></p>
  <p style="margin: 0 0 18px;"><%= WelcomeNote.paragraphs.first %></p>

  <blockquote style="margin: 0 0 18px; padding: 12px 16px; border-left: 3px solid #10b981; background: #f1f8f4; font-family: Georgia, serif; font-style: italic; color: #2b3a30;">
    &ldquo;<%= WelcomeNote::PSALM[0] %>&rdquo; <span style="font-style: normal; color: #6c7c72;">(<%= WelcomeNote::PSALM[1] %>)</span>
  </blockquote>

  <p style="margin: 0 0 18px;"><%= WelcomeNote.paragraphs.last %></p>

  <p style="margin: 0 0 8px; font-weight: 800;">A few first steps, whenever you're ready:</p>
  <ul style="margin: 0 0 18px; padding-left: 20px;">
    <% WelcomeNote::STEPS.each do |lead, rest| %>
      <li style="margin: 0 0 6px;"><strong><%= lead %></strong> <%= rest %></li>
    <% end %>
  </ul>

  <p style="margin: 0 0 18px;"><%= WelcomeNote.safety %></p>

  <blockquote style="margin: 0 0 18px; padding: 12px 16px; border-left: 3px solid #10b981; background: #f1f8f4; font-family: Georgia, serif; font-style: italic; color: #2b3a30;">
    &ldquo;<%= WelcomeNote::HEBREWS[0] %>&rdquo; <span style="font-style: normal; color: #6c7c72;">(<%= WelcomeNote::HEBREWS[1] %>)</span>
  </blockquote>

  <p style="margin: 0 0 18px;"><%= WelcomeNote.closing %></p>
  <p style="margin: 0 0 22px;"><%= safe_join(WelcomeNote::SIGN_OFF, tag.br) %></p>

  <p style="margin: 0 0 12px;">
    <%= link_to "Take your first breath →", @feed_url, style: "display: inline-block; background: #10b981; color: #052016; font-weight: 800; padding: 12px 18px; border-radius: 10px; text-decoration: none;" %>
  </p>

  <hr style="border: none; border-top: 1px solid #e6ece8; margin: 28px 0 16px;">
  <p style="margin: 0; color: #6c7c72; font-size: 12px;">
    Sent to <strong><%= @user.email %></strong> because you have a Brethreign account.
    <%= link_to "Unsubscribe from these emails", @unsubscribe_url, style: "color: #6c7c72;" %>
  </p>
</div>
