<div style="display: none; visibility: hidden; opacity: 0; color: transparent; height: 0; width: 0; max-height: 0; max-width: 0; overflow: hidden;"><%= WelcomeNote.preheader %></div>

<div style="max-width: 560px; margin: 0 auto; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #17251d; line-height: 1.65; font-size: 15.5px;">
  <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: 28px; line-height: 1.2; margin: 4px 0 16px; color: #17251d; font-weight: 700;">Welcome home, <%= @user.username %></h1>

  <p style="margin: 0 0 14px;"><%= WelcomeNote.opening(existing: @existing) %> <%= WelcomeNote.intro %></p>

  <p style="margin: 0 0 20px; padding: 12px 16px; border-left: 3px solid #0e5c43; background: #f5f1e8; border-radius: 0 10px 10px 0; font-family: Georgia, serif; font-style: italic; color: #2b3a30;">
    &ldquo;<%= WelcomeNote::PSALM[0] %>&rdquo; <span style="font-style: normal; color: #5e6862;">(<%= WelcomeNote::PSALM[1] %>)</span>
  </p>

  <p style="margin: 0 0 10px; font-weight: 800;">Three first steps, whenever you're ready:</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 20px; border-collapse: separate; border-spacing: 0 8px;">
    <% WelcomeNote::STEPS.each_with_index do |(key, title, line), i| %>
      <tr>
        <td style="width: 34px; vertical-align: top; padding: 12px 0 12px 12px; background: #f5f1e8; border-radius: 12px 0 0 12px;">
          <span style="display: inline-block; width: 24px; height: 24px; line-height: 24px; text-align: center; border-radius: 999px; background: #0e5c43; color: #ffffff; font-weight: 800; font-size: 13px;"><%= i + 1 %></span>
        </td>
        <td style="vertical-align: top; padding: 12px 14px 12px 8px; background: #f5f1e8; border-radius: 0 12px 12px 0;">
          <a href="<%= @step_urls[key] %>" style="color: #0e5c43; font-weight: 800; text-decoration: none;"><%= title %> &rarr;</a><br>
          <span style="color: #3b4741; font-size: 14px;"><%= line %></span>
        </td>
      </tr>
    <% end %>
  </table>

  <% if @ios_url || @android_url %>
    <p style="margin: 0 0 8px; font-weight: 800;">Brethreign on your phone</p>
    <p style="margin: 0 0 20px;">
      <% if @ios_url %><a href="<%= @ios_url %>" style="display: inline-block; margin: 0 8px 8px 0; padding: 9px 16px; border-radius: 999px; background: #17251d; color: #ffffff; font-weight: 700; font-size: 14px; text-decoration: none;">Download on the App Store</a><% end %>
      <% if @android_url %><a href="<%= @android_url %>" style="display: inline-block; margin: 0 8px 8px 0; padding: 9px 16px; border-radius: 999px; background: #17251d; color: #ffffff; font-weight: 700; font-size: 14px; text-decoration: none;">Get it on Google Play</a><% end %>
    </p>
  <% end %>

  <p style="margin: 0 0 18px;"><%= WelcomeNote.closing %></p>
  <p style="margin: 0 0 22px;"><%= safe_join(WelcomeNote::SIGN_OFF, tag.br) %></p>

  <p style="margin: 0 0 8px;">
    <%= link_to "Take your first breath →", @feed_url, style: "display: inline-block; background: #0e5c43; color: #ffffff; font-weight: 800; padding: 12px 20px; border-radius: 999px; text-decoration: none;" %>
  </p>

  <p style="margin: 24px 0 0; color: #5e6862; font-size: 12px;">
    Sent to <strong><%= @user.email %></strong> because you have a Brethreign account.
    <%= link_to "Unsubscribe from these emails", @unsubscribe_url, style: "color: #5e6862;" %>
  </p>
</div>
