<%#
  Locals:
    comment — the Comment to render
    post    — the Post the comment belongs to
%>
<% if comment.held_for_review? && !comment.visible_to?(current_user) %>
  <li class="fc-inline-comment fc-inline-comment-held" id="<%= dom_id(comment) %>">
    <span class="fc-avatar"><%= render_icon("shield", classes: "h-4 w-4") %></span>
    <div class="fc-inline-comment-body">
      <p class="fc-inline-comment-text fc-inline-comment-text--muted">
        This reply is held for moderator review.
      </p>
    </div>
  </li>
<% else %>
  <li class="fc-inline-comment<%= ' fc-inline-comment-held-author' if comment.held_for_review? %>"
      id="<%= dom_id(comment) %>"
      data-controller="reply-toggle comment-edit">
    <% if comment.user.profile&.avatar&.attached? %>
      <%= image_tag comment.user.profile.avatar, class: "fc-avatar object-cover" %>
    <% else %>
      <span class="fc-avatar" style="<%= avatar_tint_style(comment.user.username) %>"><%= comment.user.username.first.upcase %></span>
    <% end %>
    <div class="fc-inline-comment-body">
      <div class="fc-inline-comment-head">
        <%= link_to comment.user.username, user_path(comment.user.username), class: "fc-breath-name" %>
        <span class="fc-breath-time">· <%= time_ago_in_words(comment.created_at) %> ago</span>
        <% if comment.edited? %><span class="fc-breath-time">(edited)</span><% end %>
        <% if comment.held_for_review? %>
          <span class="fc-inline-comment-flag" title="Held for moderator review">⏳ held</span>
        <% end %>
      </div>
      <div class="fc-inline-comment-text" data-comment-edit-target="display"><%= comment.content %></div>

      <% if user_signed_in? && (comment.user == current_user || current_user.admin_or_moderator?) %>
        <%= form_with model: [ post, comment ], method: :patch, local: true,
                      class: "fc-inline-comment-editform hidden",
                      data: { comment_edit_target: "form", turbo_frame: dom_id(post, :thread) } do |f| %>
          <%= f.text_area :content,
              value: comment.content.to_plain_text,
              class: "fc-inline-reply-input",
              rows: 2,
              autocomplete: "off",
              autocapitalize: "sentences",
              spellcheck: true,
              data: { comment_edit_target: "textarea", form_type: "edit" } %>
          <div class="fc-inline-reply-actions">
            <div class="fc-inline-reply-tools">
              <button type="button" class="fc-btn" data-action="click->comment-edit#cancel">Cancel</button>
            </div>
            <%= f.submit "Save", class: "fc-btn fc-btn-primary fc-inline-reply-submit" %>
          </div>
        <% end %>
      <% end %>

      <% if user_signed_in? && post.allow_comments? %>
        <div class="fc-inline-comment-actions">
          <% if comment.depth < 2 %>
            <button type="button"
                    class="fc-inline-comment-replybtn"
                    data-action="click->reply-toggle#toggle">
              <%= render_icon("message_circle", classes: "h-3.5 w-3.5") %>
              <span>Reply</span>
            </button>
          <% end %>

          <% if comment.user == current_user || current_user.admin_or_moderator? %>
            <div class="fc-inline-comment-overflow" data-controller="dropdown">
              <button type="button"
                      class="fc-inline-comment-overflow-btn"
                      data-action="click->dropdown#toggle"
                      aria-label="More actions"
                      aria-haspopup="true">⋯</button>
              <div data-dropdown-target="menu" class="fc-inline-comment-overflow-menu hidden" role="menu">
                <button type="button"
                        data-action="click->comment-edit#edit click->dropdown#close"
                        class="fc-inline-comment-overflow-item">
                  <%= render_icon("edit", classes: "h-3.5 w-3.5") %>
                  Edit
                </button>
                <%= button_to post_comment_path(post, comment),
                    method: :delete,
                    form_class: "fc-inline-comment-overflow-form",
                    class: "fc-inline-comment-overflow-item fc-inline-comment-overflow-danger",
                    data: { turbo_confirm: "Delete this reply?", turbo_frame: dom_id(post, :thread) } do %>
                  <%= render_icon("trash", classes: "h-3.5 w-3.5") %>
                  Delete
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="fc-inline-comment-replyform hidden" data-reply-toggle-target="form">
          <%= form_with url: reply_post_comment_path(post, comment),
              scope: :comment,
              class: "fc-inline-reply is-nested",
              data: { turbo_frame: dom_id(post, :thread) } do |f| %>
            <% if current_user.profile&.avatar&.attached? %>
              <%= image_tag current_user.profile.avatar, class: "fc-avatar object-cover" %>
            <% else %>
              <span class="fc-avatar" style="<%= avatar_tint_style(current_user.username) %>"><%= current_user.username.first.upcase %></span>
            <% end %>
            <div class="fc-inline-reply-body">
              <%= f.text_area :content,
                  class: "fc-inline-reply-input",
                  rows: 2,
                  placeholder: "Reply to @#{comment.user.username}…",
                  autocomplete: "off",
                  autocapitalize: "sentences",
                  spellcheck: true,
                  data: { form_type: "reply" } %>
              <div class="fc-inline-reply-actions">
                <div class="fc-inline-reply-tools">
                  <button type="button"
                          class="fc-composer-icon-btn"
                          title="Open Bible"
                          aria-label="Open Bible"
                          data-action="click->bible-drawer#open">
                    <%= render_icon("bookopen", classes: "h-4 w-4") %>
                  </button>
                </div>
                <%= f.submit "Reply", class: "fc-btn fc-btn-primary fc-inline-reply-submit" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%
        replies = comment.replies.active.oldest_first.limit(3)
        more_replies = comment.replies.active.count - replies.size
      %>
      <% if replies.any? %>
        <ul class="fc-inline-comment-replies">
          <% replies.each do |reply| %>
            <%= render "posts/inline_comment", comment: reply, post: post %>
          <% end %>
          <% if more_replies > 0 %>
            <li class="fc-inline-comment-more">
              <%= link_to "View all #{pluralize(more_replies, 'more reply')} →",
                  post_path(post, anchor: dom_id(comment)),
                  class: "fc-inline-thread-more",
                  data: { turbo_frame: "_top" } %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </li>
<% end %>
