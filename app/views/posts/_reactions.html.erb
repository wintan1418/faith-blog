<%# "Like" segment of the action bar. A tap Loves the breath (tap again to take
    it back); hold or right-click for the other reactions. When you've reacted
    it fills the heart and highlights (which reaction you chose shows in the
    summary row above, and on data-reaction). Count lives in the meta row above.
    Local: post %>
<%
  loaded_likes = (post.likes.loaded? ? post.likes : post.likes.includes(:user)).to_a
  user_like    = user_signed_in? ? loaded_likes.find { |l| l.user_id == current_user.id } : nil
%>
<div class="fc-reactions" id="<%= dom_id(post, :reactions) %>" data-controller="emoji-reactions"
     data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Post", likeable_id: post.id) %>"
     data-emoji-reactions-unlike-url-value="<%= unlike_path(likeable_type: "Post", likeable_id: post.id) %>"
     data-emoji-reactions-mine-value="<%= user_like.present? %>"
     data-emoji-reactions-token-value="<%= form_authenticity_token %>">
  <% if user_signed_in? %>
    <button type="button"
            class="fc-breath-action fc-react-btn<%= ' is-mine' if user_like %>"
            data-reaction="<%= user_like&.display_emoji %>"
            data-action="pointerdown->emoji-reactions#holdStart pointerup->emoji-reactions#cancelHold pointerleave->emoji-reactions#cancelHold pointercancel->emoji-reactions#cancelHold click->emoji-reactions#press contextmenu->emoji-reactions#more"
            aria-label="<%= user_like ? "Remove your reaction" : "Love this breath" %>"
            aria-description="Hold for more reactions"
            title="<%= user_like ? "Remove your reaction (hold for more)" : "Love (hold for more reactions)" %>">
      <%= render_icon("heart", classes: "eg-i22") %>
      <span class="fc-react-label"><%= user_like ? "Liked" : "Like" %></span>
    </button>
    <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
      <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
    </div>
  <% else %>
    <%= link_to new_user_session_path, class: "fc-breath-action fc-react-btn", title: "Like" do %>
      <%= render_icon("heart", classes: "eg-i22") %>
      <span class="fc-react-label">Like</span>
    <% end %>
  <% end %>
</div>
