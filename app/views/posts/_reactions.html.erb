<%# React button — one clean segment in the action bar (LinkedIn "Like" / X
    like). Tap to open the emoji picker; your current reaction shows on the
    button and as a pill in the summary strip above (tap the pill to remove).
    Local: post %>
<%
  loaded_likes = (post.likes.loaded? ? post.likes : post.likes.includes(:user)).to_a
  user_like    = user_signed_in? ? loaded_likes.find { |l| l.user_id == current_user.id } : nil
%>
<div class="fc-reactions" id="<%= dom_id(post, :reactions) %>" data-controller="emoji-reactions"
     data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Post", likeable_id: post.id) %>"
     data-emoji-reactions-token-value="<%= form_authenticity_token %>">
  <% if user_signed_in? %>
    <button type="button"
            class="fc-breath-action fc-react-btn<%= ' is-mine' if user_like %>"
            data-action="click->emoji-reactions#toggle"
            aria-label="React to this breath"
            title="React">
      <span class="fc-react-emoji"><%= user_like&.display_emoji || "🙏" %></span>
      <span class="fc-react-label">React</span>
    </button>
    <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
      <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
    </div>
  <% else %>
    <%= link_to new_user_session_path, class: "fc-breath-action fc-react-btn", title: "React" do %>
      <span class="fc-react-emoji">🙏</span>
      <span class="fc-react-label">React</span>
    <% end %>
  <% end %>
</div>
