<% user_like = user_signed_in? ? current_user.likes.find_by(likeable: post) : nil %>
<% reactions = Like.reaction_types.keys %>

<div class="reaction-rail" id="<%= dom_id(post, :reactions) %>">
  <% if user_signed_in? %>
    <% reactions.each do |reaction| %>
      <% active = user_like&.reaction_type == reaction %>
      <% count = post.likes.where(reaction_type: reaction).count %>
      <% if active %>
        <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
            method: :delete,
            class: "reaction-chip is-active",
            title: "Remove #{Like.reaction_label(reaction)}" do %>
          <span class="reaction-chip-emoji"><%= Like.reaction_emoji(reaction) %></span>
          <span class="reaction-chip-label"><%= Like.reaction_label(reaction) %></span>
          <% if count.positive? %>
            <span class="reaction-chip-count"><%= count %></span>
          <% end %>
        <% end %>
      <% else %>
        <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_type: reaction),
            class: "reaction-chip",
            title: Like.reaction_label(reaction) do %>
          <span class="reaction-chip-emoji"><%= Like.reaction_emoji(reaction) %></span>
          <span class="reaction-chip-label"><%= Like.reaction_label(reaction) %></span>
          <% if count.positive? %>
            <span class="reaction-chip-count"><%= count %></span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, class: "reaction-chip" do %>
      <span class="reaction-chip-emoji">🙏</span>
      <span class="reaction-chip-label">React</span>
      <% if post.likes_count.positive? %>
        <span class="reaction-chip-count"><%= post.likes_count %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
