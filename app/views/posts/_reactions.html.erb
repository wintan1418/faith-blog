<%
  user_like = user_signed_in? ? current_user.likes.find_by(likeable: post) : nil
  emoji_counts = post.likes
                     .group(:reaction_emoji)
                     .order(Arel.sql("COUNT(*) DESC"))
                     .limit(4)
                     .count
  total = post.likes_count.to_i
%>

<div class="fc-reactions" id="<%= dom_id(post, :reactions) %>" data-controller="emoji-reactions">
  <% emoji_counts.each do |emoji, count| %>
    <% next if emoji.blank? %>
    <% mine = user_like&.display_emoji == emoji %>
    <% if mine %>
      <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
          method: :delete,
          form_class: "inline",
          class: "fc-reaction-pill is-mine",
          title: "Remove your reaction" do %>
        <span class="fc-reaction-emoji"><%= emoji %></span>
        <span class="fc-reaction-count"><%= count %></span>
      <% end %>
    <% else %>
      <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_emoji: emoji),
          form_class: "inline",
          class: "fc-reaction-pill" do %>
        <span class="fc-reaction-emoji"><%= emoji %></span>
        <span class="fc-reaction-count"><%= count %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if user_signed_in? %>
    <button type="button"
            class="fc-reaction-add"
            data-action="click->emoji-reactions#toggle"
            aria-label="Add a reaction"
            title="Add a reaction">
      <%= render_icon("smile", classes: "h-4 w-4") %>
      <% if emoji_counts.empty? %>
        <span class="fc-reaction-add-label">React</span>
      <% end %>
    </button>

    <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker"
         data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Post", likeable_id: post.id) %>"
         data-emoji-reactions-token-value="<%= form_authenticity_token %>">
      <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
    </div>
  <% else %>
    <%= link_to "React", new_user_session_path, class: "fc-reaction-add" %>
  <% end %>

  <% if total.positive? && emoji_counts.empty? %>
    <span class="fc-reaction-summary"><%= total %></span>
  <% end %>
</div>
