<%# Share menu trigger for a single breath. Local: post
    Links carry ?ref=<the sharer> (ShareReferral) so a newcomer who joins
    through them is credited to whoever shared. The image sheet's data is
    fetched only when it opens (ShareCardsController). %>
<%
  sharer    = user_signed_in? ? current_user : nil
  share_url = post_url(post, ref: ShareReferral.ref_for(sharer, post))
  snippet   = truncate(post.content.to_plain_text.to_s.strip, length: 1500, separator: " ")
  author    = post.anonymous? ? "anonymous" : post.user.username
  imageable = post.visible_to?(nil)
%>
<div class="fc-share" data-controller="share"
     data-share-url-value="<%= share_url %>"
     data-share-title-value="<%= post.title %>"
     data-share-author-value="<%= author %>"
     data-share-snippet-value="<%= snippet %>"
     data-share-card-url-value="<%= post_share_card_path(post) if imageable %>">
  <button type="button"
          class="fc-breath-action"
          data-action="click->share#toggle"
          aria-label="Share this breath"
          title="Share">
    <%= render_icon("send", classes: "eg-i22") %>
    <span class="fc-action-label">Share</span>
  </button>

  <div data-share-target="menu" class="fc-share-menu hidden" role="menu">
    <button type="button" data-action="click->share#nativeShare" role="menuitem" class="hidden" data-share-target="nativeItem">Share to WhatsApp, X, more…</button>
    <button type="button" data-action="click->share#copyLink" role="menuitem">Copy link</button>
    <button type="button" data-action="click->share#whatsapp" role="menuitem" data-share-target="webItem">Send to WhatsApp</button>
    <button type="button" data-action="click->share#twitter"  role="menuitem" data-share-target="webItem">Share on X</button>
    <button type="button" data-action="click->share#linkedin" role="menuitem" data-share-target="webItem">Share on LinkedIn</button>
    <button type="button" data-action="click->share#email"    role="menuitem" data-share-target="webItem">Email</button>
    <% if imageable %>
      <hr class="fc-share-divider">
      <button type="button" data-action="click->share#snapshot" role="menuitem" class="fc-share-snap">
        Snapshot for status
      </button>
      <% if post.comments_count.to_i.positive? %>
        <button type="button" data-action="click->share#shareThread" role="menuitem" class="fc-share-snap">
          Share as thread
        </button>
      <% end %>
    <% end %>
  </div>

  <div data-share-target="toast" class="fc-share-toast hidden"></div>
</div>
