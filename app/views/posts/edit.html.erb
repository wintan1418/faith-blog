<% content_for(:title) { "Edit Post - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mystic-panel-strong overflow-hidden">
      <div class="border-b border-faith-green/10 p-6">
        <span class="mystic-kicker">Edit Post</span>
        <h1 class="mt-3 text-3xl font-bold text-faith-dark">Edit Post</h1>
        <p class="mystic-copy mt-1">Make changes to your post.</p>
      </div>

      <div class="p-6">
        <%= render "form", post: @post, rooms: @rooms %>
      </div>
    </div>

    <div class="mt-6 flex justify-end">
      <%= button_to "Delete Post", post_path(@post), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure you want to delete this post? This action cannot be undone." } %>
    </div>
  </div>
</div>

