<span id="<%= dom_id(post, :bookmark) %>">
  <% if user_signed_in? %>
    <% if bookmarked_post?(post) %>
      <%= button_to post_bookmark_path(post), method: :delete, class: "fc-action eg-save is-saved", title: "Remove bookmark", aria: { label: "Remove bookmark" }, data: { turbo_frame: "_top" } do %>
        <%= render_icon("bookmark", classes: "eg-i20") %>
        <span class="fc-action-label">Saved</span>
      <% end %>
    <% else %>
      <%= button_to post_bookmark_path(post), class: "fc-action eg-save", title: "Save post", aria: { label: "Save post" }, data: { turbo_frame: "_top" } do %>
        <%= render_icon("bookmark", classes: "eg-i20") %>
        <span class="fc-action-label">Save</span>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, class: "fc-action eg-save", title: "Save post", aria: { label: "Save post" } do %>
      <%= render_icon("bookmark", classes: "eg-i20") %>
      <span class="fc-action-label">Save</span>
    <% end %>
  <% end %>
</span>
