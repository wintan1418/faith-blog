<% reshared_by = local_assigns[:reshared_by] %>
<% if post.held_for_review? && !post.visible_to?(current_user) %>
  <article class="fc-card fc-card-held" id="<%= dom_id(post) %>">
    <div class="fc-held-placeholder">
      <%= render_icon("shield", classes: "h-5 w-5") %>
      <p>This breath is held for moderator review.</p>
    </div>
  </article>
<% else %>
<article class="fc-breath<%= ' fc-card-held-author' if post.held_for_review? %><%= ' is-prayer' if post.prayer_status_prayer_pending? %><%= ' is-answered' if post.prayer_status_prayer_answered? %>" id="<%= dom_id(post) %>">
  <% if reshared_by %>
    <div class="fc-breath-attribution">
      <%= render_icon("repeat", classes: "h-3.5 w-3.5") %>
      <%= link_to reshared_by.username, user_path(reshared_by.username), class: "fc-breath-attribution-name" %>
      <span>reshared</span>
    </div>
  <% end %>
  <% if post.held_for_review? && current_user == post.user %>
    <div class="fc-held-banner">
      <%= render_icon("shield", classes: "h-4 w-4") %>
      <span>Held for moderator review — only you and moderators can see this right now.</span>
    </div>
  <% end %>

  <div class="fc-breath-grid">
    <div class="fc-breath-avatar">
      <% if post.anonymous? %>
        <span class="fc-avatar"><%= render_icon("users", classes: "h-4 w-4") %></span>
      <% elsif post.user.profile&.avatar&.attached? %>
        <%= link_to user_path(post.user.username) do %>
          <%= image_tag post.user.profile.avatar, class: "fc-avatar object-cover", alt: post.user.username %>
        <% end %>
      <% else %>
        <%= link_to user_path(post.user.username), class: "fc-avatar", style: avatar_tint_style(post.user.username) do %>
          <%= post.user.username.first.upcase %>
        <% end %>
      <% end %>
    </div>

    <div class="fc-breath-main">
      <header class="fc-breath-head">
        <div class="fc-breath-head-author">
          <% if post.anonymous? %>
            <span class="fc-breath-name">Anonymous</span>
          <% else %>
            <%= link_to post.user.username, user_path(post.user.username), class: "fc-breath-name" %>
            <span class="fc-breath-handle">@<%= post.user.username %></span>
          <% end %>
          <span class="fc-breath-dot">·</span>
          <span class="fc-breath-time"><%= time_ago_in_words(post.published_at || post.created_at) %> ago</span>
        </div>
        <% if user_signed_in? && (post.user == current_user || current_user_admin?) %>
          <%= link_to edit_post_path(post), class: "fc-action", title: "Edit breath" do %>
            <%= render_icon("pencil", classes: "h-4 w-4") %>
          <% end %>
        <% end %>
      </header>

      <%
        has_meta = post.room || post.featured? || post.threaded? ||
                   post.prayer_status_prayer_pending? || post.prayer_status_prayer_answered?
      %>
      <% if has_meta %>
        <div class="fc-breath-meta">
          <% if post.room %>
            <%= link_to post.room.name, room_path(post.room), class: "fc-badge" %>
          <% end %>
          <% if post.featured? %>
            <span class="fc-featured-tag">★ Featured</span>
          <% end %>
          <% if post.threaded? %>
            <span class="fc-thread-chip" title="Open thread">
              <%= render_icon("message_circle", classes: "h-3.5 w-3.5") %>
              <span>Thread</span>
            </span>
          <% end %>
          <% if post.prayer_status_prayer_pending? %>
            <span class="fc-prayer-chip" title="Prayer request">
              🙏 <span>Prayer</span>
            </span>
          <% elsif post.prayer_status_prayer_answered? %>
            <span class="fc-prayer-chip is-answered" title="Answered">
              🌟 <span>Answered</span>
            </span>
          <% end %>
        </div>
      <% end %>

      <%
        plain_text   = post.content.to_plain_text.to_s
        # Body is clamped to 3 lines by the base .fc-breath-copy rule. Roughly
        # 50 chars per line on the card width, so anything over ~150 chars is
        # very likely to overflow and need a "…more" affordance.
        likely_overflow = plain_text.length > 150 || plain_text.lines.size > 3
      %>
      <div class="fc-breath-body" data-controller="expand-text scripture">
        <% if post.display_title %>
          <%= link_to post.display_title, post_path(post), class: "fc-breath-title hover:text-[var(--fc-accent)]" %>
        <% end %>
        <%= render_social_card_text(
              post.content,
              class_name: "fc-breath-copy#{' is-untitled' unless post.display_title}",
              data: { expand_text_target: "copy" }
            ) %>
        <% if likely_overflow %>
          <button type="button"
                  class="fc-breath-readmore"
                  data-expand-text-target="toggle"
                  data-action="click->expand-text#expand">…more</button>
        <% end %>
      </div>

      <% if post.has_voice_note? %>
        <%= render "posts/voice_note", post: post %>
      <% end %>

      <% if post.quote_repost? %>
        <%= render "posts/embedded_quote", quoted: post.quoted_post %>
      <% end %>

      <% if post.has_images? %>
        <%
          imgs = post.images.first(4)
          grid_class = "fc-breath-media-grid is-#{imgs.size}"
        %>
        <div class="<%= grid_class %>" data-controller="lightbox">
          <% imgs.each do |img| %>
            <%= image_tag img, class: "fc-breath-media-image", alt: post.title, loading: "lazy" %>
          <% end %>
        </div>
      <% end %>

      <% if post.tags.any? %>
        <div class="fc-breath-tags">
          <% post.tags.limit(4).each do |tag| %>
            <%= link_to "##{tag.name}", search_path(q: tag.name), class: "fc-breath-tag" %>
          <% end %>
        </div>
      <% end %>

      <footer class="fc-breath-actions">
        <%= render "posts/reactions", post: post %>

        <button type="button"
                class="fc-breath-action<%= ' is-thread' if post.threaded? %>"
                data-controller="thread-toggle"
                data-thread-toggle-url-value="<%= inline_thread_post_path(post) %>"
                data-thread-toggle-frame-value="<%= dom_id(post, :thread) %>"
                data-action="click->thread-toggle#toggle"
                aria-label="<%= post.threaded? ? "Open thread (#{post.comments_count})" : "Reply" %>"
                title="<%= post.threaded? ? "Open thread" : "Reply" %>">
          <%= render_icon("message_circle", classes: "h-4 w-4") %>
          <span data-count="<%= post.comments_count %>"><%= post.comments_count.positive? ? post.comments_count : "" %></span>
        </button>

        <%= render "reshares/button", post: post %>
        <%= render "posts/share_button", post: post %>

        <% if post.prayer_status_prayer_pending? && user_signed_in? %>
          <% mine = post.user_id == current_user.id %>
          <% joined = !mine && joined_prayer_chain?(post) %>
          <% if mine %>
            <%= button_to mark_prayer_answered_post_path(post),
                method: :post,
                form_class: "inline",
                class: "fc-breath-action is-prayer-action",
                data: { turbo_confirm: "Mark this prayer answered? Everyone in the chain will be notified." } do %>
              🌟 <span>Mark answered</span>
            <% end %>
          <% elsif joined %>
            <%= button_to leave_prayer_chain_post_path(post),
                method: :delete,
                form_class: "inline",
                class: "fc-breath-action is-prayer-action is-joined",
                title: "Leave the prayer chain" do %>
              🙏 <span>Praying<% if post.intercessions_count.to_i.positive? %> · <%= post.intercessions_count %><% end %></span>
            <% end %>
          <% else %>
            <%= button_to join_prayer_chain_post_path(post),
                method: :post,
                form_class: "inline",
                class: "fc-breath-action is-prayer-action" do %>
              🙏 <span>Join chain<% if post.intercessions_count.to_i.positive? %> · <%= post.intercessions_count %><% end %></span>
            <% end %>
          <% end %>
        <% end %>

        <div class="fc-breath-actions-end">
          <%= render "posts/overflow_menu", post: post %>
        </div>
      </footer>

      <%= turbo_frame_tag dom_id(post, :thread), class: "fc-breath-thread" %>
    </div>
  </div>
</article>
<% end %>
