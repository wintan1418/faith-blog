<article class="fc-card" id="<%= dom_id(post) %>">
  <header class="fc-card-header-strip">
    <div class="flex min-w-0 items-center gap-2">
      <% if post.anonymous? %>
        <span class="fc-avatar"><%= render_icon("users", classes: "h-4 w-4") %></span>
      <% elsif post.user.profile&.avatar&.attached? %>
        <%= link_to user_path(post.user.username) do %>
          <%= image_tag post.user.profile.avatar, class: "fc-avatar object-cover", alt: post.user.username %>
        <% end %>
      <% else %>
        <%= link_to user_path(post.user.username), class: "fc-avatar" do %>
          <%= post.user.username.first.upcase %>
        <% end %>
      <% end %>

      <div class="min-w-0">
        <div class="flex min-w-0 flex-wrap items-center gap-2 text-sm">
          <% if post.anonymous? %>
            <span class="font-extrabold text-[var(--fc-ink)]">Anonymous</span>
          <% else %>
            <%= link_to post.user.username, user_path(post.user.username), class: "font-extrabold text-[var(--fc-ink)] hover:text-[var(--fc-accent)]" %>
          <% end %>
          <% if post.room %>
            <%= link_to post.room.name, room_path(post.room), class: "fc-badge" %>
          <% end %>
          <span class="text-xs font-semibold text-[var(--fc-muted)]">· <%= time_ago_in_words(post.published_at || post.created_at) %></span>
          <% if post.featured? %>
            <span class="text-xs font-bold text-[var(--fc-gold)]">Featured</span>
          <% end %>
        </div>
      </div>
    </div>

    <% if user_signed_in? && (post.user == current_user || current_user.admin?) %>
      <%= link_to edit_post_path(post), class: "fc-action", title: "Edit post" do %>
        <%= render_icon("pencil", classes: "h-4 w-4") %>
      <% end %>
    <% else %>
      <span class="text-[var(--fc-muted)]">...</span>
    <% end %>
  </header>

  <div class="fc-card-body">
    <%= link_to post_path(post), class: "group block" do %>
      <h2 class="fc-post-title transition-colors group-hover:text-[var(--fc-accent)]">
        <%= post.title %>
      </h2>
      <p class="fc-post-copy mt-2 line-clamp-3">
        <%= truncate(post.content.to_plain_text, length: 220) %>
      </p>
    <% end %>

    <% if post.has_images? %>
      <%= link_to post_path(post), class: "mt-4 block overflow-hidden rounded-md border border-[var(--fc-line)] bg-[var(--fc-surface-2)]" do %>
        <%= image_tag post.images.first, class: "h-72 w-full object-cover", alt: post.title %>
      <% end %>
    <% end %>

    <% if post.tags.any? %>
      <div class="fc-tags mt-4 flex flex-wrap gap-x-3 gap-y-1">
        <% post.tags.limit(4).each do |tag| %>
          <%= link_to "##{tag.name}", search_path(q: tag.name), class: "hover:text-[var(--fc-ink)]" %>
        <% end %>
      </div>
    <% end %>

    <footer class="fc-card-actions mt-5">
      <div class="flex flex-wrap items-center gap-3">
        <% if user_signed_in? %>
          <div class="relative" data-controller="reactions" id="<%= dom_id(post, :reactions) %>">
            <% user_like = current_user.likes.find_by(likeable: post) %>
            <% if user_like %>
              <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
                  method: :delete,
                  class: "fc-action text-[var(--fc-accent)]",
                  data: { turbo_frame: "_top" },
                  title: "Remove reaction" do %>
                <span><%= Like.reaction_emoji(user_like.reaction_type) %></span>
                <span><%= post.likes_count %></span>
              <% end %>
            <% else %>
              <button type="button"
                      class="fc-action"
                      data-action="click->reactions#showDropdown"
                      title="Add reaction">
                <span>Pray</span>
                <span><%= post.likes_count %></span>
              </button>

              <div class="absolute bottom-full left-0 z-50 mb-2 hidden rounded-lg border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] p-2 shadow-xl" data-reactions-target="dropdown">
                <div class="flex gap-1">
                  <% Like.reaction_types.keys.each do |reaction| %>
                    <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_type: reaction),
                        class: "rounded-md p-2 text-xl hover:bg-[var(--fc-surface-2)]",
                        title: Like.reaction_label(reaction),
                        data: { turbo_frame: "_top" } do %>
                      <%= Like.reaction_emoji(reaction) %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <span class="font-bold">Pray <%= post.likes_count %></span>
        <% end %>

        <%= link_to post_path(post, anchor: "comments"), class: "fc-action" do %>
          <%= render_icon("message_circle", classes: "h-4 w-4") %>
          <%= post.comments_count %>
        <% end %>

        <div id="<%= dom_id(post, :reshare) %>" class="leading-none">
          <%= render "reshares/button", post: post %>
        </div>
      </div>

      <% if user_signed_in? %>
        <% if current_user.has_bookmarked?(post) %>
          <%= button_to post_bookmark_path(post), method: :delete, class: "fc-action text-[var(--fc-gold)]", data: { turbo_frame: "_top" }, title: "Remove bookmark" do %>
            <%= render_icon("bookmark", classes: "h-4 w-4") %>
            Saved
          <% end %>
        <% else %>
          <%= button_to post_bookmark_path(post), class: "fc-action", data: { turbo_frame: "_top" }, title: "Save post" do %>
            <%= render_icon("bookmark", classes: "h-4 w-4") %>
            Save
          <% end %>
        <% end %>
      <% end %>
    </footer>
  </div>
</article>
