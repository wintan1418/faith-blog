<%# Lean Twitter-style composer used inside the modal AND on /posts/new.
    Locals: post, rooms %>
<% mode = local_assigns.fetch(:mode, post.kind || "breath").to_s %>
<%= form_with model: post,
    html: { class: "fc-composer-form", multipart: true, data: { controller: "post-form composer-mode", composer_mode_initial_value: mode } } do |f| %>
  <% if post.errors.any? %>
    <div class="fc-composer-errors">
      <strong>Couldn't post:</strong>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="fc-composer-tabs" role="tablist" aria-label="What are you posting?">
    <button type="button"
            class="fc-composer-tab is-active"
            data-mode="breath"
            data-action="click->composer-mode#switch"
            data-composer-mode-target="tab"
            role="tab">
      <%= render_icon("sparkles", classes: "h-4 w-4") %>
      <span>Breathe</span>
    </button>
    <button type="button"
            class="fc-composer-tab"
            data-mode="thread"
            data-action="click->composer-mode#switch"
            data-composer-mode-target="tab"
            role="tab">
      <%= render_icon("message_circle", classes: "h-4 w-4") %>
      <span>Start a thread</span>
    </button>
  </div>

  <%= f.hidden_field :kind, value: mode, data: { composer_mode_target: "kindField" } %>

  <div class="fc-composer-head">
    <% if current_user.profile&.avatar&.attached? %>
      <%= image_tag current_user.profile.avatar, class: "fc-avatar object-cover" %>
    <% else %>
      <span class="fc-avatar"><%= current_user.username.first.upcase %></span>
    <% end %>
    <div class="fc-composer-author">
      <p class="fc-composer-name"><%= current_user.username %></p>
      <p class="fc-composer-handle"
         data-composer-mode-target="handle"
         data-handle-breath="breathing into the community"
         data-handle-thread="opening a thread for the community">breathing into the community</p>
    </div>
  </div>

  <%= f.text_field :title,
      class: "fc-composer-title",
      placeholder: "Title — what is this breath about?",
      maxlength: 200,
      required: true,
      data: {
        composer_mode_target: "title",
        title_breath: "Title — what is this breath about?",
        title_thread: "What do you want to discuss?"
      } %>

  <div data-controller="emoji-picker">
    <%= f.rich_text_area :content,
        class: "fc-composer-body",
        placeholder: "What's on your heart? Breathe it out...",
        data: {
          emoji_picker_target: "editor",
          controller: "mentions",
          composer_mode_target: "body",
          body_breath: "What's on your heart? Breathe it out...",
          body_thread: "Pose a question. Invite the community in."
        } %>

    <div class="fc-composer-toolbar">
      <div class="fc-composer-tools">
        <button type="button"
                data-emoji-picker-target="button"
                data-action="click->emoji-picker#toggle"
                class="fc-composer-icon-btn"
                title="Add emoji"
                aria-label="Add emoji">
          <%= render_icon("smile", classes: "h-5 w-5") %>
        </button>

        <label class="fc-composer-icon-btn cursor-pointer" title="Add images" aria-label="Add images">
          <%= render_icon("image", classes: "h-5 w-5") %>
          <%= f.file_field :images,
              multiple: true,
              accept: "image/*",
              class: "sr-only",
              data: { action: "change->post-form#previewImages" } %>
        </label>
      </div>

      <div class="fc-composer-meta">
        <label class="fc-composer-pill">
          <span class="fc-composer-pill-label">Room</span>
          <%= f.select :room_id,
              rooms.map { |r| ["#{r.icon ? "#{r.icon} " : ""}#{r.name}", r.id] },
              { include_blank: "None — just breathe" },
              class: "fc-composer-pill-select" %>
        </label>

        <label class="fc-composer-toggle">
          <%= f.check_box :anonymous, class: "fc-composer-checkbox" %>
          <span>Anonymous</span>
        </label>

        <label class="fc-composer-toggle">
          <%= f.check_box :prayer_status,
              {
                checked: post.prayer_status_prayer_pending? || post.prayer_status_prayer_answered?,
                class: "fc-composer-checkbox"
              },
              "prayer_pending", "not_a_prayer" %>
          <span>🙏 Prayer request</span>
        </label>
      </div>
    </div>

    <div class="relative">
      <div data-emoji-picker-target="picker" class="hidden absolute right-0 z-50 mt-2">
        <emoji-picker style="width: 320px; height: 380px;"></emoji-picker>
      </div>
    </div>
  </div>

  <div id="image-previews" class="fc-composer-previews hidden" data-post-form-target="previews"></div>

  <div class="fc-composer-footer">
    <button type="button" class="fc-btn" data-action="click->composer-modal#close">Cancel</button>
    <% unless post.persisted? %>
      <button type="submit" name="post[status]" value="draft" class="fc-btn">Save draft</button>
    <% end %>
    <button type="submit"
            name="post[status]"
            value="<%= post.persisted? ? (post.draft? ? "draft" : "published") : "published" %>"
            class="fc-btn fc-btn-primary"
            data-composer-mode-target="submit"
            data-submit-breath="<%= post.persisted? ? "Update" : "Breathe" %>"
            data-submit-thread="<%= post.persisted? ? "Update thread" : "Open the thread" %>">
      <%= post.persisted? ? "Update" : "Breathe" %>
    </button>
  </div>
<% end %>
