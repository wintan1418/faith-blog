<%# Lean Twitter-style composer used inside the modal AND on /posts/new.
    Locals: post, rooms %>
<% mode = local_assigns.fetch(:mode, post.kind || "breath").to_s %>
<%= form_with model: post,
    html: { class: "fc-composer-form", multipart: true, data: {
      controller: "post-form composer-mode composer-assistant",
      composer_mode_initial_value: mode,
      composer_assistant_gentleness_url_value: check_gentleness_posts_path,
      composer_assistant_scripture_url_value: suggest_scripture_posts_path
    } } do |f| %>
  <% if post.errors.any? %>
    <div class="fc-composer-errors">
      <strong>Couldn't post:</strong>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="fc-composer-tabs" role="tablist" aria-label="What are you posting?">
    <button type="button"
            class="fc-composer-tab is-active"
            data-mode="breath"
            data-action="click->composer-mode#switch"
            data-composer-mode-target="tab"
            role="tab">
      <%= render_icon("sparkles", classes: "h-4 w-4") %>
      <span>Breathe</span>
    </button>
    <button type="button"
            class="fc-composer-tab"
            data-mode="thread"
            data-action="click->composer-mode#switch"
            data-composer-mode-target="tab"
            role="tab">
      <%= render_icon("message_circle", classes: "h-4 w-4") %>
      <span>Start a thread</span>
    </button>
  </div>

  <%= f.hidden_field :kind, value: mode, data: { composer_mode_target: "kindField" } %>

  <div class="fc-composer-head">
    <% if current_user.profile&.avatar&.attached? %>
      <%= image_tag current_user.profile.avatar, class: "fc-avatar object-cover" %>
    <% else %>
      <span class="fc-avatar" style="<%= avatar_tint_style(current_user.username) %>"><%= current_user.username.first.upcase %></span>
    <% end %>
    <div class="fc-composer-author">
      <p class="fc-composer-name"><%= current_user.username %></p>
      <p class="fc-composer-handle"
         data-composer-mode-target="handle"
         data-handle-breath="breathing into the community"
         data-handle-thread="opening a thread for the community">breathing into the community</p>
    </div>
  </div>

  <%= f.text_field :title,
      class: "fc-composer-title",
      placeholder: mode == "thread" ? "What do you want to discuss?" : "Add a title (optional)",
      maxlength: 200,
      required: mode == "thread",
      data: {
        composer_mode_target: "title",
        title_breath: "Add a title (optional)",
        title_thread: "What do you want to discuss?"
      } %>

  <div data-controller="emoji-picker">
    <%= f.rich_text_area :content,
        class: "fc-composer-body",
        placeholder: "What's on your heart? Breathe it out...",
        data: {
          emoji_picker_target: "editor",
          controller: "mentions",
          composer_mode_target: "body",
          body_breath: "What's on your heart? Breathe it out...",
          body_thread: "Pose a question. Invite the community in."
        } %>

    <div class="fc-composer-toolbar">
      <div class="fc-composer-tools">
        <div class="fc-emoji-anchor">
          <button type="button"
                  data-emoji-picker-target="button"
                  data-action="click->emoji-picker#toggle"
                  class="fc-composer-icon-btn"
                  title="Add emoji"
                  aria-label="Add emoji">
            <%= render_icon("smile", classes: "h-5 w-5") %>
          </button>
          <div data-emoji-picker-target="picker" class="fc-emoji-popover hidden">
            <emoji-picker></emoji-picker>
          </div>
        </div>

        <label class="fc-composer-icon-btn cursor-pointer" title="Add images" aria-label="Add images">
          <%= render_icon("image", classes: "h-5 w-5") %>
          <%= f.file_field :images,
              multiple: true,
              accept: "image/*",
              class: "sr-only",
              data: { action: "change->post-form#previewImages" } %>
        </label>

        <div class="fc-voice-recorder" data-controller="voice-recorder">
          <button type="button"
                  class="fc-composer-icon-btn"
                  data-voice-recorder-target="trigger"
                  data-action="click->voice-recorder#togglePanel"
                  title="Record voice note"
                  aria-label="Record voice note">
            🎙️
          </button>

          <%# Hidden inputs that the recorder fills in. %>
          <%= f.file_field :voice_note,
              accept: "audio/*",
              class: "sr-only",
              data: { voice_recorder_target: "fileInput" } %>
          <%= f.hidden_field :voice_duration_ms,
              data: { voice_recorder_target: "durationInput" } %>

          <div class="fc-voice-recorder-panel hidden" data-voice-recorder-target="panel">
            <div class="fc-voice-recorder-row">
              <button type="button"
                      class="fc-voice-recorder-record"
                      data-voice-recorder-target="recordBtn"
                      data-action="click->voice-recorder#record"
                      title="Start recording">●</button>
              <button type="button"
                      class="fc-voice-recorder-stop hidden"
                      data-voice-recorder-target="stopBtn"
                      data-action="click->voice-recorder#stop"
                      title="Stop">■</button>
              <span class="fc-voice-recorder-timer" data-voice-recorder-target="timer">0:00</span>
              <span class="fc-voice-recorder-max">/ 1:30 max</span>
            </div>

            <div class="fc-voice-recorder-preview hidden" data-voice-recorder-target="preview">
              <audio controls preload="metadata" data-voice-recorder-target="previewAudio"></audio>
              <div class="fc-voice-recorder-actions">
                <button type="button" class="fc-btn" data-action="click->voice-recorder#retry">Re-record</button>
                <button type="button" class="fc-btn" data-action="click->voice-recorder#discard">Discard</button>
              </div>
            </div>
          </div>

          <%# Inline summary chip shown after a successful recording so the
              user can see (and remove) the attached note without re-opening
              the panel. %>
          <div class="fc-voice-recorder-summary hidden" data-voice-recorder-target="summary">
            🎙️ Voice note attached · <span data-voice-recorder-target="summaryDuration">0:00</span>
            <button type="button" class="fc-voice-recorder-remove"
                    data-voice-recorder-target="removeBtn"
                    data-action="click->voice-recorder#remove"
                    aria-label="Remove voice note">×</button>
          </div>
        </div>

        <button type="button"
                class="fc-composer-icon-btn"
                title="Open Bible"
                aria-label="Open Bible"
                data-action="click->bible-drawer#open">
          <%= render_icon("bookopen", classes: "h-5 w-5") %>
        </button>

        <button type="button"
                class="fc-composer-asst-btn"
                data-composer-assistant-target="gentlenessBtn"
                data-action="click->composer-assistant#checkGentleness"
                title="Run a quick tone check">
          🕊️ <span>Check tone</span>
        </button>
        <button type="button"
                class="fc-composer-asst-btn"
                data-composer-assistant-target="scriptureBtn"
                data-action="click->composer-assistant#suggestScripture"
                title="Suggest a fitting scripture">
          📖 <span>Suggest scripture</span>
        </button>
        <button type="button"
                class="fc-composer-asst-btn fc-composer-asst-toggle"
                data-composer-assistant-target="scriptureAutoBtn"
                data-action="click->composer-assistant#toggleAutoScripture"
                title="Suggest scripture automatically as you type"
                aria-pressed="false">
          ⚡ <span class="fc-composer-asst-label">Auto: off</span>
        </button>
      </div>

      <div class="fc-composer-meta">
        <label class="fc-composer-pill">
          <span class="fc-composer-pill-label">Room</span>
          <%= f.select :room_id,
              rooms.map { |r| ["#{r.icon ? "#{r.icon} " : ""}#{r.name}", r.id] },
              { include_blank: "None — just breathe" },
              class: "fc-composer-pill-select" %>
        </label>

        <label class="fc-composer-toggle">
          <%= f.check_box :anonymous, class: "fc-composer-checkbox" %>
          <span>Anonymous</span>
        </label>

        <label class="fc-composer-toggle">
          <%= f.check_box :prayer_status,
              {
                checked: post.prayer_status_prayer_pending? || post.prayer_status_prayer_answered?,
                class: "fc-composer-checkbox"
              },
              "prayer_pending", "not_a_prayer" %>
          <span>🙏 Prayer request</span>
        </label>

        <label class="fc-composer-pill" title="Pick a future date/time to auto-publish this breath">
          <span class="fc-composer-pill-label">⏱️ Schedule</span>
          <%= f.datetime_local_field :scheduled_for,
              value: post.scheduled_for&.in_time_zone&.strftime("%Y-%m-%dT%H:%M"),
              min: Time.current.strftime("%Y-%m-%dT%H:%M"),
              class: "fc-composer-pill-select" %>
        </label>
      </div>
    </div>


    <div class="fc-asst-panel hidden"
         data-composer-assistant-target="panel"
         aria-live="polite">
      <div data-composer-assistant-target="panelContent"></div>
    </div>
  </div>

  <div id="image-previews" class="fc-composer-previews hidden" data-post-form-target="previews"></div>

  <div class="fc-composer-footer">
    <button type="button" class="fc-btn" data-action="click->composer-modal#close">Cancel</button>
    <% unless post.persisted? %>
      <button type="submit" name="post[status]" value="draft" class="fc-btn">Save draft</button>
    <% end %>
    <button type="submit"
            name="post[status]"
            value="<%= post.persisted? ? (post.draft? ? "draft" : "published") : "published" %>"
            class="fc-btn fc-btn-primary"
            data-composer-mode-target="submit"
            data-submit-breath="<%= post.persisted? ? "Update" : "Breathe" %>"
            data-submit-thread="<%= post.persisted? ? "Update thread" : "Open the thread" %>">
      <%= post.persisted? ? "Update" : "Breathe" %>
    </button>
  </div>
<% end %>
