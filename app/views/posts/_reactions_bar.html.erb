<%
  loaded_likes = (post.likes.loaded? ? post.likes : post.likes.includes(:user)).to_a
                   .reject { |l| l.reaction_emoji.to_s.empty? }
  user_like    = user_signed_in? ? current_user.likes.find_by(likeable: post) : nil
  emoji_groups = loaded_likes
                   .group_by(&:reaction_emoji)
                   .sort_by { |_, likes| -likes.size }
                   .first(4)
%>
<div class="post-reactions-bar">
  <div class="post-reactions-left fc-reactions" id="<%= dom_id(post, :reactions) %>" data-controller="emoji-reactions"
       data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Post", likeable_id: post.id) %>"
       data-emoji-reactions-token-value="<%= form_authenticity_token %>">
    <% emoji_groups.each do |emoji, group| %>
      <% mine = user_like&.display_emoji == emoji %>
      <% tip = reactor_names_label(group) %>
      <% if mine %>
        <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
            method: :delete,
            form_class: "inline",
            class: "fc-reaction-pill is-mine",
            title: "Remove your reaction" do %>
          <span class="fc-reaction-emoji"><%= emoji %></span>
          <span class="fc-reaction-count"><%= group.size %></span>
          <% if tip.present? %><span class="fc-reaction-tip" role="tooltip"><%= tip %></span><% end %>
        <% end %>
      <% else %>
        <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_emoji: emoji),
            form_class: "inline",
            class: "fc-reaction-pill" do %>
          <span class="fc-reaction-emoji"><%= emoji %></span>
          <span class="fc-reaction-count"><%= group.size %></span>
          <% if tip.present? %><span class="fc-reaction-tip" role="tooltip"><%= tip %></span><% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if user_signed_in? %>
      <% if emoji_groups.empty? && user_like.nil? %>
        <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_emoji: "🙏"),
            form_class: "inline",
            class: "fc-reaction-add",
            title: "Amen" do %>
          <span class="fc-reaction-emoji">🙏</span>
          <span class="fc-reaction-add-label">Amen</span>
        <% end %>
      <% end %>
      <button type="button"
              class="fc-reaction-add"
              data-action="click->emoji-reactions#toggle"
              aria-label="Add a reaction"
              title="Add a reaction">
        <%= render_icon("smile", classes: "h-4 w-4") %>
      </button>
      <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
        <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
      </div>
    <% else %>
      <%= link_to "React", new_user_session_path, class: "fc-reaction-add" %>
    <% end %>

    <% if loaded_likes.any? %>
      <button type="button" class="fc-reaction-viewers"
              data-action="reactors-modal#open"
              data-reactors-modal-url-param="<%= reactions_post_path(post) %>"
              title="See who reacted">
        <%= pluralize(loaded_likes.size, "reaction") %>
      </button>
    <% end %>

    <%= render "reshares/button", post: post %>
    <%= render "posts/share_button", post: post %>
  </div>

  <div class="post-reactions-right">
    <% if user_signed_in? %>
      <%= render "posts/bookmark_button", post: post %>
      <% if current_user.admin_or_moderator? %>
        <% if post.featured? %>
          <%= button_to "Unfeature", unfeature_post_path(post), form_class: "inline", class: "fc-btn" %>
        <% else %>
          <%= button_to "★ Feature", feature_post_path(post), form_class: "inline", class: "fc-btn" %>
        <% end %>
      <% end %>
      <% if post.user != current_user %>
        <%= render "reports/button", reportable: post, label: "Report" %>
      <% end %>
    <% else %>
      <%= render "posts/bookmark_button", post: post %>
    <% end %>
  </div>
</div>
