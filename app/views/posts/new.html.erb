<% content_for(:title) { "New breath - Brethreign" } %>

<div class="fc-app">
  <div class="fc-shell" style="grid-template-columns: minmax(0, 1fr); max-width: 640px;">
    <main class="fc-main">
      <div class="fc-panel fc-composer-panel-page">
        <header class="fc-composer-bar eg-cmp-bar">
          <h1 class="fc-composer-bar-title eg-cmp-bar-title">New breath</h1>
          <%= link_to "Drafts", drafts_path, class: "eg-cmp-drafts-link" %>
          <%= link_to "Cancel", feed_path, class: "eg-cmp-text-btn eg-cmp-page-cancel", data: { action: "click->composer-modal#close" } %>
        </header>
        <%= render "posts/composer", post: @post, rooms: @rooms, page: true %>
      </div>
    </main>
  </div>
</div>
