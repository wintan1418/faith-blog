<% content_for(:title) { "Create Post - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mystic-panel-strong overflow-hidden">
      <div class="border-b border-faith-green/10 p-6">
        <span class="mystic-kicker">New Post</span>
        <h1 class="mt-3 text-3xl font-bold text-faith-dark">Share with the Community</h1>
        <p class="mystic-copy mt-1">Your story can encourage and inspire others.</p>
      </div>

      <div class="p-6">
        <%= render "form", post: @post, rooms: @rooms %>
      </div>
    </div>
  </div>
</div>

