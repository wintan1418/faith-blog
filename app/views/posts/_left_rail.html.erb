<div class="post-rail-block">
  <%= link_to feed_path, class: "post-back-link" do %>
    <span aria-hidden="true">←</span> Back to Feed
  <% end %>
</div>

<nav class="post-rail-block post-toc" aria-label="In this breath" data-toc-target="nav">
  <p class="post-rail-label">In this breath</p>
  <ol class="post-toc-list" data-toc-target="list">
    <li class="post-toc-empty">Sections appear as you scroll.</li>
  </ol>
</nav>

<div class="post-rail-block post-stats">
  <p class="post-rail-label">Reading stats</p>
  <ul class="post-stats-list">
    <% if post.respond_to?(:reading_time) %>
      <li>
        <span><%= render_icon("clock", classes: "h-4 w-4") %> Read time</span>
        <span><%= post.reading_time %> min</span>
      </li>
    <% end %>
    <li>
      <span><%= render_icon("filetext", classes: "h-4 w-4") %> Words</span>
      <span><%= number_with_delimiter(post.content.to_plain_text.to_s.split.size) %></span>
    </li>
    <li>
      <span><%= render_icon("eye", classes: "h-4 w-4") rescue render_icon("sparkles", classes: "h-4 w-4") %> Views</span>
      <span><%= number_with_delimiter(post.views_count.to_i) %></span>
    </li>
    <li>
      <span><%= render_icon("message_circle", classes: "h-4 w-4") %> Replies</span>
      <span><%= post.comments_count %></span>
    </li>
  </ul>
</div>
