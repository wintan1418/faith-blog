<%# LinkedIn-style engagement meta row: reaction emojis + total on the left,
    "N comments · N reposts" on the right. Hidden entirely when a breath has no
    engagement yet. Re-rendered by the like turbo-stream. Local: post %>
<%
  loaded_likes = (post.likes.loaded? ? post.likes : post.likes.includes(:user)).to_a
  reacted      = loaded_likes.reject { |l| l.reaction_emoji.to_s.empty? }
  top_emojis   = reacted.group_by(&:reaction_emoji)
                        .sort_by { |_, g| -g.size }
                        .first(3)
                        .map(&:first)
  total        = reacted.size
  comments     = post.comments_count.to_i
  reposts      = post.reshares_count.to_i
  has_any      = total.positive? || comments.positive? || reposts.positive?
%>
<div class="fc-breath-stats<%= ' is-empty' unless has_any %>" id="<%= dom_id(post, :reaction_summary) %>">
  <% if total.positive? %>
    <span class="fc-breath-stats-reactions">
      <span class="fc-breath-stats-emojis">
        <% top_emojis.each do |emoji| %><span class="fc-breath-stats-emoji"><%= emoji %></span><% end %>
      </span>
      <span class="fc-breath-stats-count"><%= number_with_delimiter(total) %></span>
    </span>
  <% else %>
    <span></span>
  <% end %>

  <span class="fc-breath-stats-meta">
    <% parts = [] %>
    <% parts << link_to(pluralize(comments, "comment"), post_path(post, anchor: "comments"), class: "fc-breath-stats-link") if comments.positive? %>
    <% parts << pluralize(reposts, "repost") if reposts.positive? %>
    <%= safe_join(parts, " · ") %>
  </span>
</div>
