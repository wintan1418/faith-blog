<%# Link previews / meta tags only ever describe a breath the whole world may
    read. A held, draft or scheduled breath gets a generic card so its words
    (and photos) can't leak through a share preview or a cached crawl. %>
<% public_breath = @post.visible_to?(nil) %>
<% page_title = public_breath ? (@post.display_title || truncate(@post.content.to_plain_text.to_s.strip, length: 60, separator: " ")) : "A breath on Brethreign" %>
<% content_for(:title) { "#{page_title} - Brethreign" } %>
<% post_excerpt = public_breath ? truncate(@post.content.to_plain_text.to_s.strip, length: 200, separator: " ") : "Sane, kind conversations about work, life and faith on Brethreign. Everyone welcome." %>
<% content_for(:meta_description) { post_excerpt } %>
<% content_for(:og_title) { page_title } %>
<% content_for(:og_description) { post_excerpt } %>
<% content_for(:og_url) { post_url(@post) } %>
<% content_for(:og_type) { "article" } %>
<% content_for(:canonical) { post_url(@post) } %>
<% if public_breath %>
  <% content_for(:structured_data) do %>
    <script type="application/ld+json"><%= raw({
      "@context" => "https://schema.org", "@type" => "DiscussionForumPosting",
      "headline" => page_title.to_s.truncate(110), "text" => post_excerpt,
      "url" => post_url(@post), "datePublished" => (@post.published_at || @post.created_at)&.iso8601,
      "dateModified" => @post.updated_at.iso8601,
      "author" => { "@type" => "Person", "name" => (@post.respond_to?(:anonymous?) && @post.anonymous? ? "A Brethreign member" : @post.user&.display_name.to_s) },
      "interactionStatistic" => [
        { "@type" => "InteractionCounter", "interactionType" => "https://schema.org/LikeAction", "userInteractionCount" => @post.likes_count.to_i },
        { "@type" => "InteractionCounter", "interactionType" => "https://schema.org/CommentAction", "userInteractionCount" => @post.comments_count.to_i }
      ]
    }.to_json) %></script>
  <% end %>
<% end %>
<% if public_breath && @post.has_images? %>
  <%# A full 1200×630 address: WhatsApp, LinkedIn, X and Google ignore a relative one. %>
  <% og = resized_image_src(@post.images.first, width: 1200, height: 630, crop: "fill", gravity: "auto") %>
  <% content_for(:og_image) { og.is_a?(String) && og.start_with?("http") ? og : "#{request.base_url}#{url_for(@post.images.first)}" } %>
<% elsif public_breath && !@post.anonymous? %>
  <% content_for(:og_accent) { @post.user&.accent_color } %>
<% end %>

<% if @post.held_for_review? && !@post.visible_to?(current_user) %>
  <div class="post-page-shell">
    <div class="post-page-grid">
      <div class="post-page-main">
        <article class="fc-card fc-card-held">
          <div class="fc-held-placeholder">
            <%= render_icon("shield", classes: "h-5 w-5") %>
            <p>This breath is held for moderator review.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
<% else %>
  <div class="post-page-shell">
    <div class="post-page-grid">
      <aside class="post-left-rail">
        <%= render "posts/left_rail", post: @post %>
      </aside>

      <main class="post-page-main">
        <% if @post.held_for_review? && current_user == @post.user %>
          <div class="fc-held-banner mb-4">
            <%= render_icon("shield", classes: "h-4 w-4") %>
            <span>Held for moderator review — only you and moderators can see this right now.</span>
          </div>
        <% end %>

        <% auto = flash[:series_auto] %>
        <% if auto.is_a?(Hash) && auto["post_id"] == @post.id && current_user == @post.user %>
          <%= render "posts/series_auto_notice", post: @post, info: auto %>
        <% end %>

        <article class="post-card" data-controller="toc"
                 data-toc-active-class="is-active">
          <%= render "posts/post_header", post: @post %>
          <% series_parts, series_index = series_context_for(@post, current_user) %>
          <% if series_parts %>
            <%= link_to series_path(@post.series), class: "sr-topline" do %>
              <%= render_icon("library", classes: "sr-topline-icon") %>
              <span>Part <%= @post.series_position || series_index + 1 %> of <%= series_last_number(series_parts.each_with_index.map { |part, i| part.series_position || i + 1 }) %> · <strong><%= @post.series.title %></strong></span>
            <% end %>
          <% end %>

          <% if @post.has_images? %>
            <figure class="post-hero">
              <%= image_tag photo_src(@post.images.first, width: 1600), alt: @post.title %>
            </figure>
          <% end %>

          <div class="post-body" data-toc-target="body" data-controller="scripture">
            <%= render_rich_social_text(@post.content, class_name: "fc-social-text") %>
          </div>

          <% if @post.game_share.present? %>
            <%= render "posts/game_share_card", post: @post %>
          <% end %>

          <% if @post.quote_repost? %>
            <div class="post-embedded-quote">
              <%= render "posts/embedded_quote", quoted: @post.quoted_post %>
            </div>
          <% end %>

          <% if series_parts %>
            <%= render "posts/series_card", post: @post, parts: series_parts, index: series_index %>
          <% end %>

          <%# Only breaths this reader may see — a draft linking here must not leak. %>
          <% visible_linked  = @post.linked_posts.select { |p| p.visible_to?(current_user) } %>
          <% visible_linking = @post.linking_posts.select { |p| p.visible_to?(current_user) } %>
          <% if visible_linked.any? || visible_linking.any? %>
            <div class="post-linked">
              <% if visible_linked.any? %>
                <p class="post-section-label">Related</p>
                <% visible_linked.each do |linked| %>
                  <%= render "posts/linked_card", linked: linked %>
                <% end %>
              <% end %>
              <% if visible_linking.any? %>
                <p class="post-section-label">Linked here</p>
                <% visible_linking.each do |linking| %>
                  <%= render "posts/linked_card", linked: linking %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <%= render "posts/reactions_bar", post: @post %>
        </article>

        <section id="comments" class="post-conversation">
          <header class="post-conversation-head">
            <div>
              <h2>The Conversation</h2>
              <p><%= pluralize(@post.comments_count, "voice") %></p>
            </div>
          </header>

          <% if @post.allow_comments? %>
            <% if user_signed_in? %>
              <div class="post-conversation-composer" data-controller="composer">
                <%= form_with model: [@post, @new_comment], id: "comment_form", class: "composer-form",
                              data: { controller: "pristine-field" } do |f| %>
                  <% if current_user.profile&.avatar&.attached? %>
                    <%= image_tag avatar_src(current_user.profile), class: "composer-avatar object-cover" %>
                  <% else %>
                    <span class="composer-avatar"><%= current_user.username.first.upcase %></span>
                  <% end %>
                  <div class="composer-body">
                    <div class="composer-collapsed" data-composer-target="collapsed" data-action="click->composer#expand">
                      Share encouragement, wisdom, or a prayer…
                    </div>
                    <div class="composer-expanded hidden" data-composer-target="expanded">
                      <div data-controller="emoji-picker">
                        <%= f.rich_text_area :content,
                            class: "composer-input",
                            placeholder: "Share encouragement, wisdom, or a prayer…",
                            data: { controller: "mentions", emoji_picker_target: "editor" } %>
                        <div class="composer-toolbar">
                          <button type="button"
                                  data-emoji-picker-target="button"
                                  data-action="click->emoji-picker#toggle"
                                  class="composer-tool"
                                  title="Add emoji">
                            <%= render_icon("smile", classes: "h-4 w-4") %>
                          </button>
                          <%= render "gifs/picker", scope: "comment", button_class: "composer-tool" %>
                          <div class="composer-spacer"></div>
                          <button type="button"
                                  data-action="click->composer#collapse"
                                  class="fc-btn">Cancel</button>
                          <%= f.submit "Post", class: "fc-btn fc-btn-primary" %>
                        </div>
                        <div class="relative">
                          <div data-emoji-picker-target="picker" class="hidden absolute right-0 z-50 mt-2">
                            <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="post-conversation-empty">
                <p><%= link_to "Sign in", new_user_session_path %> to join the conversation.</p>
              </div>
            <% end %>

            <%= render "comments/list", post: @post %>
          <% else %>
            <div class="post-conversation-empty">
              <p>Comments are disabled for this breath.</p>
            </div>
          <% end %>
        </section>
      </main>

      <aside class="post-right-rail">
        <%= render "posts/right_rail", post: @post %>
      </aside>
    </div>
  </div>
<% end %>
