<% content_for(:title) { "#{@post.title} - Faith Community" } %>
<% post_excerpt = truncate(@post.content.to_plain_text.to_s.strip, length: 200, separator: " ") %>
<% content_for(:meta_description) { post_excerpt } %>
<% content_for(:og_title) { @post.title } %>
<% content_for(:og_description) { post_excerpt } %>
<% content_for(:og_url) { post_url(@post) } %>
<% content_for(:og_type) { "article" } %>
<% if @post.has_images? %>
  <% content_for(:og_image) { url_for(@post.images.first) } %>
<% end %>

<% if @post.held_for_review? && !@post.visible_to?(current_user) %>
  <div class="post-page-shell">
    <div class="post-page-grid">
      <div class="post-page-main">
        <article class="fc-card fc-card-held">
          <div class="fc-held-placeholder">
            <%= render_icon("shield", classes: "h-5 w-5") %>
            <p>This breath is held for moderator review.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
<% else %>
  <div class="post-page-shell">
    <div class="post-page-grid">
      <aside class="post-left-rail">
        <%= render "posts/left_rail", post: @post %>
      </aside>

      <main class="post-page-main">
        <% if @post.held_for_review? && current_user == @post.user %>
          <div class="fc-held-banner mb-4">
            <%= render_icon("shield", classes: "h-4 w-4") %>
            <span>Held for moderator review — only you and moderators can see this right now.</span>
          </div>
        <% end %>

        <article class="post-card" data-controller="toc"
                 data-toc-active-class="is-active">
          <%= render "posts/post_header", post: @post %>

          <% if @post.has_images? %>
            <figure class="post-hero">
              <%= image_tag @post.images.first, alt: @post.title %>
            </figure>
          <% end %>

          <div class="post-body" data-toc-target="body" data-controller="scripture">
            <%= render_with_mentions(@post.content) %>
          </div>

          <% if @post.linked_posts.any? || @post.linking_posts.any? %>
            <div class="post-linked">
              <% if @post.linked_posts.any? %>
                <p class="post-section-label">Related</p>
                <% @post.linked_posts.each do |linked| %>
                  <%= render "posts/linked_card", linked: linked %>
                <% end %>
              <% end %>
              <% if @post.linking_posts.any? %>
                <p class="post-section-label">Linked here</p>
                <% @post.linking_posts.each do |linking| %>
                  <%= render "posts/linked_card", linked: linking %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <%= render "posts/reactions_bar", post: @post %>
        </article>

        <section id="comments" class="post-conversation">
          <header class="post-conversation-head">
            <div>
              <h2>The Conversation</h2>
              <p><%= pluralize(@post.comments_count, "voice") %></p>
            </div>
          </header>

          <% if @post.allow_comments? %>
            <% if user_signed_in? %>
              <div class="post-conversation-composer" data-controller="composer">
                <%= form_with model: [@post, @new_comment], id: "comment_form", class: "composer-form" do |f| %>
                  <% if current_user.profile&.avatar&.attached? %>
                    <%= image_tag current_user.profile.avatar, class: "composer-avatar object-cover" %>
                  <% else %>
                    <span class="composer-avatar"><%= current_user.username.first.upcase %></span>
                  <% end %>
                  <div class="composer-body">
                    <div class="composer-collapsed" data-composer-target="collapsed" data-action="click->composer#expand">
                      Share encouragement, wisdom, or a prayer…
                    </div>
                    <div class="composer-expanded hidden" data-composer-target="expanded">
                      <div data-controller="emoji-picker">
                        <%= f.rich_text_area :content,
                            class: "composer-input",
                            placeholder: "Share encouragement, wisdom, or a prayer…",
                            data: { controller: "mentions", emoji_picker_target: "editor" } %>
                        <div class="composer-toolbar">
                          <button type="button"
                                  data-emoji-picker-target="button"
                                  data-action="click->emoji-picker#toggle"
                                  class="composer-tool"
                                  title="Add emoji">
                            <%= render_icon("smile", classes: "h-4 w-4") %>
                          </button>
                          <div class="composer-spacer"></div>
                          <button type="button"
                                  data-action="click->composer#collapse"
                                  class="fc-btn">Cancel</button>
                          <%= f.submit "Post", class: "fc-btn fc-btn-primary" %>
                        </div>
                        <div class="relative">
                          <div data-emoji-picker-target="picker" class="hidden absolute right-0 z-50 mt-2">
                            <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="post-conversation-empty">
                <p><%= link_to "Sign in", new_user_session_path %> to join the conversation.</p>
              </div>
            <% end %>

            <%= render "comments/list", post: @post %>
          <% else %>
            <div class="post-conversation-empty">
              <p>Comments are disabled for this breath.</p>
            </div>
          <% end %>
        </section>
      </main>

      <aside class="post-right-rail">
        <%= render "posts/right_rail", post: @post %>
      </aside>
    </div>
  </div>
<% end %>
