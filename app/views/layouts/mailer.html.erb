<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      /* Email styles need to be inline */
    </style>
  </head>

  <body>
    <%# The Brethreign logo (brand pack PNG: email clients don't show SVG).
        Emails that draw their own header set content_for(:own_brand). %>
    <% unless content_for?(:own_brand) %>
      <div style="max-width: 560px; margin: 0 auto; padding: 8px 0 16px;">
        <a href="<%= root_url %>" style="display: inline-block; text-decoration: none;">
          <img src="<%= root_url %>brand/brethreign-logo-darkg.png" width="162" height="36" alt="Brethreign" style="display: block; border: 0; width: 162px; height: 36px;">
        </a>
      </div>
    <% end %>
    <%= yield %>
    <%# Follow Brethreign (plain links: email clients don't show SVG icons). %>
    <% unless content_for?(:no_socials) %>
      <div style="max-width: 560px; margin: 24px auto 0; padding: 16px 0 8px; border-top: 1px solid #ece6da; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #5e6862;">
        Follow Brethreign:
        <% BrandSocials.profiles.each_with_index do |account, i| %><%= " · " if i.positive? %><a href="<%= account.url %>" style="color: #0e5c43; font-weight: 600; text-decoration: none;"><%= account.label %></a><% end %>
        <% if BrandSocials.email %><br>Say hello: <a href="mailto:<%= BrandSocials.email %>" style="color: #0e5c43; text-decoration: none;"><%= BrandSocials.email %></a><% end %>
      </div>
    <% end %>
  </body>
</html>
