<!DOCTYPE html>
<html lang="en" class="h-full theme-light" data-theme="light">
  <head>
    <script>
      // Apply theme immediately to prevent flash
      (function() {
        const saved = localStorage.getItem('fc-dark');
        const legacy = localStorage.getItem('theme');
        const serverDark = <%= current_user&.respond_to?(:dark_mode?) && current_user.dark_mode? ? "true" : "false" %>;
        const dark = saved === null
          ? (legacy ? legacy === 'dark' : (serverDark || window.matchMedia('(prefers-color-scheme: dark)').matches))
          : saved === '1';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('theme-dark', dark);
        document.documentElement.classList.toggle('theme-light', !dark);
      })();
    </script>
    <title><%= content_for(:title) || "Faith Community" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "A faith-based community platform for sharing testimonies, struggles, victories, and spiritual resources." %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Social share / Open Graph %>
    <% og_title       = content_for?(:og_title)       ? content_for(:og_title)       : (content_for(:title) || "Faith Community") %>
    <% og_description = content_for?(:og_description) ? content_for(:og_description) : "Breathe into the faith community." %>
    <% og_image       = content_for?(:og_image)       ? content_for(:og_image)       : asset_url("og-default.png") rescue nil %>
    <% og_url         = content_for?(:og_url)         ? content_for(:og_url)         : request.original_url %>
    <% og_type        = content_for?(:og_type)        ? content_for(:og_type)        : "website" %>
    <meta property="og:site_name" content="Faith Community" />
    <meta property="og:title" content="<%= og_title %>" />
    <meta property="og:description" content="<%= og_description %>" />
    <meta property="og:url" content="<%= og_url %>" />
    <meta property="og:type" content="<%= og_type %>" />
    <% if og_image.present? %>
      <meta property="og:image" content="<%= og_image %>" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content="<%= og_image %>" />
    <% else %>
      <meta name="twitter:card" content="summary" />
    <% end %>
    <meta name="twitter:title" content="<%= og_title %>" />
    <meta name="twitter:description" content="<%= og_description %>" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="h-full bg-stone-50 font-sans antialiased theme-light">
    <script>
      (function() {
        var dark = document.documentElement.classList.contains('theme-dark');
        document.body.classList.toggle('theme-dark', dark);
        document.body.classList.toggle('theme-light', !dark);
      })();
    </script>
    <div class="min-h-full" data-controller="<%= "composer-modal" if user_signed_in? %>">
      <%= render "shared/navbar" %>
      
      <div id="flash_messages"><%= render "shared/flash" %></div>

      <main>
        <%= yield %>
      </main>

      <% if user_signed_in? %>
        <%= render "shared/composer_modal" %>
      <% end %>

      <%= render "shared/footer" %>
    </div>
  </body>
</html>
