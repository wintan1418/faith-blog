<!DOCTYPE html>
<html lang="en" class="h-full theme-light" data-theme="light">
  <head>
    <script>
      // Apply theme immediately to prevent flash
      // Saved choice on this device → legacy key → account setting → light.
      // New members start in light mode (the OS dark setting no longer decides).
      (function() {
        const saved = localStorage.getItem('fc-dark');
        const legacy = localStorage.getItem('theme');
        const serverDark = <%= current_user&.respond_to?(:dark_mode?) && current_user.dark_mode? ? "true" : "false" %>;
        const dark = saved === null
          ? (legacy ? legacy === 'dark' : serverDark)
          : saved === '1';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('theme-dark', dark);
        document.documentElement.classList.toggle('theme-light', !dark);

        // Daypart ambience: the app's background glow follows the viewer's
        // local time — dawn, day, dusk, night. Purely atmospheric.
        const h = new Date().getHours();
        document.documentElement.dataset.daypart =
          h < 6 ? 'night' : h < 9 ? 'dawn' : h < 17 ? 'day' : h < 21 ? 'dusk' : 'night';
        // Greeting bucket for the feed masthead — the viewer's clock, not the server's.
        document.documentElement.dataset.greet =
          h < 5 ? 'night' : h < 12 ? 'morning' : h < 17 ? 'afternoon' : h < 21 ? 'evening' : 'night';
      })();
    </script>
    <%# In the mobile apps the title becomes the native header, so drop the site-name suffix ("Inbox - Brethreign" → "Inbox"). %>
    <title><%= hotwire_native_app? ? native_app_title : (content_for(:title) || "Brethreign — breathe") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "A calm, faith-centred space for everyone: honest, sane conversations about life, work, belief and everything in between. No ads, no noise." %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Brethreign">
    <%= csrf_meta_tags %>
    <% if ios_app_id %><meta name="apple-itunes-app" content="app-id=<%= ios_app_id %>"><% end %>
    <%= csp_meta_tag %>

    <%# PWA %>
    <link rel="manifest" href="/manifest.webmanifest">
    <%# Favicons: Google search uses /favicon.ico or a PNG that is a multiple of 48px. %>
    <%# ?v= busts browsers' sticky favicon cache after the November 2026 rebrand. %>
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=2">
    <link rel="icon" type="image/svg+xml" href="/icon.svg?v=2">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <meta name="theme-color" content="#07110d">
    <% if user_signed_in? && WebPushConfig.configured? %>
      <meta name="vapid-public-key" content="<%= WebPushConfig.public_key %>">
    <% end %>

    <%# Structured data for search engines: the organisation and the site. %>
    <script type="application/ld+json"><%= raw({
      "@context" => "https://schema.org",
      "@graph" => [
        { "@type" => "Organization", "@id" => "#{request.base_url}/#org", "name" => "Brethreign",
          "url" => "#{request.base_url}/", "logo" => "#{request.base_url}/icon.png",
          "sameAs" => [ "https://play.google.com/store/apps/details?id=com.brethreign.app", *BrandSocials.same_as ],
          "contactPoint" => { "@type" => "ContactPoint", "contactType" => "public relations", "email" => BrandSocials.email }.compact },
        { "@type" => "WebSite", "@id" => "#{request.base_url}/#site", "name" => "Brethreign",
          "url" => "#{request.base_url}/", "publisher" => { "@id" => "#{request.base_url}/#org" } }
      ]
    }.to_json) %></script>
    <%= yield :structured_data %>

    <%# Social share / Open Graph %>
    <% og_title       = content_for?(:og_title)       ? content_for(:og_title)       : (content_for(:title) || "Brethreign") %>
    <% og_description = content_for?(:og_description) ? content_for(:og_description) : "Faith at the centre, everyone welcome. Sane, kind conversations about everything. No ads, no noise." %>
    <% og_accent      = content_for?(:og_accent)      ? content_for(:og_accent)      : current_user&.accent_color.presence %>
    <%# A JPEG, not the SVG: WhatsApp, Facebook and LinkedIn don't show SVG previews.
        public/og/<accent>.jpg are rendered from og/show.svg by bin/render-og-cards. %>
    <% og_slug        = AccentPalette.valid?(og_accent) ? og_accent : AccentPalette::DEFAULT %>
    <% og_image       = content_for?(:og_image)       ? content_for(:og_image)       : "#{request.base_url}/og/#{og_slug}.jpg" %>
    <% og_url         = content_for?(:og_url)         ? content_for(:og_url)         : request.original_url %>
    <% og_type        = content_for?(:og_type)        ? content_for(:og_type)        : "website" %>
    <link rel="canonical" href="<%= content_for?(:canonical) ? content_for(:canonical) : "#{request.base_url}#{request.path}" %>">
    <meta property="og:site_name" content="Brethreign" />
    <meta property="og:title" content="<%= og_title %>" />
    <meta property="og:description" content="<%= og_description %>" />
    <meta property="og:url" content="<%= og_url %>" />
    <meta property="og:type" content="<%= og_type %>" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="<%= og_image %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brethreign: sane, kind conversations about work, life and faith" />
    <% if !content_for?(:og_image) || content_for?(:og_image_type) %><meta property="og:image:type" content="<%= content_for?(:og_image_type) ? content_for(:og_image_type) : "image/jpeg" %>" /><% end %>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@brethreign" />
    <meta name="twitter:title" content="<%= og_title %>" />
    <meta name="twitter:description" content="<%= og_description %>" />
    <meta name="twitter:image" content="<%= og_image %>" />
    <meta name="twitter:image:alt" content="Brethreign: sane, kind conversations about work, life and faith" />
    
    <%# Fonts come from our own domain over the connection that's already open
        (Google Fonts meant two more servers to reach). The two faces every page
        uses are preloaded; text shows at once and swaps in (display=swap). %>
    <link rel="preload" href="<%= asset_path("br-inter-normal-400-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= asset_path("br-playfair-display-normal-700-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <%= stylesheet_link_tag "fonts", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%# Royal Emerald polish: loaded last so it overrides the earlier passes. %>
    <%= stylesheet_link_tag "brand_polish", "data-turbo-track": "reload" %>
    <%# Evergreen design language: loaded last, on every page. %>
    <%= stylesheet_link_tag "evergreen", "evergreen_feed", "evergreen_composer", "evergreen_inbox", "evergreen_games", "evergreen_admin", "evergreen_pages", "evergreen_around", "evergreen_scripture", "evergreen_series", "evergreen_search", "evergreen_daily_bible", "evergreen_org_pages", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= yield :head %>
  </head>

  <body class="h-full bg-stone-50 font-sans antialiased theme-light<%= ' hotwire-native' if hotwire_native_app? %>"
        data-controller="<%= 'pwa' if user_signed_in? && !hotwire_native_app? %><%= 'guest-gate' if guest_gate? %>"
        data-native-signed-in="<%= user_signed_in? %>"
        data-native-admin="<%= user_signed_in? && current_user_admin? %>"
        <% if hotwire_native_app? && user_signed_in? %>
        data-native-unread-notifications="<%= current_user.unread_notifications_count.to_i %>"
        data-native-unread-messages="<%= current_user.unread_conversations_count.to_i %>"
        <% end %>
        data-pwa-vapid-key-value="<%= WebPushConfig.public_key if user_signed_in? && WebPushConfig.configured? %>"
        style="<%= AccentPalette.css_vars(current_user&.accent_color) %>">
    <script>
      (function() {
        var dark = document.documentElement.classList.contains('theme-dark');
        document.body.classList.toggle('theme-dark', dark);
        document.body.classList.toggle('theme-light', !dark);
      })();
    </script>

    <%= render "shared/presence_heartbeat" %>

    <%# First-load splash. Visible until DOMContentLoaded, then fades out.
        Accent-tinted background, brand mark with orbital rings, and a
        3D "breathe breathe breathe" stagger. Only renders on full HTML
        loads, not Turbo navigations (Turbo's progress bar handles those). %>
    <%# The apps have their own native launch animation, so no web splash inside them. %>
    <% unless hotwire_native_app? %>
    <div id="fc-splash" aria-hidden="true" data-turbo-temporary>
      <div class="fc-splash-stage">
        <span class="fc-splash-orbit fc-splash-orbit--1"></span>
        <span class="fc-splash-orbit fc-splash-orbit--2"></span>
        <span class="fc-splash-orbit fc-splash-orbit--3"></span>
        <div class="fc-splash-mark">
          <%= render "shared/logomark", color: "#3cdb9d" %>
        </div>
      </div>
      <div class="fc-splash-words">
        <span class="fc-splash-word" style="--i: 0">breathe</span>
        <span class="fc-splash-word" style="--i: 1">breathe</span>
        <span class="fc-splash-word" style="--i: 2">breathe</span>
      </div>
    </div>
    <script>
      (function() {
        var splash = document.getElementById('fc-splash');
        if (!splash) return;
        // Once per visit: Turbo re-runs this on every page, and a cached page must never bring it back.
        if (window.__fcSplashShown) { splash.remove(); return; }
        window.__fcSplashShown = true;
        var startedAt = Date.now();
        var MIN_VISIBLE = 400;
        var done = false;
        var hide = function() {
          if (done) return;
          done = true;
          var wait = Math.max(0, MIN_VISIBLE - (Date.now() - startedAt));
          setTimeout(function() {
            splash.classList.add('is-leaving');
            splash.style.pointerEvents = 'none';
            setTimeout(function() { splash.remove(); }, 420);
          }, wait);
        };
        // Hide as soon as the page is usable (not after every image and font),
        // and never block for more than 2.5s on a slow connection.
        if (document.readyState !== 'loading') hide();
        else document.addEventListener('DOMContentLoaded', hide);
        setTimeout(hide, 2500);
      })();
    </script>
    <% end %>
    <%# Ambient scripture / brethren / golden-breath rain in the page
        background, accent-tinted, behind every screen. Subtle by design —
        pointer-events: none, low opacity, paused when the tab is hidden,
        off entirely for prefers-reduced-motion. Members can switch it off
        (Settings → Accent, or the account menu). %>
    <div id="fc-rain"
         class="fc-rain"
         aria-hidden="true"
         data-controller="rain"
         data-rain-on-value="<%= user_signed_in? && current_user.background_rain? %>"
         data-rain-items-value="<%= BackgroundRain.items.to_json %>"></div>

    <div class="min-h-full fc-page" data-controller="<%= ["reactors-modal", ("composer-modal notifications-modal bible-drawer notification-sound" if user_signed_in?)].compact.join(" ") %>">
      <%# The signed-out welcome page stands on its own, without the top and bottom bars. %>
      <%= render "shared/navbar" unless content_for?(:bare_page) %>

      <div id="flash_messages" data-guest-gate-allow><%= render "shared/flash" %></div>
      <%# Seeds: "+5 seeds" toasts and the rank-up celebration land here. %>
      <div id="seed_toasts" class="seed-toasts">
        <%= render "seeds/rank_up_modal", user: current_user if user_signed_in? && current_user.rank_up_pending? %>
      </div>
      <%= render "shared/app_update_banner" if outdated_android_app? %>
      <%= render "shared/contact_privacy_notice" if user_signed_in? && current_user.contact_privacy_notice_pending? && controller_path != "settings/privacies" %>

      <main>
        <%= yield %>
      </main>

      <%= render "shared/whats_new", release: Announcement.unseen_release_for(current_user) if user_signed_in? %>

      <%= render "shared/reactors_modal" %>
      <%= render "shared/guest_gate" if guest_gate? %>

      <% if user_signed_in? %>
        <%= render "shared/composer_modal" %>
        <%= render "shared/notifications_modal" %>
        <%= render "shared/bible_drawer" %>
      <% end %>
    </div>
    <%= render "shared/ad_tracking" if ad_tracking_enabled? %>
    <% if user_signed_in? %>
      <%= turbo_stream_from current_user, :badges %>
      <%= render "shared/unread_counts", messages: current_user.unread_conversations_count, notifications: current_user.unread_notifications_count %>
    <% end %>
  </body>
</html>
