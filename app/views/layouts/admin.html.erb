<!DOCTYPE html>
<html lang="en" class="h-full theme-light" data-theme="light">
  <head>
    <script>
      (function() {
        const saved = localStorage.getItem('fc-dark');
        const legacy = localStorage.getItem('theme');
        const serverDark = <%= current_user&.respond_to?(:dark_mode?) && current_user.dark_mode? ? "true" : "false" %>;
        const dark = saved === null
          ? (legacy ? legacy === 'dark' : (serverDark || window.matchMedia('(prefers-color-scheme: dark)').matches))
          : saved === '1';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('theme-dark', dark);
        document.documentElement.classList.toggle('theme-light', !dark);
      })();
    </script>
    <title><%= content_for(:title) || "Admin - Faith Community" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="h-full font-sans antialiased theme-light">
    <script>
      (function() {
        var dark = document.documentElement.classList.contains('theme-dark');
        document.body.classList.toggle('theme-dark', dark);
        document.body.classList.toggle('theme-light', !dark);
      })();
    </script>

    <div class="fc-app fc-admin min-h-full">
      <div class="fc-topbar sticky top-0 z-50">
        <div class="fc-topbar-inner">
          <div class="flex min-w-0 items-center gap-3">
            <%= link_to admin_root_path, class: "fc-brand flex min-w-0 items-center gap-2" do %>
              <span class="fc-brand-mark"><%= render_icon("sparkles", classes: "h-4 w-4") %></span>
              <span class="hidden text-base font-extrabold sm:inline">Faith Community</span>
              <span class="hidden rounded-md border border-[var(--fc-line)] px-2 py-0.5 text-xs font-bold text-[var(--fc-muted)] md:inline">Admin</span>
            <% end %>

            <nav class="hidden items-center gap-1 lg:flex">
              <%= link_to admin_root_path, class: "fc-nav-link #{'is-active' if current_page?(admin_root_path)}" do %>
                <%= render_icon("home", classes: "h-4 w-4") %>
                Dashboard
              <% end %>
              <%= link_to admin_users_path, class: "fc-nav-link #{'is-active' if request.path.include?('/admin/users')}" do %>
                <%= render_icon("users", classes: "h-4 w-4") %>
                Users
              <% end %>
              <%= link_to admin_posts_path, class: "fc-nav-link #{'is-active' if request.path.include?('/admin/posts')}" do %>
                <%= render_icon("filetext", classes: "h-4 w-4") %>
                Posts
              <% end %>
              <%= link_to admin_rooms_path, class: "fc-nav-link #{'is-active' if request.path.include?('/admin/rooms')}" do %>
                <%= render_icon("message_circle", classes: "h-4 w-4") %>
                Rooms
              <% end %>
              <%= link_to admin_resources_path, class: "fc-nav-link #{'is-active' if request.path.include?('/admin/resources')}" do %>
                <%= render_icon("bookopen", classes: "h-4 w-4") %>
                Resources
              <% end %>
              <%= link_to admin_reports_path, class: "fc-nav-link #{'is-active' if request.path.include?('/admin/reports')}" do %>
                <%= render_icon("shield", classes: "h-4 w-4") %>
                Reports
                <% pending_count = Report.pending.count %>
                <% if pending_count.positive? %>
                  <span class="rounded-full bg-red-100 px-1.5 py-0.5 text-[10px] font-extrabold text-red-700"><%= pending_count %></span>
                <% end %>
              <% end %>
            </nav>
          </div>

          <div class="flex items-center gap-2">
            <%= link_to feed_path, class: "fc-btn" do %>
              <%= render_icon("arrow_right", classes: "h-4 w-4 rotate-180") %>
              Site
            <% end %>
            <button type="button" class="fc-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode" data-controller="theme" data-action="theme#toggle">
              <span data-theme-target="lightIcon"><%= render_icon("moon", classes: "h-4 w-4") %></span>
              <span data-theme-target="darkIcon" class="hidden"><%= render_icon("sun", classes: "h-4 w-4") %></span>
            </button>
            <div class="fc-avatar">
              <% if current_user.profile.avatar.attached? %>
                <%= image_tag current_user.profile.avatar, class: "h-full w-full rounded-full object-cover" %>
              <% else %>
                <%= current_user.username.first.upcase %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <% if notice || alert %>
        <div class="mx-auto max-w-6xl px-4 pt-4">
          <% if notice %>
            <div class="mb-2 rounded-lg border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] px-4 py-3 text-sm font-semibold text-[var(--fc-soft)] shadow-sm">
              <%= notice %>
            </div>
          <% end %>
          <% if alert %>
            <div class="mb-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800 shadow-sm">
              <%= alert %>
            </div>
          <% end %>
        </div>
      <% end %>

      <main class="mx-auto w-full max-w-6xl px-4 py-7">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="fc-section-label mb-2">Admin Console</p>
            <h1 class="text-2xl font-extrabold text-[var(--fc-ink)]"><%= content_for(:page_title) || "Dashboard" %></h1>
          </div>
          <p class="text-sm font-semibold text-[var(--fc-muted)]">Signed in as <%= current_user.username %></p>
        </div>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
