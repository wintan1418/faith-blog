<!DOCTYPE html>
<html lang="en" class="h-full theme-light" data-theme="light">
  <head>
    <script>
      (function() {
        const saved = localStorage.getItem('fc-dark');
        const legacy = localStorage.getItem('theme');
        const serverDark = <%= current_user&.respond_to?(:dark_mode?) && current_user.dark_mode? ? "true" : "false" %>;
        const dark = saved === null
          ? (legacy ? legacy === 'dark' : (serverDark || window.matchMedia('(prefers-color-scheme: dark)').matches))
          : saved === '1';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('theme-dark', dark);
        document.documentElement.classList.toggle('theme-light', !dark);
      })();
    </script>
    <title><%= hotwire_native_app? ? (content_for?(:title) ? native_app_title : "Admin") : (content_for(:title) || "Admin - Brethreign") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <%# Same markers as the main layout: the apps read them to know you're still signed in
      (without them, opening Admin looked like a sign-out and sent the app back to Feed). %>
  <body class="h-full font-sans antialiased theme-light<%= ' hotwire-native' if hotwire_native_app? %>"
        data-native-signed-in="<%= user_signed_in? %>"
        data-native-admin="<%= user_signed_in? && current_user_admin? %>"
        <% if hotwire_native_app? && user_signed_in? %>
        data-native-unread-notifications="<%= current_user.unread_notifications_count.to_i %>"
        data-native-unread-messages="<%= current_user.unread_conversations_count.to_i %>"
        <% end %>>
    <script>
      (function() {
        var dark = document.documentElement.classList.contains('theme-dark');
        document.body.classList.toggle('theme-dark', dark);
        document.body.classList.toggle('theme-light', !dark);
      })();
    </script>

    <% pending_count = Report.pending.count %>
    <% queue_count = AiModerationReview.where(status: %i[pending flagged]).count %>
    <% admin_nav_items = [
      ["Dashboard", admin_root_path, "home", current_page?(admin_root_path)],
      ["Users", admin_users_path, "users", request.path.include?("/admin/users")],
      ["Posts", admin_posts_path, "filetext", request.path.include?("/admin/posts")],
      ["Rooms", admin_rooms_path, "message_circle", request.path.include?("/admin/rooms")],
      ["Resources", admin_resources_path, "bookopen", request.path.include?("/admin/resources")],
      ["Reports", admin_reports_path, "shield", request.path.include?("/admin/reports")],
      ["Moderation", admin_moderation_reviews_path, "sparkles", request.path.include?("/admin/moderation_reviews")],
      ["Verses", admin_bible_verses_path, "bookopen", request.path.include?("/admin/bible_verses")],
      ["Golden Breaths", admin_golden_breaths_path, "sparkles", request.path.include?("/admin/golden_breaths")],
      ["Broadcasts", admin_broadcasts_path, "send", request.path.include?("/admin/broadcasts")],
      ["Announcements", admin_announcements_path, "sparkles", request.path.include?("/admin/announcements")]
    ] %>

    <div class="fc-app fc-admin min-h-full">
      <div class="admin-shell">
        <aside class="admin-sidebar">
          <%= link_to admin_root_path, class: "admin-brand" do %>
            <span class="fc-brand-mark"><%= render_icon("sparkles", classes: "h-4 w-4") %></span>
            <span>
              <span class="block text-sm font-extrabold text-[var(--fc-ink)]">Brethreign</span>
              <span class="block text-xs font-bold text-[var(--fc-muted)]">Admin Console</span>
            </span>
          <% end %>

          <nav class="admin-side-nav" aria-label="Admin navigation">
            <% admin_nav_items.each do |label, path, icon, active| %>
              <%= link_to path, class: "admin-side-link #{'is-active' if active}" do %>
                <span class="admin-side-icon"><%= render_icon(icon, classes: "h-4 w-4") %></span>
                <span class="min-w-0 flex-1"><%= label %></span>
                <% if label == "Reports" && pending_count.positive? %>
                  <span class="admin-count"><%= pending_count %></span>
                <% elsif label == "Moderation" && queue_count.positive? %>
                  <span class="admin-count"><%= queue_count %></span>
                <% end %>
              <% end %>
            <% end %>
          </nav>

          <div class="admin-sidebar-footer">
            <%= link_to feed_path, class: "admin-side-link" do %>
              <span class="admin-side-icon"><%= render_icon("arrow_right", classes: "h-4 w-4 rotate-180") %></span>
              <span>Back to Site</span>
            <% end %>
          </div>
        </aside>

        <div class="admin-main">
          <header class="admin-topbar">
            <div class="min-w-0">
              <p class="fc-section-label mb-1">Admin Console</p>
              <h1 class="truncate text-2xl font-extrabold text-[var(--fc-ink)]"><%= content_for(:page_title) || "Dashboard" %></h1>
            </div>

            <div class="flex shrink-0 items-center gap-2">
              <%= link_to feed_path, class: "admin-back-to-app", title: "Back to app", aria: { label: "Back to app" } do %>
                <%= render_icon("arrow_right", classes: "h-4 w-4 rotate-180") %>
                <span class="admin-back-to-app-label">App</span>
              <% end %>

              <nav class="admin-mobile-nav" aria-label="Admin navigation">
                <% admin_nav_items.each do |label, path, icon, active| %>
                  <%= link_to path, class: "admin-mobile-link #{'is-active' if active}", title: label, aria: { label: label } do %>
                    <%= render_icon(icon, classes: "h-4 w-4") %>
                  <% end %>
                <% end %>
              </nav>
              <button type="button" class="fc-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode" data-controller="theme" data-action="theme#toggle">
                <span data-theme-target="lightIcon"><%= render_icon("moon", classes: "h-4 w-4") %></span>
                <span data-theme-target="darkIcon" class="hidden"><%= render_icon("sun", classes: "h-4 w-4") %></span>
              </button>
              <div class="fc-avatar" title="<%= current_user.username %>">
                <% if current_user.profile&.avatar&.attached? %>
                  <%= image_tag current_user.profile.avatar, class: "h-full w-full rounded-full object-cover", alt: current_user.username %>
                <% else %>
                  <%= current_user.username.first.upcase %>
                <% end %>
              </div>
            </div>
          </header>

          <% if notice || alert %>
            <div class="admin-flashes">
              <% if notice %>
                <div class="rounded-lg border border-[var(--fc-line-strong)] bg-[var(--fc-surface)] px-4 py-3 text-sm font-semibold text-[var(--fc-soft)] shadow-sm">
                  <%= notice %>
                </div>
              <% end %>
              <% if alert %>
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800 shadow-sm">
                  <%= alert %>
                </div>
              <% end %>
            </div>
          <% end %>

          <main class="admin-content">
            <%= yield %>
          </main>
        </div>
      </div>
    </div>
  </body>
</html>
