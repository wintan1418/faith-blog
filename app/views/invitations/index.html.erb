<% content_for(:title) { "Invite friends - Brethreign" } %>
<% content_for(:app_title) { "Invite friends" } %>
<% reward = Seeds::RULES["invite_joined"] %>
<% share_text = "Come join the conversation on Brethreign — a calm place to talk about work, life and faith." %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-5xl">
    <div class="cj-page-head">
      <span class="mystic-kicker">Invite friends</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Bring someone into the conversation.</h1>
      <p class="mystic-copy mt-2 max-w-2xl">Share your personal link anywhere. Anyone who joins through it is connected to you.</p>
    </div>

    <% if current_user.can_invite_by_link? %>
      <section class="cj-share" data-controller="invite-link" data-invite-link-message-value="<%= @invite_message %>"
               data-invite-link-title-value="Come join the conversation on Brethreign" data-invite-link-url-value="<%= @invite_url %>"
               aria-labelledby="cj-share-title">
        <div class="cj-share-head">
          <h2 id="cj-share-title" class="cj-share-title"><%= render_icon("link", classes: "h-5 w-5") %> Your invite link</h2>
          <span class="cj-reward"><%= render_icon("sprout", classes: "h-4 w-4") %> +<%= reward[:points] %> seeds when a friend joins and posts</span>
        </div>

        <div class="fc-invite-link-row cj-link-row">
          <input type="text" class="fc-invite-link-input" data-invite-link-target="input" value="<%= @invite_url %>"
                 readonly aria-label="Your invite link" data-action="focus->invite-link#select">
          <button type="button" class="fc-btn fc-btn-primary" data-invite-link-target="copyBtn" data-action="click->invite-link#copy">
            <%= render_icon("copy", classes: "h-4 w-4") %><span>Copy link</span>
          </button>
        </div>

        <div class="cj-share-row" role="group" aria-label="Share your invite">
          <button type="button" class="cj-share-btn is-native" hidden data-invite-link-target="nativeBtn" data-action="click->invite-link#share">
            <%= render_icon("share", classes: "h-4 w-4") %> Share…
          </button>
          <%= link_to "https://wa.me/?#{{ text: @invite_message }.to_query}", target: "_blank", rel: "noopener", class: "cj-share-btn is-whatsapp" do %>
            <span class="cj-share-glyph" aria-hidden="true"><%= render_icon("chat", classes: "h-3.5 w-3.5") %></span> WhatsApp
          <% end %>
          <%= link_to "https://twitter.com/intent/tweet?#{{ text: share_text, url: @invite_url }.to_query}", target: "_blank", rel: "noopener", class: "cj-share-btn is-x" do %>
            <span class="cj-share-glyph" aria-hidden="true">𝕏</span> X
          <% end %>
          <%= link_to "https://www.linkedin.com/sharing/share-offsite/?#{{ url: @invite_url }.to_query}", target: "_blank", rel: "noopener", class: "cj-share-btn is-linkedin" do %>
            <span class="cj-share-glyph" aria-hidden="true">in</span> LinkedIn
          <% end %>
          <%= link_to "https://www.facebook.com/sharer/sharer.php?#{{ u: @invite_url }.to_query}", target: "_blank", rel: "noopener", class: "cj-share-btn is-facebook" do %>
            <span class="cj-share-glyph" aria-hidden="true">f</span> Facebook
          <% end %>
          <%= link_to "mailto:?#{{ subject: "Come join the conversation on Brethreign", body: @invite_message }.to_query.gsub("+", "%20")}", class: "cj-share-btn is-email" do %>
            <span class="cj-share-glyph" aria-hidden="true"><%= render_icon("mail", classes: "h-3.5 w-3.5") %></span> Email
          <% end %>
        </div>

        <div class="cj-message">
          <label class="cj-message-label" for="cj-message">Ready-to-send message</label>
          <textarea id="cj-message" class="cj-message-text" rows="3" readonly data-invite-link-target="message"><%= @invite_message %></textarea>
          <button type="button" class="fc-btn cj-message-copy" data-invite-link-target="messageBtn" data-action="click->invite-link#copyMessage">
            <%= render_icon("copy", classes: "h-4 w-4") %><span>Copy message</span>
          </button>
        </div>
        <p class="cj-fine">Seeds are paid once per friend, after they publish their first breath or write their first comment (up to <%= reward[:daily_cap] %> friends a day). <%= link_to "How seeds work", seeds_guide_path %></p>
      </section>
    <% else %>
      <section class="cj-share">
        <p class="mystic-copy">Your personal invite link opens once you're 18. You can still invite friends by email below.</p>
      </section>
    <% end %>

    <section class="cj-joined" aria-labelledby="cj-joined-title">
      <div class="cj-joined-head">
        <h2 id="cj-joined-title" class="cj-share-title"><%= render_icon("users", classes: "h-5 w-5") %> Joined through you</h2>
        <span class="cj-joined-count"><%= @invitee_count %></span>
      </div>
      <% if @invitees.any? %>
        <ul class="cj-joined-list">
          <% @invitees.each do |person| %>
            <li class="cj-joined-item">
              <%= link_to user_path(person.username), class: "cj-joined-person" do %>
                <% if person.profile&.avatar&.attached? %>
                  <%= image_tag avatar_src(person.profile, 80), class: "cj-joined-face", alt: "" %>
                <% else %>
                  <span class="cj-joined-face is-initial" style="<%= avatar_tint_style(person.username) %>"><%= person.username.first.upcase %></span>
                <% end %>
                <span class="cj-joined-who">
                  <strong><%= person.display_name %></strong>
                  <small>Joined <%= time_ago_in_words(person.created_at) %> ago</small>
                </span>
              <% end %>
              <% if @rewarded_ids.include?(person.id) %>
                <span class="cj-joined-status is-paid"><%= render_icon("sprout", classes: "h-3.5 w-3.5") %> +<%= reward[:points] %></span>
              <% else %>
                <span class="cj-joined-status">Not posted yet</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="cj-joined-empty">No one yet. Send your link to someone who'd enjoy a calmer conversation.</p>
      <% end %>
    </section>

    <h2 class="cj-section-title">Invite by email</h2>

    <section class="mystic-panel-strong mb-6 p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-black text-[var(--fc-ink)]">Bulk invite — come and breathe</h2>
          <p class="mystic-copy mt-1 text-sm">Paste any number of emails (commas, spaces, or new lines). Each one gets the warm "Hey, glad to invite you" email with your optional note.</p>
        </div>
      </div>

      <%= form_with url: bulk_invitations_path, method: :post, class: "mt-5 space-y-4" do %>
        <label class="fc-cms-label">
          <span>Emails (up to 100 per batch)</span>
          <%= text_area_tag :bulk_emails, params[:bulk_emails],
              rows: 6,
              class: "fc-cms-input font-mono text-sm",
              placeholder: "abby@example.com, ben@example.com\ncara@example.com\ndan@example.com" %>
        </label>

        <label class="fc-cms-label">
          <span>Personal note (optional, sent to all)</span>
          <%= text_area_tag :bulk_message, params[:bulk_message],
              rows: 3,
              maxlength: 1_000,
              class: "fc-cms-input",
              placeholder: "I thought this community would bless you..." %>
        </label>

        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-bold text-[var(--fc-muted)]">Capped at 300 invites per 24 hours.</p>
          <%= button_tag class: "fc-btn fc-btn-primary" do %>
            <%= render_icon("send", classes: "h-4 w-4") %>
            Send the batch
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <section class="mystic-panel-strong p-6">
        <h2 class="text-xl font-black text-[var(--fc-ink)]">Send a single invite</h2>
        <p class="mystic-copy mt-1 text-sm">The recipient will get a signed join link.</p>

        <%= form_with model: @invitation, url: invitations_path, class: "mt-6 space-y-5" do |f| %>
          <% if @invitation.errors.any? %>
            <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">
              <%= @invitation.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <div>
            <%= f.label :email, "Email address", class: "label" %>
            <%= f.email_field :email, required: true, class: "input", placeholder: "friend@example.com" %>
          </div>

          <div>
            <%= f.label :message, "Personal note", class: "label" %>
            <%= f.text_area :message, rows: 5, maxlength: 1_000, class: "input", placeholder: "I thought this community would bless you..." %>
          </div>

          <%= f.button class: "fc-btn fc-btn-primary w-full justify-center" do %>
            <%= render_icon("send", classes: "h-4 w-4") %>
            Send Invitation
          <% end %>
        <% end %>
      </section>

      <section class="mystic-panel-strong overflow-hidden">
        <div class="border-b border-[var(--fc-line-strong)] p-6">
          <h2 class="text-xl font-black text-[var(--fc-ink)]">Sent invites</h2>
          <p class="mystic-copy mt-1 text-sm">Pending and accepted invitations from your account.</p>
        </div>

        <% if @invitations.any? %>
          <div class="divide-y divide-[var(--fc-line)]">
            <% @invitations.each do |invitation| %>
              <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="truncate font-black text-[var(--fc-ink)]"><%= invitation.email %></p>
                  <p class="mt-1 text-sm font-semibold text-[var(--fc-muted)]">
                    <% if invitation.accepted? %>
                      Accepted <%= time_ago_in_words(invitation.accepted_at) %> ago
                    <% elsif invitation.last_sent_at.present? %>
                      Sent <%= time_ago_in_words(invitation.last_sent_at) %> ago
                    <% else %>
                      Created <%= time_ago_in_words(invitation.created_at) %> ago
                    <% end %>
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="rounded-full border border-[var(--fc-line-strong)] px-3 py-1 text-xs font-black text-[var(--fc-muted)]">
                    <%= invitation.accepted? ? "Accepted" : "Pending" %>
                  </span>
                  <% unless invitation.accepted? %>
                    <%= button_to "Resend", resend_invitation_path(invitation), method: :post, class: "btn btn-secondary btn-sm" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-8 text-center">
            <h3 class="text-lg font-black text-[var(--fc-ink)]">No invites sent yet</h3>
            <p class="mystic-copy mx-auto mt-2 max-w-sm text-sm">Invite someone who would value slower, faith-filled conversation.</p>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
