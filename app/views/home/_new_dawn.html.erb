<%# "A new dawn": the new Brethreign mark rises like the sun over the
    horizon, then beats like a heart. Pure CSS (welcome.css, "New dawn"). The
    styles at rest ARE the final scene; the keyframes only run from night
    towards it, so the first paint is always complete, and
    prefers-reduced-motion simply shows the risen sun. %>
<% stars = [ [ 8, 12, 2 ], [ 18, 30, 1 ], [ 30, 8, 1 ], [ 44, 20, 2 ], [ 58, 6, 1 ], [ 66, 26, 1 ], [ 78, 12, 2 ], [ 88, 32, 1 ], [ 93, 8, 1 ], [ 12, 44, 1 ], [ 52, 38, 1 ] ] %>

<figure class="dawn-wrap">
  <div class="dawn" role="img" aria-label="The new Brethreign logo rises like the sun at dawn.">
    <span class="dawn-sky dawn-sky-night"></span>
    <span class="dawn-sky dawn-sky-dawn"></span>
    <span class="dawn-stars">
      <% stars.each do |x, y, size| %>
        <i style="left: <%= x %>%; top: <%= y %>%;"<%= ' class="is-big"'.html_safe if size == 2 %>></i>
      <% end %>
    </span>

    <span class="dawn-sun-path">
      <span class="dawn-sun">
        <span class="dawn-glow"></span>
        <span class="dawn-ripple"></span>
        <span class="dawn-beat"><%= render "shared/logomark", css_class: "dawn-mark", color: "#3cdb9d" %></span>
      </span>
    </span>

    <span class="dawn-ground"></span>
  </div>

  <figcaption class="dawn-caption">
    <span class="dawn-eyebrow">Our new look is here</span>
    <span class="dawn-line">A new dawn for Brethreign.</span>
  </figcaption>
</figure>
