<% content_for(:title) { "Faith Community - Stories, Prayer, Rooms" } %>

<div class="home-page">
  <section class="home-hero">
    <div class="home-container home-hero-grid">
      <div class="home-hero-copy">
        <span class="home-kicker">
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          Faith Community
        </span>
        <h1 class="home-title">A thoughtful home for stories, prayer, and wisdom.</h1>
        <p class="home-lede">
          Share testimonies, ask for prayer, join focused rooms, and keep spiritual resources close without the noise of a generic social feed.
        </p>
        <div class="home-actions">
          <% if user_signed_in? %>
            <%= link_to "Open Feed", feed_path, class: "home-btn home-btn-primary" %>
            <%= link_to "Browse Rooms", rooms_path, class: "home-btn home-btn-secondary" %>
          <% else %>
            <%= link_to "Join Community", new_user_registration_path, class: "home-btn home-btn-primary" %>
            <%= link_to "Sign In", new_user_session_path, class: "home-btn home-btn-secondary" %>
          <% end %>
        </div>
        <div class="home-quick-list" aria-label="Community features">
          <span>Prayer rooms</span>
          <span>Testimonies</span>
          <span>Saved resources</span>
        </div>
      </div>

      <div class="home-summary" aria-label="Community summary">
        <div class="home-summary-top">
          <span>Today</span>
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
        </div>
        <blockquote>
          "How good and pleasant it is when God's people live together in unity."
        </blockquote>
        <p>Psalm 133:1</p>
        <div class="home-stats">
          <div>
            <strong><%= @rooms.size %></strong>
            <span>Rooms</span>
          </div>
          <div>
            <strong><%= @featured_posts.size %></strong>
            <span>Featured</span>
          </div>
          <div>
            <strong>24/7</strong>
            <span>Prayer</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <div>
          <span class="home-kicker">Rooms</span>
          <h2>Find the right room for the conversation.</h2>
        </div>
        <%= link_to "View all rooms", rooms_path, class: "home-link-btn" %>
      </div>

      <div class="home-card-grid">
        <% @rooms.first(6).each do |room| %>
          <%= link_to room_path(room), class: "home-room-card" do %>
            <div class="home-card-icon">
              <%= render_icon(room.icon || "sparkles", classes: "h-5 w-5") %>
            </div>
            <h3><%= room.name %></h3>
            <p><%= room.description %></p>
            <div class="home-card-meta">
              <span><%= pluralize(room.posts_count, "post") %></span>
              <span><%= pluralize(room.members_count, "member") %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <% if @featured_posts.any? %>
    <section class="home-section home-section-featured">
      <div class="home-container">
        <div class="home-section-head">
          <div>
            <span class="home-kicker">Featured</span>
            <h2>Stories worth slowing down for.</h2>
          </div>
        </div>

        <div class="home-story-grid">
          <% @featured_posts.each do |post| %>
            <%= link_to post_path(post), class: "home-story-card" do %>
              <div class="home-story-meta">
                <span><%= post.room.name %></span>
                <time><%= time_ago_in_words(post.published_at || post.created_at) %> ago</time>
              </div>
              <h3><%= post.title %></h3>
              <p><%= post.content.to_plain_text.truncate(180) %></p>
              <div class="home-story-foot">
                <span><%= post.anonymous? ? "Anonymous" : post.user.username %></span>
                <span><%= pluralize(post.comments_count, "comment") %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>
