<%# The front door for signed-out web visitors at "/".
    Computers: "A new dawn" (the logo story) large on the left with the
    wordmark, headline and actions on the right. Phones: stacked, the scene as
    a short banner on top. "Get the app" (coming soon + waitlist) sits under
    the actions. The public feed is behind "Look around first". %>
<% content_for(:title) { "Brethreign · Sane, kind conversations about work, life and faith" } %>
<% content_for(:meta_description) { "Brethreign is a social space with faith at its centre and room for everyone. Share what is on your heart, ask big questions and have sane, respectful conversations about life, work, relationships and belief. Free on the web and Android." } %>
<% content_for(:og_description) { "Faith at the centre, everyone welcome. Sane, kind conversations about everything. Free on the web and Android." } %>
<% content_for(:bare_page) { "1" } %>

<div class="welcome">
  <div class="welcome-grid">
    <div class="welcome-brand">
      <%= render "home/new_dawn" %>
      <span class="welcome-word" aria-hidden="true">Brethreign</span>
    </div>

    <section class="welcome-main" aria-labelledby="welcome-title">
      <h1 id="welcome-title" class="welcome-title">Faith at the centre. Everyone welcome.</h1>
      <p class="welcome-sub">Sane, kind conversations about everything.</p>

      <div class="auth welcome-actions">
        <h2 class="welcome-h2">Join today</h2>
        <%= render "devise/shared/google_sign_in", divider: "or" %>
        <%= link_to "Create account", new_user_registration_path, class: "welcome-btn welcome-btn-primary" %>
        <p class="welcome-legal">
          By joining you agree to our <%= link_to "Terms", terms_path %>
          and <%= link_to "Privacy Policy", privacy_path %>.
        </p>

        <h3 class="welcome-h3">Already have an account?</h3>
        <%= link_to "Sign in", new_user_session_path, class: "welcome-btn welcome-btn-outline" %>

        <%= link_to "Look around first", root_path(browse: 1), class: "welcome-browse", data: { guest_gate_allow: true } %>
      </div>

      <%= render "home/get_the_app" %>
    </section>
  </div>

  <footer class="welcome-footer" aria-label="About Brethreign">
    <nav>
      <%= link_to "About", about_path %>
      <%= link_to "Privacy", privacy_path %>
      <%= link_to "Terms", terms_path %>
      <%= link_to "Child safety", child_safety_path %>
    </nav>
    <span>&copy; <%= Date.current.year %> Brethreign</span>
  </footer>
</div>
