<%
  user_like = user_signed_in? ? current_user.likes.find_by(likeable: comment) : nil
  emoji_counts = comment.likes
                        .where.not(reaction_emoji: [ nil, "" ])
                        .group(:reaction_emoji)
                        .count
                        .sort_by { |_, c| -c }
                        .first(3)
                        .to_h
  default_emoji = "🙏"
%>

<span class="fc-reactions" id="<%= dom_id(comment, :reactions) %>">
  <% emoji_counts.each do |emoji, count| %>
    <% mine = user_like&.display_emoji == emoji %>
    <% if mine %>
      <%= button_to unlike_path(likeable_type: "Comment", likeable_id: comment.id),
          method: :delete,
          form_class: "inline",
          class: "fc-reaction-pill is-mine",
          title: "Remove your reaction" do %>
        <span class="fc-reaction-emoji"><%= emoji %></span>
        <span class="fc-reaction-count"><%= count %></span>
      <% end %>
    <% else %>
      <%= button_to likes_path(likeable_type: "Comment", likeable_id: comment.id, reaction_emoji: emoji),
          form_class: "inline",
          class: "fc-reaction-pill" do %>
        <span class="fc-reaction-emoji"><%= emoji %></span>
        <span class="fc-reaction-count"><%= count %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if user_signed_in? && user_like.nil? && emoji_counts.empty? %>
    <%= button_to likes_path(likeable_type: "Comment", likeable_id: comment.id, reaction_emoji: default_emoji),
        form_class: "inline",
        class: "fc-reaction-add",
        title: "Amen" do %>
      <span class="fc-reaction-emoji"><%= default_emoji %></span>
      <span class="fc-reaction-add-label">Amen</span>
    <% end %>
  <% elsif !user_signed_in? && emoji_counts.empty? %>
    <%= link_to new_user_session_path, class: "fc-reaction-add" do %>
      <span class="fc-reaction-emoji"><%= default_emoji %></span>
      <span class="fc-reaction-add-label">Amen</span>
    <% end %>
  <% end %>
</span>
