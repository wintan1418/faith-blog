<%
  user_like = user_signed_in? ? current_user.likes.find_by(likeable: comment) : nil
  emoji_counts = comment.likes
                        .where.not(reaction_emoji: [ nil, "" ])
                        .group(:reaction_emoji)
                        .count
                        .sort_by { |_, c| -c }
                        .first(3)
                        .to_h
%>

<span class="fc-reactions" id="<%= dom_id(comment, :reactions) %>" data-controller="emoji-reactions"
      data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Comment", likeable_id: comment.id) %>"
      data-emoji-reactions-token-value="<%= form_authenticity_token %>">
  <% emoji_counts.each do |emoji, count| %>
    <% mine = user_like&.display_emoji == emoji %>
    <% if mine %>
      <%= button_to unlike_path(likeable_type: "Comment", likeable_id: comment.id),
          method: :delete,
          form_class: "inline",
          class: "fc-reaction-pill is-mine",
          title: "Remove your reaction" do %>
        <span class="fc-reaction-emoji"><%= emoji %></span>
        <span class="fc-reaction-count"><%= count %></span>
      <% end %>
    <% else %>
      <%= button_to likes_path(likeable_type: "Comment", likeable_id: comment.id, reaction_emoji: emoji),
          form_class: "inline",
          class: "fc-reaction-pill" do %>
        <span class="fc-reaction-emoji"><%= emoji %></span>
        <span class="fc-reaction-count"><%= count %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if user_signed_in? %>
    <% if emoji_counts.empty? && user_like.nil? %>
      <%= button_to likes_path(likeable_type: "Comment", likeable_id: comment.id, reaction_emoji: "🙏"),
          form_class: "inline",
          class: "fc-reaction-add",
          title: "Amen" do %>
        <span class="fc-reaction-emoji">🙏</span>
        <span class="fc-reaction-add-label">Amen</span>
      <% end %>
    <% end %>
    <button type="button"
            class="fc-reaction-add"
            data-action="click->emoji-reactions#toggle"
            aria-label="Add reaction">
      <%= render_icon("smile", classes: "h-4 w-4") %>
    </button>
    <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
      <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
    </div>
  <% else %>
    <%= link_to "React", new_user_session_path, class: "fc-reaction-add" %>
  <% end %>
</span>
