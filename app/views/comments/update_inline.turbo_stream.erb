<%# Re-render the inline thread frame after an edit or delete from a feed card. %>
<%
  comments = @post.comments.root_comments.active.visible_for(current_user)
                  .includes(:user, :replies)
                  .order(created_at: :desc)
                  .limit(3)
%>
<%= turbo_stream.replace dom_id(@post, :thread) do %>
  <%= render "posts/inline_thread", post: @post, comments: comments, new_comment: Comment.new %>
<% end %>
