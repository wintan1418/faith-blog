<%= form_with model: [post, comment], id: "comment_form", class: "flex items-start gap-3" do |f| %>
  <% if current_user.profile.avatar.attached? %>
    <%= image_tag current_user.profile.avatar, class: "mystic-avatar h-10 w-10 shrink-0 object-cover" %>
  <% else %>
    <span class="mystic-avatar mystic-avatar-fallback grid h-10 w-10 shrink-0 place-items-center font-bold">
      <%= current_user.username.first.upcase %>
    </span>
  <% end %>

  <div class="min-w-0 flex-1" data-controller="emoji-picker">
    <div class="mb-2 flex items-center justify-between">
      <label class="text-sm font-bold text-faith-dark">Your Comment</label>
      <button type="button"
              data-emoji-picker-target="button"
              data-action="click->emoji-picker#toggle"
              class="mystic-action rounded-full p-2"
              title="Add emoji">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </button>
    </div>

    <div class="relative">
      <%= f.rich_text_area :content,
          class: "trix-content input min-h-36",
          placeholder: "Share encouragement, wisdom, or a prayer...",
          data: { controller: "mentions" } %>

      <div data-emoji-picker-target="picker" class="absolute bottom-full right-0 z-50 mb-2 hidden">
        <emoji-picker
          style="width: 320px; height: 360px;"
          skin-tone-emoji="👍"
          class="rounded-2xl border border-faith-green/10 shadow-xl">
        </emoji-picker>
      </div>
    </div>

    <div class="mt-3 flex items-center justify-end">
      <%= f.submit "Post Comment", class: "btn btn-primary btn-sm" %>
    </div>
  </div>
<% end %>
