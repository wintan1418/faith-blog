<div class="p-5 sm:p-6" id="<%= dom_id(comment) %>">
  <div class="flex items-start gap-3">
    <%= link_to user_path(comment.user.username), class: "shrink-0" do %>
      <% if comment.user.profile.avatar.attached? %>
        <%= image_tag comment.user.profile.avatar, class: "mystic-avatar h-10 w-10 object-cover" %>
      <% else %>
        <span class="mystic-avatar mystic-avatar-fallback grid h-10 w-10 place-items-center text-sm font-bold">
          <%= comment.user.username.first.upcase %>
        </span>
      <% end %>
    <% end %>

    <div class="min-w-0 flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <%= link_to comment.user.username, user_path(comment.user.username), class: "font-bold text-faith-dark hover:text-faith-green" %>
        <time class="text-xs font-semibold text-faith-muted" datetime="<%= comment.created_at.iso8601 %>">
          <%= time_ago_in_words(comment.created_at) %> ago
        </time>
        <% if comment.edited? %>
          <span class="text-xs font-semibold text-faith-muted">(edited)</span>
        <% end %>
      </div>

      <% if comment.deleted? %>
        <p class="italic text-faith-muted"><%= comment.content %></p>
      <% else %>
        <div class="prose-faith text-base">
          <%= render_with_mentions(comment.content) %>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-3">
          <% if user_signed_in? %>
            <% if current_user.has_liked?(comment) %>
              <%= button_to unlike_path(likeable_type: "Comment", likeable_id: comment.id), method: :delete, class: "text-xs font-bold text-faith-green hover:text-faith-dark", data: { turbo_frame: "_top" } do %>
                Pray <%= comment.likes_count %>
              <% end %>
            <% else %>
              <%= button_to likes_path(likeable_type: "Comment", likeable_id: comment.id), class: "text-xs font-bold text-faith-muted hover:text-faith-green", data: { turbo_frame: "_top" } do %>
                Pray <%= comment.likes_count > 0 ? comment.likes_count : "" %>
              <% end %>
            <% end %>
          <% else %>
            <span class="text-xs font-bold text-faith-muted">Pray <%= comment.likes_count %></span>
          <% end %>

          <% if user_signed_in? && comment.depth < 2 %>
            <button type="button"
                    class="text-xs font-bold text-faith-muted hover:text-faith-green"
                    data-controller="reply-toggle"
                    data-action="click->reply-toggle#toggle">
              Reply
            </button>
          <% end %>

          <% if user_signed_in? && (comment.user == current_user || current_user.admin_or_moderator?) %>
            <%= button_to post_comment_path(post, comment), method: :delete, class: "text-xs font-bold text-faith-muted hover:text-red-600", data: { turbo_confirm: "Delete this comment?" } do %>
              Delete
            <% end %>
          <% end %>

          <% if user_signed_in? && comment.user != current_user %>
            <%= render "reports/button", reportable: comment, label: "Report", classes: "text-xs font-bold text-faith-muted hover:text-red-600" %>
          <% end %>
        </div>

        <% if user_signed_in? && comment.depth < 2 %>
          <div class="mt-4 hidden" data-reply-toggle-target="form">
            <%= form_with url: reply_post_comment_path(post, comment), class: "flex items-start gap-2" do |f| %>
              <%= f.text_area :content, class: "input resize-none text-sm", rows: 2, placeholder: "Write a reply..." %>
              <%= f.submit "Reply", class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if comment.replies.active.any? %>
        <div class="mt-5 space-y-4 border-l-2 border-faith-green/10 pl-4">
          <% comment.replies.active.oldest_first.each do |reply| %>
            <%= render "comments/comment", comment: reply, post: post %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
