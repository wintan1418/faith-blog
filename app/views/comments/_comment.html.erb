<% if comment.held_for_review? && !comment.visible_to?(current_user) %>
  <div class="fc-comment fc-comment-held" id="<%= dom_id(comment) %>">
    <div class="fc-held-placeholder">
      <%= render_icon("shield", classes: "h-5 w-5") %>
      <p>This reply is held for moderator review.</p>
    </div>
  </div>
<% else %>
<div class="fc-comment<%= ' fc-comment-held-author' if comment.held_for_review? %>" id="<%= dom_id(comment) %>" data-controller="reply-toggle">
  <% if comment.held_for_review? && current_user == comment.user %>
    <div class="fc-held-banner">
      <%= render_icon("shield", classes: "h-4 w-4") %>
      <span>Held for moderator review — only you and moderators can see this reply for now.</span>
    </div>
  <% end %>
  <div class="fc-comment-grid">
    <%= link_to user_path(comment.user.username), class: "fc-comment-avatar" do %>
      <% if comment.user.profile&.avatar&.attached? %>
        <%= image_tag comment.user.profile.avatar, class: "fc-avatar object-cover", alt: comment.user.username %>
      <% else %>
        <span class="fc-avatar" style="<%= avatar_tint_style(comment.user.username) %>"><%= comment.user.username.first.upcase %></span>
      <% end %>
    <% end %>

    <div class="fc-comment-main">
      <header class="fc-comment-head">
        <%= link_to comment.user.username, user_path(comment.user.username), class: "fc-breath-name" %>
        <span class="fc-breath-handle">@<%= comment.user.username %></span>
        <span class="fc-breath-dot">·</span>
        <time class="fc-breath-time" datetime="<%= comment.created_at.iso8601 %>">
          <%= time_ago_in_words(comment.created_at) %> ago
        </time>
        <% if comment.edited? %><span class="fc-breath-time">(edited)</span><% end %>
      </header>

      <% if comment.deleted? %>
        <p class="fc-comment-deleted"><%= comment.content %></p>
      <% else %>
        <div class="fc-comment-body" data-controller="scripture">
          <%= render_with_mentions(comment.content) %>
        </div>

        <div class="fc-comment-actions">
          <%= render "comments/reaction", comment: comment %>

          <% if user_signed_in? && comment.depth < 2 %>
            <button type="button"
                    class="fc-breath-action"
                    data-action="click->reply-toggle#toggle">
              <%= render_icon("message_circle", classes: "h-4 w-4") %>
              <span>Reply</span>
            </button>
          <% end %>

          <% if user_signed_in? && (comment.user == current_user || current_user.admin_or_moderator?) %>
            <%= button_to post_comment_path(post, comment),
                method: :delete,
                form_class: "inline",
                class: "fc-breath-action",
                data: { turbo_confirm: "Delete this comment?" } do %>
              <span>Delete</span>
            <% end %>
          <% end %>

          <% if user_signed_in? && comment.user != current_user %>
            <%= render "reports/button", reportable: comment, label: "Report" %>
          <% end %>
        </div>

        <% if user_signed_in? && comment.depth < 2 %>
          <div class="fc-comment-reply-form hidden" data-reply-toggle-target="form">
            <%= form_with url: reply_post_comment_path(post, comment), scope: :comment, class: "fc-inline-reply" do |f| %>
              <% if current_user.profile&.avatar&.attached? %>
                <%= image_tag current_user.profile.avatar, class: "fc-avatar object-cover" %>
              <% else %>
                <span class="fc-avatar" style="<%= avatar_tint_style(current_user.username) %>"><%= current_user.username.first.upcase %></span>
              <% end %>
              <div class="fc-inline-reply-body">
                <%= f.text_area :content,
                    class: "fc-inline-reply-input",
                    rows: 2,
                    placeholder: "Write a reply...",
                    data: { controller: "mentions" } %>
                <div class="fc-inline-reply-actions">
                  <div class="fc-inline-reply-tools">
                    <button type="button"
                            class="fc-composer-icon-btn"
                            title="Open Bible"
                            aria-label="Open Bible"
                            data-action="click->bible-drawer#open">
                      <%= render_icon("bookopen", classes: "h-4 w-4") %>
                    </button>
                  </div>
                  <%= f.submit "Reply", class: "fc-btn fc-btn-primary fc-inline-reply-submit" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if comment.replies.active.any? %>
        <div class="fc-comment-replies">
          <% comment.replies.active.oldest_first.each do |reply| %>
            <%= render "comments/comment", comment: reply, post: post %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>
