<div id="<%= dom_id(post, :comments_list) %>" class="cm-list">
  <% comments = post.comments.root_comments.active.visible_for(current_user).includes(:replies, likes: :user, user: { profile: { avatar_attachment: :blob } }).oldest_first %>
  <% if comments.any? %>
    <% comments.each do |comment| %>
      <%= render "comments/comment", comment: comment, post: post %>
    <% end %>
  <% else %>
    <div class="p-8 text-center">
      <p class="text-faith-muted">No comments yet. Be the first to share your thoughts.</p>
    </div>
  <% end %>
</div>
