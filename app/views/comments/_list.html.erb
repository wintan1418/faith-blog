<div id="<%= dom_id(post, :comments_list) %>" class="divide-y divide-faith-green/10">
  <% comments = post.comments.root_comments.active.includes(:user, :replies).oldest_first %>
  <% if comments.any? %>
    <% comments.each do |comment| %>
      <%= render "comments/comment", comment: comment, post: post %>
    <% end %>
  <% else %>
    <div class="p-8 text-center">
      <p class="text-faith-muted">No comments yet. Be the first to share your thoughts.</p>
    </div>
  <% end %>
</div>
