<%# Like button for a bot update (same emoji picker as breaths). Local: item, my_reaction %>
<div class="fc-reactions" id="<%= dom_id(item, :reactions) %>" data-controller="emoji-reactions"
     data-emoji-reactions-url-value="<%= likes_path(likeable_type: "BotItem", likeable_id: item.id) %>"
     data-emoji-reactions-token-value="<%= form_authenticity_token %>">
  <button type="button" class="fc-breath-action fc-react-btn<%= ' is-mine' if my_reaction %>"
          data-action="click->emoji-reactions#toggle" aria-label="React to this update" title="Like">
    <% if my_reaction %>
      <span class="fc-react-emoji"><%= my_reaction.display_emoji %></span>
    <% else %>
      <%= render_icon("thumbsup", classes: "h-5 w-5") %>
    <% end %>
    <span class="fc-react-label">Like<%= " · #{item.likes_count}" if item.likes_count.positive? %></span>
  </button>
  <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
    <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
  </div>
</div>
