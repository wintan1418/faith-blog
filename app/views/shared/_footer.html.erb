<footer class="mystic-footer text-white py-12">
  <div class="mystic-container">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="mb-4 flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-2xl bg-white/10 text-white">
            <%= render_icon("sparkles", classes: "w-5 h-5") %>
          </span>
          <div>
            <p class="font-bold">Faith Community</p>
            <p class="text-sm text-white/65">A thoughtful home for faith-filled conversation.</p>
          </div>
        </div>
        <p class="max-w-xl text-sm leading-6 text-white/70">
          Share testimonies, ask for prayer, join rooms, save resources, and keep walking with people who are serious about encouragement and wisdom.
        </p>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-white/80">Explore</h4>
        <ul class="space-y-2 text-sm text-white/65">
          <li><%= link_to "Home", root_path, class: "hover:text-white" %></li>
          <li><%= link_to "Rooms", rooms_path, class: "hover:text-white" %></li>
          <li><%= link_to "Resources", resources_root_path, class: "hover:text-white" %></li>
          <li><%= link_to "About", about_path, class: "hover:text-white" %></li>
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-white/80">Community</h4>
        <ul class="space-y-2 text-sm text-white/65">
          <li><%= link_to "Guidelines", guidelines_path, class: "hover:text-white" %></li>
          <li><%= link_to "Contact", contact_path, class: "hover:text-white" %></li>
          <% if user_signed_in? %>
            <li><%= link_to "Bookmarks", bookmarks_path, class: "hover:text-white" %></li>
            <li><%= link_to "Connections", my_connections_path, class: "hover:text-white" %></li>
          <% else %>
            <li><%= link_to "Sign In", new_user_session_path, class: "hover:text-white" %></li>
            <li><%= link_to "Join", new_user_registration_path, class: "hover:text-white" %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-sm text-white/55">
      &copy; <%= Date.current.year %> Faith Community.
    </div>
  </div>
</footer>
