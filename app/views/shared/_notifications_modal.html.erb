<% return unless user_signed_in? %>

<dialog data-notifications-modal-target="dialog"
        data-action="mousedown->notifications-modal#backdropClick"
        class="fc-notif-dialog">
  <div class="fc-notif-panel">
    <%= turbo_frame_tag "notifications_panel", src: nil, loading: "lazy" do %>
      <div class="fc-notif-loading">Loading…</div>
    <% end %>
  </div>
</dialog>
