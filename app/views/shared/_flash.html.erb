<% if notice || alert %>
  <div class="fc-toast-stack" data-controller="flash">
    <% if notice %>
      <div class="fc-toast is-success" role="status" data-flash-target="message">
        <span class="fc-toast-dot" aria-hidden="true"></span>
        <span class="fc-toast-text"><%= notice %></span>
        <button type="button" class="fc-toast-close" data-action="click->flash#dismiss" aria-label="Dismiss">×</button>
      </div>
    <% end %>
    <% if alert %>
      <div class="fc-toast is-error" role="alert" data-flash-target="message">
        <span class="fc-toast-dot" aria-hidden="true"></span>
        <span class="fc-toast-text"><%= alert %></span>
        <button type="button" class="fc-toast-close" data-action="click->flash#dismiss" aria-label="Dismiss">×</button>
      </div>
    <% end %>
  </div>
<% end %>
