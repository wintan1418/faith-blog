<%# The Brethreign logomark: a "B" with two soft halos, from the brand pack
    (brethreign-logomark-*.svg). Drawn in currentColor, so CSS picks the
    colour; pass color: "#3cdb9d" to fix it. Decorative; label the thing
    around it. locals: css_class (optional), color (optional) %>
<%= brand_mark_svg(local_assigns[:css_class], color: local_assigns[:color]) %>
