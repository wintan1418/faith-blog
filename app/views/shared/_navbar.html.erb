<nav class="fc-topbar sticky top-0 z-50">
  <div class="fc-topbar-inner">
    <div class="flex min-w-0 items-center gap-4">
      <%= link_to root_path, class: "brethreign-brand", aria: { label: "Brethreign" } do %>
        <%# Custom brand mark — soft mint disc with a stylized 'breath' wave %>
        <span class="brethreign-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="brthGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%"   stop-color="#34d399"/>
                <stop offset="100%" stop-color="#059669"/>
              </linearGradient>
            </defs>
            <circle cx="16" cy="16" r="15" fill="url(#brthGrad)"/>
            <path d="M7 19 C 11 13, 14 13, 16 19 C 18 25, 21 25, 25 19"
                  fill="none" stroke="#042f1d" stroke-width="2.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="22" cy="11" r="1.6" fill="#042f1d"/>
          </svg>
        </span>
        <span class="brethreign-wordmark">
          <span class="brethreign-word">brethre<span class="brethreign-accent">i</span>gn</span>
          <span class="brethreign-tag">breathe!</span>
        </span>
      <% end %>

      <div class="hidden items-center gap-0.5 md:flex">
        <% if user_signed_in? %>
          <%= link_to feed_path, class: "fc-nav-link #{'is-active' if request.path.start_with?('/feed')}" do %>
            <%= render_icon("message_circle", classes: "h-4 w-4") %>
            Feed
          <% end %>
        <% else %>
          <%= link_to root_path, class: "fc-nav-link #{'is-active' if current_page?(root_path)}" do %>
            <%= render_icon("message_circle", classes: "h-4 w-4") %>
            Feed
          <% end %>
        <% end %>
        <%= link_to rooms_path, class: "fc-nav-link #{'is-active' if request.path.start_with?('/rooms')}" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
          Rooms
        <% end %>
        <%= link_to resources_root_path, class: "fc-nav-link #{'is-active' if request.path.start_with?('/resources') || request.path.start_with?('/resource_categories')}" do %>
          <%= render_icon("bookopen", classes: "h-4 w-4") %>
          Library
        <% end %>
      </div>
    </div>

    <div class="fc-topbar-actions">
      <% if user_signed_in? %>
        <%= form_with url: search_path, method: :get, class: "relative hidden min-w-0 lg:block" do %>
          <%= render_icon("search", classes: "absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#75847a]") %>
          <input type="text" name="q" placeholder="Search posts, people, resources..." class="fc-search">
        <% end %>

        <button type="button"
                class="fc-btn fc-btn-primary hidden sm:inline-flex"
                data-action="click->composer-modal#open">
          <span class="text-lg leading-none">+</span>
          Breathe
        </button>

        <div class="fc-topbar-icons">
          <button type="button" class="fc-icon-btn relative" title="Notifications" data-action="click->notifications-modal#open">
            <%= render_icon("sparkles", classes: "h-4 w-4") %>
            <% if current_user.unread_notifications_count.positive? %>
              <span class="fc-notif-pulse-badge"></span>
            <% end %>
          </button>

          <%= link_to conversations_path, class: "fc-icon-btn relative hidden sm:inline-flex", title: "Inbox" do %>
            <%= render_icon("mail", classes: "h-4 w-4") %>
            <% if current_user.unread_conversations_count.positive? %>
              <span class="fc-notif-pulse-badge is-mint"></span>
            <% end %>
          <% end %>

          <button type="button" class="fc-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode" data-controller="theme" data-action="theme#toggle">
            <span data-theme-target="lightIcon"><%= render_icon("moon", classes: "h-4 w-4") %></span>
            <span data-theme-target="darkIcon" class="hidden"><%= render_icon("sun", classes: "h-4 w-4") %></span>
          </button>
        </div>

        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="fc-avatar" aria-label="Open account menu">
            <% if current_user.profile.avatar.attached? %>
              <%= image_tag current_user.profile.avatar, class: "h-full w-full rounded-full object-cover" %>
            <% else %>
              <%= current_user.username.first.upcase %>
            <% end %>
          </button>

          <div data-dropdown-target="menu" class="fc-dropdown-menu hidden absolute right-0 mt-2 w-56 py-2 shadow-xl">
            <div class="fc-dropdown-head px-4 py-3">
              <p class="truncate text-sm font-bold text-[var(--fc-ink)]"><%= current_user.username %></p>
              <p class="truncate text-xs text-[var(--fc-muted)]"><%= current_user.email %></p>
            </div>
            <%= link_to "Profile", user_path(current_user.username), class: "fc-dropdown-item" %>
            <button type="button"
                    class="fc-dropdown-item w-full text-left"
                    data-action="click->bible-drawer#open click->dropdown#close">
              📖 Open Bible
            </button>
            <button type="button"
                    class="fc-dropdown-item w-full text-left"
                    data-pwa-target="enableBtn"
                    data-action="click->pwa#togglePush click->dropdown#close">
              🔕 Turn on push
            </button>
            <%= link_to "Library", resources_root_path, class: "fc-dropdown-item" %>
            <%= link_to "Drafts", drafts_path, class: "fc-dropdown-item" %>
            <%= link_to "Inbox", conversations_path, class: "fc-dropdown-item" %>
            <%= link_to "Invites", invitations_path, class: "fc-dropdown-item" %>
            <%= link_to "People", people_path, class: "fc-dropdown-item" %>
            <%= link_to "Connections", my_connections_path, class: "fc-dropdown-item" %>
            <%= link_to "Settings", edit_settings_profile_path, class: "fc-dropdown-item" %>
            <% if current_user_admin? %>
              <%= link_to "Admin Dashboard", admin_root_path, class: "fc-dropdown-item" %>
            <% end %>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "fc-dropdown-item fc-dropdown-danger w-full text-left" %>
          </div>
        </div>
      <% else %>
        <button type="button" class="fc-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode" data-controller="theme" data-action="theme#toggle">
          <span data-theme-target="lightIcon"><%= render_icon("moon", classes: "h-4 w-4") %></span>
          <span data-theme-target="darkIcon" class="hidden"><%= render_icon("sun", classes: "h-4 w-4") %></span>
        </button>
        <%= link_to "Sign In", new_user_session_path, class: "fc-nav-link" %>
        <%= link_to "Join", new_user_registration_path, class: "fc-btn fc-btn-primary" %>
      <% end %>
    </div>
  </div>
</nav>

<%# ── Mobile bottom navigation bar ── %>
<nav class="fc-bottom-nav" aria-label="Mobile navigation">
  <% if user_signed_in? %>
    <%= link_to feed_path, class: "fc-bottom-nav-item #{'is-active' if request.path.start_with?('/feed')}" do %>
      <%= render_icon("message_circle", classes: "h-5 w-5") %>
      <span>Feed</span>
    <% end %>
    <%= link_to rooms_path, class: "fc-bottom-nav-item #{'is-active' if request.path.start_with?('/rooms')}" do %>
      <%= render_icon("users", classes: "h-5 w-5") %>
      <span>Rooms</span>
    <% end %>
    <button type="button" class="fc-bottom-nav-item fc-bottom-nav-compose" data-action="click->composer-modal#open">
      <%= render_icon("send", classes: "h-5 w-5") %>
      <span>Breathe</span>
    </button>
    <button type="button"
            class="fc-bottom-nav-item"
            data-action="click->bible-drawer#open">
      <%= render_icon("bookopen", classes: "h-5 w-5") %>
      <span>Bible</span>
    </button>
    <%= link_to user_path(current_user.username), class: "fc-bottom-nav-item #{'is-active' if request.path == user_path(current_user.username)}" do %>
      <%= render_icon("users", classes: "h-5 w-5") %>
      <span>Profile</span>
    <% end %>
  <% else %>
    <%= link_to root_path, class: "fc-bottom-nav-item #{'is-active' if current_page?(root_path)}" do %>
      <%= render_icon("message_circle", classes: "h-5 w-5") %>
      <span>Feed</span>
    <% end %>
    <%= link_to rooms_path, class: "fc-bottom-nav-item #{'is-active' if request.path.start_with?('/rooms')}" do %>
      <%= render_icon("users", classes: "h-5 w-5") %>
      <span>Rooms</span>
    <% end %>
    <%= link_to resources_root_path, class: "fc-bottom-nav-item #{'is-active' if request.path.start_with?('/resources')}" do %>
      <%= render_icon("bookopen", classes: "h-5 w-5") %>
      <span>Library</span>
    <% end %>
    <%= link_to search_path, class: "fc-bottom-nav-item #{'is-active' if request.path.start_with?('/search')}" do %>
      <%= render_icon("search", classes: "h-5 w-5") %>
      <span>Search</span>
    <% end %>
    <%= link_to new_user_session_path, class: "fc-bottom-nav-item" do %>
      <%= render_icon("users", classes: "h-5 w-5") %>
      <span>Sign In</span>
    <% end %>
  <% end %>
</nav>

