<%# "Join to continue": opened by guest_gate_controller.js when a signed-out web
    visitor clicks further than the page they landed on. %>
<dialog class="guest-gate" aria-labelledby="guest-gate-title" aria-describedby="guest-gate-text"
        data-guest-gate-target="dialog" data-guest-gate-allow
        data-action="click->guest-gate#backdrop close->guest-gate#closed">
  <div class="guest-gate-card">
    <button type="button" class="guest-gate-close" aria-label="Close" data-action="guest-gate#close">
      <%= render_icon("x", classes: "h-5 w-5") %>
    </button>
    <span class="guest-gate-mark" aria-hidden="true">
      <%= render "shared/logomark" %>
    </span>
    <h2 id="guest-gate-title" class="guest-gate-title">Join Brethreign to keep reading</h2>
    <p id="guest-gate-text" class="guest-gate-text">Open breaths, meet people, pray together and join the conversation. It's free.</p>
    <div class="guest-gate-actions">
      <%= link_to "Create account", new_user_registration_path, class: "guest-gate-btn guest-gate-btn-primary", data: { turbo_frame: "_top", guest_gate_auth: true } %>
      <%= link_to "Sign in", new_user_session_path, class: "guest-gate-btn guest-gate-btn-outline", data: { turbo_frame: "_top", guest_gate_auth: true } %>
    </div>
  </div>
</dialog>
