<%# "Brethren you may know": a swipeable row of cards (LinkedIn's "People you may know"). %>
<% suggestions = local_assigns.fetch(:suggestions) %>
<% nudge = local_assigns.fetch(:nudge, false) %>
<% if suggestions.any? || nudge %>
  <section class="bys" aria-label="Brethren you may know">
    <div class="bys-head">
      <h2 class="bys-title">Brethren you may know</h2>
      <%= link_to "See all", suggested_people_path, class: "bys-all" %>
    </div>
    <div class="bys-row">
      <% if nudge %>
        <div class="bys-card bys-card--nudge">
          <div class="bys-nudge-icon" aria-hidden="true">⛪</div>
          <p class="bys-name">Help brethren find you</p>
          <p class="bys-reason">Add your assembly and what you do, and we'll suggest people from your church and your field.</p>
          <%= link_to "Add details", edit_settings_professional_path, class: "bys-connect" %>
        </div>
      <% end %>
      <% suggestions.each do |s| %>
        <%= render "shared/brethren_suggestion_card", s: s %>
      <% end %>
    </div>
  </section>
<% end %>
