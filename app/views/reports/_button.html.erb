<%= button_to reports_path,
    method: :post,
    params: {
      reportable_type: reportable.class.name,
      reportable_id: reportable.id,
      reason: local_assigns.fetch(:reason, "Submitted for moderator review.")
    },
    class: local_assigns.fetch(:classes, "fc-action text-[var(--fc-muted)] hover:text-red-600"),
    data: { turbo_confirm: "Report this for moderator review?", turbo_frame: "_top" },
    title: "Report" do %>
  <%= render_icon("flag", classes: "h-4 w-4") %>
  <span class="fc-action-label"><%= local_assigns[:label] || "Report" %></span>
<% end %>
