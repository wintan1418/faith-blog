<% content_for(:title) { @query.text.present? ? "#{@query.text} - Search - Brethreign" : "Search - Brethreign" } %>

<div class="srch-page">
  <header class="srch-head">
    <h1 class="srch-title">Search</h1>
    <%= form_with url: search_path, method: :get, class: "srch-form", role: "search",
                  data: { controller: "search-suggest", search_suggest_url_value: search_suggest_path,
                          search_suggest_clear_url_value: (user_signed_in? ? search_recent_path : nil),
                          action: "focusout->search-suggest#focusout", turbo_action: "advance" } do %>
      <% search_params.except(:q, :page).each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>
      <div class="srch-box">
        <%= render_icon("search", classes: "srch-box-ico") %>
        <input type="search" name="q" value="<%= @query.text %>" autocomplete="off" spellcheck="false"
               class="srch-input" placeholder="Search breaths, people, rooms, the Bible…"
               aria-label="Search Brethreign" role="combobox" aria-autocomplete="list" aria-expanded="false"
               aria-controls="srch-page-listbox" enterkeyhint="search"
               <%= "autofocus" if @query.text.blank? %>
               data-search-suggest-target="input"
               data-action="input->search-suggest#input keydown->search-suggest#keydown focus->search-suggest#focus click->search-suggest#focus">
        <button type="submit" class="srch-submit">Search</button>
      </div>
      <div id="srch-page-listbox" class="srch-dd" role="listbox" aria-label="Suggestions" hidden data-search-suggest-target="panel"></div>
    <% end %>
    <p class="srch-tips">
      Tips: <code>"exact phrase"</code> · <code>-word</code> to leave out · <code>from:username</code>
    </p>
  </header>

  <% if @query.text.present? %>
    <nav class="srch-tabs" aria-label="What to search">
      <%= search_tab_link("top", "Top", @tab) %>
      <%= search_tab_link("breaths", "Breaths", @tab) %>
      <%= search_tab_link("people", "People", @tab) %>
      <%= search_tab_link("rooms", "Rooms", @tab) %>
      <%= search_tab_link("bible", "Bible", @tab) %>
      <%= search_tab_link("resources", "Resources", @tab) %>
    </nav>

    <% if @tab == "breaths" %>
      <% active = %i[room from date type sort].count { |k| params[k].present? } + (@query.from_username && params[:from].blank? ? 1 : 0) %>
      <details class="srch-filters-wrap" <%= "open" if active.positive? %>>
        <summary class="srch-filters-toggle">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg> Filters<%= " (#{active})" if active.positive? %>
        </summary>
        <%= render "search/filters" %>
      </details>
    <% end %>

    <% if @suggestion %>
      <p class="srch-didyoumean">
        Did you mean
        <%= link_to @suggestion, search_path(search_params(q: [ @suggestion, (@query.from_username && "from:#{@query.from_username}") ].compact.join(" "), page: nil)), class: "srch-didyoumean-link" %>?
      </p>
    <% end %>

    <div class="srch-results">
      <%= render "search/tab_#{@tab}" %>
    </div>
  <% else %>
    <div class="srch-empty">
      <span class="srch-empty-ico"><%= render_icon("search", classes: "w-7 h-7") %></span>
      <h2 class="srch-empty-title">What are you looking for?</h2>
      <p class="srch-empty-copy">Find breaths, people, rooms, a Bible verse (try “John 3 16”) or something from the library.</p>
      <div class="srch-chips">
        <% %w[testimony prayer faith hope healing worship].each do |word| %>
          <%= link_to word, search_path(q: word), class: "srch-chip" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
