<% content_for(:title) { "Search - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container max-w-4xl py-12">
      <div class="text-center">
        <span class="mystic-kicker mx-auto">
          <%= render_icon("search", classes: "w-4 h-4") %>
          Search
        </span>
        <h1 class="mystic-title mt-4 text-4xl sm:text-6xl">Discover stories, people, and resources.</h1>
        <p class="mystic-copy mx-auto mt-4 max-w-2xl text-lg">Search across posts, community members, and library resources.</p>
      </div>

      <%= form_with url: search_path, method: :get, class: "mx-auto mt-8 max-w-2xl" do %>
        <div class="relative">
          <%= render_icon("search", classes: "absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-faith-muted") %>
          <input type="text" name="q" value="<%= @query %>"
                 class="input h-14 rounded-full pl-12 pr-28 text-base"
                 placeholder="Search posts, users, resources..." autofocus>
          <button type="submit" class="btn btn-primary absolute right-2 top-1/2 -translate-y-1/2">Search</button>
        </div>
      <% end %>
    </div>
  </section>

  <div class="mystic-container max-w-4xl py-8">
    <% if @query.present? %>
      <div class="mb-8 flex flex-wrap justify-center gap-2">
        <%= link_to "Posts", search_path(q: @query), class: "px-5 py-2.5 rounded-full text-sm font-bold transition-all #{@result_type == :posts || @result_type.nil? ? 'bg-faith-green text-white' : 'mystic-badge'}" %>
        <%= link_to "People", search_path(q: @query, type: "users"), class: "px-5 py-2.5 rounded-full text-sm font-bold transition-all #{@result_type == :users ? 'bg-faith-green text-white' : 'mystic-badge'}" %>
        <%= link_to "Resources", search_path(q: @query, type: "resources"), class: "px-5 py-2.5 rounded-full text-sm font-bold transition-all #{@result_type == :resources ? 'bg-faith-green text-white' : 'mystic-badge'}" %>
      </div>

      <% if @results&.any? %>
        <p class="mb-6 text-center text-sm font-semibold text-faith-muted">
          Found <span class="text-faith-dark"><%= @results.count %></span> results for "<span class="text-faith-dark"><%= @query %></span>"
        </p>

        <% case @result_type %>
        <% when :posts, nil %>
          <div class="space-y-5">
            <% @results.each do |post| %>
              <%= render "posts/card", post: post %>
            <% end %>
          </div>
        <% when :users %>
          <div class="space-y-4">
            <% @results.each do |user| %>
              <div class="mystic-panel flex items-center gap-4 p-5">
                <% if user.profile.avatar.attached? %>
                  <%= image_tag user.profile.avatar, class: "mystic-avatar h-16 w-16 object-cover" %>
                <% else %>
                  <span class="mystic-avatar mystic-avatar-fallback grid h-16 w-16 place-items-center text-xl font-bold">
                    <%= user.username.first.upcase %>
                  </span>
                <% end %>
                <div class="min-w-0 flex-1">
                  <%= link_to user.display_name.presence || user.username, user_path(user.username), class: "text-lg font-bold text-faith-dark hover:text-faith-green" %>
                  <p class="text-sm font-semibold text-faith-muted">@<%= user.username %></p>
                  <% if user.profile.bio.present? %>
                    <p class="mystic-copy mt-1 line-clamp-2 text-sm"><%= user.profile.bio %></p>
                  <% end %>
                </div>
                <% if user_signed_in? && user != current_user %>
                  <% if current_user.following?(user) %>
                    <%= button_to "Following", unfollow_user_path(user.username), method: :delete, class: "btn btn-secondary" %>
                  <% else %>
                    <%= button_to "Follow", follow_user_path(user.username), class: "btn btn-primary" %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% when :resources %>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <% @results.each do |resource| %>
              <%= link_to resources_item_path(resource), class: "mystic-card-link mystic-panel p-5" do %>
                <div class="mb-4 flex items-start justify-between gap-4">
                  <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white/75 text-faith-green">
                    <%= render_icon(resource.type_icon, classes: "w-6 h-6") %>
                  </span>
                  <span class="mystic-badge px-3 py-1"><%= resource.resource_type.titleize %></span>
                </div>
                <h3 class="text-lg font-bold text-faith-dark"><%= resource.title %></h3>
                <p class="mystic-copy mt-2 line-clamp-3 text-sm"><%= resource.description %></p>
                <p class="mt-4 text-xs font-bold uppercase tracking-wide text-faith-muted"><%= resource.resource_category.name %></p>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if @pagy&.pages.to_i > 1 %>
          <div class="mt-8">
            <%== pagy_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <div class="mystic-panel p-12 text-center">
          <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-white/75 text-faith-green">
            <%= render_icon("search", classes: "w-8 h-8") %>
          </div>
          <h2 class="text-xl font-bold text-faith-dark">No results found</h2>
          <p class="mystic-copy mt-2">We could not find anything matching "<%= @query %>".</p>
          <div class="mt-6 flex justify-center gap-3">
            <%= link_to "Browse Rooms", rooms_path, class: "btn btn-secondary" %>
            <%= link_to "Explore Feed", feed_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="mystic-panel p-12 text-center">
        <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-white/75 text-faith-green">
          <%= render_icon("search", classes: "w-8 h-8") %>
        </div>
        <h2 class="text-xl font-bold text-faith-dark">What are you looking for?</h2>
        <p class="mystic-copy mx-auto mt-2 max-w-md">Try a topic, username, resource title, or room theme.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <% %w[testimony prayer faith hope healing worship].each do |tag| %>
            <%= link_to "##{tag}", search_path(q: tag), class: "mystic-badge px-4 py-2" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
