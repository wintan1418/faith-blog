<% content_for(:title) { "Bookmarks - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container max-w-4xl py-10 sm:py-14">
      <span class="mystic-kicker">
        <%= render_icon("bookmark", classes: "w-4 h-4") %>
        Saved
      </span>
      <h1 class="mystic-title mt-4 text-4xl sm:text-5xl">Saved Posts</h1>
      <p class="mystic-copy mt-3 text-lg">Posts you bookmarked for later reading and reflection.</p>
    </div>
  </section>

  <div class="mystic-container max-w-4xl py-8">
    <% if @posts.any? %>
      <div class="space-y-5">
        <% @posts.each do |post| %>
          <%= render "posts/card", post: post %>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-8">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="mystic-panel p-12 text-center">
        <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-white/75 text-faith-green">
          <%= render_icon("bookmark", classes: "w-8 h-8") %>
        </div>
        <h2 class="text-xl font-bold text-faith-dark">No bookmarks yet</h2>
        <p class="mystic-copy mx-auto mt-2 max-w-md">Save posts you want to revisit by using the save action on a post.</p>
        <%= link_to "Explore Posts", feed_path, class: "btn btn-primary mt-6" %>
      </div>
    <% end %>
  </div>
</div>
