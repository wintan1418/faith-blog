<% content_for(:title) { "Library · Brethreign" } %>

<%
  type_tint = ->(t) {
    case t.to_s
    when /article|blog/   then "article"
    when /video/          then "video"
    when /audio|podcast|sermon/ then "audio"
    when /book|ebook/     then "book"
    when /guide|study/    then "guide"
    else "default"
    end
  }

  total_resources = (@featured_resources&.size.to_i) + (@recent_resources&.size.to_i)
%>

<div class="fc-page">
  <header class="fc-page-hero">
    <div class="fc-page-hero-inner">
      <span class="fc-page-kicker">
        <%= render_icon("bookopen", classes: "h-3.5 w-3.5") %>
        Library
      </span>
      <h1 class="fc-page-title">Keep helpful teaching close.</h1>
      <p class="fc-page-sub">
        Curated articles, books, videos, audio, and study guides for prayer,
        growth, and practical Christian living.
      </p>

      <%= form_with url: resources_items_path, method: :get, class: "fc-page-search" do %>
        <%= render_icon("search", classes: "fc-page-search-icon h-5 w-5") %>
        <input name="q"
               type="text"
               value="<%= params[:q] %>"
               placeholder="Search the library — try “prayer” or “Wesley”"
               class="fc-page-search-input">
        <button type="submit" class="fc-btn fc-btn-primary">Search</button>
      <% end %>

      <% if @categories&.any? %>
        <nav class="fc-page-chips" aria-label="Categories">
          <%= link_to "All", resources_root_path, class: "fc-page-chip is-active" %>
          <% @categories.first(8).each do |category| %>
            <%= link_to resource_category_path(category), class: "fc-page-chip" do %>
              <%= category.name %>
              <span class="fc-page-chip-count"><%= category.resources.size %></span>
            <% end %>
          <% end %>
        </nav>
      <% end %>
    </div>
  </header>

  <section class="fc-page-body">
    <% if @featured_resources&.any? %>
      <div class="fc-section-head">
        <div>
          <span class="fc-page-kicker">Featured</span>
          <h2 class="fc-section-title">Start here.</h2>
        </div>
        <%= link_to "View all →", resources_items_path, class: "fc-section-link" %>
      </div>

      <div class="fc-resource-grid">
        <% @featured_resources.each do |resource| %>
          <%
            tint = type_tint.call(resource.resource_type)
            cover = resource.respond_to?(:cover_image) && resource.cover_image&.attached? ? resource.cover_image : nil
          %>
          <%= link_to resources_item_path(resource),
                      class: "fc-resource-card tint-#{tint}" do %>
            <% if cover %>
              <div class="fc-resource-cover">
                <%= image_tag cover, class: "fc-resource-cover-img", alt: resource.title %>
              </div>
            <% else %>
              <div class="fc-resource-cover fc-resource-cover-placeholder">
                <%= render_icon(resource.type_icon, classes: "h-9 w-9") %>
              </div>
            <% end %>
            <div class="fc-resource-body">
              <span class="fc-resource-type"><%= resource.resource_type.to_s.titleize %></span>
              <h3 class="fc-resource-title"><%= resource.title %></h3>
              <p class="fc-resource-desc"><%= truncate(resource.description.to_s, length: 140) %></p>
              <footer class="fc-resource-foot">
                <span><%= resource.user&.username || "Community" %></span>
                <span class="fc-resource-foot-sep">·</span>
                <span><%= pluralize(resource.downloads_count.to_i, "download") %></span>
              </footer>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="fc-resource-split">
      <main>
        <div class="fc-section-head">
          <div>
            <span class="fc-page-kicker">Recent</span>
            <h2 class="fc-section-title">Just added</h2>
          </div>
          <% if user_signed_in? %>
            <%= link_to "Submit a resource →", new_resources_item_path, class: "fc-section-link" %>
          <% end %>
        </div>

        <% if @recent_resources&.any? %>
          <ul class="fc-resource-list">
            <% @recent_resources.each do |resource| %>
              <% tint = type_tint.call(resource.resource_type) %>
              <li class="fc-resource-row tint-<%= tint %>">
                <%= link_to resources_item_path(resource), class: "fc-resource-row-link" do %>
                  <span class="fc-resource-row-icon">
                    <%= render_icon(resource.type_icon, classes: "h-5 w-5") %>
                  </span>
                  <span class="fc-resource-row-body">
                    <span class="fc-resource-row-title"><%= resource.title %></span>
                    <span class="fc-resource-row-desc"><%= truncate(resource.description.to_s, length: 110) %></span>
                    <span class="fc-resource-row-meta">
                      <%= resource.resource_category.name %>
                      ·
                      <%= time_ago_in_words(resource.created_at) %> ago
                    </span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="fc-empty">
            <div class="fc-empty-mark" aria-hidden="true">📚</div>
            <h3 class="fc-empty-title">No resources yet.</h3>
            <p class="fc-empty-text">Approved resources will appear here as people contribute.</p>
          </div>
        <% end %>
      </main>

      <aside class="fc-resource-aside">
        <div class="fc-side-card">
          <p class="fc-page-kicker">Library at a glance</p>
          <div class="fc-aside-stats">
            <div><span><%= @categories&.size.to_i %></span><small>Categories</small></div>
            <div><span><%= @featured_resources&.size.to_i %></span><small>Featured</small></div>
            <div><span><%= total_resources %></span><small>Loaded</small></div>
          </div>
        </div>

        <div class="fc-side-card fc-side-card--accent">
          <h3 class="fc-side-card-title">Share something good</h3>
          <p class="fc-side-card-text">
            Submit a piece that's helped your walk — articles, books, talks. A moderator
            reviews each one before it lands here.
          </p>
          <% if user_signed_in? %>
            <%= link_to "Submit a resource", new_resources_item_path, class: "fc-btn fc-btn-primary mt-3 inline-flex" %>
          <% else %>
            <%= link_to "Sign in to submit", new_user_session_path, class: "fc-btn mt-3 inline-flex" %>
          <% end %>
        </div>
      </aside>
    </div>
  </section>
</div>
