<% content_for(:title) { "Resource Library - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container py-14 sm:py-18">
      <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-end">
        <div class="space-y-5">
          <span class="mystic-kicker">
            <%= render_icon("library", classes: "w-4 h-4") %>
            Resource Library
          </span>
          <h1 class="mystic-title text-4xl sm:text-6xl">Keep helpful teaching close.</h1>
          <p class="mystic-copy max-w-2xl text-lg">
            Curated articles, books, videos, audio, and guides for study, prayer, growth, and practical Christian living.
          </p>
        </div>

        <div class="mystic-panel p-5">
          <%= form_with url: resources_items_path, method: :get, class: "relative" do %>
            <%= render_icon("search", classes: "absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-faith-muted") %>
            <input name="q" type="text" placeholder="Search resources" class="input h-12 rounded-full pl-12 pr-4 py-0">
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="mystic-container py-10">
    <% if @categories.any? %>
      <div class="mb-10 flex gap-3 overflow-x-auto pb-2">
        <%= link_to "All Resources", resources_root_path, class: "mystic-badge px-4 py-2" %>
        <% @categories.each do |category| %>
          <%= link_to resource_category_path(category), class: "mystic-badge px-4 py-2 whitespace-nowrap" do %>
            <%= category.name %>
            <span class="text-faith-muted"><%= category.resources.size %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @featured_resources.any? %>
      <div class="mb-12">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <span class="mystic-kicker">Featured</span>
            <h2 class="mystic-title mt-3 text-3xl sm:text-5xl">Start here.</h2>
          </div>
          <%= link_to "View all", resources_items_path, class: "btn btn-secondary" %>
        </div>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          <% @featured_resources.each do |resource| %>
            <%= link_to resources_item_path(resource), class: "mystic-card-link mystic-panel p-6" do %>
              <div class="mb-5 flex items-start justify-between gap-4">
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white/80 text-faith-green">
                  <%= render_icon(resource.type_icon, classes: "w-6 h-6") %>
                </span>
                <span class="mystic-badge px-3 py-1"><%= resource.resource_type.titleize %></span>
              </div>
              <p class="text-xs font-bold uppercase tracking-wide text-faith-muted"><%= resource.resource_category.name %></p>
              <h3 class="mt-2 text-2xl font-bold leading-tight text-faith-dark"><%= resource.title %></h3>
              <p class="mystic-copy mt-3 line-clamp-3 text-sm"><%= resource.description %></p>
              <div class="mt-5 flex items-center justify-between border-t border-faith-green/10 pt-4 text-sm font-semibold text-faith-muted">
                <span><%= resource.user&.username || "Community" %></span>
                <span><%= pluralize(resource.downloads_count, "download") %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_320px]">
      <main>
        <div class="mb-6 flex items-center justify-between gap-4">
          <div>
            <span class="mystic-kicker">Recent</span>
            <h2 class="mystic-title mt-3 text-3xl sm:text-4xl">Recently added</h2>
          </div>
          <% if user_signed_in? %>
            <%= link_to "Submit", new_resources_item_path, class: "btn btn-primary" %>
          <% end %>
        </div>

        <div class="mystic-panel overflow-hidden">
          <% if @recent_resources.any? %>
            <div class="divide-y divide-faith-green/10">
              <% @recent_resources.each do |resource| %>
                <%= link_to resources_item_path(resource), class: "flex gap-4 p-5 transition hover:bg-white/55" do %>
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/80 text-faith-green">
                    <%= render_icon(resource.type_icon, classes: "w-5 h-5") %>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-base font-bold text-faith-dark"><%= resource.title %></span>
                    <span class="mystic-copy mt-1 line-clamp-2 text-sm"><%= resource.description %></span>
                    <span class="mt-2 flex flex-wrap gap-2 text-xs font-semibold text-faith-muted">
                      <span><%= resource.resource_category.name %></span>
                      <span>•</span>
                      <span><%= time_ago_in_words(resource.created_at) %> ago</span>
                    </span>
                  </span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="p-10 text-center">
              <h3 class="text-xl font-bold text-faith-dark">No resources yet</h3>
              <p class="mystic-copy mt-2">Approved resources will appear here.</p>
            </div>
          <% end %>
        </div>
      </main>

      <aside class="space-y-5">
        <div class="mystic-panel p-6">
          <h3 class="text-xl font-bold text-faith-dark">Library Stats</h3>
          <div class="mt-5 space-y-3">
            <div class="flex justify-between text-sm"><span class="text-faith-muted">Categories</span><span class="font-bold text-faith-dark"><%= @categories.size %></span></div>
            <div class="flex justify-between text-sm"><span class="text-faith-muted">Featured</span><span class="font-bold text-faith-dark"><%= @featured_resources.size %></span></div>
            <div class="flex justify-between text-sm"><span class="text-faith-muted">Recent</span><span class="font-bold text-faith-dark"><%= @recent_resources.size %></span></div>
          </div>
        </div>

        <div class="mystic-panel-strong p-6">
          <h3 class="text-xl font-bold text-faith-dark">Share a Resource</h3>
          <p class="mystic-copy mt-2 text-sm">Submit material that has helped your walk. Moderators can review it before it reaches the library.</p>
          <% if user_signed_in? %>
            <%= link_to "Submit Resource", new_resources_item_path, class: "btn btn-primary mt-5 w-full" %>
          <% else %>
            <%= link_to "Sign in to submit", new_user_session_path, class: "btn btn-secondary mt-5 w-full" %>
          <% end %>
        </div>
      </aside>
    </div>
  </section>
</div>
