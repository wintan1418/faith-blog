<div style="max-width: 560px; margin: 0 auto; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #17251d; font-size: 15.5px; line-height: 1.65;">
  <%= render "heading", kicker: "Sign-in check", title: "Is this you signing in?" %>
  <p style="margin: 0 0 14px;">Hi <%= @user.username %>, someone just signed in to your account with your password on <strong><%= @device_name %></strong><%= " near #{@location}" if @location %>, a device we haven't seen you use before.</p>
  <p style="margin: 0 0 6px;">If it's you, enter this code to finish signing in:</p>

  <%= render "code", code: @code %>

  <p style="margin: 0 0 6px; color: #5e6862; font-size: 13px;"><%= @time.in_time_zone("Africa/Lagos").strftime("%-d %B %Y, %-l:%M %p") %> (West Africa Time)</p>

  <%= render "wasnt_you", lead: "Someone knows your password. Don't share this code. Secure your account: it signs out every device and lets you choose a new password." %>
</div>
