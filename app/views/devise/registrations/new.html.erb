<% content_for(:title) { "Join - Faith Community" } %>

<div class="mystic-shell flex min-h-[calc(100vh-160px)] items-center px-4 py-12">
  <div class="mx-auto grid w-full max-w-5xl gap-8 lg:grid-cols-[1fr_460px] lg:items-center">
    <div class="hidden space-y-5 lg:block">
      <span class="mystic-kicker">
        <%= render_icon("users", classes: "w-4 h-4") %>
        Join the community
      </span>
      <h1 class="mystic-title text-6xl">Create a place for your story, prayers, and growth.</h1>
      <p class="mystic-copy max-w-xl text-lg">Your account unlocks posting, rooms, bookmarks, connections, and your Brethren Card profile.</p>
    </div>

    <div class="mystic-panel-strong p-6 sm:p-8">
      <div class="mb-8">
        <div class="mb-4 grid h-12 w-12 place-items-center rounded-2xl bg-white/80 text-faith-green">
          <%= render_icon("sparkles", classes: "w-6 h-6") %>
        </div>
        <h1 class="text-3xl font-bold text-faith-dark">Create account</h1>
        <p class="mt-1 text-sm text-faith-muted">Start participating in Faith Community.</p>
      </div>

      <%= render "devise/shared/google_sign_in" %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5", data: { turbo: false } }) do |f| %>
        <% if resource.errors.any? %>
          <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
            <ul class="list-inside list-disc text-sm text-red-700">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :username, class: "label" %>
          <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "input", placeholder: "Choose a username" %>
          <p class="mt-1 text-xs text-faith-muted">Letters, numbers, and underscores. 3-30 characters.</p>
        </div>

        <div>
          <%= f.label :email, class: "label" %>
          <%= f.email_field :email, autocomplete: "email", class: "input", placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :password, class: "label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input", placeholder: "Minimum 8 characters" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input", placeholder: "Repeat your password" %>
        </div>

        <%= f.submit "Create Account", class: "btn btn-primary btn-lg w-full" %>

        <p class="text-center text-xs leading-5 text-faith-muted">
          By creating an account, you agree to follow the community guidelines and treat others with care.
        </p>
      <% end %>

      <p class="mt-6 text-center text-sm text-faith-muted">
        Already have an account?
        <%= link_to "Sign in", new_session_path(resource_name), class: "font-bold text-faith-green hover:text-faith-dark" %>
      </p>
    </div>
  </div>
</div>
