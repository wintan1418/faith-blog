<% content_for(:title) { "Join - Brethreign" } %>

<%= render layout: "devise/shared/auth_shell", locals: { title: "Join Brethreign", subtitle: "A place to breathe: share your story, pray, and grow together." } do %>
  <%= render "devise/shared/google_sign_in" %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { class: "auth-form", data: { turbo: hotwire_native_app? } }) do |f| %>
    <% if resource.errors.any? %>
      <div class="auth-errors" role="alert">
        <% resource.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="auth-field">
      <%= f.label :username, "Username", class: "auth-label" %>
      <div class="auth-input-wrap">
        <span class="auth-input-prefix">@</span>
        <%= f.text_field :username, autocomplete: "username", autocapitalize: "none", spellcheck: false,
                         class: "auth-input has-prefix", placeholder: "yourname", required: true,
                         minlength: 3, maxlength: 30, pattern: "[A-Za-z0-9_]+",
                         title: "Letters, numbers and underscores" %>
      </div>
      <p class="auth-hint">Letters, numbers and underscores. This is how people find you.</p>
    </div>

    <div class="auth-field">
      <%= f.label :email, "Email", class: "auth-label" %>
      <div class="auth-input-wrap">
        <%= render_icon("mail", classes: "auth-input-icon") %>
        <%= f.email_field :email, autocomplete: "email", inputmode: "email", class: "auth-input",
                          placeholder: "you@example.com", required: true %>
      </div>
    </div>

    <div class="auth-field" data-controller="password-field" data-password-field-strength-value="true">
      <%= f.label :password, "Password", class: "auth-label" %>
      <div class="auth-input-wrap">
        <%= render_icon("lock", classes: "auth-input-icon") %>
        <%= f.password_field :password, autocomplete: "new-password", class: "auth-input",
                             placeholder: "At least 8 characters", required: true, minlength: 8,
                             data: { password_field_target: "input", action: "input->password-field#measure" } %>
        <button type="button" class="auth-eye" data-action="password-field#toggle" data-password-field-target="toggle"
                aria-label="Show password" aria-pressed="false">Show</button>
      </div>
      <div class="auth-strength" data-password-field-target="meter" data-level="0" aria-live="polite">
        <span></span><span></span><span></span><span></span>
        <em data-password-field-target="label">Use 8 or more characters</em>
      </div>
    </div>

    <%= f.submit "Create account", class: "auth-submit", data: { turbo_submits_with: "Creating your account…" } %>

    <p class="auth-legal">
      By joining you agree to our
      <%= link_to "Terms", terms_path, data: { turbo_frame: "_top" } %>,
      <%= link_to "Community Guidelines", guidelines_path, data: { turbo_frame: "_top" } %>
      and <%= link_to "Privacy Policy", privacy_path, data: { turbo_frame: "_top" } %>.
      There's no tolerance for abusive or objectionable content.
    </p>
  <% end %>

  <p class="auth-switch">
    Already a member? <%= link_to "Sign in", new_session_path(resource_name) %>
  </p>
<% end %>
