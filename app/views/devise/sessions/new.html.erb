<% content_for(:title) { "Sign In - Brethreign" } %>

<%= render layout: "devise/shared/auth_shell", locals: { title: "Welcome back", subtitle: "Take a breath. Your community is here." } do %>
  <%= render "devise/shared/google_sign_in" %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
               html: { class: "auth-form", data: { turbo: hotwire_native_app? } }) do |f| %>
    <div class="auth-field">
      <%= f.label :email, "Email", class: "auth-label" %>
      <div class="auth-input-wrap">
        <%= render_icon("mail", classes: "auth-input-icon") %>
        <%= f.email_field :email, autofocus: !hotwire_native_app?, autocomplete: "email", inputmode: "email",
                          class: "auth-input", placeholder: "you@example.com", required: true %>
      </div>
    </div>

    <div class="auth-field" data-controller="password-field">
      <div class="auth-label-row">
        <%= f.label :password, "Password", class: "auth-label" %>
        <%= link_to "Forgot?", new_password_path(resource_name), class: "auth-link-small" %>
      </div>
      <div class="auth-input-wrap">
        <%= render_icon("lock", classes: "auth-input-icon") %>
        <%= f.password_field :password, autocomplete: "current-password", class: "auth-input",
                             placeholder: "Your password", required: true, data: { password_field_target: "input" } %>
        <button type="button" class="auth-eye" data-action="password-field#toggle" data-password-field-target="toggle"
                aria-label="Show password" aria-pressed="false">Show</button>
      </div>
    </div>

    <label class="auth-check">
      <%= f.check_box :remember_me, { checked: true } %>
      <span>Keep me signed in</span>
    </label>

    <%= f.submit "Sign in", class: "auth-submit", data: { turbo_submits_with: "Signing in…" } %>
  <% end %>

  <p class="auth-switch">
    New to Brethreign? <%= link_to "Create an account", new_registration_path(resource_name) %>
  </p>
<% end %>
