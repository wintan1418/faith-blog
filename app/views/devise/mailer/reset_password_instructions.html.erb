<div style="max-width: 560px; margin: 0 auto; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #17251d; font-size: 15.5px; line-height: 1.65;">
  <p style="margin: 0 0 6px; color: #0e5c43; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 800;">Choose a new password</p>
  <h1 style="margin: 0 0 16px; font-family: Georgia, 'Times New Roman', serif; font-size: 26px; line-height: 1.25; color: #17251d; font-weight: 700;">Hi <%= @resource.username %></h1>
  <p style="margin: 0 0 18px;">Someone (we hope you!) asked to choose a new password for your Brethreign account. Tap below to choose one. The link works for 6 hours.</p>
  <p style="margin: 0 0 18px;">
    <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" style="display: inline-block; background: #0e5c43; color: #ffffff; font-weight: 700; padding: 12px 22px; border-radius: 999px; text-decoration: none;">Choose a new password</a>
  </p>
  <p style="margin: 0; color: #5e6862; font-size: 13px;">Didn't ask for this? Ignore this email: your password stays the same until you open the link and choose a new one.</p>
</div>
