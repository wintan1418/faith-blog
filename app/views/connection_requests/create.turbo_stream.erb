<%= turbo_stream.replace "flash_messages", partial: "shared/flash" %>
<%= turbo_stream.replace dom_id(@receiver, :connection_actions), partial: "users/connection_actions", locals: { user: @receiver } %>
<%# Brethren-you-may-know card: show the request was sent, right on the card. %>
<% if @connection_request&.persisted? %>
  <%= turbo_stream.replace dom_id(@receiver, :suggestion_action) do %>
    <div id="<%= dom_id(@receiver, :suggestion_action) %>"><span class="bys-connect bys-connect--sent">Request sent ✓</span></div>
  <% end %>
<% end %>
