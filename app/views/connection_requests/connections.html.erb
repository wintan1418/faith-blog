<% content_for :title, "My Connections" %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-5xl">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="mystic-kicker">Connections</span>
        <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">My Connections</h1>
        <p class="mystic-copy mt-2">Members whose Brethren Cards you can view.</p>
      </div>
      <%= link_to "Pending Requests", connection_requests_path, class: "btn btn-secondary" %>
    </div>

    <% if @connections.any? %>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <% @connections.each do |user| %>
          <div class="mystic-panel p-5">
            <div class="flex items-start gap-4">
              <% if user.profile&.avatar&.attached? %>
                <%= image_tag user.profile.avatar, class: "mystic-avatar h-16 w-16 object-cover" %>
              <% else %>
                <span class="mystic-avatar mystic-avatar-fallback grid h-16 w-16 place-items-center text-xl font-bold">
                  <%= user.display_name.first.upcase %>
                </span>
              <% end %>

              <div class="min-w-0 flex-1">
                <%= link_to user.display_name, user_path(user.username), class: "text-lg font-bold text-faith-dark hover:text-faith-green" %>
                <% if user.brethren_card&.occupation.present? %>
                  <p class="text-sm font-semibold text-faith-muted"><%= user.brethren_card.occupation %></p>
                <% end %>
                <% if user.brethren_card&.church_or_assembly.present? %>
                  <p class="mt-1 truncate text-sm text-faith-muted"><%= user.brethren_card.church_or_assembly %></p>
                <% end %>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap gap-2 border-t border-faith-green/10 pt-4">
              <%= link_to "View Card", brethren_card_path(user.username), class: "btn btn-primary btn-sm flex-1" %>
              <%= button_to conversations_path(recipient_id: user.id), method: :post, class: "btn btn-secondary btn-sm" do %>
                Message
              <% end %>
              <% if user.brethren_card&.whatsapp_link %>
                <%= link_to "WhatsApp", user.brethren_card.whatsapp_link, target: "_blank", rel: "noopener", class: "btn btn-secondary btn-sm" %>
              <% end %>
              <% if user.brethren_card&.gmail_link %>
                <%= link_to "Email", user.brethren_card.gmail_link, target: "_blank", rel: "noopener", class: "btn btn-secondary btn-sm" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="mystic-panel p-12 text-center">
        <h2 class="text-xl font-bold text-faith-dark">No connections yet</h2>
        <p class="mystic-copy mx-auto mt-2 max-w-md">Send "Can I Know You More?" requests to members you want to connect with.</p>
        <%= link_to "Explore the Feed", feed_path, class: "btn btn-primary mt-6" %>
      </div>
    <% end %>
  </div>
</div>
