<% content_for :title, "Connection Requests" %>
<%# Accepting from someone's profile and tapping back used to show the old
    snapshot with the request still pending: always load this page fresh. %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-5xl">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="mystic-kicker">Requests</span>
        <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Connection Requests</h1>
        <p class="mystic-copy mt-2">Manage "Can I Know You More?" requests.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Find brethren", people_path, class: "btn btn-primary" %>
        <%= link_to "My Connections (#{current_user.connections_count})", my_connections_path, class: "btn btn-secondary" %>
      </div>
    </div>

    <div class="mb-6">
      <%= render "shared/brethren_suggestions", suggestions: @suggestions if @suggestions.present? %>
    </div>

    <%# Requests accepted, declined or sent elsewhere update these lists live. %>
    <%= turbo_stream_from current_user, :connection_requests %>

    <div class="grid gap-6 lg:grid-cols-2">
      <%= render "received_requests", pending_requests: @pending_requests %>

      <%= render "sent_requests", sent_requests: @sent_requests %>
    </div>
  </div>
</div>
