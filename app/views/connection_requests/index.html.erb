<% content_for :title, "Connection Requests" %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-5xl">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="mystic-kicker">Requests</span>
        <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Connection Requests</h1>
        <p class="mystic-copy mt-2">Manage "Can I Know You More?" requests.</p>
      </div>
      <%= link_to "My Connections (#{current_user.connections_count})", my_connections_path, class: "btn btn-secondary" %>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="mystic-panel p-6">
        <div class="mb-5 flex items-center justify-between">
          <h2 class="text-xl font-bold text-faith-dark">Received Requests</h2>
          <% if @pending_requests.any? %>
            <span class="mystic-badge px-3 py-1"><%= @pending_requests.count %></span>
          <% end %>
        </div>

        <% if @pending_requests.any? %>
          <div class="space-y-4">
            <% @pending_requests.each do |request| %>
              <div class="rounded-2xl bg-white/60 p-4">
                <div class="flex items-center gap-3">
                  <% if request.sender.profile&.avatar&.attached? %>
                    <%= image_tag request.sender.profile.avatar, class: "mystic-avatar h-12 w-12 object-cover" %>
                  <% else %>
                    <span class="mystic-avatar mystic-avatar-fallback grid h-12 w-12 place-items-center font-bold">
                      <%= request.sender.display_name.first.upcase %>
                    </span>
                  <% end %>
                  <div class="min-w-0 flex-1">
                    <%= link_to request.sender.display_name, user_path(request.sender.username), class: "font-bold text-faith-dark hover:text-faith-green" %>
                    <p class="text-sm text-faith-muted">wants to know you more</p>
                    <p class="text-xs font-semibold text-faith-muted"><%= time_ago_in_words(request.created_at) %> ago</p>
                  </div>
                </div>
                <div class="mt-4 flex gap-2">
                  <%= button_to "Accept", accept_connection_request_path(request), method: :post, class: "btn btn-primary btn-sm" %>
                  <%= button_to "Decline", decline_connection_request_path(request), method: :post, class: "btn btn-secondary btn-sm" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl bg-white/45 p-8 text-center">
            <p class="font-semibold text-faith-muted">No pending requests.</p>
          </div>
        <% end %>
      </section>

      <section class="mystic-panel p-6">
        <h2 class="mb-5 text-xl font-bold text-faith-dark">Sent Requests</h2>

        <% if @sent_requests.any? %>
          <div class="divide-y divide-faith-green/10">
            <% @sent_requests.each do |request| %>
              <div class="flex items-center gap-4 py-4">
                <% if request.receiver.profile&.avatar&.attached? %>
                  <%= image_tag request.receiver.profile.avatar, class: "mystic-avatar h-12 w-12 object-cover" %>
                <% else %>
                  <span class="mystic-avatar mystic-avatar-fallback grid h-12 w-12 place-items-center font-bold">
                    <%= request.receiver.display_name.first.upcase %>
                  </span>
                <% end %>
                <div class="min-w-0 flex-1">
                  <%= link_to request.receiver.display_name, user_path(request.receiver.username), class: "font-bold text-faith-dark hover:text-faith-green" %>
                  <p class="text-sm text-faith-muted">Sent <%= time_ago_in_words(request.created_at) %> ago</p>
                </div>
                <span class="mystic-badge px-3 py-1"><%= request.status.titleize %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl bg-white/45 p-8 text-center">
            <p class="font-semibold text-faith-muted">You have not sent any requests yet.</p>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
