<% content_for(:title) { "Rooms · Brethreign" } %>

<%
  rooms_total   = @rooms.size
  posts_total   = @rooms.sum { |r| r.posts_count.to_i }
  members_total = @rooms.sum { |r| r.members_count.to_i }

  # Map a room slug → a tint palette key. Keeps each card visually distinct.
  tint_for = ->(slug) {
    case slug.to_s
    when /prayer/  then "prayer"
    when /testim/  then "testimony"
    when /bible/   then "bible"
    when /quest/   then "questions"
    when /encour/  then "encourage"
    when /youth/   then "youth"
    when /worship/ then "worship"
    when /family/  then "family"
    else "default"
    end
  }
%>

<div class="fc-page">
  <header class="fc-page-hero">
    <div class="fc-page-hero-inner">
      <span class="fc-page-kicker">
        <%= render_icon("users", classes: "h-3.5 w-3.5") %>
        Community Rooms
      </span>
      <h1 class="fc-page-title">Step into a room — focused spaces for breath.</h1>
      <p class="fc-page-sub">
        Prayer requests stay in prayer, testimonies in testimony, questions in questions.
        Each room keeps a topic clear so it doesn't all collapse into one noisy stream.
      </p>

      <div class="fc-page-stats">
        <div class="fc-page-stat">
          <span class="fc-page-stat-num"><%= rooms_total %></span>
          <span class="fc-page-stat-label">Rooms</span>
        </div>
        <div class="fc-page-stat">
          <span class="fc-page-stat-num"><%= number_with_delimiter(members_total) %></span>
          <span class="fc-page-stat-label">Members</span>
        </div>
        <div class="fc-page-stat">
          <span class="fc-page-stat-num"><%= number_with_delimiter(posts_total) %></span>
          <span class="fc-page-stat-label">Breaths</span>
        </div>
        <% if user_signed_in? %>
          <button type="button"
                  class="fc-btn fc-btn-primary fc-page-cta"
                  data-action="click->composer-modal#open">
            ✦ Take a breath
          </button>
        <% end %>
      </div>
    </div>
  </header>

  <section class="fc-page-body">
    <% if @rooms.any? %>
      <div class="fc-room-grid">
        <% @rooms.each do |room| %>
          <%= link_to room_path(room),
                      class: "fc-room-card tint-#{tint_for.call(room.slug)}" do %>
            <div class="fc-room-card-band"></div>
            <div class="fc-room-card-head">
              <span class="fc-room-card-icon">
                <%= render_icon(room.icon || "sparkles", classes: "h-6 w-6") %>
              </span>
              <% if room.posts_count.to_i >= 30 %>
                <span class="fc-room-card-badge">Active</span>
              <% end %>
            </div>
            <h2 class="fc-room-card-name"><%= room.name %></h2>
            <p class="fc-room-card-desc"><%= truncate(room.description.to_s, length: 140) %></p>
            <footer class="fc-room-card-foot">
              <span class="fc-room-card-stat">
                <%= render_icon("message_circle", classes: "h-3.5 w-3.5") %>
                <%= pluralize(room.posts_count.to_i, "breath") %>
              </span>
              <span class="fc-room-card-stat">
                <%= render_icon("users", classes: "h-3.5 w-3.5") %>
                <%= pluralize(room.members_count.to_i, "member") %>
              </span>
              <span class="fc-room-card-enter">Enter →</span>
            </footer>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="fc-empty">
        <div class="fc-empty-mark" aria-hidden="true">
          <%= render_icon("users", classes: "h-7 w-7") %>
        </div>
        <h2 class="fc-empty-title">No rooms yet.</h2>
        <p class="fc-empty-text">Rooms will appear here once they're created.</p>
      </div>
    <% end %>
  </section>
</div>
