<% content_for(:title) { "Community Rooms - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container py-14 sm:py-18">
      <div class="max-w-3xl space-y-5">
        <span class="mystic-kicker">
          <%= render_icon("users", classes: "w-4 h-4") %>
          Community Rooms
        </span>
        <h1 class="mystic-title text-4xl sm:text-6xl">Focused spaces for real conversation.</h1>
        <p class="mystic-copy text-lg">
          Each room keeps a topic clear so prayer requests, testimonies, questions, and resources do not collapse into one noisy stream.
        </p>
      </div>
    </div>
  </section>

  <section class="mystic-container py-10">
    <div class="mb-8 grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
      <div class="mystic-panel p-4">
        <div class="flex flex-wrap gap-2">
          <span class="mystic-badge px-4 py-2">All Rooms</span>
          <span class="mystic-badge px-4 py-2"><%= pluralize(@rooms.size, "room") %></span>
          <span class="mystic-badge px-4 py-2"><%= pluralize(@rooms.sum(&:posts_count), "post") %></span>
        </div>
      </div>
      <% if user_signed_in? %>
        <%= link_to "Start a Post", new_post_path, class: "btn btn-primary" %>
      <% end %>
    </div>

    <% if @rooms.any? %>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% @rooms.each do |room| %>
          <%= link_to room_path(room), class: "mystic-card-link mystic-panel p-6" do %>
            <div class="flex items-start justify-between gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-2xl bg-white/75 text-faith-green">
                <%= render_icon(room.icon || "sparkles", classes: "w-7 h-7") %>
              </div>
              <% if room.posts_count.to_i > 50 %>
                <span class="mystic-badge px-3 py-1 text-faith-accent">Active</span>
              <% end %>
            </div>

            <div class="mt-6">
              <h2 class="text-2xl font-bold leading-tight text-faith-dark"><%= room.name %></h2>
              <p class="mystic-copy mt-3 line-clamp-3 text-sm"><%= room.description %></p>
            </div>

            <div class="mt-6 flex flex-wrap gap-4 border-t border-faith-green/10 pt-4">
              <span class="mystic-stat"><%= render_icon("message_circle", classes: "w-4 h-4") %><%= pluralize(room.posts_count, "post") %></span>
              <span class="mystic-stat"><%= render_icon("users", classes: "w-4 h-4") %><%= pluralize(room.members_count, "member") %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="mystic-panel p-10 text-center">
        <h2 class="text-xl font-bold text-faith-dark">No rooms yet</h2>
        <p class="mystic-copy mt-2">Rooms will appear here once they are created.</p>
      </div>
    <% end %>
  </section>
</div>
