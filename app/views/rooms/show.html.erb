<% content_for(:title) { "#{@room.name} - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container py-10 sm:py-14">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="flex items-start gap-5">
          <div class="grid h-16 w-16 shrink-0 place-items-center rounded-3xl bg-white/75 text-faith-green shadow-sm">
            <%= render_icon(@room.icon || "sparkles", classes: "w-8 h-8") %>
          </div>
          <div class="min-w-0">
            <div class="mb-3 flex flex-wrap items-center gap-2">
              <span class="mystic-kicker">Room</span>
              <% if @is_member %>
                <span class="mystic-badge px-3 py-1">Member</span>
              <% end %>
            </div>
            <h1 class="mystic-title text-4xl sm:text-6xl"><%= @room.name %></h1>
            <p class="mystic-copy mt-4 max-w-3xl text-lg"><%= @room.description %></p>
            <div class="mt-5 flex flex-wrap gap-4">
              <span class="mystic-stat"><%= render_icon("message_circle", classes: "w-4 h-4") %><%= pluralize(@room.posts_count, "post") %></span>
              <span class="mystic-stat"><%= render_icon("users", classes: "w-4 h-4") %><%= pluralize(@room.members_count, "member") %></span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <% if user_signed_in? %>
            <%= link_to new_post_path(room_id: @room.id), class: "btn btn-primary" do %>
              <%= render_icon("pencil", classes: "w-4 h-4") %>
              Share Here
            <% end %>
            <% if @is_member %>
              <%= button_to "Leave Room", leave_room_path(@room), method: :delete, class: "btn btn-secondary", data: { turbo_confirm: "Leave this room?" } %>
            <% else %>
              <%= button_to "Join Room", join_room_path(@room), class: "btn btn-secondary" %>
            <% end %>
          <% else %>
            <%= link_to "Sign in to participate", new_user_session_path, class: "btn btn-secondary" %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="mystic-container py-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <main class="min-w-0 space-y-5">
        <% if @posts.any? %>
          <% @posts.each do |post| %>
            <%= render "posts/card", post: post %>
          <% end %>

          <% if @pagy.pages > 1 %>
            <div class="pt-4">
              <%== pagy_nav(@pagy) %>
            </div>
          <% end %>
        <% else %>
          <div class="mystic-panel p-10 text-center">
            <div class="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-2xl bg-white/75 text-faith-green">
              <%= render_icon(@room.icon || "sparkles", classes: "w-7 h-7") %>
            </div>
            <h2 class="text-xl font-bold text-faith-dark">No posts in this room yet</h2>
            <p class="mystic-copy mx-auto mt-2 max-w-md">Be the first to start a meaningful conversation in <%= @room.name %>.</p>
            <% if user_signed_in? %>
              <%= link_to "Create First Post", new_post_path(room_id: @room.id), class: "btn btn-primary mt-6" %>
            <% end %>
          </div>
        <% end %>
      </main>

      <aside class="space-y-5">
        <% if @room.rules.present? %>
          <div class="mystic-panel p-6">
            <h3 class="mb-3 flex items-center gap-2 font-bold text-faith-dark">
              <%= render_icon("shield", classes: "w-5 h-5 text-faith-green") %>
              Room Guidelines
            </h3>
            <p class="mystic-copy text-sm"><%= @room.rules %></p>
          </div>
        <% end %>

        <div class="mystic-panel p-6">
          <div class="mb-4 flex items-center justify-between">
            <h3 class="font-bold text-faith-dark">Other Rooms</h3>
            <%= link_to "View all", rooms_path, class: "text-sm font-bold text-faith-green hover:text-faith-dark" %>
          </div>
          <div class="space-y-2">
            <% Room.public_rooms.where.not(id: @room.id).ordered.limit(5).each do |room| %>
              <%= link_to room_path(room), class: "flex items-center gap-3 rounded-2xl p-2 transition hover:bg-white/70" do %>
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/80 text-faith-green">
                  <%= render_icon(room.icon || "sparkles", classes: "w-5 h-5") %>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-bold text-faith-dark"><%= room.name %></span>
                  <span class="text-xs font-semibold text-faith-muted"><%= pluralize(room.posts_count, "post") %></span>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
