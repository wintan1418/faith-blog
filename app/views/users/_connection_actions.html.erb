<% connection = current_user.connection_with(user) %>

<div id="<%= dom_id(user, :connection_actions) %>" class="flex flex-wrap gap-3">
  <% if current_user.brethren_card.blank? || !current_user.brethren_card.complete? %>
    <%= link_to "Complete Brethren Card", edit_settings_brethren_card_path, class: "btn btn-primary" %>
  <% elsif connection&.accepted? %>
    <%= link_to "View Brethren Card", brethren_card_path(user.username), class: "btn btn-secondary" %>
  <% elsif connection&.pending? && connection.sender == current_user %>
    <span class="btn btn-secondary cursor-not-allowed opacity-70">Request Sent</span>
  <% elsif connection&.pending? && connection.receiver == current_user %>
    <%= button_to "Accept Request", accept_connection_request_path(connection), method: :post, class: "btn btn-primary" %>
    <%= button_to "Decline", decline_connection_request_path(connection), method: :post, class: "btn btn-secondary" %>
  <% else %>
    <%= button_to "Can I Know You More?", connection_requests_path(receiver_id: user.id), method: :post, class: "btn btn-primary" %>
  <% end %>
</div>
