<% content_for(:title) { "#{@user.username} - Brethreign" } %>
<% content_for(:og_accent) { @user.accent_color } %>
<% content_for(:og_title) { "#{@user.username} on Brethreign" } %>

<div class="mystic-shell profile-page" data-controller="profile-hero">
  <%# Sticky mini-bar: slides in when the hero scrolls out of view. %>
  <div class="profile-minibar" data-profile-hero-target="minibar" style="<%= AccentPalette.css_vars(@user.accent_color) %>">
    <div class="profile-minibar-inner">
      <% if @user.profile&.avatar&.attached? %>
        <%= image_tag avatar_src(@user.profile), class: "profile-minibar-avatar object-cover", alt: @user.display_name %>
      <% else %>
        <span class="profile-minibar-avatar" style="<%= avatar_tint_style(@user.username) %>"><%= @user.username.first.upcase %></span>
      <% end %>
      <span class="profile-minibar-name"><%= @user.display_name.presence || @user.username %></span>
      <% if user_signed_in? && @user != current_user %>
        <div class="profile-minibar-action">
          <%= render "users/follow_actions", user: @user, follow_class: "fc-btn fc-btn-primary", following_class: "fc-btn" %>
        </div>
      <% end %>
    </div>
  </div>

  <section class="profile-hero" data-profile-hero-target="hero">
    <div class="mystic-container max-w-6xl py-12">
      <%# The hero carries the profile OWNER's accent, not the viewer's —
          the cover, avatar ring, and badges tint to their chosen colour. %>
      <div class="profile-hero-panel" style="<%= AccentPalette.css_vars(@user.accent_color) %>">
        <div class="profile-cover" aria-hidden="true"></div>
        <div class="profile-avatar-wrap">
          <% if @user.profile&.avatar&.attached? %>
            <%= image_tag avatar_src(@user.profile, 400), class: "profile-avatar object-cover", alt: @user.display_name %>
          <% else %>
            <span class="profile-avatar profile-avatar-fallback">
              <%= @user.username.first.upcase %>
            </span>
          <% end %>
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <% display_name = @user.display_name.presence || @user.username %>
                <h1 class="profile-title<%= " is-long" if display_name.length > 13 %><%= " is-very-long" if display_name.length > 20 %>"><%= display_name %></h1>
                <% if @user.super_admin? || @user.admin? || @user.moderator? %>
                  <span class="profile-role-badge">
                    <%= render_icon("shield", classes: "h-3.5 w-3.5") %>
                    <%= @user.super_admin? ? "Super Admin" : (@user.admin? ? "Admin" : "Moderator") %>
                  </span>
                <% end %>
              </div>
              <p class="profile-handle">@<%= @user.username %></p>
              <% if @user.profile&.show_birthday && @user.profile.birthday_today? %>
                <p class="profile-birthday-today">🎂 Birthday today</p>
              <% end %>
              <% if (headline = @user.professional_headline) %>
                <p class="profile-headline"><%= headline %></p>
              <% end %>
              <% if @user.profile&.assembly.present? %>
                <p class="profile-assembly">⛪ <%= @user.profile.assembly %></p>
              <% end %>
            </div>

            <% if user_signed_in? && @user == current_user %>
              <%= link_to "Edit Profile", edit_settings_profile_path, class: "btn btn-secondary" %>
            <% end %>
          </div>

          <% if @user.profile.bio.present? %>
            <p class="profile-bio"><%= @user.profile.bio %></p>
          <% end %>

          <div class="mt-5 flex flex-wrap gap-3">
            <% if @user.profile.location.present? %>
              <span class="profile-meta">
                <%= render_icon("globe", classes: "w-4 h-4") %>
                <%= @user.profile.location %>
              </span>
            <% end %>
            <% if @user.profile.faith_background.present? %>
              <span class="profile-meta">
                <%= render_icon("cross", classes: "w-4 h-4") %>
                <%# Labelled: on its own, "Saved 5 years ago" read like a date something was saved.
                    One span, so the label and the answer wrap together as a sentence. %>
                <span><span class="profile-meta-label">Faith background:</span> <%= @user.profile.faith_background %></span>
              </span>
            <% end %>
            <span class="profile-meta">
              <%= render_icon("clock", classes: "w-4 h-4") %>
              Joined <%= @user.created_at.strftime("%B %Y") %>
            </span>
          </div>

          <% badges = @user.user_badges.order(:awarded_at) %>
          <% if badges.any? %>
            <div class="profile-badges" aria-label="Milestones">
              <% badges.each do |badge| %>
                <% info = badge.info %>
                <span class="profile-badge" title="<%= info[:name] %> — <%= info[:blurb] %>">
                  <span class="profile-badge-emoji"><%= info[:emoji] %></span>
                  <span class="profile-badge-name"><%= info[:name] %></span>
                </span>
              <% end %>
            </div>
          <% end %>

          <div class="profile-stats">
            <%= link_to followers_user_path(@user.username), class: "profile-stat" do %>
              <span data-profile-hero-target="count" data-count="<%= @user.followers_count %>"><%= number_to_human(@user.followers_count, format: "%n%u", units: { thousand: "k" }) %></span>
              <small>Followers</small>
            <% end %>
            <%= link_to following_user_path(@user.username), class: "profile-stat" do %>
              <span data-profile-hero-target="count" data-count="<%= @user.following_count %>"><%= number_to_human(@user.following_count, format: "%n%u", units: { thousand: "k" }) %></span>
              <small>Following</small>
            <% end %>
            <div class="profile-stat">
              <span data-profile-hero-target="count" data-count="<%= @user.posts.published.count %>"><%= @user.posts.published.count %></span>
              <small>Breaths</small>
            </div>
            <% if @user.current_breath_streak.to_i.positive? %>
              <div class="profile-stat profile-stat-streak" title="Current breath streak">
                <span>🔥 <%= @user.current_breath_streak %></span>
                <small><%= @user.current_breath_streak == 1 ? "day" : "days" %> streak</small>
              </div>
            <% end %>
          </div>

          <% if user_signed_in? && @user != current_user %>
            <div class="profile-actions mt-6">
              <%= render "users/follow_actions", user: @user %>
              <%= render "users/connection_actions", user: @user %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="mystic-container max-w-5xl pb-10 pt-2">
    <%= turbo_frame_tag "profile_tab", target: "_top" do %>
      <nav class="profile-tabs" aria-label="Profile sections">
        <% tabs = { "breaths" => "Breaths", "professional" => "Professional", "portfolio" => "Portfolio", "about" => "About" } %>
        <%# Visitors only see Portfolio when there's work in it. %>
        <% tabs.delete("portfolio") unless (user_signed_in? && current_user == @user) || @user.portfolio_items.visible.exists? %>
        <% tabs.each do |key, label| %>
          <%= link_to label, user_path(@user.username, tab: (key == "breaths" ? nil : key)),
                      class: "profile-tab#{' is-active' if @tab == key}",
                      aria: { current: (@tab == key ? "page" : nil) },
                      data: { turbo_frame: "profile_tab", turbo_action: "advance" } %>
        <% end %>
      </nav>

      <div class="profile-tab-body">
        <% case @tab %>
        <% when "professional" %>
          <%= render "users/professional", user: @user, strength: @strength %>
        <% when "portfolio" %>
          <%= render "users/portfolio", user: @user %>
        <% when "about" %>
          <%= render "users/about", user: @user %>
        <% else %>
          <%= render "users/breaths_tab" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
