<% content_for(:title) { "#{@user.username} - Faith Community" } %>

<div class="mystic-shell profile-page">
  <section class="profile-hero">
    <div class="mystic-container max-w-6xl py-12">
      <div class="profile-hero-panel">
        <div class="profile-avatar-wrap">
          <% if @user.profile&.avatar&.attached? %>
            <%= image_tag @user.profile.avatar, class: "profile-avatar object-cover", alt: @user.display_name %>
          <% else %>
            <span class="profile-avatar profile-avatar-fallback">
              <%= @user.username.first.upcase %>
            </span>
          <% end %>
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h1 class="profile-title"><%= @user.display_name.presence || @user.username %></h1>
                <% if @user.super_admin? || @user.admin? || @user.moderator? %>
                  <span class="profile-role-badge">
                    <%= render_icon("shield", classes: "h-3.5 w-3.5") %>
                    <%= @user.super_admin? ? "Super Admin" : (@user.admin? ? "Admin" : "Moderator") %>
                  </span>
                <% end %>
              </div>
              <p class="profile-handle">@<%= @user.username %></p>
            </div>

            <% if user_signed_in? && @user == current_user %>
              <%= link_to "Edit Profile", edit_settings_profile_path, class: "btn btn-secondary" %>
            <% end %>
          </div>

          <% if @user.profile.bio.present? %>
            <p class="profile-bio"><%= @user.profile.bio %></p>
          <% end %>

          <div class="mt-5 flex flex-wrap gap-3">
            <% if @user.profile.location.present? %>
              <span class="profile-meta">
                <%= render_icon("globe", classes: "w-4 h-4") %>
                <%= @user.profile.location %>
              </span>
            <% end %>
            <% if @user.profile.faith_background.present? %>
              <span class="profile-meta">
                <%= render_icon("church", classes: "w-4 h-4") %>
                <%= @user.profile.faith_background %>
              </span>
            <% end %>
            <span class="profile-meta">
              <%= render_icon("clock", classes: "w-4 h-4") %>
              Joined <%= @user.created_at.strftime("%B %Y") %>
            </span>
          </div>

          <div class="profile-stats">
            <%= link_to followers_user_path(@user.username), class: "profile-stat" do %>
              <span><%= number_to_human(@user.followers_count, format: "%n%u", units: { thousand: "k" }) %></span>
              <small>Followers</small>
            <% end %>
            <%= link_to following_user_path(@user.username), class: "profile-stat" do %>
              <span><%= number_to_human(@user.following_count, format: "%n%u", units: { thousand: "k" }) %></span>
              <small>Following</small>
            <% end %>
            <div class="profile-stat">
              <span><%= @user.posts.published.count %></span>
              <small>Posts</small>
            </div>
          </div>

          <% if user_signed_in? && @user != current_user %>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <%= render "users/follow_actions", user: @user %>
              <%= render "users/connection_actions", user: @user %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="mystic-container max-w-5xl py-10">
    <% if user_signed_in? && @user == current_user %>
      <section class="mystic-panel-strong profile-card-panel mb-10 p-6 sm:p-8">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <span class="mystic-kicker">Private Profile Card</span>
            <h2 class="profile-section-title mt-3">My Brethren Card</h2>
            <p class="mystic-copy mt-2">Shared only when connection requests are accepted.</p>
          </div>
          <%= link_to "Edit Card", edit_settings_brethren_card_path, class: "btn btn-secondary" %>
        </div>

        <% if current_user.brethren_card&.complete? %>
          <div class="grid gap-4 md:grid-cols-2">
            <% [
              ["Church / Assembly", current_user.brethren_card.church_or_assembly],
              ["Occupation", current_user.brethren_card.occupation],
              ["WhatsApp", current_user.brethren_card.whatsapp_number],
              ["Email", current_user.brethren_card.email],
              ["About", current_user.brethren_card.bio]
            ].each do |label, value| %>
              <% next if value.blank? %>
              <div class="profile-card-field">
                <p class="profile-card-label"><%= label %></p>
                <p class="profile-card-value"><%= value %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="profile-card-empty">
            <h3>Complete Your Brethren Card</h3>
            <p class="mystic-copy mx-auto mt-2 max-w-md">Add the details you want trusted connections to see after a request is accepted.</p>
            <%= link_to "Complete My Card", edit_settings_brethren_card_path, class: "btn btn-primary mt-6" %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section>
      <div class="profile-section-heading mb-6 flex items-center gap-3">
        <%= render_icon("filetext", classes: "w-6 h-6 text-faith-green") %>
        <h2>Posts by <%= @user.display_name.presence || @user.username %></h2>
      </div>

      <% if @posts.any? %>
        <div class="space-y-5">
          <% @posts.each do |post| %>
            <%= render "posts/card", post: post %>
          <% end %>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="mt-8">
            <%== pagy_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <div class="mystic-panel profile-empty-posts p-12 text-center">
          <h3>No posts yet</h3>
          <p class="mystic-copy mt-2">Posts will appear here when published.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
