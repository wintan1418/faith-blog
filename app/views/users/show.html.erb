<% content_for(:title) { "#{@user.username} - Faith Community" } %>

<div class="mystic-shell">
  <section class="mystic-hero">
    <div class="mystic-container max-w-5xl py-12">
      <div class="flex flex-col gap-8 md:flex-row md:items-start">
        <div class="relative shrink-0">
          <% if @user.profile&.avatar&.attached? %>
            <%= image_tag @user.profile.avatar, class: "mystic-avatar h-32 w-32 object-cover md:h-40 md:w-40" %>
          <% else %>
            <span class="mystic-avatar mystic-avatar-fallback grid h-32 w-32 place-items-center text-5xl font-bold md:h-40 md:w-40">
              <%= @user.username.first.upcase %>
            </span>
          <% end %>
          <% if @user.super_admin? || @user.admin? || @user.moderator? %>
            <span class="absolute -bottom-2 right-2 mystic-badge px-3 py-1 shadow-sm">
              <%= @user.super_admin? ? "Super Admin" : (@user.admin? ? "Admin" : "Moderator") %>
            </span>
          <% end %>
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
              <h1 class="mystic-title text-4xl sm:text-6xl"><%= @user.display_name.presence || @user.username %></h1>
              <p class="mt-1 text-lg font-semibold text-faith-muted">@<%= @user.username %></p>
            </div>

            <% if user_signed_in? && @user == current_user %>
              <%= link_to "Edit Profile", edit_settings_profile_path, class: "btn btn-secondary" %>
            <% end %>
          </div>

          <% if @user.profile.bio.present? %>
            <p class="mystic-copy mt-5 max-w-2xl text-lg"><%= @user.profile.bio %></p>
          <% end %>

          <div class="mt-5 flex flex-wrap gap-3">
            <% if @user.profile.location.present? %>
              <span class="mystic-badge px-3 py-1">
                <%= render_icon("globe", classes: "w-4 h-4") %>
                <%= @user.profile.location %>
              </span>
            <% end %>
            <span class="mystic-badge px-3 py-1">
              <%= render_icon("clock", classes: "w-4 h-4") %>
              Joined <%= @user.created_at.strftime("%B %Y") %>
            </span>
          </div>

          <div class="mt-6 grid max-w-md grid-cols-3 gap-3">
            <%= link_to followers_user_path(@user.username), class: "rounded-2xl bg-white/65 p-4 text-center transition hover:bg-white" do %>
              <span class="block text-2xl font-bold text-faith-dark"><%= number_to_human(@user.followers_count, format: "%n%u", units: { thousand: "k" }) %></span>
              <span class="text-xs font-semibold text-faith-muted">Followers</span>
            <% end %>
            <%= link_to following_user_path(@user.username), class: "rounded-2xl bg-white/65 p-4 text-center transition hover:bg-white" do %>
              <span class="block text-2xl font-bold text-faith-dark"><%= number_to_human(@user.following_count, format: "%n%u", units: { thousand: "k" }) %></span>
              <span class="text-xs font-semibold text-faith-muted">Following</span>
            <% end %>
            <div class="rounded-2xl bg-white/65 p-4 text-center">
              <span class="block text-2xl font-bold text-faith-dark"><%= @user.posts.published.count %></span>
              <span class="text-xs font-semibold text-faith-muted">Posts</span>
            </div>
          </div>

          <% if user_signed_in? && @user != current_user %>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <% if current_user.following?(@user) %>
                <%= button_to "Following", unfollow_user_path(@user.username), method: :delete, class: "btn btn-secondary" %>
              <% else %>
                <%= button_to "Follow", follow_user_path(@user.username), class: "btn btn-primary" %>
              <% end %>

              <%= render "users/connection_actions", user: @user %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="mystic-container max-w-5xl py-10">
    <% if user_signed_in? && @user == current_user %>
      <section class="mystic-panel-strong mb-10 p-6 sm:p-8">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <span class="mystic-kicker">Private Profile Card</span>
            <h2 class="mt-3 text-3xl font-bold text-faith-dark">My Brethren Card</h2>
            <p class="mystic-copy mt-2">Shared only when connection requests are accepted.</p>
          </div>
          <%= link_to "Edit Card", edit_settings_brethren_card_path, class: "btn btn-secondary" %>
        </div>

        <% if current_user.brethren_card&.complete? %>
          <div class="grid gap-4 md:grid-cols-2">
            <% [
              ["Church / Assembly", current_user.brethren_card.church_or_assembly],
              ["Occupation", current_user.brethren_card.occupation],
              ["WhatsApp", current_user.brethren_card.whatsapp_number],
              ["Email", current_user.brethren_card.email],
              ["About", current_user.brethren_card.bio]
            ].each do |label, value| %>
              <% next if value.blank? %>
              <div class="rounded-2xl bg-white/65 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-faith-muted"><%= label %></p>
                <p class="mt-1 text-sm font-semibold text-faith-dark"><%= value %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl border border-dashed border-faith-green/25 bg-white/45 p-8 text-center">
            <h3 class="text-xl font-bold text-faith-dark">Complete Your Brethren Card</h3>
            <p class="mystic-copy mx-auto mt-2 max-w-md">Add the details you want trusted connections to see after a request is accepted.</p>
            <%= link_to "Complete My Card", edit_settings_brethren_card_path, class: "btn btn-primary mt-6" %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section>
      <div class="mb-6 flex items-center gap-3">
        <%= render_icon("filetext", classes: "w-6 h-6 text-faith-green") %>
        <h2 class="text-3xl font-bold text-faith-dark">Posts by <%= @user.display_name.presence || @user.username %></h2>
      </div>

      <% if @posts.any? %>
        <div class="space-y-5">
          <% @posts.each do |post| %>
            <%= render "posts/card", post: post %>
          <% end %>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="mt-8">
            <%== pagy_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <div class="mystic-panel p-12 text-center">
          <h3 class="text-xl font-bold text-faith-dark">No posts yet</h3>
          <p class="mystic-copy mt-2">Posts will appear here when published.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
