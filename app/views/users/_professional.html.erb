<%# Professional tab: experience, education and skills (LinkedIn-style), with
    the owner's profile strength and next steps at the top. %>
<% owner = user_signed_in? && user == current_user %>
<% strength = local_assigns[:strength] %>
<% name = user.display_name.presence || user.username %>
<% roles = user.experiences.to_a %>
<% schools = user.educations.to_a %>
<% skills = user.profile&.skills.to_a %>

<% if owner && strength %>
  <section class="mystic-panel-strong pro-strength" aria-label="Profile strength">
    <div class="pro-strength-head">
      <div>
        <p class="pro-strength-kicker">Profile strength</p>
        <p class="pro-strength-level"><%= strength.level %></p>
      </div>
      <p class="pro-strength-score"><%= strength.score %><small>%</small></p>
    </div>
    <div class="pro-strength-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= strength.score %>">
      <span style="width: <%= strength.score %>%"></span>
    </div>
    <% if strength.complete? %>
      <p class="pro-strength-note">Your profile is complete. Brethren searching for your skills will find you first.</p>
    <% else %>
      <p class="pro-strength-note">Strong profiles show up first when brethren look for your skills. <%= strength.done_steps.size %> of <%= strength.steps.size %> done.</p>
      <ul class="pro-steps">
        <% strength.next_steps.first(4).each do |step| %>
          <li class="pro-step">
            <span class="pro-step-dot" aria-hidden="true"></span>
            <span class="pro-step-label"><%= step.label %><% if step.hint %> <small>(<%= step.hint %>)</small><% end %></span>
            <%= link_to step.action, step.path, class: "pro-step-go", aria: { label: "#{step.action}: #{step.label}" } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<% if roles.empty? && schools.empty? && skills.empty? && user.profile&.headline.blank? %>
  <section class="mystic-panel-strong pro-card pro-card--empty">
    <% if owner %>
      <h2 class="pro-card-title">Your professional side</h2>
      <p class="pro-empty">Let brethren in your field find you: add what you do, where you've served and what you studied.</p>
      <%= link_to "Add professional details", edit_settings_professional_path, class: "btn btn-primary" %>
    <% else %>
      <p class="pro-empty"><%= name %> hasn't added professional details yet.</p>
    <% end %>
  </section>
<% else %>
  <section class="mystic-panel-strong pro-card" aria-label="Experience">
    <div class="pro-panel-head">
      <h2 class="pro-card-title">Experience</h2>
      <% if owner %><%= link_to "+ Add", new_settings_experience_path, class: "pro-item-edit" %><% end %>
    </div>
    <% if roles.any? %>
      <ul class="pro-list">
        <% roles.each do |experience| %>
          <li class="pro-item">
            <%= render "users/org_mark", name: experience.organization %>
            <div class="pro-item-main">
              <p class="pro-item-title"><%= experience.title %></p>
              <p class="pro-item-sub"><%= [ experience.organization, experience.employment_type ].compact_blank.join(" · ") %></p>
              <p class="pro-item-meta"><%= experience.date_range %> · <%= experience.duration %></p>
              <% if experience.location.present? %><p class="pro-item-meta"><%= experience.location %></p><% end %>
              <% if experience.description.present? %>
                <p class="pro-item-desc"><%= simple_format(experience.description, {}, wrapper_tag: "span") %></p>
              <% end %>
            </div>
            <% if owner %><%= link_to "Edit", edit_settings_experience_path(experience), class: "pro-item-edit", aria: { label: "Edit #{experience.title}" } %><% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="pro-empty"><%= owner ? "Add your current role so brethren know what you do." : "No roles added yet." %></p>
    <% end %>
  </section>

  <% if schools.any? || owner %>
    <section class="mystic-panel-strong pro-card" aria-label="Education">
      <div class="pro-panel-head">
        <h2 class="pro-card-title">Education</h2>
        <% if owner %><%= link_to "+ Add", new_settings_education_path, class: "pro-item-edit" %><% end %>
      </div>
      <% if schools.any? %>
        <ul class="pro-list">
          <% schools.each do |education| %>
            <li class="pro-item">
              <%= render "users/org_mark", name: education.school %>
              <div class="pro-item-main">
                <p class="pro-item-title"><%= education.school %></p>
                <% sub = [ education.qualification, education.field_of_study ].compact_blank.join(", ") %>
                <% if sub.present? %><p class="pro-item-sub"><%= sub %></p><% end %>
                <% if education.years %><p class="pro-item-meta"><%= education.years %></p><% end %>
              </div>
              <% if owner %><%= link_to "Edit", edit_settings_education_path(education), class: "pro-item-edit", aria: { label: "Edit #{education.school}" } %><% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="pro-empty">Add a school, college or training.</p>
      <% end %>
    </section>
  <% end %>

  <% if skills.any? || owner %>
    <section class="mystic-panel-strong pro-card" aria-label="Skills">
      <div class="pro-panel-head">
        <h2 class="pro-card-title">Skills</h2>
        <% if owner %><%= link_to "Edit", edit_settings_professional_path, class: "pro-item-edit" %><% end %>
      </div>
      <% if skills.any? %>
        <div class="pro-skills">
          <% skills.each do |skill| %><span class="pro-skill"><%= skill %></span><% end %>
        </div>
      <% else %>
        <p class="pro-empty">List what you're good at, at work or in service.</p>
      <% end %>
    </section>
  <% end %>
<% end %>
