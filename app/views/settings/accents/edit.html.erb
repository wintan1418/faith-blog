<% content_for(:title) { "Accent color · Settings · Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-8">
      <span class="mystic-kicker">Settings</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Accent color</h1>
      <p class="mystic-copy mt-2">Pick the color that paints your buttons, badges, and highlights across the app.</p>
    </div>

    <%= render "settings/tabs", active: :accent %>

    <div class="mystic-panel-strong overflow-hidden" data-controller="accent-picker">
      <div class="border-b border-faith-green/10 p-6">
        <h2 class="text-xl font-bold text-faith-dark">Choose your accent</h2>
        <p class="mystic-copy text-sm">Tap any swatch — it applies instantly and saves itself.</p>
        <p class="fc-accent-status mt-2 text-sm font-semibold" data-accent-picker-target="status" role="status" aria-live="polite"></p>
      </div>

      <%= form_with url: settings_accent_path, method: :patch, class: "p-6", local: true,
                    data: { accent_picker_target: "form" } do |f| %>
        <div class="fc-accent-swatches">
          <% AccentPalette::PALETTE.each do |slug, swatch| %>
            <label class="fc-accent-swatch<%= ' is-selected' if @current == slug %>"
                   data-accent-picker-target="swatch"
                   data-accent="<%= swatch[:accent] %>"
                   data-accent-deep="<%= swatch[:accent_2] %>"
                   data-name="<%= swatch[:name] %>"
                   data-action="click->accent-picker#pick"
                   style="--swatch: <%= swatch[:accent] %>; --swatch-2: <%= swatch[:accent_2] %>;">
              <%= f.radio_button :accent_color, slug, checked: (@current == slug), class: "sr-only", tabindex: -1 %>
              <span class="fc-accent-swatch-dot" aria-hidden="true"></span>
              <span class="fc-accent-swatch-name"><%= swatch[:name] %></span>
              <% if @current == slug %>
                <span class="fc-accent-swatch-check" aria-hidden="true">✓</span>
              <% end %>
            </label>
          <% end %>
        </div>

        <noscript>
          <div class="mt-6 flex justify-end">
            <%= f.submit "Save accent", class: "fc-btn fc-btn-primary" %>
          </div>
        </noscript>
      <% end %>
    </div>
  </div>
</div>
