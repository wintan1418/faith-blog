<% content_for :title, "Professional Profile" %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-4xl">
    <div class="mb-8">
      <span class="mystic-kicker">Settings</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Professional</h1>
      <p class="mystic-copy mt-2 max-w-2xl">Your work, education and skills. Shown on your profile so people in your field can find you.</p>
    </div>

    <%= render "settings/tabs", active: :professional %>

    <div class="pro-settings">
      <%= link_to new_settings_linkedin_import_path, class: "li-banner" do %>
        <span class="li-banner-mark" aria-hidden="true">in</span>
        <span class="li-banner-text"><b>Import from LinkedIn</b><span>Bring your roles, education and skills across in a minute.</span></span>
        <span class="li-banner-go" aria-hidden="true">→</span>
      <% end %>

      <section class="mystic-panel-strong pro-panel">
        <h2 class="pro-panel-title">Headline & skills</h2>
        <%= form_with model: @profile, url: settings_professional_path, method: :patch, class: "space-y-5" do |f| %>
          <% if @profile.errors.any? %>
            <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"><%= @profile.errors.full_messages.to_sentence %></div>
          <% end %>
          <div>
            <%= f.label :headline, "Headline", class: "label" %>
            <%= f.text_field :headline, class: "input", maxlength: 120,
                             placeholder: "Nurse at Lagos University Teaching Hospital · Worship leader" %>
            <p class="mt-1 text-xs text-faith-muted">One line under your name. Leave blank to use your current role.</p>
          </div>
          <div>
            <%= f.label :industry, "Industry", class: "label" %>
            <%= f.select :industry, Profile::INDUSTRIES, { include_blank: "Choose your industry" }, class: "input" %>
          </div>
          <div>
            <%= f.label :assembly, "Church / Assembly", class: "label" %>
            <%= f.text_field :assembly, class: "input", maxlength: 120, list: "assembly-options", autocomplete: "off",
                             placeholder: "Start typing, e.g. RCCG Jubilee Parish, Lagos" %>
            <datalist id="assembly-options">
              <% Profile.popular_assemblies.each do |name| %><option value="<%= name %>"></option><% end %>
            </datalist>
            <p class="mt-1 text-xs text-faith-muted">Shown on your profile. Pick from the list if your church is there, so brethren from the same assembly can find you.</p>
          </div>
          <div>
            <%= f.label :skills_list, "Skills", class: "label" %>
            <%= f.text_field :skills_list, class: "input", placeholder: "Nursing, Public speaking, Graphic design, Counselling" %>
            <p class="mt-1 text-xs text-faith-muted">Separate with commas (up to <%= Profile::MAX_SKILLS %>).</p>
          </div>
          <%= f.submit "Save", class: "btn btn-primary" %>
        <% end %>
      </section>

      <section class="mystic-panel-strong pro-panel" id="open-to">
        <h2 class="pro-panel-title">Open to</h2>
        <p class="pro-empty mb-3">Let people know what you're looking for. A coloured ring and a small badge show on your photo.</p>
        <%= form_with model: @profile, url: settings_professional_path, method: :patch, class: "ot-form" do |f| %>
          <%= hidden_field_tag "profile[open_to][]", "" %>
          <div class="ot-options">
            <% Profile::OPEN_TO.each do |key, info| %>
              <label class="ot-option ot-option--<%= info[:colour] %>">
                <%= check_box_tag "profile[open_to][]", key, @profile.open_to.include?(key), id: "open_to_#{key}" %>
                <span class="ot-dot" aria-hidden="true"></span>
                <span><b><%= info[:label] %></b><small><%= info[:badge] %> badge</small></span>
              </label>
            <% end %>
          </div>
          <fieldset class="ot-who">
            <legend>Who can see this</legend>
            <label><%= f.radio_button :open_to_visibility, "everyone" %> Everyone on Brethreign</label>
            <label><%= f.radio_button :open_to_visibility, "connections" %> My connections only</label>
          </fieldset>
          <p class="text-xs text-faith-muted">Looking for new work quietly? Choose “My connections only”.</p>
          <%= f.submit "Save", class: "btn btn-primary" %>
        <% end %>
      </section>

      <section class="mystic-panel-strong pro-panel">
        <div class="pro-panel-head">
          <h2 class="pro-panel-title">Experience</h2>
          <%= link_to "+ Add", new_settings_experience_path, class: "btn btn-secondary btn-sm" %>
        </div>
        <% if current_user.experiences.any? %>
          <ul class="pro-list">
            <% current_user.experiences.each do |experience| %>
              <li class="pro-item">
                <%= render "users/org_mark", name: experience.organization %>
                <div class="pro-item-main">
                  <p class="pro-item-title"><%= experience.title %></p>
                  <p class="pro-item-sub"><%= [ experience.organization, experience.type_label ].compact_blank.join(" · ") %></p>
                  <p class="pro-item-meta"><%= experience.date_range %> · <%= experience.duration %></p>
                </div>
                <%= link_to "Edit", edit_settings_experience_path(experience), class: "pro-item-edit" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="pro-empty">Add your current job, or a past one. Volunteer and church roles can go here too.</p>
        <% end %>
      </section>

      <section class="mystic-panel-strong pro-panel">
        <div class="pro-panel-head">
          <h2 class="pro-panel-title">Education</h2>
          <%= link_to "+ Add", new_settings_education_path, class: "btn btn-secondary btn-sm" %>
        </div>
        <% if current_user.educations.any? %>
          <ul class="pro-list">
            <% current_user.educations.each do |education| %>
              <li class="pro-item">
                <%= render "users/org_mark", name: education.school %>
                <div class="pro-item-main">
                  <p class="pro-item-title"><%= education.school %></p>
                  <p class="pro-item-sub"><%= [ education.qualification, education.field_of_study ].compact_blank.join(", ") %></p>
                  <% if education.years %><p class="pro-item-meta"><%= education.years %></p><% end %>
                </div>
                <%= link_to "Edit", edit_settings_education_path(education), class: "pro-item-edit" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="pro-empty">Add a school, university, seminary or course.</p>
        <% end %>
      </section>

      <section class="mystic-panel-strong pro-panel">
        <div class="pro-panel-head">
          <h2 class="pro-panel-title">Licenses &amp; certifications</h2>
          <%= link_to "+ Add", new_settings_certification_path, class: "btn btn-secondary btn-sm" %>
        </div>
        <% if current_user.certifications.any? %>
          <ul class="pro-list">
            <% current_user.certifications.each do |cert| %>
              <li class="pro-item">
                <%= render "users/org_mark", name: cert.issuer.presence || cert.name %>
                <div class="pro-item-main">
                  <p class="pro-item-title"><%= cert.name %></p>
                  <% if cert.issuer.present? %><p class="pro-item-sub"><%= cert.issuer %></p><% end %>
                  <% if cert.dates.present? %><p class="pro-item-meta"><%= cert.dates %></p><% end %>
                </div>
                <%= link_to "Edit", edit_settings_certification_path(cert), class: "pro-item-edit" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="pro-empty">Professional licenses, certificates and courses you've completed.</p>
        <% end %>
      </section>

      <section class="mystic-panel-strong pro-panel" id="languages">
        <h2 class="pro-panel-title">Languages</h2>
        <% if current_user.languages.any? %>
          <ul class="pro-lang-list">
            <% current_user.languages.each do |lang| %>
              <li>
                <span><b><%= lang.name %></b> <span class="pro-item-meta"><%= lang.proficiency_label %></span></span>
                <%= button_to "Remove", settings_language_path(lang), method: :delete, class: "pro-remove",
                              aria: { label: "Remove #{lang.name}" } %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <%= form_with model: UserLanguage.new, url: settings_languages_path, class: "pro-lang-form" do |f| %>
          <%= f.text_field :name, class: "input", required: true, maxlength: 60, placeholder: "English, Yoruba, French…",
                           aria: { label: "Language" } %>
          <%= f.select :proficiency, UserLanguage::LABELS.invert, { selected: "professional_working" }, class: "input",
                       aria: { label: "Level" } %>
          <%= f.submit "Add", class: "btn btn-secondary" %>
        <% end %>
      </section>
    </div>
  </div>
</div>
