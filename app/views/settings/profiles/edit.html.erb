<% content_for(:title) { "Edit Profile - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-8">
      <span class="mystic-kicker">Settings</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Profile</h1>
      <p class="mystic-copy mt-2">Manage your public profile information.</p>
    </div>

    <%= render "settings/tabs", active: :profile %>

    <div class="mystic-panel-strong overflow-hidden">
      <div class="border-b border-faith-green/10 p-6">
        <h2 class="text-xl font-bold text-faith-dark">Profile Information</h2>
        <p class="mystic-copy text-sm">Update what other members see on your profile.</p>
      </div>

      <div class="p-6">
        <%= form_with model: @profile, url: settings_profile_path, method: :patch, class: "space-y-6" do |f| %>
          <% if @profile.errors.any? %>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
              <ul class="list-inside list-disc text-sm text-red-700">
                <% @profile.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <label class="label">Profile Photo</label>
            <div class="flex flex-wrap items-center gap-4">
              <% if @profile.avatar.attached? %>
                <%= image_tag @profile.avatar, class: "mystic-avatar h-20 w-20 object-cover" %>
              <% else %>
                <span class="mystic-avatar mystic-avatar-fallback grid h-20 w-20 place-items-center text-2xl font-bold">
                  <%= current_user.username.first.upcase %>
                </span>
              <% end %>
              <div>
                <%= f.file_field :avatar, class: "text-sm text-faith-muted file:mr-4 file:rounded-full file:border-0 file:bg-white file:px-4 file:py-2 file:text-sm file:font-bold file:text-faith-green" %>
                <p class="mt-1 text-xs text-faith-muted">JPG or PNG up to 5MB.</p>
              </div>
            </div>
          </div>

          <div>
            <%= f.label :bio, class: "label" %>
            <%= f.text_area :bio, class: "input", rows: 4, placeholder: "Tell others a bit about yourself and your faith journey..." %>
            <p class="mt-1 text-xs text-faith-muted"><%= @profile.bio&.length || 0 %>/500 characters</p>
          </div>

          <div>
            <%= f.label :location, class: "label" %>
            <%= f.text_field :location, class: "input", placeholder: "City, Country" %>
          </div>

          <div>
            <%= f.label :faith_background, class: "label" %>
            <%= f.text_field :faith_background, class: "input", placeholder: "e.g. Baptist, Non-denominational, Catholic" %>
          </div>

          <div>
            <%= f.label :website, class: "label" %>
            <%= f.url_field :website, class: "input", placeholder: "https://yourblog.com" %>
          </div>

          <label class="flex items-center gap-2 border-t border-faith-green/10 pt-4 text-sm font-semibold text-faith-muted">
            <%= f.check_box :public_profile, class: "h-4 w-4 rounded border-faith-green/20 text-faith-green focus:ring-faith-green" %>
            Make my profile public
          </label>

          <%= f.submit "Save Changes", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
