<% content_for(:title) { "Account Settings - Faith Community" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-8">
      <span class="mystic-kicker">Settings</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Account</h1>
      <p class="mystic-copy mt-2">Manage sign-in details and account credentials.</p>
    </div>

    <%= render "settings/tabs", active: :account %>

    <div class="mystic-panel-strong overflow-hidden">
      <div class="border-b border-faith-green/10 p-6">
        <h2 class="text-xl font-bold text-faith-dark">Account Settings</h2>
        <p class="mystic-copy text-sm">Update your username, email, or password.</p>
      </div>

      <div class="p-6">
        <%= form_with model: current_user, url: settings_account_path, method: :patch, class: "space-y-6" do |f| %>
          <% if current_user.errors.any? %>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
              <ul class="list-inside list-disc text-sm text-red-700">
                <% current_user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= f.label :username, class: "label" %>
            <%= f.text_field :username, class: "input" %>
          </div>

          <div>
            <%= f.label :email, class: "label" %>
            <%= f.email_field :email, class: "input" %>
          </div>

          <div class="border-t border-faith-green/10 pt-5">
            <h3 class="mb-1 text-sm font-bold text-faith-dark">Change Password</h3>
            <p class="mb-4 text-sm text-faith-muted">Leave blank if you do not want to change your password.</p>
            <div class="space-y-4">
              <div>
                <%= f.label :password, "New Password", class: "label" %>
                <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
              </div>
              <div>
                <%= f.label :password_confirmation, "Confirm New Password", class: "label" %>
                <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
              </div>
            </div>
          </div>

          <%= f.submit "Save Changes", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>

    <div class="mt-6 rounded-3xl border border-red-200 bg-red-50/80 p-6">
      <h2 class="text-lg font-bold text-red-900">Danger Zone</h2>
      <p class="mt-1 text-sm text-red-700">Irreversible account actions live here.</p>
      <%= button_to "Delete Account", edit_user_registration_path, method: :get, class: "btn btn-danger mt-4", data: { turbo_confirm: "Are you absolutely sure you want to delete your account? This cannot be undone." } %>
    </div>
  </div>
</div>
