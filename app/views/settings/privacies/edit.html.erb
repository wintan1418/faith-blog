<% content_for(:title) { "Privacy Settings - Brethreign" } %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-8">
      <span class="mystic-kicker">Settings</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Privacy</h1>
      <p class="mystic-copy mt-2">Control how visible your profile and contact details are to the community.</p>
    </div>

    <%= render "settings/tabs", active: :privacy %>

    <div class="mystic-panel-strong overflow-hidden">
      <div class="border-b border-faith-green/10 p-6">
        <h2 class="text-xl font-bold text-faith-dark">Profile Visibility</h2>
        <p class="mystic-copy text-sm">This affects profile discovery and public profile pages.</p>
      </div>

      <div class="p-6">
        <%= form_with model: @profile, url: settings_privacy_path, method: :patch, class: "space-y-6" do |f| %>
          <% if @profile.errors.any? %>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
              <ul class="list-inside list-disc text-sm text-red-700">
                <% @profile.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <label class="mystic-panel flex items-start gap-3 p-5">
            <%= f.check_box :public_profile, class: "mt-1 h-4 w-4 rounded border-faith-green/20 text-faith-green focus:ring-faith-green" %>
            <span>
              <span class="block font-bold text-faith-dark">Make my profile public</span>
              <span class="mt-1 block text-sm text-faith-muted">Members can find your profile and read the public details you add.</span>
            </span>
          </label>

          <label class="mystic-panel flex items-start gap-3 p-5">
            <%= hidden_field_tag "user[show_online_status]", "0", id: nil %>
            <%= check_box_tag "user[show_online_status]", "1", current_user.show_online_status?,
                  id: "user_show_online_status",
                  class: "mt-1 h-4 w-4 rounded border-faith-green/20 text-faith-green focus:ring-faith-green" %>
            <span>
              <span class="block font-bold text-faith-dark">Show when I'm online</span>
              <span class="mt-1 block text-sm text-faith-muted">Brethren see a green dot and "Active now" on your picture, and you appear in "Online now" on the feed. Turn this off to browse quietly.</span>
            </span>
          </label>

          <% bible = current_user.bible_habit %>
          <label class="mystic-panel flex items-start gap-3 p-5">
            <%= hidden_field_tag "bible[show_streak]", "0", id: nil %>
            <%= check_box_tag "bible[show_streak]", "1", bible.nil? || bible.show_streak?,
                  id: "bible_show_streak",
                  class: "mt-1 h-4 w-4 rounded border-faith-green/20 text-faith-green focus:ring-faith-green" %>
            <span>
              <span class="block font-bold text-faith-dark">Show my Bible reading streak on my profile</span>
              <span class="mt-1 block text-sm text-faith-muted">"12 days in the Word" on your profile. On the feed, others only ever see how many brethren read today, never who.</span>
            </span>
          </label>

          <section class="ctp-section" id="contact-privacy" aria-labelledby="contact-privacy-title">
            <h2 class="ctp-title" id="contact-privacy-title">Contact details &amp; privacy</h2>
            <p class="ctp-copy">
              Your Brethren Card email and WhatsApp number are private unless you choose otherwise. Your sign-in email
              (<%= current_user.email %>) is never shown to other members.
              <%= link_to "Edit the details themselves", edit_settings_brethren_card_path(anchor: "contact"), class: "ctp-link" %>.
            </p>
            <%= render "settings/contact_visibility_fields", card: @brethren_card %>
            <p class="ctp-copy ctp-small">Brethreign admins can see contact details to keep the community safe. A block always hides them.</p>
          </section>

          <%= f.submit "Save Changes", class: "btn btn-primary" %>
        <% end %>

        <section class="ctp-section ctp-people" id="contact-people" aria-labelledby="contact-people-title">
          <h3 class="ctp-subtitle" id="contact-people-title">Connections I chose (<%= @contact_shares.size %>)</h3>
          <p class="ctp-copy ctp-small">They see any detail not set to “Only me”. You can also add someone with “Share my contact” on their profile or in a chat.</p>
          <% if @contact_shares.any? %>
            <ul class="ctp-list">
              <% @contact_shares.each do |share| %>
                <% person = share.viewer %>
                <li class="ctp-person">
                  <%= link_to user_path(person.username), class: "ctp-person-who" do %>
                    <% if person.profile&.avatar&.attached? %>
                      <%= image_tag avatar_src(person.profile, 96), class: "ctp-avatar", alt: "" %>
                    <% else %>
                      <span class="ctp-avatar" style="<%= avatar_tint_style(person.username) %>"><%= person.username.first.upcase %></span>
                    <% end %>
                    <span class="min-w-0"><span class="ctp-person-name"><%= person.display_name %></span><span class="ctp-person-handle">@<%= person.username %><%= " · not connected now, so they can't see it" unless @connection_ids.include?(person.id) %></span></span>
                  <% end %>
                  <%= button_to "Remove", contact_share_path(share), method: :delete, class: "ctp-remove", form_class: "ctp-remove-form",
                                aria: { label: "Stop sharing with #{person.display_name}" } %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="ctp-empty">Nobody yet.</p>
          <% end %>

          <% if @shareable_connections.any? %>
            <%= form_with url: contact_shares_path, method: :post, class: "ctp-add" do %>
              <label class="sr-only" for="contact_share_user_id">Add a connection</label>
              <%= select_tag :user_id, options_from_collection_for_select(@shareable_connections, :id, ->(u) { "#{u.display_name} (@#{u.username})" }),
                             prompt: "Add one of your connections…", id: "contact_share_user_id", class: "input ctp-select", required: true %>
              <button type="submit" class="btn btn-secondary ctp-add-btn">Add</button>
            <% end %>
          <% elsif @contact_shares.empty? %>
            <p class="ctp-copy ctp-small">When you connect with brethren, you can add them here.</p>
          <% end %>
        </section>
      </div>
    </div>
  </div>
</div>
