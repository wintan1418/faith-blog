<% content_for :title, "Edit Your Brethren Card" %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-6xl">
    <div class="mb-8">
      <span class="mystic-kicker">Settings</span>
      <h1 class="mystic-title mt-3 text-4xl sm:text-5xl">Brethren Card</h1>
      <p class="mystic-copy mt-2 max-w-2xl">Your private connection card. Members only see it after you both connect.</p>
    </div>

    <%= render "settings/tabs", active: :brethren_card %>

    <div class="bc-layout">
      <section class="mystic-panel-strong p-5 sm:p-6">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-extrabold text-faith-dark">Card Details</h2>
            <p class="mystic-copy mt-1 text-sm">Keep it short enough to scan, but useful enough for real fellowship.</p>
          </div>
          <span class="mystic-badge px-3 py-1"><%= @brethren_card.complete? ? "Complete" : "Incomplete" %></span>
        </div>

        <%= form_with model: @brethren_card, url: settings_brethren_card_path, method: :patch, class: "space-y-5" do |f| %>
          <% if @brethren_card.errors.any? %>
            <div class="rounded-lg border border-red-200 bg-red-50 p-4">
              <p class="mb-2 text-sm font-bold text-red-700">Please correct the following:</p>
              <ul class="list-inside list-disc text-sm text-red-700">
                <% @brethren_card.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <%= f.label :church_or_assembly, "Church / Assembly", class: "label" %>
              <%= f.text_field :church_or_assembly, class: "input", placeholder: "Living Faith Chapel, Lagos" %>
            </div>

            <div>
              <%= f.label :occupation, "What You Do", class: "label" %>
              <%= f.text_field :occupation, class: "input", placeholder: "Software engineer, student, pastor..." %>
            </div>
          </div>

          <div>
            <%= f.label :bio, "About You", class: "label" %>
            <%= f.text_area :bio, class: "input min-h-[130px] resize-none", placeholder: "A brief introduction about your faith, service, or what kind of fellowship you value.", maxlength: 500 %>
            <p class="mt-1 text-xs text-faith-muted"><%= @brethren_card.bio&.length || 0 %>/500 characters</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <%= f.label :whatsapp_number, "WhatsApp Number", class: "label" %>
              <%= f.text_field :whatsapp_number, class: "input", placeholder: "+234 812 345 6789" %>
              <p class="mt-1 text-xs text-faith-muted">Include country code.</p>
            </div>

            <div>
              <%= f.label :email, "Email Address", class: "label" %>
              <%= f.email_field :email, class: "input", placeholder: "name@example.com" %>
            </div>
          </div>

          <div class="rounded-lg border border-[var(--border)] bg-[var(--surface-2)] p-4">
            <p class="text-sm font-bold text-faith-dark">Profile photo</p>
            <p class="mystic-copy mt-1 text-sm">
              Your profile photo is managed from <%= link_to "profile settings", edit_settings_profile_path, class: "font-bold text-faith-green hover:text-faith-dark" %>.
            </p>
          </div>

          <%= f.submit "Save Brethren Card", class: "btn btn-primary w-full" %>
        <% end %>
      </section>

      <aside class="space-y-5">
        <section class="bc-card bc-card-compact">
          <div class="text-center">
            <span class="bc-avatar-ring">
              <% if current_user.profile&.avatar&.attached? %>
                <%= image_tag current_user.profile.avatar, class: "bc-avatar", alt: current_user.display_name %>
              <% else %>
                <span class="bc-avatar"><%= current_user.display_name.first.upcase %></span>
              <% end %>
            </span>
            <h2 class="mt-3 text-xl font-extrabold text-faith-dark"><%= current_user.display_name %></h2>
            <p class="text-sm font-semibold text-faith-muted"><%= @brethren_card.occupation.presence || "Your occupation" %></p>
          </div>

          <div class="mt-5 space-y-3">
            <div class="bc-field">
              <span class="bc-icon"><%= render_icon("church", classes: "h-4 w-4") %></span>
              <div>
                <p class="bc-label">Church</p>
                <p class="bc-value"><%= @brethren_card.church_or_assembly.presence || "Your church/assembly" %></p>
              </div>
            </div>

            <div class="bc-field">
              <span class="bc-icon"><%= render_icon("file_text", classes: "h-4 w-4") %></span>
              <div>
                <p class="bc-label">About</p>
                <p class="bc-value"><%= @brethren_card.bio.presence || "A brief introduction appears here." %></p>
              </div>
            </div>
          </div>
        </section>

        <section class="mystic-panel p-5">
          <h3 class="font-extrabold text-faith-dark">How it works</h3>
          <ol class="mt-3 space-y-2 text-sm text-faith-muted">
            <li>1. Complete your card.</li>
            <li>2. Send or accept a connection request.</li>
            <li>3. Connected members can view each other's card.</li>
            <li>4. Use the shared contact details respectfully.</li>
          </ol>
        </section>
      </aside>
    </div>
  </div>
</div>
