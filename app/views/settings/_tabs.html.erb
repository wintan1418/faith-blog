<% active = local_assigns.fetch(:active) %>

<div class="settings-tabs">
  <%= link_to "Profile", edit_settings_profile_path, class: "settings-tab #{'is-active' if active == :profile}" %>
  <%= link_to "Account", edit_settings_account_path, class: "settings-tab #{'is-active' if active == :account}" %>
  <%= link_to "Notifications", edit_settings_notifications_path, class: "settings-tab #{'is-active' if active == :notifications}" %>
  <%= link_to "Privacy", edit_settings_privacy_path, class: "settings-tab #{'is-active' if active == :privacy}" %>
  <%= link_to "Brethren Card", edit_settings_brethren_card_path, class: "settings-tab #{'is-active' if active == :brethren_card}" %>
</div>
