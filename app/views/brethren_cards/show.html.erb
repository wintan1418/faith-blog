<% content_for :title, "#{@user.display_name}'s Brethren Card" %>

<div class="mystic-shell py-8">
  <div class="mystic-container max-w-3xl">
    <div class="mb-6">
      <%= link_to user_path(@user.username), class: "btn btn-secondary" do %>
        <%= render_icon("arrow_right", classes: "h-4 w-4 rotate-180") %>
        Back to Profile
      <% end %>
    </div>

    <article class="bc-card bc-card-full">
      <header class="text-center">
        <span class="bc-avatar-ring">
          <% if @user.profile&.avatar&.attached? %>
            <%= image_tag avatar_src(@user.profile, 400), class: "bc-avatar", alt: @user.display_name %>
          <% else %>
            <span class="bc-avatar"><%= @user.display_name.first.upcase %></span>
          <% end %>
        </span>

        <h1 class="mt-4 text-3xl font-extrabold text-faith-dark"><%= @user.display_name %></h1>
        <% if @full_card && @brethren_card&.occupation.present? %>
          <p class="mt-1 text-base font-semibold text-faith-muted"><%= @brethren_card.occupation %></p>
        <% end %>
        <span class="mystic-badge mt-4 px-3 py-1">Brethreign Connection</span>
      </header>

      <div class="mt-6 space-y-3">
        <% if @full_card && @brethren_card&.church_or_assembly.present? %>
          <section class="bc-field">
            <span class="bc-icon"><%= render_icon("church", classes: "h-4 w-4") %></span>
            <div>
              <p class="bc-label">Church / Assembly</p>
              <p class="bc-value"><%= @brethren_card.church_or_assembly %></p>
            </div>
          </section>
        <% end %>

        <% if @full_card && @brethren_card&.bio.present? %>
          <section class="bc-field">
            <span class="bc-icon"><%= render_icon("file_text", classes: "h-4 w-4") %></span>
            <div>
              <p class="bc-label">About</p>
              <p class="bc-value"><%= @brethren_card.bio %></p>
            </div>
          </section>
        <% end %>
      </div>

      <footer class="mt-6 border-t border-[var(--border)] pt-5" id="contact">
        <p class="bc-label mb-3 text-center">Contact Details</p>
        <% if @contact.any? %>
          <div class="grid gap-3 sm:grid-cols-2">
            <% if @contact[:whatsapp] %>
              <%= link_to @brethren_card.whatsapp_link, target: "_blank", rel: "noopener", class: "bc-contact" do %>
                <span class="bc-icon"><%= render_icon("phone", classes: "h-4 w-4") %></span>
                <span class="min-w-0">
                  <span class="block text-xs font-bold text-faith-dark">WhatsApp</span>
                  <span class="block truncate text-sm text-faith-muted"><%= @contact[:whatsapp] %></span>
                  <% if @owner %><span class="ctp-seen-by">Seen by: <%= contact_visibility_label(@brethren_card, :whatsapp) %></span><% end %>
                </span>
              <% end %>
            <% end %>

            <% if @contact[:email] %>
              <%= link_to @brethren_card.gmail_link, target: "_blank", rel: "noopener", class: "bc-contact" do %>
                <span class="bc-icon"><%= render_icon("mail", classes: "h-4 w-4") %></span>
                <span class="min-w-0">
                  <span class="block text-xs font-bold text-faith-dark">Email</span>
                  <span class="block truncate text-sm text-faith-muted"><%= @contact[:email] %></span>
                  <% if @owner %><span class="ctp-seen-by">Seen by: <%= contact_visibility_label(@brethren_card, :email) %></span><% end %>
                </span>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <% if @owner %>
          <p class="ctp-card-note">
            <% if @contact.empty? %>You haven't added an email or WhatsApp number.<% end %>
            <%= link_to "Choose who can see your contact details", edit_settings_privacy_path(anchor: "contact-privacy"), class: "font-bold text-faith-green" %>
          </p>
        <% elsif @contact.empty? %>
          <p class="ctp-card-note"><%= @user.display_name %> keeps their contact details private. You can still send a message.</p>
        <% end %>
      </footer>
    </article>
  </div>
</div>
