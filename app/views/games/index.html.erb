<% content_for(:title) { "Games · Brethreign" } %>

<div class="fc-app">
  <div class="fc-shell fc-games-shell" style="grid-template-columns: minmax(0, 1fr);">
    <main class="fc-main fc-games">
      <header class="fc-games-head fc-games-head--hub">
        <div class="fc-games-head-copy">
          <%= link_to feed_path, class: "fc-games-back" do %>
            <%= render_icon("chevronleft", classes: "h-[18px] w-[18px]") %>
            Feed
          <% end %>
          <h1 class="fc-games-title">Games</h1>
          <p class="fc-games-intro">Sharpen your scripture and climb the weekly leaderboard.</p>
        </div>
        <a href="#leaderboard" class="fc-games-lbpill">
          <%= render_icon("trophy", classes: "fc-games-lbpill-icon") %>
          Leaderboard
          <span class="fc-games-lbpill-meta">resets in <%= leaderboard_reset_countdown %></span>
        </a>
      </header>

      <%# ── Your stats ─────────────────────────────────────────── %>
      <section class="fc-games-stats" aria-label="Your stats">
        <div class="fc-games-stat">
          <span class="fc-games-stat-num"><%= @my_stats[:score_this_week] %></span>
          <span class="fc-games-stat-label">Score this week</span>
        </div>
        <div class="fc-games-stat">
          <span class="fc-games-stat-num"><%= @my_stats[:plays_this_week] %></span>
          <span class="fc-games-stat-label">Plays this week</span>
        </div>
        <div class="fc-games-stat">
          <span class="fc-games-stat-num"><%= @my_stats[:best_ever] %></span>
          <span class="fc-games-stat-label">Best single run</span>
        </div>
        <div class="fc-games-stat">
          <span class="fc-games-stat-num"><%= @my_rank ? "##{@my_rank}" : "—" %></span>
          <span class="fc-games-stat-label">Rank <%= { "week" => "this week", "month" => "this month", "all" => "all time" }.fetch(@window, "this week") %></span>
        </div>
      </section>

      <%# ── Today's challenge: the chess puzzle of the day ─────── %>
      <%= link_to games_chess_path, class: "fc-games-feature" do %>
        <span class="fc-games-feature-tile" aria-hidden="true"><%= render_icon("chess", classes: "h-10 w-10") %></span>
        <span class="fc-games-feature-copy">
          <span class="fc-games-feature-kicker">Today's challenge</span>
          <span class="fc-games-feature-title">Chess puzzle of the day</span>
          <span class="fc-games-feature-body">Today's puzzle from Lichess, played right here. +1 to +5 based on rating, plus the 10-stage ladder.</span>
        </span>
        <span class="fc-games-feature-cta">
          <%= @chess_solved_today ? "Solved · play the ladder" : "Solve it" %>
          <%= render_icon("arrowright", classes: "h-5 w-5") %>
        </span>
      <% end %>

      <%# ── All games ──────────────────────────────────────────── %>
      <section class="fc-games-section" aria-labelledby="all_games_heading">
        <h2 id="all_games_heading" class="fc-games-h2">All games</h2>
        <div class="fc-games-grid">
          <% GamesHelper::HUB_GAMES.each do |game| %>
            <% meta = game_kind_meta(game[:kind]) %>
            <% best = @best_by_kind[game[:kind]] %>
            <%= link_to public_send(game[:path]), class: "fc-games-card", data: { game: game[:kind] } do %>
              <span class="fc-games-card-top">
                <%= game_icon_tile(game[:kind]) %>
                <span class="fc-games-card-name-wrap">
                  <span class="fc-games-card-name"><%= meta[:name] %></span>
                  <span class="fc-games-card-meta"><%= game[:meta] %></span>
                </span>
              </span>
              <span class="fc-games-card-body"><%= game[:body] %></span>
              <span class="fc-games-card-foot">
                <span class="fc-games-card-best"><%= best ? "Best: #{best}" : "Not played yet" %></span>
                <span class="fc-games-play">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="<%= IconHelper::ICONS["play"] %>"/></svg>
                  Play
                </span>
              </span>
            <% end %>
          <% end %>
        </div>
        <p class="fc-games-more">
          Want the story behind the quiz?
          <%= link_to church_history_path, class: "fc-games-more-link" do %>
            Explore the Church History arena <%= render_icon("arrowright", classes: "h-4 w-4") %>
          <% end %>
        </p>
      </section>

      <%# ── Champions + leaderboard ─────────────────────────────── %>
      <section id="leaderboard" class="fc-games-section">
        <% if @champions.present? %>
          <div class="mb-6">
            <h2 class="fc-games-h2 fc-games-h2--icon">
              <span class="fc-games-h2-icon is-gold"><%= render_icon("crown", classes: "h-5 w-5") %></span>
              This week's champions
            </h2>
            <div class="fc-champ-grid mt-3">
              <% @champions.each do |champ| %>
                <% meta = game_kind_meta(champ[:kind]) %>
                <div class="fc-champ-card<%= ' is-me' if champ[:user]&.id == current_user.id %>">
                  <%= game_icon_tile(champ[:kind], size: :sm) %>
                  <div class="fc-champ-body">
                    <span class="fc-champ-game"><%= meta[:name] %></span>
                    <% if champ[:user] %>
                      <%= link_to champ[:user].username, user_path(champ[:user].username), class: "fc-champ-name" %>
                    <% end %>
                  </div>
                  <span class="fc-champ-score"><%= champ[:total_score] %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="fc-games-lbhead">
          <div>
            <h2 class="fc-games-h2 fc-games-h2--icon">
              <span class="fc-games-h2-icon is-gold"><%= render_icon("trophy", classes: "h-5 w-5") %></span>
              Leaderboard
            </h2>
            <% if @window == "week" %>
              <p class="fc-lb-reset">
                <%= render_icon("hourglass", classes: "h-4 w-4") %>
                Resets in <%= leaderboard_reset_countdown %>. Every Monday, a clean slate.
              </p>
            <% end %>
          </div>
          <div class="fc-window-tabs" role="navigation" aria-label="Leaderboard window">
            <%= link_to "Week",  games_path(window: "week", anchor: "leaderboard"),  class: "fc-window-tab #{'is-active' if @window == 'week'}", "aria-current": (@window == "week" ? "true" : nil) %>
            <%= link_to "Month", games_path(window: "month", anchor: "leaderboard"), class: "fc-window-tab #{'is-active' if @window == 'month'}", "aria-current": (@window == "month" ? "true" : nil) %>
            <%= link_to "All time", games_path(window: "all", anchor: "leaderboard"), class: "fc-window-tab #{'is-active' if @window == 'all'}", "aria-current": (@window == "all" ? "true" : nil) %>
          </div>
        </div>

        <% if @leaderboard.any? %>
          <ol class="fc-leaderboard">
            <% @leaderboard.each_with_index do |row, i| %>
              <li class="fc-lb-row<%= ' is-me' if row[:user].id == current_user.id %>">
                <span class="fc-lb-rank<%= " fc-trend-rank is-#{i + 1}" if i < 3 %>"><%= i + 1 %></span>
                <% if row[:user].profile&.avatar&.attached? %>
                  <%= image_tag avatar_src(row[:user].profile), class: "fc-avatar object-cover", alt: "" %>
                <% else %>
                  <span class="fc-avatar" style="<%= avatar_tint_style(row[:user].username) %>">
                    <%= row[:user].username.first.upcase %>
                  </span>
                <% end %>
                <div class="fc-lb-body">
                  <%= link_to row[:user].username, user_path(row[:user].username), class: "fc-lb-name" %>
                  <span class="fc-lb-meta">
                    <%= pluralize(row[:plays], "play") %> · best <%= row[:best] %>
                  </span>
                </div>
                <span class="fc-lb-score"><%= row[:total_score] %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <div class="fc-empty">
            <div class="fc-empty-mark fc-games-empty-mark" aria-hidden="true"><%= render_icon("trophy", classes: "h-7 w-7") %></div>
            <h3 class="fc-empty-title">No one has played yet this <%= @window == 'all' ? 'season' : @window %>.</h3>
            <p class="fc-empty-text">Be the first.</p>
            <div class="fc-empty-actions">
              <%= link_to "Take the quiz", games_quiz_path, class: "fc-btn fc-btn-primary" %>
            </div>
          </div>
        <% end %>
      </section>
    </main>
  </div>
</div>
