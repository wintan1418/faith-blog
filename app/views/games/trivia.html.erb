<% content_for(:title) { "Religion Trivia · Faith Community" } %>

<div class="fc-app">
  <div class="fc-shell" style="grid-template-columns: minmax(0, 1fr); max-width: 640px;">
    <main class="fc-main">
      <header class="mb-5">
        <%= link_to games_path, class: "text-sm font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" do %>
          ← Back to games
        <% end %>
        <h1 class="mt-2 text-2xl font-extrabold text-[var(--fc-ink)]">🌍 Religion Trivia</h1>
        <p class="text-sm text-[var(--fc-muted)]">Five multi-choice questions from Open Trivia DB. Wider than just the Bible — religions, history, traditions.</p>
      </header>

      <section data-controller="quiz"
               data-quiz-generate-url-value="<%= games_trivia_generate_path %>"
               data-quiz-submit-url-value="<%= games_trivia_submit_path %>"
               data-quiz-csrf-value="<%= form_authenticity_token %>">
        <div class="fc-quiz" data-quiz-target="stage">
          <div class="fc-quiz-screen" data-quiz-target="ring">
            <p class="fc-quiz-kicker">Trivia · 5 questions</p>
            <h2 class="fc-quiz-headline">Test your reach.</h2>
            <p class="fc-quiz-sub">Questions span world religions, scripture, and history. Counts toward the leaderboard.</p>
            <button type="button"
                    class="fc-btn fc-btn-primary fc-quiz-start"
                    data-action="click->quiz#start">
              Start trivia
            </button>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
