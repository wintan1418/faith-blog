<% content_for(:title) { "Bible Quiz · Faith Community" } %>

<div class="fc-app">
  <div class="fc-shell" style="grid-template-columns: minmax(0, 1fr); max-width: 640px;">
    <main class="fc-main">
      <header class="mb-5">
        <%= link_to games_path, class: "text-sm font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" do %>
          ← Back to games
        <% end %>
        <h1 class="mt-2 text-2xl font-extrabold text-[var(--fc-ink)]">📖 Bible Quiz</h1>
        <p class="text-sm text-[var(--fc-muted)]">5 questions. One try at each. Don't sweat it — you can play again.</p>
      </header>

      <section data-controller="quiz"
               data-quiz-generate-url-value="<%= games_quiz_generate_path %>"
               data-quiz-submit-url-value="<%= games_quiz_submit_path %>"
               data-quiz-csrf-value="<%= form_authenticity_token %>">
        <div class="fc-quiz" data-quiz-target="stage">
          <%# initial state: ready button %>
          <div class="fc-quiz-screen" data-quiz-target="ready">
            <p class="fc-quiz-kicker">Daily-feel · timed for under 2 minutes</p>
            <h2 class="fc-quiz-headline">Ready when you are.</h2>
            <p class="fc-quiz-sub">Each question is multiple choice. Quick taps, no penalty for getting it wrong.</p>
            <button type="button"
                    class="fc-btn fc-btn-primary fc-quiz-start"
                    data-action="click->quiz#start">
              Start quiz
            </button>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
