<% content_for(:title) { "Verse Memory · Brethreign" } %>

<div class="fc-app">
  <div class="fc-shell" style="grid-template-columns: minmax(0, 1fr); max-width: 720px;">
    <main class="fc-main">
      <header class="mb-5">
        <%= link_to games_path, class: "text-sm font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" do %>
          ← Back to games
        <% end %>
        <h1 class="mt-2 text-2xl font-extrabold text-[var(--fc-ink)]">🧠 Verse Memory</h1>
        <p class="text-sm text-[var(--fc-muted)]">One verse, five blanks — fill them in.</p>
      </header>

      <section data-controller="quiz"
               data-quiz-game-name-value="Verse Memory"
               data-quiz-generate-url-value="<%= games_verse_memory_generate_path %>"
               data-quiz-submit-url-value="<%= games_verse_memory_submit_path %>"
               data-quiz-csrf-value="<%= form_authenticity_token %>">
        <div class="fc-quiz" data-quiz-target="stage">
          <div class="fc-quiz-screen">
            <p class="fc-quiz-kicker">Verse memory · 5 blanks</p>
            <h2 class="fc-quiz-headline">How well do you know it?</h2>
            <p class="fc-quiz-sub">Five different KJV verses, one blank each — the last one asks you to finish the verse. Hide the Word in your heart.</p>
            <button type="button" class="fc-btn fc-btn-primary fc-quiz-start" data-action="click->quiz#start">
              ▶ Start round
            </button>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
