<% content_for(:title) { "4 Pics 1 Word · Brethreign" } %>

<div class="fc-app">
  <div class="fc-shell" style="grid-template-columns: minmax(0, 1fr); max-width: 720px;">
    <main class="fc-main">
      <header class="mb-5">
        <%= link_to games_path, class: "text-sm font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" do %>
          ← Back to games
        <% end %>
        <h1 class="mt-2 text-2xl font-extrabold text-[var(--fc-ink)]">🖼️ 4 Pics 1 Word</h1>
        <p class="text-sm text-[var(--fc-muted)]">Read the four emoji — guess the Bible story or concept.</p>
      </header>

      <section data-controller="quiz"
               data-quiz-generate-url-value="<%= games_pic_word_generate_path %>"
               data-quiz-submit-url-value="<%= games_pic_word_submit_path %>"
               data-quiz-csrf-value="<%= form_authenticity_token %>">
        <div class="fc-quiz fc-quiz-picword" data-quiz-target="stage">
          <div class="fc-quiz-screen">
            <p class="fc-quiz-kicker">4 pics · 1 word · 5 puzzles</p>
            <h2 class="fc-quiz-headline">What story is this?</h2>
            <p class="fc-quiz-sub">Four emoji together hint at a Bible story, character, miracle, or parable. Pick the right one.</p>
            <button type="button" class="fc-btn fc-btn-primary fc-quiz-start" data-action="click->quiz#start">
              ▶ Start puzzles
            </button>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
