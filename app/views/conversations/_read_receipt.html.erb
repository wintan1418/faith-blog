<% viewer_id = local_assigns[:viewer_id] || current_user&.id %>
<% latest = conversation.messages.visible.order(created_at: :desc).first %>
<%# Under your latest message (if it's the last one in the thread): "Seen 9:20" with their photo, or "Sent". %>
<div id="read_receipt" class="msg-receipt">
  <% if latest && latest.sender_id == viewer_id %>
    <% reader_participant = conversation.conversation_participants.includes(user: :profile).where.not(user_id: viewer_id).first %>
    <% reader = reader_participant&.user %>
    <% if conversation.read_by_other?(latest) && reader %>
      <span class="msg-receipt-seen" title="Seen by <%= reader.display_name %>">
        <%= render_icon("checkcheck", classes: "msg-receipt-icon") %>
        Seen<% if (read_at = reader_participant.last_read_at) %> <%= local_time_tag(read_at, "short", read_at.in_time_zone.strftime("%-l:%M")) %><% end %>
        <%= render "conversations/avatar", user: reader, size: "h-4 w-4" %>
      </span>
    <% else %>
      <span class="msg-receipt-sent">Sent</span>
    <% end %>
  <% end %>
</div>
