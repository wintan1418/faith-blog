<% other_user = conversation.other_participant_for(current_user) %>

<section class="inbox-thread">
  <header class="inbox-thread-head">
    <div class="flex min-w-0 items-center gap-3">
      <%= render "conversations/avatar", user: other_user, size: "h-11 w-11" %>
      <div class="min-w-0">
        <%= link_to other_user.display_name, user_path(other_user.username), class: "block truncate text-base font-black text-[var(--fc-ink)] hover:text-[var(--fc-accent)]" %>
        <p class="truncate text-sm font-semibold text-[var(--fc-muted)]">@<%= other_user.username %></p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to "View Profile", user_path(other_user.username), class: "btn btn-secondary btn-sm" %>
      <%= button_to "Archive", archive_conversation_path(conversation), method: :post, class: "btn btn-secondary btn-sm" %>
    </div>
  </header>

  <div id="messages" class="inbox-messages">
    <% if messages.any? %>
      <%= render partial: "conversations/message", collection: messages, as: :message %>
    <% else %>
      <div class="mystic-panel p-10 text-center">
        <h2 class="text-xl font-black text-[var(--fc-ink)]">Start the conversation</h2>
        <p class="mystic-copy mx-auto mt-2 max-w-md">This space is private between you and <%= other_user.display_name %>.</p>
      </div>
    <% end %>
  </div>

  <%= render "conversations/composer", conversation: conversation, message: message %>
</section>
