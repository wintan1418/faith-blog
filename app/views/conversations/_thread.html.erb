<% other_user = conversation.other_participant_for(current_user) %>

<section class="msg-thread"
         data-controller="typing"
         data-typing-conversation-id-value="<%= conversation.id %>"
         data-typing-user-id-value="<%= current_user.id %>"
         data-typing-username-value="<%= current_user.display_name %>">
  <%= turbo_stream_from [conversation, current_user.id, :messages] %>
  <%= turbo_stream_from [conversation, current_user.id, :read_receipt] %>

  <header class="msg-thread-head">
    <%= link_to conversations_path, class: "msg-icon-btn msg-thread-back", title: "Back to messages", aria: { label: "Back to messages" } do %>
      <%= render_icon("chevron_left", classes: "h-6 w-6") %>
    <% end %>

    <%= link_to user_path(other_user.username), class: "msg-thread-who" do %>
      <%= render "conversations/avatar", user: other_user, size: "h-10 w-10", online: other_user.online? %>
      <span class="min-w-0">
        <span class="msg-thread-name"><%= other_user.display_name %></span>
        <span class="msg-thread-status<%= ' is-online' if other_user.online? %>"><%= other_user.last_seen_label %></span>
      </span>
    <% end %>

    <div class="msg-thread-menu" data-controller="dropdown">
      <button type="button" class="msg-icon-btn" data-action="click->dropdown#toggle" title="More options" aria-label="More options">
        <%= render_icon("more", classes: "h-5 w-5") %>
      </button>
      <div data-dropdown-target="menu" class="msg-menu hidden">
        <%= link_to "View profile", user_path(other_user.username), class: "msg-menu-item" %>
        <% if current_user.blocked_message_user?(other_user) %>
          <%= button_to "Unblock #{other_user.display_name}", message_block_path(other_user), method: :delete, form_class: "w-full", class: "msg-menu-item" %>
        <% else %>
          <%= button_to "Block #{other_user.display_name}", message_blocks_path(user_id: other_user.id), method: :post, form_class: "w-full", class: "msg-menu-item",
                        data: { turbo_confirm: "Block #{other_user.display_name}? They won't be able to message you." } %>
        <% end %>
        <%= button_to "Archive conversation", archive_conversation_path(conversation), method: :post, form_class: "w-full", class: "msg-menu-item is-danger" %>
      </div>
    </div>
  </header>

  <div id="messages" class="msg-messages" data-controller="chat-scroll">
    <% if messages.any? %>
      <div class="msg-intro">
        <%= render "conversations/avatar", user: other_user, size: "h-16 w-16" %>
        <p class="msg-intro-name"><%= other_user.display_name %></p>
        <% if other_user.profile&.bio.present? %><p class="msg-intro-bio"><%= truncate(other_user.profile.bio, length: 90) %></p><% end %>
      </div>
      <% previous = nil %>
      <% messages.each do |msg| %>
        <%= render "conversations/message", message: msg, previous: previous, viewer_id: current_user.id %>
        <% previous = msg %>
      <% end %>
    <% else %>
      <div class="msg-intro is-empty">
        <%= render "conversations/avatar", user: other_user, size: "h-20 w-20" %>
        <p class="msg-intro-name"><%= other_user.display_name %></p>
        <p class="msg-intro-bio">This conversation is private between you and <%= other_user.display_name %>. Start with a kind word.</p>
      </div>
    <% end %>
  </div>

  <%= render "conversations/read_receipt", conversation: conversation, viewer_id: current_user.id %>

  <div class="typing-indicator msg-typing hidden" data-typing-target="indicator">
    <span class="typing-dots"><span></span><span></span><span></span></span>
    <span class="typing-text"></span>
  </div>

  <% if conversation.blocked_for?(current_user) %>
    <div class="msg-composer msg-composer--blocked">Messaging is blocked in this conversation.</div>
  <% else %>
    <%= render "conversations/composer", conversation: conversation, message: message %>
  <% end %>
</section>
