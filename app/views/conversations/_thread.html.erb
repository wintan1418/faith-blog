<% other_user = conversation.other_participant_for(current_user) %>

<section class="inbox-thread"
         data-controller="typing"
         data-typing-conversation-id-value="<%= conversation.id %>"
         data-typing-user-id-value="<%= current_user.id %>"
         data-typing-username-value="<%= current_user.display_name %>">
  <%= turbo_stream_from [conversation, current_user.id, :messages] %>
  <%= turbo_stream_from [conversation, current_user.id, :read_receipt] %>

  <header class="inbox-thread-head">
    <%= link_to conversations_path, class: "inbox-thread-back", title: "Back to inbox" do %>
      <span class="inbox-thread-back-arrow">‹</span>
      <span class="inbox-thread-back-label">Inbox</span>
    <% end %>

    <% if defined?(@conversations) && @conversations.present? %>
      <div class="inbox-thread-switcher" data-controller="dropdown">
        <button type="button"
                class="inbox-thread-switcher-trigger"
                data-action="click->dropdown#toggle"
                aria-label="Switch conversation">
          <%= render_icon("message_circle", classes: "h-4 w-4") %>
          <span>Switch</span>
        </button>
        <div data-dropdown-target="menu" class="inbox-switcher-menu hidden">
          <div class="inbox-switcher-head">Your conversations</div>
          <% @conversations.first(8).each do |conv| %>
            <% next if conv == conversation %>
            <% other = conv.other_participant_for(current_user) %>
            <%= link_to conversation_path(conv), class: "inbox-switcher-row", data: { turbo_frame: "_top" } do %>
              <%= render "conversations/avatar", user: other, size: "h-8 w-8" %>
              <div class="min-w-0">
                <p class="inbox-switcher-row-name"><%= other.display_name %></p>
                <p class="inbox-switcher-row-snippet">@<%= other.username %></p>
              </div>
            <% end %>
          <% end %>
          <%= link_to "See all in inbox →", conversations_path, class: "inbox-switcher-all" %>
        </div>
      </div>
    <% end %>

    <%= link_to user_path(other_user.username), class: "inbox-thread-identity" do %>
      <span class="inbox-avatar-wrap<%= ' is-online' if other_user.online? %>">
        <%= render "conversations/avatar", user: other_user, size: "h-10 w-10" %>
      </span>
      <div class="min-w-0">
        <p class="inbox-thread-name"><%= other_user.display_name %></p>
        <p class="inbox-thread-handle<%= ' is-online' if other_user.online? %>">
          <% if other_user.online? %><span class="inbox-pulse-dot"></span><% end %>
          <%= other_user.last_seen_label %>
        </p>
      </div>
    <% end %>

    <div class="inbox-thread-actions" data-controller="dropdown">
      <button type="button" class="fc-icon-btn" data-action="click->dropdown#toggle" title="More" aria-label="More">
        <%= render_icon("sparkles", classes: "h-4 w-4") rescue "⋯" %>
      </button>
      <div data-dropdown-target="menu" class="fc-dropdown-menu hidden absolute right-0 top-full mt-2 w-48 py-2 z-30">
        <%= link_to "View profile", user_path(other_user.username), class: "fc-dropdown-item" %>
        <% if current_user.blocked_message_user?(other_user) %>
          <%= button_to "Unblock", message_block_path(other_user), method: :delete, form_class: "inline w-full", class: "fc-dropdown-item w-full text-left" %>
        <% else %>
          <%= button_to "Block", message_blocks_path(user_id: other_user.id), method: :post, form_class: "inline w-full", class: "fc-dropdown-item w-full text-left" %>
        <% end %>
        <%= button_to "Archive conversation", archive_conversation_path(conversation), method: :post, form_class: "inline w-full", class: "fc-dropdown-item fc-dropdown-danger w-full text-left" %>
      </div>
    </div>
  </header>

  <% last_mine_id = messages.reverse.find { |m| m.sender_id == current_user.id }&.id %>

  <div id="messages" class="inbox-messages">
    <% if messages.any? %>
      <%= render partial: "conversations/message",
                 collection: messages,
                 as: :message,
                 locals: { viewer_id: current_user.id, last_mine_id: last_mine_id, conversation: conversation } %>
    <% else %>
      <div class="inbox-empty-card">
        <%= render_icon("mail", classes: "h-9 w-9") %>
        <h2>Start gently</h2>
        <p>This space is private between you and <%= other_user.display_name %>. Send a thoughtful first message.</p>
      </div>
    <% end %>
  </div>

  <%= render "conversations/read_receipt", conversation: conversation, viewer_id: current_user.id %>

  <div class="typing-indicator hidden" data-typing-target="indicator">
    <span class="typing-dots"><span></span><span></span><span></span></span>
    <span class="typing-text"></span>
  </div>

  <% if conversation.blocked_for?(current_user) %>
    <div class="inbox-composer">
      <div class="inbox-blocked-note">
        Messaging is blocked in this conversation.
      </div>
    </div>
  <% else %>
    <%= render "conversations/composer", conversation: conversation, message: message %>
  <% end %>
</section>
