<%= form_with model: [conversation, message],
              class: "msg-composer",
              id: "new_message",
              html: { multipart: true, data: {
                controller: "dm-composer",
                action: "submit->dm-composer#onSubmit",
                dm_composer_gentleness_url_value: check_gentleness_posts_path
              } } do |f| %>

  <% if message.errors.any? %>
    <div class="msg-composer-errors">
      <%= message.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%# Inline previews (images + recorded voice note) sit ABOVE the row %>
  <div class="dm-previews-row">
    <div data-dm-composer-target="previews" class="dm-previews hidden"></div>
    <%# After recording: listen back, then send or delete. %>
    <div data-dm-composer-target="voicePreview" class="msg-voice-preview hidden">
      <audio controls preload="metadata" class="msg-voice-preview-audio" data-dm-composer-target="voiceAudio"></audio>
      <span class="msg-voice-preview-length" data-dm-composer-target="voiceLength">0:00</span>
      <button type="button" class="msg-icon-btn" data-action="click->dm-composer#clearVoice"
              title="Delete voice note" aria-label="Delete voice note">
        <%= render_icon("trash", classes: "h-4 w-4") %>
      </button>
    </div>

    <div data-dm-composer-target="scripturePreview" class="dm-scripture-chip hidden">
      <%= render_icon("book_open", classes: "h-4 w-4") %>
      <span data-dm-composer-target="scriptureLabel"></span>
      <button type="button"
              class="dm-scripture-clear"
              data-action="click->dm-composer#clearVerse"
              aria-label="Remove verse">✕</button>
    </div>
  </div>

  <%# Kindness nudge — shown only when the tone check reads as harsh. %>
  <div class="dm-nudge hidden" data-dm-composer-target="nudge">
    <div class="dm-nudge-head">
      <span class="dm-nudge-title">⚠️ This might land harder than you mean</span>
      <button type="button" class="dm-nudge-close" data-action="click->dm-composer#dismissNudge" aria-label="Keep editing">✕</button>
    </div>
    <p class="dm-nudge-text" data-dm-composer-target="nudgeText"></p>
    <blockquote class="dm-nudge-suggestion hidden" data-dm-composer-target="nudgeSuggestion"></blockquote>
    <div class="dm-nudge-actions">
      <button type="button" class="dm-nudge-soften" data-action="click->dm-composer#useSuggestion">Use softer wording</button>
      <button type="button" class="dm-nudge-send" data-action="click->dm-composer#sendAnyway">Send anyway</button>
    </div>
  </div>

  <%# While recording a voice note: an unmistakable bar with a live timer. %>
  <div class="msg-recording hidden" data-dm-composer-target="recordingBar" role="status" aria-live="polite">
    <span class="msg-recording-dot" aria-hidden="true"></span>
    <span class="msg-recording-label">Recording</span>
    <span class="msg-recording-time" data-dm-composer-target="recordingTime">0:00</span>
    <span class="msg-recording-max">max 2:00</span>
    <button type="button" class="msg-recording-cancel" data-action="click->dm-composer#cancelRecording">Cancel</button>
    <button type="button" class="msg-recording-stop" data-action="click->dm-composer#stopRecordingClick">Stop</button>
  </div>

  <%# LinkedIn-style: a roomy text box, then a tool row with Send on the right. %>
  <div class="msg-compose" data-controller="emoji-picker">
    <%= f.text_area :body,
                    value: (message.body.presence || params[:draft].to_s.first(500).presence),
                    rows: 1,
                    class: "msg-compose-input",
                    maxlength: 4000,
                    placeholder: "Write a message…",
                    aria: { label: "Write a message" },
                    data: {
                      typing_target: "input",
                      emoji_picker_target: "editor",
                      dm_composer_target: "bodyInput",
                      action: "input->typing#input input->dm-composer#onInput keydown->dm-composer#onKeydown"
                    } %>

    <div class="msg-compose-bar">
      <div class="msg-compose-tools">
        <label class="msg-tool" title="Add photos" aria-label="Add photos">
          <%= render_icon("image", classes: "h-5 w-5") %>
          <%= f.file_field :images,
              multiple: true,
              accept: "image/*",
              class: "sr-only",
              data: { dm_composer_target: "imageInput", action: "change->dm-composer#previewImages" } %>
        </label>
        <button type="button" class="msg-tool" data-emoji-picker-target="button" data-action="click->emoji-picker#toggle"
                title="Add emoji" aria-label="Add emoji">
          <%= render_icon("smile", classes: "h-5 w-5") %>
        </button>
        <button type="button" class="msg-tool" data-action="click->dm-composer#toggleVersePanel"
                title="Share a verse" aria-label="Share a verse">
          <%= render_icon("book_open", classes: "h-5 w-5") %>
        </button>
        <button type="button" class="msg-tool" data-dm-composer-target="recordBtn" data-action="click->dm-composer#toggleRecord"
                title="Record a voice note" aria-label="Record a voice note">
          <%= render_icon("mic", classes: "h-5 w-5") %>
        </button>
      </div>

      <%= f.button "Send", type: "submit", class: "msg-send hidden", data: { dm_composer_target: "sendBtn" } %>
    </div>

    <%# IMPORTANT: explicitly pass value: "" so Rails doesn't serialize the
        ActiveStorage::Attached::One proxy as its #inspect string. The JS
        controller swaps this element for a real file input once a voice
        note is finalised. %>
    <%= f.hidden_field :voice_note, value: "", data: { dm_composer_target: "voiceField" } %>
    <%= f.hidden_field :scripture_ref, value: "", data: { dm_composer_target: "scriptureField" } %>

    <%# Verse panel: type a reference (e.g. John 3:16) and attach it to the message. %>
    <div class="dm-verse-panel msg-verse-panel hidden" data-dm-composer-target="versePanel">
      <input type="text" class="dm-verse-input" placeholder="e.g. John 3:16"
             data-dm-composer-target="verseInput" data-action="keydown->dm-composer#verseKeydown">
      <button type="button" class="dm-verse-add" data-action="click->dm-composer#attachVerse">Add</button>
    </div>

    <div data-emoji-picker-target="picker" class="msg-emoji-popover hidden">
      <emoji-picker></emoji-picker>
    </div>
  </div>
<% end %>
