<%= form_with model: [conversation, message], class: "inbox-composer", id: "new_message" do |f| %>
  <% if message.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-800">
      <%= message.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="flex items-end gap-2 relative" data-controller="emoji-picker">
    <button type="button"
            data-emoji-picker-target="button"
            data-action="click->emoji-picker#toggle"
            class="inbox-emoji-btn"
            title="Add emoji"
            aria-label="Add emoji">
      <%= render_icon("smile", classes: "h-5 w-5") %>
    </button>

    <%= f.text_area :body,
                    rows: 2,
                    class: "inbox-input",
                    maxlength: 4000,
                    placeholder: "Write a thoughtful message...",
                    data: { typing_target: "input", action: "input->typing#input", emoji_picker_target: "editor" } %>

    <%= f.button class: "fc-btn fc-btn-primary min-h-11" do %>
      <%= render_icon("send", classes: "h-4 w-4") %>
      Send
    <% end %>

    <div data-emoji-picker-target="picker"
         class="hidden absolute bottom-full left-0 z-50 mb-2">
      <emoji-picker style="width: 320px; height: 360px;"></emoji-picker>
    </div>
  </div>
<% end %>
