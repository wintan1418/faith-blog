<% message = local_assigns.fetch(:message) %>
<%# Never touch current_user eagerly — this partial is also rendered in
    Action Cable broadcasts (no request context), where current_user raises. %>
<% viewer_id = local_assigns[:viewer_id] || current_user&.id %>
<%# The thread passes the previous message; live appends and edits look it up. %>
<% previous = local_assigns.key?(:previous) ? local_assigns[:previous] : message.previous_in_thread %>
<% mine = message.sender_id == viewer_id %>
<% deleted = message.deleted? %>
<% removed = !deleted && message.removed? %>
<% starts_group = message_starts_group?(message, previous) %>

<%
  loaded_likes = message.likes.loaded? ? message.likes.to_a : message.likes.includes(:user).to_a
  user_like    = viewer_id ? loaded_likes.find { |l| l.user_id == viewer_id } : nil
  emoji_groups = loaded_likes
                   .reject { |l| l.reaction_emoji.to_s.empty? }
                   .group_by(&:reaction_emoji)
                   .sort_by { |_, likes| -likes.size }
                   .first(4)
%>

<div id="<%= dom_id(message) %>" class="msg-item <%= mine ? 'is-mine' : 'is-theirs' %><%= ' starts-group' if starts_group %><%= ' is-deleted' if deleted %>">
  <% if message_starts_day?(message, previous) %>
    <div class="msg-day" role="separator"><span><%= local_time_tag(message.created_at, "day", message_day_label(message.created_at)) %></span></div>
  <% end %>

  <div class="msg-line">
    <div class="msg-gutter">
      <% if starts_group %>
        <%= render "conversations/avatar", user: message.sender, size: "h-10 w-10" %>
      <% else %>
        <span class="msg-gutter-time"><%= local_time_tag(message.created_at, "short", message.created_at.in_time_zone.strftime("%-l:%M")) %></span>
      <% end %>
    </div>

    <div class="msg-content">
      <% if starts_group %>
        <div class="msg-head">
          <span class="msg-name"><%= message.sender.display_name %></span>
          <span class="msg-time">· <%= local_time_tag(message.created_at, "time", message.created_at.in_time_zone.strftime("%-l:%M %p")) %></span>
        </div>
      <% end %>

      <div class="msg-bubble" data-controller="message-menu" data-action="click->message-menu#toggle">
        <% if deleted %>
          <p class="msg-deleted">This message was deleted</p>
        <% elsif removed %>
          <p class="msg-deleted msg-removed">🛡 This message was removed for breaking our community guidelines.</p>
        <% else %>
          <% if (quoted = message.reply_to) %>
            <%# The message this replies to. Tapping it jumps to the original. %>
            <a href="#<%= dom_id(quoted) %>" class="msg-quote" data-turbo="false"
               aria-label="Replying to <%= quoted.sender.display_name %>: <%= quoted.quote_snippet %>">
              <span class="msg-quote-name"><%= quoted.sender_id == viewer_id ? "You" : quoted.sender.display_name %></span>
              <span class="msg-quote-text"><%= quoted.quote_snippet %></span>
            </a>
          <% end %>

          <% if message.has_scripture? %>
            <%= render "conversations/scripture_card", message: message %>
          <% end %>

          <% if message.has_images? %>
            <div class="msg-images <%= "is-grid-#{[message.images.count, 4].min}" %>" data-controller="lightbox">
              <% message.images.each do |img| %>
                <%= image_tag photo_src(img, width: 900), class: "msg-image", loading: "lazy", alt: "Photo" %>
              <% end %>
            </div>
          <% end %>

          <% if message.has_voice_note? %>
            <%# The player takes every tap, so voice notes get their own options
                button (react, reply, edit, delete) on touch screens. %>
            <div class="msg-voice-row">
              <audio controls preload="metadata" class="msg-voice" src="<%= url_for(message.voice_note) %>"></audio>
              <% unless deleted || removed %>
                <button type="button" class="msg-more" data-action="message-menu#toggleFromButton"
                        title="Message options" aria-label="Message options">&#8943;</button>
              <% end %>
            </div>
          <% end %>

          <% if message.body.present? %>
            <div class="msg-body"><%= simple_format(message.body) %></div>
          <% end %>

          <% if !mine && MoneyTalk.mentions?(message.body) %>
            <p class="msg-money-tip" role="note">
              🛡 <strong>Money mentioned.</strong> Only send money to people you know and trust.
              Never share your PIN, OTP, BVN or password, not even with Brethreign staff.
              Something feels off? Tap the message and report it.
            </p>
          <% end %>

          <% if message.respond_to?(:edited?) && message.edited? %>
            <span class="msg-edited">(edited)</span>
          <% end %>
        <% end %>

        <% unless deleted || removed %>
          <div class="msg-actions" data-message-menu-target="actions"
               data-controller="emoji-reactions message-edit"
               data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Message", likeable_id: message.id) %>"
               data-emoji-reactions-token-value="<%= form_authenticity_token %>">
            <button type="button" class="msg-action" data-action="click->emoji-reactions#toggle" title="React" aria-label="React">
              <%= render_icon("smile", classes: "h-4 w-4") %>
            </button>
            <button type="button" class="msg-action msg-action--reply" title="Reply" aria-label="Reply to this message"
                    data-reply-id="<%= message.id %>"
                    data-reply-name="<%= mine ? "yourself" : message.sender.display_name %>"
                    data-reply-snippet="<%= message.quote_snippet %>">
              <%= render_icon("reply", classes: "h-4 w-4") %>
            </button>
            <% if mine %>
              <button type="button" class="msg-action" data-action="click->message-edit#start"
                      data-message-edit-message-id-param="<%= message.id %>" title="Edit" aria-label="Edit">
                <%= render_icon("pencil", classes: "h-4 w-4") %>
              </button>
              <%= button_to conversation_message_path(message.conversation_id, message),
                  method: :delete, form_class: "inline", class: "msg-action", title: "Delete", aria: { label: "Delete" },
                  data: { turbo_confirm: "Delete this message?" } do %>
                <%= render_icon("trash", classes: "h-4 w-4") %>
              <% end %>
            <% else %>
              <%= button_to reports_path(reportable_type: "Message", reportable_id: message.id, reason: "Reported private message."),
                  method: :post, form_class: "inline", class: "msg-action", title: "Report", aria: { label: "Report" },
                  data: { turbo_frame: "_top", turbo_confirm: "Report this message?" } do %>
                <%= render_icon("flag", classes: "h-4 w-4") %>
              <% end %>
            <% end %>
            <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
              <emoji-picker style="width: 300px; height: 340px;"></emoji-picker>
            </div>
          </div>
        <% end %>
      </div>

      <% if !deleted && !removed && (emoji_groups.any? || user_like) %>
        <%# Chats are one-on-one, so reactions show without a count. %>
        <div class="msg-reactions">
          <% emoji_groups.each do |emoji, group| %>
            <% mine_emoji = user_like&.display_emoji == emoji %>
            <% tip = reactor_names_label(group) %>
            <% if mine_emoji %>
              <%= button_to unlike_path(likeable_type: "Message", likeable_id: message.id),
                  method: :delete, form_class: "inline", class: "msg-reaction is-mine", title: "Remove your reaction" do %>
                <span><%= emoji %></span>
                <% if tip.present? %><span class="fc-reaction-tip" role="tooltip"><%= tip %></span><% end %>
              <% end %>
            <% else %>
              <%= button_to likes_path(likeable_type: "Message", likeable_id: message.id, reaction_emoji: emoji),
                  form_class: "inline", class: "msg-reaction" do %>
                <span><%= emoji %></span>
                <% if tip.present? %><span class="fc-reaction-tip" role="tooltip"><%= tip %></span><% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
