<% message = local_assigns.fetch(:message) %>
<% quick_reactions = %w[❤️ 🙏 😂 😮 😢 👍] %>
<%# Never touch current_user eagerly — this partial is also rendered in
    Action Cable broadcasts (no request context), where current_user raises. %>
<% viewer_id = local_assigns[:viewer_id] || current_user&.id %>
<%# The thread passes the previous message; live appends and edits look it up. %>
<% previous = local_assigns.key?(:previous) ? local_assigns[:previous] : message.previous_in_thread %>
<% mine = message.sender_id == viewer_id %>
<% deleted = message.deleted? %>
<% removed = !deleted && message.removed? %>
<% starts_group = message_starts_group?(message, previous) %>
<%# Photos alone, or a verse alone, sit on the chat without a bubble around them. %>
<% plain = !deleted && !removed && message.body.blank? && !message.reply_to && !message.forwarded? &&
           !message.has_voice_note? && !message.has_documents? && (message.has_images? || message.has_scripture? || message.has_gif?) %>

<%
  loaded_likes = message.likes.loaded? ? message.likes.to_a : message.likes.includes(:user).to_a
  user_like    = viewer_id ? loaded_likes.find { |l| l.user_id == viewer_id } : nil
  emoji_groups = loaded_likes
                   .reject { |l| l.reaction_emoji.to_s.empty? }
                   .group_by(&:reaction_emoji)
                   .sort_by { |_, likes| -likes.size }
                   .first(4)
%>

<div id="<%= dom_id(message) %>" class="msg-item <%= mine ? 'is-mine' : 'is-theirs' %><%= ' starts-group' if starts_group %><%= ' is-deleted' if deleted %>">
  <% if message_starts_day?(message, previous) %>
    <div class="msg-day" role="separator"><span><%= local_time_tag(message.created_at, "day", message_day_label(message.created_at)) %></span></div>
  <% end %>

  <div class="msg-line">
    <% unless mine %>
      <div class="msg-gutter">
        <% if starts_group %><%= render "conversations/avatar", user: message.sender, size: "h-7 w-7" %><% end %>
      </div>
    <% end %>

    <div class="msg-content">
      <% if starts_group %>
        <span class="sr-only"><%= mine ? "You" : message.sender.display_name %>:</span>
      <% end %>

      <div class="msg-bubble<%= ' is-plain' if plain %><%= ' has-voice' if !deleted && !removed && message.has_voice_note? %>" data-controller="message-menu"
           data-action="click->message-menu#swallowClick:capture click->message-menu#toggle mouseenter->message-menu#hoverPlace touchstart->message-menu#holdStart:passive touchmove->message-menu#holdMove:passive touchend->message-menu#holdEnd touchcancel->message-menu#holdEnd contextmenu->message-menu#suppressContextMenu">
        <% if deleted %>
          <p class="msg-deleted">This message was deleted</p>
        <% elsif removed %>
          <p class="msg-deleted msg-removed"><%= render_icon("shield", classes: "h-4 w-4") %> This message was removed for breaking our community guidelines.</p>
        <% else %>
          <% if message.forwarded? %>
            <p class="msg-forwarded"><%= render_icon("forward", classes: "h-3.5 w-3.5") %> Forwarded</p>
          <% end %>

          <% if (quoted = message.reply_to) %>
            <%# The message this replies to. Tapping it jumps to the original. %>
            <a href="#<%= dom_id(quoted) %>" class="msg-quote" data-turbo="false"
               aria-label="Replying to <%= quoted.sender.display_name %>: <%= quoted.quote_snippet %>">
              <span class="msg-quote-name"><%= quoted.sender_id == viewer_id ? "You" : quoted.sender.display_name %></span>
              <span class="msg-quote-text"><%= quoted.quote_snippet %></span>
            </a>
          <% end %>

          <% if message.has_scripture? %>
            <%= render "conversations/scripture_card", message: message %>
          <% end %>

          <% if message.has_gif? %>
            <% gif_w, gif_h = gif_display_size(message, max: 240) %>
            <%# Loaded straight from Klipy's CDN; the size keeps its shape while it loads. %>
            <div class="msg-gif-wrap">
              <img src="<%= message.gif_url %>" class="msg-gif" width="<%= gif_w %>" height="<%= gif_h %>"
                   loading="lazy" decoding="async" alt="<%= message.gif_alt %>" style="aspect-ratio: <%= gif_w %> / <%= gif_h %>">
            </div>
          <% end %>

          <% if message.has_images? %>
            <%# Tapping a photo opens it full screen, so photos get the same
                options button as voice notes (react, reply, edit, delete). %>
            <div class="msg-media-row">
              <div class="msg-images <%= "is-grid-#{[message.images.count, 4].min}" %>" data-controller="lightbox">
                <% message.images.each do |img| %>
                  <%# Tapping opens the viewer (with Save); Download is also in the ⋯ menu. %>
                  <div class="msg-image-wrap">
                    <%= image_tag photo_src(img, width: 900), class: "msg-image", loading: "lazy", alt: "Photo",
                                  data: { download: message_file_download_path(message, img),
                                          download_legacy: rails_blob_path(img, disposition: "attachment") } %>
                  </div>
                <% end %>
              </div>
              <button type="button" class="msg-more" data-action="message-menu#toggleFromButton"
                      title="Message options" aria-label="Message options"><%= render_icon("more", classes: "h-5 w-5") %></button>
            </div>
          <% end %>

          <% if message.has_documents? %>
            <%# Downloads the file under its original name (the apps save it to the phone). %>
            <div class="msg-media-row">
            <div class="msg-docs">
              <% message.documents.each do |doc| %>
                <%= link_to message_file_download_path(message, doc), class: "msg-doc", rel: "noopener",
                      data: { turbo: false, legacy_href: rails_blob_path(doc, disposition: "attachment") },
                      title: "Open #{doc.filename}" do %>
                  <span class="msg-doc-icon is-<%= document_kind(doc) %>" aria-hidden="true"><%= render_icon("file", classes: "h-5 w-5") %></span>
                  <span class="msg-doc-text">
                    <span class="msg-doc-name"><%= doc.filename %></span>
                    <span class="msg-doc-meta"><%= document_meta(doc) %></span>
                  </span>
                  <span class="msg-doc-get" aria-hidden="true"><%= render_icon("download", classes: "h-4 w-4") %></span>
                <% end %>
              <% end %>
            </div>
            <%# Tapping the file opens it, so it gets the options button too. %>
            <button type="button" class="msg-more" data-action="message-menu#toggleFromButton"
                    title="Message options" aria-label="Message options"><%= render_icon("more", classes: "h-5 w-5") %></button>
            </div>
          <% end %>

          <% if message.has_voice_note? %>
            <%# The player takes every tap, so voice notes get their own options
                button (react, reply, edit, delete) on touch screens. %>
            <div class="msg-voice-row">
              <%# Play button and a waveform-style bar that fills as it plays (voice-player). %>
              <div class="msg-voice-player" data-controller="voice-player">
                <audio preload="metadata" class="msg-voice" src="<%= message_file_inline_path(message, message.voice_note) %>" data-voice-player-target="audio"></audio>
                <button type="button" class="msg-voice-play" data-voice-player-target="playBtn" data-action="voice-player#toggle"
                        aria-label="Play voice note">
                  <%= render_icon("play", classes: "msg-voice-icon is-play") %>
                  <%= render_icon("pause", classes: "msg-voice-icon is-pause") %>
                </button>
                <span class="msg-wave" data-voice-player-target="progress" data-action="click->voice-player#seek" aria-hidden="true">
                  <% bars = voice_wave_bars(message) %>
                  <span class="msg-wave-bars"><% bars.each do |h| %><i style="height: <%= h %>px"></i><% end %></span>
                  <span class="msg-wave-fill" data-voice-player-target="fill"><span class="msg-wave-bars"><% bars.each do |h| %><i style="height: <%= h %>px"></i><% end %></span></span>
                </span>
                <span class="msg-voice-time">
                  <span class="msg-voice-current" data-voice-player-target="current">0:00</span>
                  <span class="msg-voice-total" data-voice-player-target="total"></span>
                </span>
              </div>
              <% unless deleted || removed %>
                <button type="button" class="msg-more" data-action="message-menu#toggleFromButton"
                        title="Message options" aria-label="Message options"><%= render_icon("more", classes: "h-5 w-5") %></button>
              <% end %>
            </div>
          <% end %>

          <% if message.body.present? %>
            <div class="msg-body"><%= simple_format(message.body) %></div>
          <% end %>

          <% if !mine && MoneyTalk.mentions?(message.body) %>
            <p class="msg-money-tip" role="note">
              <%= render_icon("shield", classes: "msg-money-tip-icon") %> <strong>Money mentioned.</strong> Only send money to people you know and trust.
              Never share your PIN, OTP, BVN or password, not even with Brethreign staff.
              Something feels off? Tap the message and report it.
            </p>
          <% end %>

        <% end %>

        <span class="msg-stamp">
          <% if !deleted && !removed && message.respond_to?(:edited?) && message.edited? %><span class="msg-edited">Edited</span><% end %>
          <%= local_time_tag(message.created_at, "short", message.created_at.in_time_zone.strftime("%-l:%M")) %>
        </span>

        <% unless deleted || removed %>
          <div class="msg-actions" data-message-menu-target="actions"
               data-controller="emoji-reactions message-edit"
               data-action="message-menu:closed->emoji-reactions#hideQuick"
               data-emoji-reactions-url-value="<%= likes_path(likeable_type: "Message", likeable_id: message.id) %>"
               data-emoji-reactions-unlike-url-value="<%= unlike_path(likeable_type: "Message", likeable_id: message.id) %>"
               data-emoji-reactions-mine-emoji-value="<%= user_like&.display_emoji %>"
               data-emoji-reactions-token-value="<%= form_authenticity_token %>">
            <div class="msg-action-row">
            <%# React: one small button; tap (or hover on a computer) pops up the quick-reaction pill. %>
            <button type="button" class="msg-action msg-action--react" title="React" aria-label="React"
                    aria-haspopup="true" aria-expanded="false"
                    data-action="click->emoji-reactions#toggleQuick mouseenter->emoji-reactions#hoverQuick">
              <%= render_icon("smile", classes: "h-4 w-4") %>
            </button>
            <button type="button" class="msg-action msg-action--reply" title="Reply" aria-label="Reply to this message"
                    data-reply-id="<%= message.id %>"
                    data-reply-name="<%= mine ? "yourself" : message.sender.display_name %>"
                    data-reply-snippet="<%= message.quote_snippet %>">
              <%= render_icon("reply", classes: "h-4 w-4") %>
            </button>
            <% if message.body.present? %>
              <button type="button" class="msg-action" title="Copy" aria-label="Copy text"
                      data-action="message-menu#copy" data-message-menu-text-param="<%= message.body %>">
                <%= render_icon("copy", classes: "h-4 w-4") %>
              </button>
            <% end %>
            <%= link_to forward_conversation_message_path(message.conversation_id, message), class: "msg-action",
                  title: "Forward", aria: { label: "Forward to another chat" }, data: { turbo_frame: "_top" } do %>
              <%= render_icon("forward", classes: "h-4 w-4") %>
            <% end %>
            <% share_images = message.has_images? ? message.images.map { |img| photo_src(img, width: 1080) } : [] %>
            <% share_docs = message.has_documents? ? message.documents.map { |d| { url: message_file_download_path(message, d), name: d.filename.to_s, type: d.content_type } } : [] %>
            <% if message.body.present? || message.has_scripture? || share_images.any? || share_docs.any? %>
              <button type="button" class="msg-action" title="Share" aria-label="Share outside Brethreign"
                      data-controller="message-share"
                      data-message-share-text-value="<%= [ message.body.presence, (message.scripture_ref if message.has_scripture?) ].compact.join("\n") %>"
                      data-message-share-images-value="<%= share_images.to_json %>"
                      data-message-share-files-value="<%= share_docs.to_json %>"
                      data-action="click->message-share#share">
                <%= render_icon("share", classes: "h-4 w-4") %>
              </button>
            <% end %>
            <%# Download / save lives here, not as buttons on the bubble (QA: too loud). %>
            <% if message.has_voice_note? %>
              <%= render "conversations/media_download", message: message, attachment: message.voice_note,
                         label: "Download voice note", class_name: "msg-action msg-action--download" %>
            <% elsif message.has_images? && message.images.size == 1 %>
              <%= render "conversations/media_download", message: message, attachment: message.images.first,
                         label: "Download photo", class_name: "msg-action msg-action--download" %>
            <% elsif message.has_images? %>
              <button type="button" class="msg-action msg-action--download" data-action="message-menu#viewPhotos"
                      title="Save photos" aria-label="Save photos (opens the viewer)">
                <%= render_icon("download", classes: "h-4 w-4") %>
              </button>
            <% end %>
            <% if mine %>
              <button type="button" class="msg-action" data-action="click->message-edit#start"
                      data-message-edit-message-id-param="<%= message.id %>" title="Edit" aria-label="Edit">
                <%= render_icon("pencil", classes: "h-4 w-4") %>
              </button>
              <%= button_to conversation_message_path(message.conversation_id, message),
                  method: :delete, form_class: "inline", class: "msg-action", title: "Delete", aria: { label: "Delete" },
                  data: { turbo_confirm: "Delete this message?" } do %>
                <%= render_icon("trash", classes: "h-4 w-4") %>
              <% end %>
            <% else %>
              <%= button_to reports_path(reportable_type: "Message", reportable_id: message.id, reason: "Reported private message."),
                  method: :post, form_class: "inline", class: "msg-action", title: "Report", aria: { label: "Report" },
                  data: { turbo_frame: "_top", turbo_confirm: "Report this message?" } do %>
                <%= render_icon("flag", classes: "h-4 w-4") %>
              <% end %>
            <% end %>
            </div>
            <%# The quick-reaction pill: tap an emoji to react (tap yours again to take
                it back), + for any emoji. Pinned on screen next to React when open. %>
            <div class="msg-react-pill" role="group" aria-label="Choose a reaction" hidden
                 data-emoji-reactions-target="quick">
              <% quick_reactions.each do |emoji| %>
                <% chosen = user_like&.display_emoji == emoji %>
                <button type="button" class="msg-react-quick<%= ' is-mine' if chosen %>"
                        data-action="click->emoji-reactions#quick" data-emoji-reactions-emoji-param="<%= emoji %>"
                        title="<%= chosen ? 'Remove your reaction' : 'React' %>" aria-label="<%= chosen ? 'Remove reaction' : 'React with' %> <%= emoji %>"
                        aria-pressed="<%= chosen %>"><%= emoji %></button>
              <% end %>
              <button type="button" class="msg-react-more" data-action="click->emoji-reactions#toggle"
                      title="More reactions" aria-label="More reactions"><%= render_icon("plus", classes: "h-4 w-4") %></button>
            </div>
            <div class="fc-reaction-picker hidden" data-emoji-reactions-target="picker">
              <emoji-picker style="width: 300px; height: 340px;"></emoji-picker>
            </div>
          </div>
        <% end %>
      </div>

      <% if !deleted && !removed && (emoji_groups.any? || user_like) %>
        <%# Compact chips grouped by emoji; a count only when more than one person chose it. %>
        <div class="msg-reactions">
          <% emoji_groups.each do |emoji, group| %>
            <% mine_emoji = user_like&.display_emoji == emoji %>
            <% tip = reactor_names_label(group) %>
            <% if mine_emoji %>
              <%= button_to unlike_path(likeable_type: "Message", likeable_id: message.id),
                  method: :delete, form_class: "inline", class: "msg-reaction is-mine", title: "Remove your reaction" do %>
                <span><%= emoji %></span>
                <% if group.size > 1 %><span class="msg-reaction-count"><%= group.size %></span><% end %>
                <% if tip.present? %><span class="fc-reaction-tip" role="tooltip"><%= tip %></span><% end %>
              <% end %>
            <% else %>
              <%= button_to likes_path(likeable_type: "Message", likeable_id: message.id, reaction_emoji: emoji),
                  form_class: "inline", class: "msg-reaction" do %>
                <span><%= emoji %></span>
                <% if group.size > 1 %><span class="msg-reaction-count"><%= group.size %></span><% end %>
                <% if tip.present? %><span class="fc-reaction-tip" role="tooltip"><%= tip %></span><% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
