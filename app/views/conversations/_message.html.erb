<% message = local_assigns.fetch(:message) %>
<% viewer_id = local_assigns.fetch(:viewer_id, current_user&.id) %>
<% mine = message.sender_id == viewer_id %>

<div id="<%= dom_id(message) %>" class="message-row <%= mine ? 'is-mine' : 'is-theirs' %>">
  <% unless mine %>
    <%= render "conversations/avatar", user: message.sender, size: "h-8 w-8" %>
  <% end %>
  <div class="message-bubble">
    <div><%= simple_format(message.body) %></div>
    <span class="message-meta">
      <%= message.created_at.strftime("%I:%M %p") %>
      <% unless mine %>
        <%= button_to "Report", reports_path(reportable_type: "Message", reportable_id: message.id, reason: "Reported private message."), method: :post, class: "message-report-btn" %>
      <% end %>
    </span>
  </div>
</div>
