<% conversation = local_assigns.fetch(:conversation) %>
<% active = local_assigns.fetch(:active, false) %>
<% other_user = conversation.other_participant_for(current_user) %>
<% latest_message = conversation.messages.visible.order(created_at: :desc).first %>
<% unread_count = conversation.unread_count_for(current_user) %>

<%= link_to conversation_path(conversation), class: "inbox-row #{'is-active' if active} #{'is-unread' if unread_count.positive?}" do %>
  <%= render "conversations/avatar", user: other_user, size: "h-11 w-11" %>
  <span class="min-w-0 flex-1">
    <span class="flex items-center justify-between gap-3">
      <span class="truncate font-extrabold text-[var(--fc-ink)]"><%= other_user.display_name %></span>
      <% if latest_message %>
        <span class="shrink-0 text-xs font-bold text-[var(--fc-muted)]"><%= time_ago_in_words(latest_message.created_at) %></span>
      <% end %>
    </span>
    <span class="mt-1 flex items-center justify-between gap-2">
      <span class="min-w-0 truncate text-sm text-[var(--fc-muted)]">
        <% if latest_message %>
          <%= latest_message.sender == current_user ? "You: " : "" %><%= truncate(latest_message.body, length: 60) %>
        <% else %>
          No messages yet
        <% end %>
      </span>
      <% if unread_count.positive? %>
        <span class="inbox-row-badge"><%= unread_count > 99 ? "99+" : unread_count %></span>
      <% end %>
    </span>
  </span>
<% end %>
