<% conversation = local_assigns.fetch(:conversation) %>
<% active = local_assigns.fetch(:active, false) %>
<% other_user = conversation.other_participant_for(current_user) %>
<%# The list passes these in batch; fall back to per-row queries elsewhere. %>
<% latest_message = local_assigns.key?(:latest) ? local_assigns[:latest] : conversation.messages.visible.order(created_at: :desc).first %>
<% unread_count = local_assigns.key?(:unread) ? local_assigns[:unread].to_i : conversation.unread_count_for(current_user) %>

<%= link_to conversation_path(conversation), class: "msg-row#{' is-active' if active}#{' is-unread' if unread_count.positive?}" do %>
  <%= render "conversations/avatar", user: other_user, size: "h-14 w-14", online: other_user.online? %>
  <span class="msg-row-main">
    <span class="msg-row-top">
      <span class="msg-row-name"><%= other_user.display_name %></span>
      <% shown_at = latest_message&.created_at || conversation.created_at %>
      <span class="msg-row-time"><%= local_time_tag(shown_at, "inbox", inbox_time(shown_at)) %></span>
    </span>
    <span class="msg-row-bottom">
      <span class="msg-row-preview"><%= conversation_preview(latest_message, current_user) %></span>
      <% if unread_count.positive? %>
        <span class="msg-row-unread" aria-label="<%= pluralize(unread_count, 'unread message') %>"><%= unread_count > 9 ? "9+" : unread_count %></span>
      <% end %>
    </span>
  </span>
<% end %>
