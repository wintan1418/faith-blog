<% content_for(:title) { "Search messages - Brethreign" } %>

<div class="msg-page msg-page--new">
  <div class="msg-new">
    <header class="msg-list-head">
      <%= link_to conversations_path, class: "msg-icon-btn msg-thread-back", aria: { label: "Back to messages" } do %>
        <%= render_icon("chevron_left", classes: "h-6 w-6") %>
      <% end %>
      <h1 class="msg-list-title">Search messages</h1>
    </header>

    <%= form_with url: inbox_search_path, method: :get, class: "msg-search", role: "search" do %>
      <%= render_icon("search", classes: "h-4 w-4") %>
      <input type="search" name="q" value="<%= @query %>" placeholder="Search messages" aria-label="Search messages" autofocus>
    <% end %>

    <% if @query.blank? %>
      <p class="msg-empty-text msg-new-none">Type at least 2 letters to search all your conversations.</p>
    <% elsif @results.empty? %>
      <div class="msg-empty">
        <p class="msg-empty-title">No matches</p>
        <p class="msg-empty-text">Nothing matches "<%= @query %>" in your conversations.</p>
      </div>
    <% else %>
      <p class="msg-section-label"><%= pluralize(@pagy.count, "message") %></p>
      <div class="msg-rows">
        <% @results.each do |message| %>
          <% other = message.conversation.other_participant_for(current_user) %>
          <%= link_to conversation_path(message.conversation, anchor: dom_id(message)), class: "msg-row" do %>
            <%= render "conversations/avatar", user: other, size: "h-12 w-12" %>
            <span class="msg-row-main">
              <span class="msg-row-top">
                <span class="msg-row-name"><%= other.display_name %></span>
                <span class="msg-row-time"><%= local_time_tag(message.created_at, "inbox", inbox_time(message.created_at)) %></span>
              </span>
              <span class="msg-row-preview is-wrap">
                <%= message.sender_id == current_user.id ? "You: " : "" %><%= highlight(truncate(message.body, length: 160), @query, highlighter: '<mark class="msg-mark">\1</mark>') %>
              </span>
            </span>
          <% end %>
        <% end %>
      </div>
      <% if @pagy.pages > 1 %><div class="msg-pagination"><%== pagy_nav(@pagy) %></div><% end %>
    <% end %>
  </div>
</div>
