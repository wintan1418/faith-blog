<% user = local_assigns.fetch(:user) %>
<% size = local_assigns.fetch(:size, "h-10 w-10") %>
<% online = local_assigns.fetch(:online, false) %>

<span class="msg-avatar<%= ' is-online' if online %>">
  <% if user.profile&.avatar&.attached? %>
    <%= image_tag user.profile.avatar, class: "#{size} rounded-full object-cover", alt: "" %>
  <% else %>
    <span class="<%= size %> msg-avatar-initial" style="<%= avatar_tint_style(user.username) %>">
      <%= user.display_name.first.upcase %>
    </span>
  <% end %>
</span>
