<%# Always fetch fresh: going back to the list should show the latest messages, not a saved copy. %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>
<% content_for(:title) { "Messaging - Brethreign" } %>

<div class="msg-page msg-page--index">
  <div class="msg-shell">
    <%= render "conversations/list", conversations: @conversations, filter: @filter, unread_total: @unread_total, active: @conversation %>

    <% if @conversation %>
      <%= render "conversations/thread", conversation: @conversation, messages: @messages, message: @message %>
    <% else %>
      <section class="msg-thread msg-thread--empty">
        <div class="msg-empty">
          <span class="msg-empty-icon"><%= render_icon("mail", classes: "h-8 w-8") %></span>
          <p class="msg-empty-title">Select a conversation</p>
          <p class="msg-empty-text">Choose someone on the left, or start a new message.</p>
          <%= link_to "New message", new_conversation_path, class: "msg-btn msg-btn-primary" %>
        </div>
      </section>
    <% end %>
  </div>
</div>
