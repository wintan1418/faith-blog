<% content_for(:title) { "Inbox - Faith Community" } %>

<div class="inbox-shell">
  <aside class="inbox-list inbox-list--full">
    <div class="inbox-list-head">
      <h2>Messages</h2>
      <div class="flex items-center gap-1">
        <%= link_to inbox_search_path, class: "fc-icon-btn", title: "Search messages" do %>
          <%= render_icon("search", classes: "h-4 w-4") %>
        <% end %>
        <%= link_to my_connections_path, class: "fc-icon-btn", title: "My connections" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
        <% end %>
      </div>
    </div>

    <% if @conversations.any? %>
      <div class="inbox-list-scroll">
        <% @conversations.each do |conversation| %>
          <%= render "conversations/conversation_row", conversation: conversation, active: @conversation == conversation %>
        <% end %>
      </div>
    <% else %>
      <div class="inbox-list-empty">
        <%= render_icon("mail", classes: "h-7 w-7") %>
        <p>No conversations yet.</p>
        <small>Open a connected profile and tap Message.</small>
      </div>
    <% end %>
  </aside>

  <% if @conversation %>
    <%= render "conversations/thread", conversation: @conversation, messages: @messages, message: @message %>
  <% else %>
    <section class="inbox-thread inbox-thread--empty">
      <div class="inbox-thread-empty">
        <%= render_icon("mail", classes: "h-12 w-12") %>
        <h2>No conversation selected</h2>
        <p>Pick someone from your messages on the left, or start a new one from a connected profile.</p>
        <%= link_to "Find Connections", my_connections_path, class: "fc-btn fc-btn-primary" %>
      </div>
    </section>
  <% end %>
</div>
