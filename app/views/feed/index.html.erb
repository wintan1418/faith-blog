<% content_for(:title) { "Feed - Faith Community" } %>

<div class="fc-app">
  <div class="fc-shell" data-controller="discover">
    <aside class="fc-sidebar">
      <div class="fc-section-label">Your Space</div>
      <nav class="space-y-1">
        <%= link_to feed_path, class: "fc-rail-link #{'is-active' if current_page?(feed_path)}" do %>
          <%= render_icon("message_circle", classes: "h-4 w-4") %>
          Feed
        <% end %>
        <button type="button"
                class="fc-rail-link w-full text-left"
                data-action="click->bible-drawer#open">
          <%= render_icon("bookopen", classes: "h-4 w-4") %>
          Open Bible
        </button>
        <%= link_to games_path, class: "fc-rail-link" do %>
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          Games
        <% end %>
        <%= link_to church_history_path, class: "fc-rail-link" do %>
          <%= render_icon("bookopen", classes: "h-4 w-4") %>
          Church History
        <% end %>
        <%= link_to circles_path, class: "fc-rail-link" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
          Prayer Circles
        <% end %>
        <%= link_to answered_prayers_path, class: "fc-rail-link" do %>
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          Answered Prayers
        <% end %>
        <%= link_to bookmarks_path, class: "fc-rail-link" do %>
          <%= render_icon("bookmark", classes: "h-4 w-4") %>
          Bookmarks
        <% end %>
        <%= link_to user_path(current_user.username), class: "fc-rail-link" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
          Profile
        <% end %>
        <%= link_to my_connections_path, class: "fc-rail-link" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
          Connections
        <% end %>
        <%= link_to notifications_path, class: "fc-rail-link" do %>
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          Notifications
        <% end %>
        <% if current_user_admin? %>
          <%= link_to admin_root_path, class: "fc-rail-link #{'is-active' if request.path.start_with?('/admin')}" do %>
            <%= render_icon("sparkles", classes: "h-4 w-4") %>
            Admin
          <% end %>
        <% end %>
      </nav>

      <div class="fc-rail-games-card">
        <div class="fc-rail-games-head">
          <span class="fc-rail-games-kicker">🎯 Play</span>
          <%= link_to "Leaderboard →", games_path, class: "fc-rail-games-link" %>
        </div>
        <div class="fc-rail-games-list">
          <%= link_to games_quiz_path, class: "fc-rail-games-item" do %>
            <span class="fc-rail-games-icon">📖</span>
            <span class="fc-rail-games-label">Bible Quiz</span>
          <% end %>
          <%= link_to games_chess_path, class: "fc-rail-games-item" do %>
            <span class="fc-rail-games-icon">♚</span>
            <span class="fc-rail-games-label">Chess Puzzle</span>
          <% end %>
          <%= link_to games_history_path, class: "fc-rail-games-item" do %>
            <span class="fc-rail-games-icon">⛪</span>
            <span class="fc-rail-games-label">Church History</span>
          <% end %>
        </div>
      </div>

      <div class="fc-section-label">Your Rooms</div>
      <nav class="space-y-1">
        <% Room.public_rooms.ordered.limit(6).each do |room| %>
          <%
            tint = case room.slug.to_s
                   when /prayer/  then "prayer"
                   when /testim/  then "testimony"
                   when /bible/   then "bible"
                   when /quest/   then "questions"
                   when /encour/  then "encourage"
                   when /youth/   then "youth"
                   else "prayer"
                   end
          %>
          <%= link_to room_path(room), class: "fc-rail-link" do %>
            <span class="grid h-5 w-5 place-items-center rounded text-[10px] room-tint-<%= tint %>">
              <%= render_icon(room.icon || "sparkles", classes: "h-3.5 w-3.5") %>
            </span>
            <%= room.name %>
          <% end %>
        <% end %>
        <%= link_to "Browse all rooms ->", rooms_path, class: "mt-3 block px-3 text-sm font-semibold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
      </nav>
    </aside>

    <main class="fc-main">
      <%# Personal masthead — the greeting follows the VIEWER's clock via
          html[data-greet] (set in the layout head script); all variants render
          and CSS shows the right one, so there's no flash of wrong greeting. %>
      <header class="fc-masthead">
        <div class="min-w-0">
          <h1 class="fc-masthead-greet">
            <span class="fc-greet" data-greet="morning">Good morning</span>
            <span class="fc-greet" data-greet="afternoon">Good afternoon</span>
            <span class="fc-greet" data-greet="evening">Good evening</span>
            <span class="fc-greet" data-greet="night">Grace for the night watch</span>
            <span class="fc-greet fc-greet-fallback">Welcome back</span>,
            <span class="fc-masthead-name"><%= current_user.display_name.presence || current_user.username %></span>
          </h1>
          <p class="fc-masthead-sub"><%= Date.current.strftime("%A, %B %-d") %> · The assembly is gathered. Breathe deep.</p>
        </div>
        <% if current_user.current_breath_streak.to_i.positive? %>
          <span class="fc-masthead-streak" title="Breath streak — days in a row you've breathed">
            🔥 <%= current_user.current_breath_streak %><small><%= current_user.current_breath_streak == 1 ? "day" : "days" %></small>
          </span>
        <% end %>
      </header>

      <%# Activation ring: stays until all three first steps are done, then
          disappears for good. Each pending step is the link to do it. %>
      <% if @onboard && @onboard_done < 3 %>
        <section class="fc-onboard-ring" aria-label="Getting started progress">
          <svg viewBox="0 0 40 40" class="fc-ring" aria-hidden="true">
            <circle class="fc-ring-track" cx="20" cy="20" r="16"/>
            <circle class="fc-ring-fill" cx="20" cy="20" r="16"
                    style="stroke-dashoffset: <%= (100.5 * (1 - @onboard_done / 3.0)).round(1) %>"/>
            <text x="20" y="24.5" class="fc-ring-text"><%= @onboard_done %>/3</text>
          </svg>
          <div class="fc-onboard-mini">
            <p class="fc-onboard-mini-title">Make Brethreign feel like home</p>
            <div class="fc-onboard-mini-steps">
              <% if @onboard[:followed] %>
                <span class="fc-onboard-chip is-done">✓ Brethren someone</span>
              <% else %>
                <%= link_to "Brethren someone", people_path, class: "fc-onboard-chip" %>
              <% end %>
              <% if @onboard[:roomed] %>
                <span class="fc-onboard-chip is-done">✓ Step into a room</span>
              <% else %>
                <%= link_to "Step into a room", rooms_path, class: "fc-onboard-chip" %>
              <% end %>
              <% if @onboard[:breathed] %>
                <span class="fc-onboard-chip is-done">✓ Take a breath</span>
              <% else %>
                <button type="button" class="fc-onboard-chip" data-action="click->composer-modal#open">Take a breath</button>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>

      <div class="fc-panel fc-composer">
        <div class="fc-composer-row">
          <% if current_user.profile&.avatar&.attached? %>
            <%= image_tag current_user.profile.avatar, class: "fc-avatar object-cover" %>
          <% else %>
            <span class="fc-avatar" style="<%= avatar_tint_style(current_user.username) %>"><%= current_user.username.first.upcase %></span>
          <% end %>
          <button type="button"
                  class="fc-composer-input flex items-center text-[var(--fc-muted)]"
                  data-action="click->composer-modal#open">
            What's on your heart? Take a breath...
          </button>
          <button type="button"
                  class="fc-btn fc-btn-primary"
                  data-action="click->composer-modal#open">
            Breathe
          </button>
        </div>
        <div class="fc-composer-chips">
          <button type="button" class="fc-composer-chip is-prayer"
                  data-action="click->composer-modal#openWith"
                  data-composer-modal-prefill-param="🙏 Brethren, please pray with me — ">🙏 Prayer request</button>
          <button type="button" class="fc-composer-chip is-verse"
                  data-action="click->composer-modal#openWith"
                  data-composer-modal-prefill-param="📖 A verse on my heart today: ">📖 Share a verse</button>
          <button type="button" class="fc-composer-chip is-voice" data-action="click->composer-modal#open">🎙️ Voice note</button>
          <button type="button" class="fc-composer-chip is-read" data-action="click->bible-drawer#open">✨ Read first</button>
        </div>
      </div>

      <%# The Daily Breath prompt — one question a day the whole community
          answers. Turns readers into writers. %>
      <% breathed_today = current_user.posts.published.where(created_at: Time.current.all_day).exists? %>
      <section class="fc-daily-prompt<%= ' is-done' if breathed_today %>">
        <div class="fc-daily-prompt-body">
          <p class="fc-daily-prompt-kicker">🌅 Daily breath</p>
          <h2 class="fc-daily-prompt-q">What breath do you have today?</h2>
        </div>
        <% if breathed_today %>
          <span class="fc-daily-prompt-done">✓ You breathed today</span>
        <% else %>
          <button type="button"
                  class="fc-btn fc-btn-primary fc-daily-prompt-cta"
                  data-action="click->composer-modal#open">
            Breathe it out
          </button>
        <% end %>
      </section>

      <% if @new_member_announcements&.any? %>
        <div class="space-y-2 mb-3">
          <% @new_member_announcements.each do |joiner| %>
            <% next unless joiner.user %>
            <div class="fc-join-card"
                 data-controller="auto-dismiss"
                 data-auto-dismiss-after-ms-value="30000"
                 data-auto-dismiss-persist-key-value="join-<%= joiner.id %>"
                 data-auto-dismiss-store-key-value="fc:joins-dismissed">
              <% if joiner.user.profile&.avatar&.attached? %>
                <%= image_tag joiner.user.profile.avatar, class: "fc-avatar object-cover" %>
              <% else %>
                <span class="fc-avatar" style="<%= avatar_tint_style(joiner.user.username) %>">
                  <%= joiner.user.username.first.upcase %>
                </span>
              <% end %>
              <p class="fc-join-card-text">
                <%= link_to joiner.user.username, user_path(joiner.user.username), class: "fc-breath-name" %>
                just joined us
                <span class="fc-breath-time">· <%= time_ago_in_words(joiner.published_at) %> ago</span>
              </p>
              <button type="button"
                      class="fc-join-card-close"
                      data-action="click->auto-dismiss#dismiss"
                      aria-label="Dismiss">×</button>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @release_announcement %>
        <section class="fc-release-banner"
                 data-controller="onboarding"
                 data-onboarding-key-value="fc:release-<%= @release_announcement.id %>"
                 aria-label="Latest update">
          <button type="button"
                  class="fc-release-banner-close"
                  data-action="click->onboarding#dismiss"
                  aria-label="Dismiss">×</button>
          <% if @release_announcement.kicker.present? %>
            <p class="fc-release-banner-kicker">✦ <%= @release_announcement.kicker %></p>
          <% end %>
          <h2 class="fc-release-banner-title"><%= @release_announcement.title %></h2>
          <% if @release_announcement.body.present? %>
            <%
              # Collapse single newlines (soft-wrap from paste) into spaces,
              # keep double newlines as paragraph breaks. Avoids one ragged
              # <br> after every line when admins paste pre-wrapped text.
              clean_body = @release_announcement.body.to_s.gsub(/(?<!\n)\n(?!\n)/, " ").gsub(/[ \t]+/, " ").strip
            %>
            <div class="fc-release-banner-body"><%= simple_format(clean_body, {}, sanitize: false) %></div>
          <% end %>
        </section>
      <% end %>

      <% if @show_onboarding %>
        <section class="fc-onboarding"
                 data-controller="onboarding"
                 data-onboarding-key-value="fc:onboard-feed">
          <header class="fc-onboarding-head">
            <div>
              <p class="fc-onboarding-kicker">Welcome to Brethreign</p>
              <h2 class="fc-onboarding-title">Three quick steps to make your feed feel like home.</h2>
            </div>
            <button type="button"
                    class="fc-onboarding-close"
                    data-action="click->onboarding#dismiss"
                    aria-label="Dismiss welcome">×</button>
          </header>

          <ol class="fc-onboarding-steps">
            <li class="fc-onboarding-step">
              <div class="fc-onboarding-step-num">1</div>
              <div class="fc-onboarding-step-body">
                <h3>Brethren a few people</h3>
                <p>Their breaths will start showing up in your feed.</p>
                <% if @who_to_brethren.any? %>
                  <ul class="fc-onboarding-people">
                    <% @who_to_brethren.first(3).each do |u| %>
                      <li>
                        <% if u.profile&.avatar&.attached? %>
                          <%= image_tag u.profile.avatar, class: "fc-avatar object-cover" %>
                        <% else %>
                          <span class="fc-avatar" style="<%= avatar_tint_style(u.username) %>"><%= u.username.first.upcase %></span>
                        <% end %>
                        <%= link_to u.username, user_path(u.username), class: "fc-onboarding-person-name" %>
                        <%= button_to follow_user_path(u.username),
                            method: :post,
                            form_class: "inline ml-auto",
                            class: "fc-btn fc-btn-primary",
                            data: { turbo: false } do %>
                          Brethren
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            </li>

            <li class="fc-onboarding-step">
              <div class="fc-onboarding-step-num">2</div>
              <div class="fc-onboarding-step-body">
                <h3>Step into a room</h3>
                <p>Rooms are smaller spaces for specific kinds of breaths.</p>
                <% if @onboarding_rooms&.any? %>
                  <ul class="fc-onboarding-rooms">
                    <% @onboarding_rooms.each do |room| %>
                      <li>
                        <%= link_to room_path(room), class: "fc-onboarding-room" do %>
                          <% if room.icon.present? %>
                            <span class="fc-onboarding-room-icon"><%= render_icon(room.icon, classes: "h-4 w-4") %></span>
                          <% end %>
                          <span><%= room.name %></span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            </li>

            <li class="fc-onboarding-step">
              <div class="fc-onboarding-step-num">3</div>
              <div class="fc-onboarding-step-body">
                <h3>Take your first breath</h3>
                <p>A verse, a prayer, or just what's on your heart.</p>
                <div class="fc-onboarding-cta">
                  <button type="button"
                          class="fc-btn fc-btn-primary"
                          data-action="click->composer-modal#open click->onboarding#dismiss">
                    Take a breath
                  </button>
                  <button type="button"
                          class="fc-btn"
                          data-action="click->bible-drawer#open">
                    📖 Read scripture
                  </button>
                </div>
              </div>
            </li>
          </ol>
        </section>
      <% end %>

      <%# The stream (tabs + list) lives in a frame so switching tabs swaps
          just this region — no full page reload. target: "_top" keeps every
          link inside the cards navigating normally; only the tab links opt
          into the frame. %>
      <%= turbo_frame_tag "feed_stream", target: "_top" do %>
      <div class="fc-tabs" data-controller="feed-tabs">
        <%= link_to "Recent", feed_path,
              class: "fc-tab #{current_page?(feed_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Threads", feed_threads_path,
              class: "fc-tab #{current_page?(feed_threads_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Trending", feed_trending_path,
              class: "fc-tab #{current_page?(feed_trending_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Following", feed_following_path,
              class: "fc-tab #{current_page?(feed_following_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <button type="button" class="fc-discover-trigger" data-action="click->discover#open" aria-label="Open discover panel">
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          <span>Discover</span>
        </button>
      </div>

      <div data-controller="new-posts-pill">
        <%= turbo_stream_from "feed:public" %>
        <div id="feed_incoming" hidden data-new-posts-pill-target="bucket"></div>

        <button type="button"
                class="fc-new-posts-pill hidden"
                data-new-posts-pill-target="pill"
                data-action="click->new-posts-pill#flush"
                aria-live="polite">
          <%= render_icon("sparkles", classes: "h-3.5 w-3.5") %>
          <span data-new-posts-pill-target="count">0</span>
          <span data-new-posts-pill-target="label">new breaths</span>
        </button>

        <div class="mt-4 space-y-3">
          <% if @pinned_posts.present? %>
            <div class="fc-pinned-strip">
              <p class="fc-pinned-label">📌 Pinned for the community</p>
              <div class="space-y-3">
                <% @pinned_posts.each do |pinned| %>
                  <div class="fc-pinned-card">
                    <%= render "posts/card", post: pinned %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if @items.any? %>
            <div id="feed_list" class="space-y-3">
              <% @items.each do |item| %>
                <%= render "posts/card", post: item.post, reshared_by: item.reshared_by %>
              <% end %>
            </div>

            <% if @pagy.next %>
              <div id="feed_more"
                   data-controller="infinite-scroll"
                   data-infinite-scroll-url-value="<%= url_for(page: @pagy.next) %>">
                <div class="fc-skel-card">
                  <div class="fc-skel fc-skel-avatar"></div>
                  <div>
                    <div class="fc-skel fc-skel-line is-short"></div>
                    <div class="fc-skel fc-skel-line is-long"></div>
                    <div class="fc-skel fc-skel-line is-mid"></div>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="fc-caught-up" role="status">
                <span class="fc-caught-up-line" aria-hidden="true"></span>
                <span class="fc-caught-up-text">✦ You're all caught up</span>
                <span class="fc-caught-up-line" aria-hidden="true"></span>
              </div>
            <% end %>
          <% else %>
            <div class="fc-empty">
              <div class="fc-empty-mark" aria-hidden="true">
                <%= render_icon("message_circle", classes: "h-7 w-7") %>
              </div>
              <h2 class="fc-empty-title">Quiet here for now.</h2>
              <p class="fc-empty-text">Be the first to take a breath — share a verse, a prayer, or what's on your heart.</p>
              <div class="fc-empty-actions">
                <button type="button"
                        class="fc-btn fc-btn-primary"
                        data-action="click->composer-modal#open">
                  Take a breath
                </button>
                <button type="button"
                        class="fc-btn"
                        data-action="click->bible-drawer#open">
                  📖 Open Bible
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <% end %>
    </main>

    <aside class="fc-aside space-y-3" data-discover-target="panel">
      <header class="fc-discover-head">
        <span>Discover</span>
        <button type="button" class="fc-discover-close" data-action="click->discover#close" aria-label="Close">×</button>
      </header>

      <nav class="fc-discover-quicklinks" aria-label="Quick links">
        <button type="button"
                class="fc-discover-quicklink is-bible"
                title="Open Bible"
                aria-label="Open Bible"
                data-action="click->bible-drawer#open click->discover#close">
          <%= render_icon("bookopen", classes: "h-5 w-5") %>
        </button>
        <%= link_to people_path, class: "fc-discover-quicklink", title: "People", aria: { label: "People" } do %>
          <%= render_icon("users", classes: "h-5 w-5") %>
        <% end %>
        <%= link_to bookmarks_path, class: "fc-discover-quicklink", title: "Bookmarks", aria: { label: "Bookmarks" } do %>
          <%= render_icon("bookmark", classes: "h-5 w-5") %>
        <% end %>
        <%= link_to search_path, class: "fc-discover-quicklink", title: "Search", aria: { label: "Search" } do %>
          <%= render_icon("search", classes: "h-5 w-5") %>
        <% end %>
        <%= link_to church_history_path, class: "fc-discover-quicklink", title: "Church History", aria: { label: "Church History" } do %>
          <span class="fc-discover-quicklink-emoji">⛪</span>
        <% end %>
        <%= link_to games_path, class: "fc-discover-quicklink", title: "Games", aria: { label: "Games" } do %>
          <span class="fc-discover-quicklink-emoji">🎯</span>
        <% end %>
      </nav>
      <%
        verses = @daily_verses.presence || [
          OpenStruct.new(
            text: "He gives strength to the weary, and increases the power of the weak.",
            reference: "Isaiah 40:29"
          )
        ]
      %>
      <div class="fc-side-card fc-living-card"
           data-controller="golden-carousel"
           data-golden-carousel-interval-value="9000">
        <header class="fc-living-head">
          <p class="fc-living-kicker">Living Scriptures</p>
          <% if verses.size > 1 %>
            <div class="fc-golden-controls">
              <button type="button" class="fc-living-arrow" data-action="click->golden-carousel#prev" aria-label="Previous">‹</button>
              <button type="button" class="fc-living-arrow" data-action="click->golden-carousel#next" aria-label="Next">›</button>
            </div>
          <% end %>
        </header>

        <div class="fc-golden-track" data-golden-carousel-target="track">
          <% verses.each_with_index do |verse, i| %>
            <article class="fc-golden-slide<%= ' is-active' if i.zero? %>" data-golden-carousel-target="slide">
              <p class="fc-living-quote">"<%= verse.text %>"</p>
              <% if verse.reference.present? %>
                <p class="fc-living-ref"><%= verse.reference %></p>
              <% end %>
            </article>
          <% end %>
        </div>

        <% if verses.size > 1 %>
          <div class="fc-golden-dots fc-living-dots" role="tablist" aria-label="Living Scriptures">
            <% verses.each_with_index do |_, i| %>
              <button type="button"
                      class="fc-golden-dot<%= ' is-active' if i.zero? %>"
                      data-action="click->golden-carousel#goto"
                      data-index="<%= i %>"
                      data-golden-carousel-target="dot"
                      aria-label="Slide <%= i + 1 %>"></button>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @daily_breaths.any? %>
        <div class="fc-side-card fc-golden-card"
             data-controller="golden-carousel"
             data-golden-carousel-interval-value="7000">
          <header class="fc-golden-head">
            <p class="fc-golden-kicker">Golden Breaths</p>
            <% if @daily_breaths.size > 1 %>
              <div class="fc-golden-controls">
                <button type="button" class="fc-golden-arrow" data-action="click->golden-carousel#prev" aria-label="Previous">‹</button>
                <button type="button" class="fc-golden-arrow" data-action="click->golden-carousel#next" aria-label="Next">›</button>
              </div>
            <% end %>
          </header>

          <div class="fc-golden-track" data-golden-carousel-target="track">
            <% @daily_breaths.each_with_index do |breath, i| %>
              <article class="fc-golden-slide<%= ' is-active' if i.zero? %>" data-golden-carousel-target="slide">
                <p class="fc-golden-quote">"<%= breath.text %>"</p>
                <div class="fc-golden-foot">
                  <% if breath.author_name.present? %>
                    <span class="fc-golden-author">— <%= breath.author_name %></span>
                  <% end %>
                  <% if breath.reference.present? %>
                    <span class="fc-golden-ref"><%= breath.reference %></span>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>

          <% if @daily_breaths.size > 1 %>
            <div class="fc-golden-dots" role="tablist" aria-label="Golden breath slides">
              <% @daily_breaths.each_with_index do |_, i| %>
                <button type="button"
                        class="fc-golden-dot<%= ' is-active' if i.zero? %>"
                        data-action="click->golden-carousel#goto"
                        data-index="<%= i %>"
                        data-golden-carousel-target="dot"
                        aria-label="Slide <%= i + 1 %>"></button>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @user_reading_plan %>
        <div class="fc-side-card fc-plan-side">
          <p class="fc-plan-side-kicker">📖 <%= @user_reading_plan.plan&.title %></p>
          <p class="fc-plan-side-day">Day <%= @user_reading_plan.current_day %> of <%= @user_reading_plan.days_total %></p>
          <p class="fc-plan-side-ref"><%= @user_reading_plan.today_reading&.dig(:reference) %></p>
          <div class="fc-plan-progress">
            <div class="fc-plan-progress-bar" style="width: <%= @user_reading_plan.progress_percent %>%"></div>
          </div>
          <% if @user_reading_plan.can_check_in_today? %>
            <%= button_to "Mark today done", check_in_reading_plan_path(@user_reading_plan.plan_slug), method: :post, form_class: "inline mt-3", class: "fc-btn fc-btn-primary w-full" %>
          <% else %>
            <p class="mt-3 text-xs font-bold text-[var(--fc-accent-2)]">✓ Done for today</p>
          <% end %>
          <%= link_to "Open plan →", reading_plan_path(@user_reading_plan.plan_slug), class: "mt-2 inline-block text-xs font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
        </div>
      <% else %>
        <div class="fc-side-card">
          <p class="text-xs font-extrabold uppercase tracking-wider text-[var(--fc-muted)]">📖 Reading plan</p>
          <p class="mt-2 text-sm text-[var(--fc-soft)]">Pick a slow rhythm in scripture — psalms, John, or Proverbs.</p>
          <%= link_to "Browse plans", reading_plans_path, class: "mt-3 inline-block text-sm font-bold text-[var(--fc-accent-2)] hover:text-[var(--fc-ink)]" %>
        </div>
      <% end %>

      <div class="fc-side-card">
        <div class="mb-3 flex items-center justify-between">
          <h3 class="text-sm font-extrabold text-[var(--fc-ink)]">Open prayer requests</h3>
          <span class="text-sm text-[var(--fc-muted)]"><%= @open_prayer_requests_count %></span>
        </div>
        <% if @open_prayer_requests.any? %>
          <div class="space-y-3">
            <% @open_prayer_requests.each do |post| %>
            <div class="flex items-center gap-3">
              <span class="fc-avatar" style="<%= avatar_tint_style(post.anonymous? ? "anon-#{post.id}" : post.user.username) %>">
                <%= post.anonymous? ? render_icon("users", classes: "h-4 w-4") : post.user.username.first.upcase %>
              </span>
              <span class="min-w-0 flex-1">
                <%= link_to post_path(post), class: "block truncate text-sm font-bold text-[var(--fc-ink)] hover:text-[var(--fc-accent)]" do %>
                  <%= truncate(post.title, length: 42) %>
                <% end %>
                <span class="block truncate text-xs text-[var(--fc-muted)]">
                  <%= post.anonymous? ? "Anonymous" : post.user.username %> · <%= time_ago_in_words(post.published_at || post.created_at) %> ago
                </span>
              </span>
              <% if current_user.has_liked?(post) %>
                <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
                    method: :delete,
                    class: "fc-btn text-[var(--fc-accent)]",
                    data: { turbo_frame: "_top" } do %>
                  Praying
                <% end %>
              <% else %>
                <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_type: :praying),
                    class: "fc-btn",
                    data: { turbo_frame: "_top" } do %>
                  Pray
                <% end %>
              <% end %>
            </div>
            <% end %>
          </div>
          <div class="mt-4 flex items-center gap-4">
            <%= link_to "View prayer room", (@prayer_room ? room_path(@prayer_room) : rooms_path), class: "text-sm font-bold text-[var(--fc-accent)] hover:text-[var(--fc-ink)]" %>
            <%= link_to "🌟 Answered wall", answered_prayers_path, class: "text-sm font-bold text-[#b45309] hover:text-[var(--fc-ink)]" %>
          </div>
        <% else %>
          <div class="rounded-md border border-[var(--fc-line)] bg-[var(--fc-surface-2)] p-4">
            <p class="text-sm font-semibold text-[var(--fc-soft)]">No prayer requests yet.</p>
            <button type="button"
                    data-action="click->composer-modal#open"
                    class="mt-3 inline-block text-sm font-bold text-[var(--fc-accent)] hover:text-[var(--fc-ink)]">
              Start one
            </button>
          </div>
        <% end %>
      </div>

      <% if @trending_breaths.any? %>
        <div class="fc-side-card">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-extrabold text-[var(--fc-ink)]">Trending breaths</h3>
            <%= link_to "More", feed_trending_path, class: "text-xs font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
          </div>
          <div class="space-y-3">
            <% @trending_breaths.each_with_index do |post, idx| %>
              <%= link_to post_path(post), class: "flex items-start gap-3 hover:bg-[var(--fc-surface-2)] -mx-2 px-2 py-1.5 rounded-md transition-colors" do %>
                <span class="fc-trend-rank is-<%= idx + 1 %> mt-0.5"><%= idx + 1 %></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-bold text-[var(--fc-ink)]">
                    <%= truncate(post.title, length: 48) %>
                  </span>
                  <span class="block truncate text-xs text-[var(--fc-muted)]">
                    <%= post.anonymous? ? "Anonymous" : post.user.username %>
                    · <%= post.likes_count + post.comments_count %> reactions
                  </span>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @who_to_brethren.any? %>
        <div class="fc-side-card">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-extrabold text-[var(--fc-ink)]">Who to brethren</h3>
            <%= link_to "See all", people_path, class: "text-xs font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
          </div>
          <div class="space-y-3">
            <% @who_to_brethren.each do |user| %>
              <div class="flex items-center gap-3">
                <% if user.profile&.avatar&.attached? %>
                  <%= link_to user_path(user.username) do %>
                    <%= image_tag user.profile.avatar, class: "fc-avatar object-cover", alt: user.username %>
                  <% end %>
                <% else %>
                  <%= link_to user.username.first.upcase, user_path(user.username), class: "fc-avatar" %>
                <% end %>
                <span class="min-w-0 flex-1">
                  <%= link_to user.username, user_path(user.username), class: "block truncate text-sm font-bold text-[var(--fc-ink)] hover:text-[var(--fc-accent)]" %>
                  <% bio = user.profile&.bio.to_s.strip %>
                  <% if bio.present? %>
                    <span class="block truncate text-xs text-[var(--fc-muted)]"><%= truncate(bio, length: 32) %></span>
                  <% else %>
                    <span class="block truncate text-xs text-[var(--fc-muted)]">recent breath author</span>
                  <% end %>
                </span>
                <%= button_to follow_user_path(user.username),
                    method: :post,
                    form_class: "inline",
                    class: "fc-btn fc-btn-primary",
                    data: { turbo: false } do %>
                  Follow
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </aside>
  </div>

  <button type="button"
          class="fc-scroll-top"
          data-controller="scroll-top"
          data-action="click->scroll-top#toTop"
          aria-label="Back to top">↑</button>

  <%# Hairline reading-progress bar along the very top of the viewport. %>
  <div class="fc-scroll-progress" data-controller="scroll-progress" aria-hidden="true">
    <span class="fc-scroll-progress-bar" data-scroll-progress-target="bar"></span>
  </div>
</div>
