<% content_for(:title) { "Feed - Faith Community" } %>

<div class="fc-app">
  <div class="fc-shell" data-controller="discover">
    <aside class="fc-sidebar">
      <div class="fc-section-label">Your Space</div>
      <nav class="space-y-1">
        <%= link_to feed_path, class: "fc-rail-link #{'is-active' if current_page?(feed_path)}" do %>
          <%= render_icon("message_circle", classes: "h-4 w-4") %>
          Feed
        <% end %>
        <%= link_to bookmarks_path, class: "fc-rail-link" do %>
          <%= render_icon("bookmark", classes: "h-4 w-4") %>
          Bookmarks
        <% end %>
        <%= link_to user_path(current_user.username), class: "fc-rail-link" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
          Profile
        <% end %>
        <%= link_to my_connections_path, class: "fc-rail-link" do %>
          <%= render_icon("users", classes: "h-4 w-4") %>
          Connections
        <% end %>
        <%= link_to notifications_path, class: "fc-rail-link" do %>
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          Notifications
        <% end %>
        <% if current_user_admin? %>
          <%= link_to admin_root_path, class: "fc-rail-link #{'is-active' if request.path.start_with?('/admin')}" do %>
            <%= render_icon("sparkles", classes: "h-4 w-4") %>
            Admin
          <% end %>
        <% end %>
      </nav>

      <div class="fc-section-label">Your Rooms</div>
      <nav class="space-y-1">
        <% Room.public_rooms.ordered.limit(6).each do |room| %>
          <%
            tint = case room.slug.to_s
                   when /prayer/  then "prayer"
                   when /testim/  then "testimony"
                   when /bible/   then "bible"
                   when /quest/   then "questions"
                   when /encour/  then "encourage"
                   when /youth/   then "youth"
                   else "prayer"
                   end
          %>
          <%= link_to room_path(room), class: "fc-rail-link" do %>
            <span class="grid h-5 w-5 place-items-center rounded text-[10px] room-tint-<%= tint %>">
              <%= render_icon(room.icon || "sparkles", classes: "h-3.5 w-3.5") %>
            </span>
            <%= room.name %>
          <% end %>
        <% end %>
        <%= link_to "Browse all rooms ->", rooms_path, class: "mt-3 block px-3 text-sm font-semibold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
      </nav>
    </aside>

    <main class="fc-main">
      <div class="fc-panel fc-composer">
        <% if current_user.profile&.avatar&.attached? %>
          <%= image_tag current_user.profile.avatar, class: "fc-avatar object-cover" %>
        <% else %>
          <span class="fc-avatar"><%= current_user.username.first.upcase %></span>
        <% end %>
        <button type="button"
                class="fc-composer-input flex items-center text-[var(--fc-muted)]"
                data-action="click->composer-modal#open">
          What's on your heart? Take a breath...
        </button>
        <button type="button"
                class="fc-btn fc-btn-primary"
                data-action="click->composer-modal#open">
          Breathe
        </button>
      </div>

      <div class="fc-tabs">
        <%= link_to "Recent", feed_path, class: "fc-tab #{current_page?(feed_path) ? 'is-active' : ''}" %>
        <%= link_to "Threads", feed_threads_path, class: "fc-tab #{current_page?(feed_threads_path) ? 'is-active' : ''}" %>
        <%= link_to "Trending", feed_trending_path, class: "fc-tab #{current_page?(feed_trending_path) ? 'is-active' : ''}" %>
        <%= link_to "Following", feed_following_path, class: "fc-tab #{current_page?(feed_following_path) ? 'is-active' : ''}" %>
        <button type="button" class="fc-discover-trigger" data-action="click->discover#open" aria-label="Open discover panel">
          <%= render_icon("sparkles", classes: "h-4 w-4") %>
          <span>Discover</span>
        </button>
        <div class="ml-auto hidden sm:block">
          <%= link_to "All rooms", rooms_path, class: "fc-btn" %>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <% if @items.any? %>
          <% @items.each do |item| %>
            <%= render "posts/card", post: item.post, reshared_by: item.reshared_by %>
          <% end %>

          <% if @pagy.pages > 1 %>
            <div class="pt-4">
              <%== pagy_nav(@pagy) %>
            </div>
          <% end %>
        <% else %>
          <div class="fc-panel p-8 text-center">
            <h2 class="text-lg font-bold text-[var(--fc-ink)]">No breaths yet</h2>
            <p class="mt-2 text-sm text-[var(--fc-muted)]">Start the first conversation.</p>
            <button type="button"
                    class="fc-btn fc-btn-primary mt-5"
                    data-action="click->composer-modal#open">
              Take a breath
            </button>
          </div>
        <% end %>
      </div>
    </main>

    <aside class="fc-aside space-y-3" data-discover-target="panel">
      <header class="fc-discover-head">
        <span>Discover</span>
        <button type="button" class="fc-discover-close" data-action="click->discover#close" aria-label="Close">×</button>
      </header>
      <% if @daily_verse %>
        <div class="fc-side-card">
          <h3 class="mb-3 text-sm font-extrabold text-[var(--fc-ink)]">Today's verse</h3>
          <p class="font-serif text-lg leading-7 text-[var(--fc-soft)]">"<%= @daily_verse.text %>"</p>
          <% if @daily_verse.reference.present? %>
            <p class="mt-3 text-sm text-[var(--fc-muted)]"><%= @daily_verse.reference %></p>
          <% end %>
        </div>
      <% else %>
        <div class="fc-side-card">
          <h3 class="mb-3 text-sm font-extrabold text-[var(--fc-ink)]">Today's verse</h3>
          <p class="font-serif text-lg leading-7 text-[var(--fc-soft)]">"He gives strength to the weary, and increases the power of the weak."</p>
          <p class="mt-3 text-sm text-[var(--fc-muted)]">Isaiah 40:29</p>
        </div>
      <% end %>

      <% if @daily_breaths.any? %>
        <div class="fc-side-card fc-golden-card"
             data-controller="golden-carousel"
             data-golden-carousel-interval-value="7000">
          <header class="fc-golden-head">
            <p class="fc-golden-kicker">Golden Breaths</p>
            <% if @daily_breaths.size > 1 %>
              <div class="fc-golden-controls">
                <button type="button" class="fc-golden-arrow" data-action="click->golden-carousel#prev" aria-label="Previous">‹</button>
                <button type="button" class="fc-golden-arrow" data-action="click->golden-carousel#next" aria-label="Next">›</button>
              </div>
            <% end %>
          </header>

          <div class="fc-golden-track" data-golden-carousel-target="track">
            <% @daily_breaths.each_with_index do |breath, i| %>
              <article class="fc-golden-slide<%= ' is-active' if i.zero? %>" data-golden-carousel-target="slide">
                <p class="fc-golden-quote">"<%= breath.text %>"</p>
                <div class="fc-golden-foot">
                  <% if breath.author_name.present? %>
                    <span class="fc-golden-author">— <%= breath.author_name %></span>
                  <% end %>
                  <% if breath.reference.present? %>
                    <span class="fc-golden-ref"><%= breath.reference %></span>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>

          <% if @daily_breaths.size > 1 %>
            <div class="fc-golden-dots" role="tablist" aria-label="Golden breath slides">
              <% @daily_breaths.each_with_index do |_, i| %>
                <button type="button"
                        class="fc-golden-dot<%= ' is-active' if i.zero? %>"
                        data-action="click->golden-carousel#goto"
                        data-index="<%= i %>"
                        data-golden-carousel-target="dot"
                        aria-label="Slide <%= i + 1 %>"></button>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="fc-side-card">
        <div class="mb-3 flex items-center justify-between">
          <h3 class="text-sm font-extrabold text-[var(--fc-ink)]">Open prayer requests</h3>
          <span class="text-sm text-[var(--fc-muted)]"><%= @open_prayer_requests_count %></span>
        </div>
        <% if @open_prayer_requests.any? %>
          <div class="space-y-3">
            <% @open_prayer_requests.each do |post| %>
            <div class="flex items-center gap-3">
              <span class="fc-avatar">
                <%= post.anonymous? ? render_icon("users", classes: "h-4 w-4") : post.user.username.first.upcase %>
              </span>
              <span class="min-w-0 flex-1">
                <%= link_to post_path(post), class: "block truncate text-sm font-bold text-[var(--fc-ink)] hover:text-[var(--fc-accent)]" do %>
                  <%= truncate(post.title, length: 42) %>
                <% end %>
                <span class="block truncate text-xs text-[var(--fc-muted)]">
                  <%= post.anonymous? ? "Anonymous" : post.user.username %> · <%= time_ago_in_words(post.published_at || post.created_at) %> ago
                </span>
              </span>
              <% if current_user.has_liked?(post) %>
                <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
                    method: :delete,
                    class: "fc-btn text-[var(--fc-accent)]",
                    data: { turbo_frame: "_top" } do %>
                  Praying
                <% end %>
              <% else %>
                <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_type: :praying),
                    class: "fc-btn",
                    data: { turbo_frame: "_top" } do %>
                  Pray
                <% end %>
              <% end %>
            </div>
            <% end %>
          </div>
          <%= link_to "View prayer room", (@prayer_room ? room_path(@prayer_room) : rooms_path), class: "mt-4 inline-block text-sm font-bold text-[var(--fc-accent)] hover:text-[var(--fc-ink)]" %>
        <% else %>
          <div class="rounded-md border border-[var(--fc-line)] bg-[var(--fc-surface-2)] p-4">
            <p class="text-sm font-semibold text-[var(--fc-soft)]">No prayer requests yet.</p>
            <button type="button"
                    data-action="click->composer-modal#open"
                    class="mt-3 inline-block text-sm font-bold text-[var(--fc-accent)] hover:text-[var(--fc-ink)]">
              Start one
            </button>
          </div>
        <% end %>
      </div>

      <% if @trending_breaths.any? %>
        <div class="fc-side-card">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-extrabold text-[var(--fc-ink)]">Trending breaths</h3>
            <%= link_to "More", feed_trending_path, class: "text-xs font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
          </div>
          <div class="space-y-3">
            <% @trending_breaths.each_with_index do |post, idx| %>
              <%= link_to post_path(post), class: "flex items-start gap-3 hover:bg-[var(--fc-surface-2)] -mx-2 px-2 py-1.5 rounded-md transition-colors" do %>
                <span class="text-xs font-extrabold text-[var(--fc-faint)] mt-0.5 w-4 text-right"><%= idx + 1 %></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-bold text-[var(--fc-ink)]">
                    <%= truncate(post.title, length: 48) %>
                  </span>
                  <span class="block truncate text-xs text-[var(--fc-muted)]">
                    <%= post.anonymous? ? "Anonymous" : post.user.username %>
                    · <%= post.likes_count + post.comments_count %> reactions
                  </span>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @who_to_brethren.any? %>
        <div class="fc-side-card">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-extrabold text-[var(--fc-ink)]">Who to brethren</h3>
            <%= link_to "See all", people_path, class: "text-xs font-bold text-[var(--fc-muted)] hover:text-[var(--fc-ink)]" %>
          </div>
          <div class="space-y-3">
            <% @who_to_brethren.each do |user| %>
              <div class="flex items-center gap-3">
                <% if user.profile&.avatar&.attached? %>
                  <%= link_to user_path(user.username) do %>
                    <%= image_tag user.profile.avatar, class: "fc-avatar object-cover", alt: user.username %>
                  <% end %>
                <% else %>
                  <%= link_to user.username.first.upcase, user_path(user.username), class: "fc-avatar" %>
                <% end %>
                <span class="min-w-0 flex-1">
                  <%= link_to user.username, user_path(user.username), class: "block truncate text-sm font-bold text-[var(--fc-ink)] hover:text-[var(--fc-accent)]" %>
                  <% bio = user.profile&.bio.to_s.strip %>
                  <% if bio.present? %>
                    <span class="block truncate text-xs text-[var(--fc-muted)]"><%= truncate(bio, length: 32) %></span>
                  <% else %>
                    <span class="block truncate text-xs text-[var(--fc-muted)]">recent breath author</span>
                  <% end %>
                </span>
                <%= button_to follow_user_path(user.username),
                    method: :post,
                    form_class: "inline",
                    class: "fc-btn fc-btn-primary",
                    data: { turbo: false } do %>
                  Follow
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </aside>
  </div>
</div>
