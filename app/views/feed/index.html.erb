<% content_for(:title) { "Feed - Brethreign" } %>
<%# In the iPhone/Android apps the top bar shows this: the brand, not "Feed". %>
<% content_for(:app_title) { "Brethreign" } %>
<%
  # Verse of the day for the Today strip: one of the admin's Living Scriptures,
  # the same one all day, changing each morning.
  verses = @daily_verses.presence || [
    OpenStruct.new(text: "He gives strength to the weary, and increases the power of the weak.", reference: "Isaiah 40:29")
  ]
  verse = verses[Date.current.yday % verses.size]
  verse_chapter = verse.reference.to_s.sub(/:[\d\-–, ]+\z/, "").strip
  streak = current_user.current_breath_streak.to_i
  breathed_today = current_user.posts.published.where(created_at: Time.current.all_day).exists?
%>

<div class="fc-app eg-feed">
  <div class="fc-shell" data-controller="discover">
    <aside class="fc-sidebar eg-left" aria-label="Your space">
      <%= render "feed/walk", plan: @user_reading_plan %>

      <nav class="eg-card eg-shortcuts" aria-label="Shortcuts">
        <%= link_to feed_path, class: "fc-rail-link eg-shortcut #{'is-active' if current_page?(feed_path)}" do %>
          <%= render_icon("feed", classes: "eg-ico is-green") %>
          Feed
        <% end %>
        <button type="button"
                class="fc-rail-link eg-shortcut"
                data-tour-anchor="bible"
                data-action="click->bible-drawer#open">
          <%= render_icon("bookopen", classes: "eg-ico is-green") %>
          Open Bible
        </button>
        <%= link_to circles_path, class: "fc-rail-link eg-shortcut" do %>
          <%= render_icon("pray", classes: "eg-ico is-gold") %>
          Prayer Circles
        <% end %>
        <%= link_to answered_prayers_path, class: "fc-rail-link eg-shortcut" do %>
          <%= render_icon("answered", classes: "eg-ico is-green") %>
          Answered Prayers
        <% end %>
        <%= link_to bookmarks_path, class: "fc-rail-link eg-shortcut" do %>
          <%= render_icon("bookmark", classes: "eg-ico is-blue") %>
          Bookmarks
        <% end %>

        <details class="eg-more">
          <summary class="fc-rail-link eg-shortcut eg-more-toggle">
            <%= render_icon("chevrondown", classes: "eg-ico eg-more-chevron") %>
            <span class="eg-more-closed">See more</span>
            <span class="eg-more-open">See less</span>
          </summary>
          <%= link_to games_path, class: "fc-rail-link eg-shortcut" do %>
            <%= render_icon("games", classes: "eg-ico is-violet") %>
            Games
          <% end %>
          <%= link_to church_history_path, class: "fc-rail-link eg-shortcut" do %>
            <%= render_icon("church", classes: "eg-ico is-violet") %>
            Church History
          <% end %>
          <%= link_to blog_path, class: "fc-rail-link eg-shortcut" do %>
            <%= render_icon("blog", classes: "eg-ico is-blue") %>
            Blog &amp; guides
          <% end %>
          <%= link_to user_path(current_user.username), class: "fc-rail-link eg-shortcut" do %>
            <%= render_icon("user", classes: "eg-ico is-green") %>
            Profile
          <% end %>
          <%= link_to my_connections_path, class: "fc-rail-link eg-shortcut" do %>
            <%= render_icon("users", classes: "eg-ico is-green") %>
            Connections
          <% end %>
          <%= link_to notifications_path, class: "fc-rail-link eg-shortcut" do %>
            <%= render_icon("bell", classes: "eg-ico is-gold") %>
            Notifications
          <% end %>
          <% if current_user_admin? %>
            <%= link_to admin_root_path, class: "fc-rail-link eg-shortcut #{'is-active' if request.path.start_with?('/admin')}" do %>
              <%= render_icon("settings", classes: "eg-ico") %>
              Admin
            <% end %>
          <% end %>
        </details>
      </nav>

      <section class="eg-card eg-rooms" data-tour-anchor="rooms" aria-labelledby="eg-rooms-title">
        <div class="eg-card-head">
          <h2 class="eg-card-title" id="eg-rooms-title">Rooms</h2>
          <%= link_to "See all", rooms_path, class: "eg-card-link" %>
        </div>
        <% Room.public_rooms.ordered.limit(5).each do |room| %>
          <%
            tint = case room.slug.to_s
                   when /prayer/  then "prayer"
                   when /testim/  then "testimony"
                   when /bible/   then "bible"
                   when /quest/   then "questions"
                   when /encour/  then "encourage"
                   when /youth/   then "youth"
                   else "prayer"
                   end
          %>
          <%= link_to room_path(room), class: "fc-rail-link eg-shortcut eg-room-link" do %>
            <span class="eg-room-tile room-tint-<%= tint %>">
              <%= render_icon(room_icon_name(room), classes: "h-4 w-4") %>
            </span>
            <span class="eg-room-name"><%= room.name %></span>
          <% end %>
        <% end %>
      </section>

      <% latest_articles = BlogArticle.all.sort_by { |a| [ -a.date.jd, a.order ] }.first(3) %>
      <% if latest_articles.any? %>
        <section class="eg-blog fc-blog-card" aria-labelledby="eg-blog-title">
          <div class="eg-card-head">
            <h2 class="eg-mini-title" id="eg-blog-title">From the blog</h2>
            <%= link_to "All guides", blog_path, class: "eg-card-link" %>
          </div>
          <% latest_articles.each do |article| %>
            <%= link_to blog_article_path(article.slug), class: "eg-blog-item" do %>
              <span class="eg-blog-title"><%= article.title %></span>
              <span class="eg-blog-meta"><%= article.category %> · <%= article.minutes %> min read</span>
            <% end %>
          <% end %>
        </section>
      <% end %>
    </aside>

    <main class="fc-main eg-main">
      <%# Today: the reader's own date (the server runs on UTC, so its date can
          be a day off late at night), the breath streak, the verse of the day
          and who is online right now. %>
      <section class="eg-today" aria-label="Today">
        <svg class="eg-today-waves" viewBox="0 0 320 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M0 70c40-50 80-50 120 0s80 50 120 0 60-40 80-20M0 100c40-50 80-50 120 0s80 50 120 0 60-40 80-20"/></svg>
        <div class="eg-today-top">
          <h1 class="eg-today-date">
            <time datetime="<%= Time.current.utc.iso8601 %>" data-controller="local-time" data-local-time-format-value="today"><%= Date.current.strftime("%A, %-d %B") %></time>
          </h1>
          <% if streak.positive? %>
            <span class="eg-today-streak" title="Breath streak: days in a row you've breathed">
              <%= render_icon("flame", classes: "eg-flame") %>
              <%= streak %>-day streak
            </span>
          <% end %>
        </div>
        <blockquote class="eg-today-verse">&ldquo;<%= verse.text %>&rdquo;</blockquote>
        <div class="eg-today-foot">
          <% if verse.reference.present? %>
            <span class="eg-today-ref"><%= verse.reference %></span>
          <% end %>
          <div class="eg-today-online">
            <%= render "presence/strip", online: OnlinePresence.new(current_user) %>
          </div>
          <% if verse_chapter.present? %>
            <button type="button"
                    class="eg-today-read"
                    data-reference="<%= verse_chapter %>"
                    data-action="click->bible-drawer#open click->bible-drawer#openChapter">
              Read chapter
              <%= render_icon("chevronright", classes: "h-4 w-4") %>
            </button>
          <% end %>
        </div>
      </section>

      <%= render "feed/birthdays", birthdays: @birthdays_today %>

      <%# The Daily Breath question is the composer's prompt. %>
      <div class="fc-panel fc-composer eg-composer">
        <div class="eg-composer-row">
          <% if current_user.profile&.avatar&.attached? %>
            <%= image_tag avatar_src(current_user.profile), class: "eg-avatar object-cover", alt: "" %>
          <% else %>
            <span class="eg-avatar" style="<%= avatar_tint_style(current_user.username) %>"><%= current_user.username.first.upcase %></span>
          <% end %>
          <button type="button"
                  class="eg-composer-input"
                  data-tour-anchor="composer"
                  data-action="click->composer-modal#open">
            <span class="fc-composer-daily">What breath do you have today?</span>
            <span class="eg-composer-photo" aria-hidden="true"><%= render_icon("image", classes: "h-5 w-5") %></span>
          </button>
        </div>
        <div class="eg-chips">
          <button type="button" class="eg-chip is-prayer" data-tour-anchor="prayer" data-tour-rank="1"
                  data-action="click->composer-modal#openWith"
                  data-composer-modal-prefill-param="Brethren, please pray with me: ">
            <%= render_icon("pray", classes: "h-5 w-5") %> Prayer
          </button>
          <button type="button" class="eg-chip is-verse"
                  data-action="click->composer-modal#openWith"
                  data-composer-modal-prefill-param="A verse on my heart today: ">
            <%= render_icon("bookopen", classes: "h-5 w-5") %> Verse
          </button>
          <button type="button" class="eg-chip is-photo" data-action="click->composer-modal#open">
            <%= render_icon("image", classes: "h-5 w-5") %> Photo
          </button>
          <button type="button" class="eg-chip is-voice" data-action="click->composer-modal#open">
            <%= render_icon("mic", classes: "h-5 w-5") %> Voice
          </button>
          <% if breathed_today %>
            <p class="fc-composer-done"><%= render_icon("answered", classes: "h-4 w-4") %> You breathed today</p>
          <% end %>
        </div>
      </div>

      <%# Getting started: first steps that tick themselves, until done or hidden. %>
      <% if @onboarding || @onboarding_celebrate %>
        <%# Steps done on other pages tick here without a refresh (OnboardingChecklist.broadcast_refresh). %>
        <%= turbo_stream_from current_user, :onboarding if @onboarding %>
        <%= render "feed/onboarding_frame", checklist: @onboarding, celebrate: @onboarding_celebrate, prayer_room: @prayer_room %>
      <% end %>

      <%# New brethren: one card, not one per person. Closing it hides this group;
          the next person to join brings it back. %>
      <% joiners = Array(@new_member_announcements).select(&:user) %>
      <% join_key = "join-#{joiners.map(&:id).max}" %>
      <% if joiners.any? && !current_user.card_dismissed?(join_key) %>
        <% people = joiners.map(&:user).uniq.first(5) %>
        <div class="fc-join-card"
             data-controller="auto-dismiss"
             data-auto-dismiss-after-ms-value="30000"
             data-auto-dismiss-persist-key-value="<%= join_key %>"
             data-auto-dismiss-store-key-value="fc:joins-dismissed">
          <span class="fc-join-faces">
            <% people.first(3).each do |person| %>
              <% if person.profile&.avatar&.attached? %>
                <%= image_tag avatar_src(person.profile), class: "fc-avatar object-cover", alt: "" %>
              <% else %>
                <span class="fc-avatar" style="<%= avatar_tint_style(person.username) %>"><%= person.username.first.upcase %></span>
              <% end %>
            <% end %>
          </span>
          <p class="fc-join-card-text">
            <%= link_to people.first.username, user_path(people.first.username), class: "fc-breath-name" %>
            <% if people.size == 2 %>
              and <%= link_to people.second.username, user_path(people.second.username), class: "fc-breath-name" %>
            <% elsif people.size > 2 %>
              and <%= link_to pluralize(people.size - 1, "other"), people_path, class: "fc-breath-name" %>
            <% end %>
            just joined us. Say welcome!
          </p>
          <button type="button"
                  class="fc-join-card-close"
                  data-action="click->auto-dismiss#dismiss"
                  aria-label="Dismiss">×</button>
        </div>
      <% end %>

      <%# Introduces the Updates tab until it's closed or the tab is opened. %>
      <% unless @updates_tab || current_user.card_dismissed?("updates-intro") %>
        <%= render "bot_items/intro_banner" %>
      <% end %>

      <%# Releases written as slides show in the "What's new" pop-up instead of this banner. %>
      <% if @release_announcement && @release_announcement.slides.size < 2 && !current_user.card_dismissed?("release-#{@release_announcement.id}") %>
        <section class="fc-release-banner"
                 data-controller="onboarding"
                 data-onboarding-key-value="fc:release-<%= @release_announcement.id %>"
                 aria-label="Latest update">
          <button type="button"
                  class="fc-release-banner-close"
                  data-action="click->onboarding#dismiss"
                  aria-label="Dismiss">×</button>
          <% if @release_announcement.kicker.present? %>
            <p class="fc-release-banner-kicker"><%= render_icon("sparkles", classes: "h-4 w-4") %> <%= @release_announcement.kicker %></p>
          <% end %>
          <h2 class="fc-release-banner-title"><%= @release_announcement.title %></h2>
          <% if @release_announcement.body.present? %>
            <%
              # Collapse single newlines (soft-wrap from paste) into spaces,
              # keep double newlines as paragraph breaks. Avoids one ragged
              # <br> after every line when admins paste pre-wrapped text.
              clean_body = @release_announcement.body.to_s.gsub(/(?<!\n)\n(?!\n)/, " ").gsub(/[ \t]+/, " ").strip
            %>
            <div class="fc-release-banner-body"><%= simple_format(clean_body, {}, sanitize: false) %></div>
          <% end %>
        </section>
      <% end %>

      <%# The stream (tabs + list) lives in a frame so switching tabs swaps
          just this region — no full page reload. target: "_top" keeps every
          link inside the cards navigating normally; only the tab links opt
          into the frame. %>
      <%= turbo_frame_tag "feed_stream", target: "_top" do %>
      <div class="fc-tabs eg-tabs" data-controller="feed-tabs" role="tablist" aria-label="Feed">
        <%= link_to "Recent", feed_path,
              class: "fc-tab #{current_page?(feed_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Threads", feed_threads_path,
              class: "fc-tab #{current_page?(feed_threads_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Trending", feed_trending_path,
              class: "fc-tab #{current_page?(feed_trending_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Following", feed_following_path,
              class: "fc-tab #{current_page?(feed_following_path) ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <%= link_to "Updates", feed_updates_path,
              class: "fc-tab #{@updates_tab ? 'is-active' : ''}",
              data: { turbo_frame: "feed_stream", turbo_action: "advance", action: "click->feed-tabs#move" } %>
        <button type="button" class="fc-discover-trigger" data-tour-anchor="discover" data-action="click->discover#open" aria-label="Open discover panel">
          <%= render_icon("grid", classes: "h-4 w-4") %>
          <span>Discover</span>
        </button>
      </div>

      <div data-controller="new-posts-pill">
        <%= turbo_stream_from "feed:public" %>
        <div id="feed_incoming" hidden data-new-posts-pill-target="bucket"></div>

        <button type="button"
                class="fc-new-posts-pill hidden"
                data-new-posts-pill-target="pill"
                data-action="click->new-posts-pill#flush"
                aria-live="polite">
          <%= render_icon("sparkles", classes: "h-3.5 w-3.5") %>
          <span data-new-posts-pill-target="count">0</span>
          <span data-new-posts-pill-target="label">new breaths</span>
        </button>

        <div class="eg-stream">
          <% if @updates_tab %>
            <%= render "bot_items/stream" %>
          <% else %>
          <% if @pinned_posts.present? %>
            <div class="fc-pinned-strip">
              <p class="fc-pinned-label"><%= render_icon("pin", classes: "h-4 w-4") %> Pinned for the community</p>
              <div class="eg-stream">
                <% @pinned_posts.each do |pinned| %>
                  <div class="fc-pinned-card">
                    <%= render "posts/card", post: pinned %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if @items.any? %>
            <div id="feed_list" class="eg-stream">
              <% @items.each_with_index do |item, index| %>
                <%= render "posts/card", post: item.post, reshared_by: item.reshared_by %>
                <% if index == 3 && @suggestions %>
                  <%= render "shared/brethren_suggestions", suggestions: @suggestions, nudge: @suggestion_nudge %>
                <% end %>
              <% end %>
            </div>

            <% if @pagy.next %>
              <div id="feed_more"
                   data-controller="infinite-scroll"
                   data-infinite-scroll-url-value="<%= url_for(page: @pagy.next) %>">
                <div class="fc-skel-card">
                  <div class="fc-skel fc-skel-avatar"></div>
                  <div>
                    <div class="fc-skel fc-skel-line is-short"></div>
                    <div class="fc-skel fc-skel-line is-long"></div>
                    <div class="fc-skel fc-skel-line is-mid"></div>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="fc-caught-up" role="status">
                <span class="fc-caught-up-line" aria-hidden="true"></span>
                <span class="fc-caught-up-text"><%= render_icon("answered", classes: "h-4 w-4") %> You're all caught up</span>
                <span class="fc-caught-up-line" aria-hidden="true"></span>
              </div>
            <% end %>
          <% else %>
            <div class="fc-empty">
              <div class="fc-empty-mark" aria-hidden="true">
                <%= render_icon("chat", classes: "h-7 w-7") %>
              </div>
              <h2 class="fc-empty-title">Quiet here for now.</h2>
              <p class="fc-empty-text">Be the first to take a breath — share a verse, a prayer, or what's on your heart.</p>
              <div class="fc-empty-actions">
                <button type="button"
                        class="fc-btn fc-btn-primary"
                        data-action="click->composer-modal#open">
                  Take a breath
                </button>
                <button type="button"
                        class="fc-btn"
                        data-action="click->bible-drawer#open">
                  <%= render_icon("bookopen", classes: "h-4 w-4") %> Open Bible
                </button>
              </div>
            </div>
          <% end %>
          <% end %>
        </div>
      </div>
      <% end %>
    </main>

    <aside class="fc-aside eg-right" data-discover-target="panel" aria-label="Discover">
      <header class="fc-discover-head">
        <span>Discover</span>
        <button type="button" class="fc-discover-close" data-action="click->discover#close" aria-label="Close">×</button>
      </header>

      <%# Phones have no left column: its shortcuts and walk live in this sheet. %>
      <nav class="eg-card eg-quicklinks" aria-label="Quick links">
        <button type="button" class="eg-quicklink" data-action="click->bible-drawer#open click->discover#close">
          <%= render_icon("bookopen", classes: "eg-ico is-green") %> Open Bible
        </button>
        <%= link_to circles_path, class: "eg-quicklink" do %>
          <%= render_icon("pray", classes: "eg-ico is-gold") %> Prayer Circles
        <% end %>
        <%= link_to answered_prayers_path, class: "eg-quicklink" do %>
          <%= render_icon("answered", classes: "eg-ico is-green") %> Answered Prayers
        <% end %>
        <%= link_to bookmarks_path, class: "eg-quicklink" do %>
          <%= render_icon("bookmark", classes: "eg-ico is-blue") %> Bookmarks
        <% end %>
        <%= link_to people_path, class: "eg-quicklink" do %>
          <%= render_icon("users", classes: "eg-ico is-green") %> People
        <% end %>
        <%= link_to search_path, class: "eg-quicklink" do %>
          <%= render_icon("search", classes: "eg-ico") %> Search
        <% end %>
        <%= link_to games_path, class: "eg-quicklink" do %>
          <%= render_icon("games", classes: "eg-ico is-violet") %> Games
        <% end %>
        <%= link_to church_history_path, class: "eg-quicklink" do %>
          <%= render_icon("church", classes: "eg-ico is-violet") %> Church History
        <% end %>
        <%= link_to blog_path, class: "eg-quicklink" do %>
          <%= render_icon("blog", classes: "eg-ico is-blue") %> Blog &amp; guides
        <% end %>
      </nav>
      <%= render "feed/walk", plan: @user_reading_plan, extra_class: "eg-phone-only" %>

      <section class="fc-side-card eg-card eg-pray-card" data-tour-anchor="prayer" aria-labelledby="eg-pray-title">
        <div class="eg-card-head">
          <h2 class="eg-card-title" id="eg-pray-title">Pray for the brethren</h2>
          <% if @open_prayer_requests_count.to_i.positive? %>
            <span class="eg-count"><%= @open_prayer_requests_count %></span>
          <% end %>
        </div>
        <% if @open_prayer_requests.any? %>
          <% @open_prayer_requests.each do |post| %>
            <div class="eg-pray-row">
              <span class="eg-avatar eg-avatar-sm" style="<%= avatar_tint_style(post.anonymous? ? "anon-#{post.id}" : post.user.username) %>">
                <%= post.anonymous? ? render_icon("users", classes: "h-4 w-4") : post.user.username.first.upcase %>
              </span>
              <span class="eg-pray-text">
                <%= link_to truncate(post.title, length: 42), post_path(post), class: "eg-pray-title" %>
                <span class="eg-pray-meta"><%= post.anonymous? ? "Anonymous" : post.user.username %> · <%= time_ago_in_words(post.published_at || post.created_at) %> ago</span>
              </span>
              <% if current_user.has_liked?(post) %>
                <%= button_to unlike_path(likeable_type: "Post", likeable_id: post.id),
                    method: :delete,
                    form_class: "eg-pray-form",
                    class: "eg-pray-btn is-praying",
                    title: "You're praying. Tap to undo",
                    aria: { label: "Praying for: #{post.title}. Tap to undo" },
                    data: { turbo_frame: "_top" } do %>
                  <%= render_icon("pray", classes: "h-5 w-5") %>
                <% end %>
              <% else %>
                <%= button_to likes_path(likeable_type: "Post", likeable_id: post.id, reaction_type: :praying),
                    form_class: "eg-pray-form",
                    class: "eg-pray-btn",
                    title: "Pray",
                    aria: { label: "Pray for: #{post.title}" },
                    data: { turbo_frame: "_top" } do %>
                  <%= render_icon("pray", classes: "h-5 w-5") %>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <div class="eg-card-links">
            <%= link_to "See all requests", (@prayer_room ? room_path(@prayer_room) : rooms_path), class: "eg-card-link" %>
            <%= link_to "Answered wall", answered_prayers_path, class: "eg-card-link is-gold" %>
          </div>
        <% else %>
          <p class="eg-muted">No prayer requests yet.</p>
          <button type="button" data-action="click->composer-modal#open" class="eg-card-link">Start one</button>
        <% end %>
      </section>

      <section class="fc-side-card eg-card eg-games-card" aria-labelledby="eg-games-title">
        <div class="eg-card-head">
          <h2 class="eg-card-title" id="eg-games-title">Play today</h2>
          <%= link_to "Leaderboard", games_path, class: "eg-card-link" %>
        </div>
        <%= link_to games_chess_path, class: "eg-game-row" do %>
          <span class="eg-tile is-green"><%= render_icon("chess", classes: "h-5 w-5") %></span>
          <span class="eg-game-text"><strong>Chess puzzle</strong><small>Today's puzzle</small></span>
        <% end %>
        <%= link_to games_quiz_path, class: "eg-game-row" do %>
          <span class="eg-tile is-gold"><%= render_icon("quiz", classes: "h-5 w-5") %></span>
          <span class="eg-game-text"><strong>Bible quiz</strong><small>Test what you know</small></span>
        <% end %>
        <%= link_to games_history_path, class: "eg-game-row" do %>
          <span class="eg-tile is-violet"><%= render_icon("church", classes: "h-5 w-5") %></span>
          <span class="eg-game-text"><strong>Church history</strong><small>Walk through the centuries</small></span>
        <% end %>
      </section>

      <% if @who_to_brethren.any? %>
        <section class="fc-side-card eg-card" aria-labelledby="eg-people-title">
          <div class="eg-card-head">
            <h2 class="eg-card-title" id="eg-people-title">Brethren you may know</h2>
            <%= link_to "See all", people_path, class: "eg-card-link" %>
          </div>
          <% @who_to_brethren.each do |user| %>
            <div class="eg-person">
              <%= link_to user_path(user.username), class: "eg-person-avatar", aria: { label: user.username } do %>
                <% if user.profile&.avatar&.attached? %>
                  <%= image_tag avatar_src(user.profile), class: "eg-avatar object-cover", alt: "" %>
                <% else %>
                  <span class="eg-avatar" style="<%= avatar_tint_style(user.username) %>"><%= user.username.first.upcase %></span>
                <% end %>
              <% end %>
              <span class="eg-person-text">
                <%= link_to user.username, user_path(user.username), class: "eg-person-name" %>
                <% bio = user.profile&.bio.to_s.strip %>
                <span class="eg-person-sub"><%= bio.present? ? truncate(bio, length: 32) : "recent breath author" %></span>
              </span>
              <%= button_to follow_user_path(user.username),
                  method: :post,
                  form_class: "eg-person-form",
                  class: "eg-btn eg-btn-outline",
                  data: { turbo: false } do %>
                Follow
              <% end %>
            </div>
          <% end %>
        </section>
      <% end %>

      <% if @daily_breaths.any? %>
        <section class="fc-side-card eg-card fc-golden-card eg-golden"
                 data-controller="golden-carousel"
                 data-golden-carousel-interval-value="7000"
                 aria-labelledby="eg-golden-title">
          <header class="eg-card-head">
            <h2 class="eg-card-title" id="eg-golden-title">Golden breaths</h2>
            <% if @daily_breaths.size > 1 %>
              <div class="eg-golden-controls">
                <button type="button" class="eg-round-btn" data-action="click->golden-carousel#prev" aria-label="Previous"><%= render_icon("chevronleft", classes: "h-4 w-4") %></button>
                <button type="button" class="eg-round-btn" data-action="click->golden-carousel#next" aria-label="Next"><%= render_icon("chevronright", classes: "h-4 w-4") %></button>
              </div>
            <% end %>
          </header>

          <div class="fc-golden-track" data-golden-carousel-target="track">
            <% @daily_breaths.each_with_index do |breath, i| %>
              <article class="fc-golden-slide<%= ' is-active' if i.zero? %>" data-golden-carousel-target="slide">
                <p class="eg-golden-quote">&ldquo;<%= breath.text %>&rdquo;</p>
                <p class="eg-golden-foot">
                  <% if breath.author_name.present? %>
                    <span class="eg-golden-author"><%= breath.author_name %></span>
                  <% end %>
                  <% if breath.reference.present? %>
                    <span class="eg-golden-ref"><%= breath.reference %></span>
                  <% end %>
                </p>
              </article>
            <% end %>
          </div>

          <% if @daily_breaths.size > 1 %>
            <div class="fc-golden-dots" role="tablist" aria-label="Golden breath slides">
              <% @daily_breaths.each_with_index do |_, i| %>
                <button type="button"
                        class="fc-golden-dot<%= ' is-active' if i.zero? %>"
                        data-action="click->golden-carousel#goto"
                        data-index="<%= i %>"
                        data-golden-carousel-target="dot"
                        aria-label="Slide <%= i + 1 %>"></button>
              <% end %>
            </div>
          <% end %>
        </section>
      <% end %>
    </aside>
  </div>

  <button type="button"
          class="fc-scroll-top"
          data-controller="scroll-top"
          data-action="click->scroll-top#toTop"
          aria-label="Back to top">↑</button>

  <%# Hairline reading-progress bar along the very top of the viewport. %>
  <div class="fc-scroll-progress" data-controller="scroll-progress" aria-hidden="true">
    <span class="fc-scroll-progress-bar" data-scroll-progress-target="bar"></span>
  </div>
</div>

<%= render "feed/tour" if @show_tour %>
