<%# Reshare control. Two flavors:
    - Quick repost (one click — creates a Reshare row)
    - Quote — opens the full composer with this post embedded.
    Locals: post %>
<% if user_signed_in? && current_user.has_reshared?(post) %>
  <span id="<%= dom_id(post, :reshare) %>">
    <%= button_to post_reshare_path(post),
        method: :delete,
        class: "fc-action text-[var(--fc-gold)]",
        title: "Remove reshare",
        data: { turbo_frame: "_top" } do %>
      <%= render_icon("repeat", classes: "h-4 w-4") %>
      <%= post.reshares_count %>
    <% end %>
  </span>
<% elsif user_signed_in? && post.user == current_user %>
  <%# You can't reshare your own post, but the count still belongs in the action row. %>
  <span class="fc-action is-muted" id="<%= dom_id(post, :reshare) %>" title="You can't reshare your own breath">
    <%= render_icon("repeat", classes: "h-4 w-4") %>
    <%= post.reshares_count %>
  </span>
<% elsif user_signed_in? %>
  <div class="fc-repost" id="<%= dom_id(post, :reshare) %>" data-controller="repost-menu">
    <button type="button"
            class="fc-action"
            data-action="click->repost-menu#toggleMenu"
            data-repost-menu-target="trigger"
            aria-haspopup="true"
            aria-expanded="false"
            title="Repost">
      <%= render_icon("repeat", classes: "h-4 w-4") %>
      <%= post.reshares_count %>
    </button>

    <div class="fc-repost-menu hidden" data-repost-menu-target="menu" role="menu">
      <%= button_to post_reshare_path(post),
          method: :post,
          form_class: "fc-repost-menu-form",
          class: "fc-repost-option",
          data: { turbo_frame: "_top" } do %>
        <%= render_icon("repeat", classes: "h-4 w-4") %>
        <div class="fc-repost-option-text">
          <strong>Repost</strong>
          <span>Share to your followers as-is.</span>
        </div>
      <% end %>

      <%= link_to new_post_path(quote: post.id),
          class: "fc-repost-option",
          role: "menuitem" do %>
        <%= render_icon("edit", classes: "h-4 w-4") %>
        <div class="fc-repost-option-text">
          <strong>Quote</strong>
          <span>Write your own breath with this one embedded.</span>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <span id="<%= dom_id(post, :reshare) %>">
    <%= link_to new_user_session_path, class: "fc-action" do %>
      <%= render_icon("repeat", classes: "h-4 w-4") %>
      <%= post.reshares_count %>
    <% end %>
  </span>
<% end %>
