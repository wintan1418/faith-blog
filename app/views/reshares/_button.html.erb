<%# Reshare control. Two flavors:
    - Quick repost (one click)
    - Repost with thought (opens an inline composer)
    Locals: post %>
<% if user_signed_in? && current_user.has_reshared?(post) %>
  <span id="<%= dom_id(post, :reshare) %>">
    <%= button_to post_reshare_path(post),
        method: :delete,
        class: "fc-action text-[var(--fc-gold)]",
        title: "Remove reshare",
        data: { turbo_frame: "_top" } do %>
      <%= render_icon("repeat", classes: "h-4 w-4") %>
      <%= post.reshares_count %>
    <% end %>
  </span>
<% elsif user_signed_in? %>
  <div class="fc-repost" id="<%= dom_id(post, :reshare) %>" data-controller="repost-menu">
    <button type="button"
            class="fc-action"
            data-action="click->repost-menu#toggleMenu"
            data-repost-menu-target="trigger"
            aria-haspopup="true"
            aria-expanded="false"
            title="Repost">
      <%= render_icon("repeat", classes: "h-4 w-4") %>
      <%= post.reshares_count %>
    </button>

    <div class="fc-repost-menu hidden" data-repost-menu-target="menu" role="menu">
      <%= button_to post_reshare_path(post),
          method: :post,
          form_class: "fc-repost-menu-form",
          class: "fc-repost-option",
          data: { turbo_frame: "_top" } do %>
        <%= render_icon("repeat", classes: "h-4 w-4") %>
        <div class="fc-repost-option-text">
          <strong>Repost</strong>
          <span>Share to your followers as-is.</span>
        </div>
      <% end %>

      <button type="button"
              class="fc-repost-option"
              data-action="click->repost-menu#openComposer"
              role="menuitem">
        <%= render_icon("edit", classes: "h-4 w-4") %>
        <div class="fc-repost-option-text">
          <strong>Repost with thought</strong>
          <span>Add a note before sharing.</span>
        </div>
      </button>
    </div>

    <div class="fc-repost-composer hidden" data-repost-menu-target="composer">
      <%= form_with url: post_reshare_path(post), method: :post, local: true,
                    data: { turbo_frame: "_top" } do |f| %>
        <%= f.text_area :thought,
            class: "fc-repost-thought",
            rows: 3,
            maxlength: 280,
            placeholder: "What's your thought on this breath? (optional)",
            data: { repost_menu_target: "thought", action: "input->repost-menu#updateCount" } %>
        <div class="fc-repost-composer-actions">
          <span class="fc-repost-count" data-repost-menu-target="count">0 / 280</span>
          <div class="fc-repost-composer-buttons">
            <button type="button"
                    class="fc-btn"
                    data-action="click->repost-menu#cancel">Cancel</button>
            <%= f.submit "Repost", class: "fc-btn fc-btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <span id="<%= dom_id(post, :reshare) %>">
    <%= link_to new_user_session_path, class: "fc-action" do %>
      <%= render_icon("repeat", classes: "h-4 w-4") %>
      <%= post.reshares_count %>
    <% end %>
  </span>
<% end %>
