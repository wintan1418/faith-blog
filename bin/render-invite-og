#!/usr/bin/env bash
# Renders the invite link preview (lib/og/invite.svg) to public/og/invite.jpg,
# because WhatsApp, Facebook and LinkedIn don't show SVG previews.
# Needs Google Chrome and macOS sips. Re-run after changing the SVG.
set -euo pipefail
CHROME="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
TMP="$(mktemp -d)"
"$CHROME" --headless=new --disable-gpu --hide-scrollbars --window-size=1200,630 \
  --virtual-time-budget=2000 --screenshot="$TMP/invite.png" "file://$PWD/lib/og/invite.svg" >/dev/null 2>&1
sips -s format jpeg -s formatOptions 88 "$TMP/invite.png" --out public/og/invite.jpg >/dev/null
rm -rf "$TMP"
echo public/og/invite.jpg
